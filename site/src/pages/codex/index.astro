---
import Base from '../../layouts/Base.astro';
import GuidePage from '../../components/GuidePage.astro';
import CodexGrid from '../../components/CodexGrid.astro';
import DiscordBanner from '../../components/DiscordBanner.astro';
import { heroCodex } from '../../data/heroCodex';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'en';
const base = lang === 'en' ? '' : `/${lang}`;
---

<Base lang={lang} path="/codex/" title="Hero Codex" description="Every key hero in Last Asylum: Plague — skills, builds, team notes and how to get them.">
  <GuidePage
    title="📖 Hero Codex"
    description="Skills, build priorities and team notes for every hero that matters — compiled from the community guides."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/' }, { label: 'Hero Codex' }]}
  >
    <p>Each page: role, how to get the hero, the skills that actually matter, build priorities and the team comps they appear in. For rankings see the <a href="/tier-list/">tier list</a>.</p>

    <CodexGrid heroes={heroCodex} lang={lang} base={base} />

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>