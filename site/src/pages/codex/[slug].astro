---
import Base from '../../layouts/Base.astro';
import GuidePage from '../../components/GuidePage.astro';
import DiscordBanner from '../../components/DiscordBanner.astro';
import VideoSection from '../../components/VideoSection.astro';
import { heroCodex } from '../../data/heroCodex';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'en';

export function getStaticPaths() {
  return heroCodex.map((hero) => ({
    params: { slug: hero.slug },
    props: { hero },
  }));
}

const { hero } = Astro.props;
---

<Base lang={lang} path={`/codex/${hero.slug}/`} title={`${hero.name} — Hero Guide`} description={`${hero.name}: ${hero.role}`}>
  <GuidePage
    title={`${hero.name}`}
    description={hero.role}
    lang={lang}
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Hero Codex', href: '/codex/' }, { label: hero.name }]}
  >
    <div class="not-prose mb-6 flex flex-wrap items-center gap-2">
      <span class={`rounded px-2.5 py-1 text-sm font-bold ${hero.tier === 'S' ? 'bg-red-900/40 text-red-300' : hero.tier === 'A' ? 'bg-amber-900/40 text-amber-300' : 'bg-sky-900/40 text-sky-300'}`}>{hero.tier} tier</span>
      <span class="rounded bg-stone-800 px-2.5 py-1 text-sm text-plague-200">{hero.rarity}</span>
      <span class="rounded bg-stone-800 px-2.5 py-1 text-sm text-stone-300">{hero.faction}</span>
      <span class="rounded bg-stone-800 px-2.5 py-1 text-sm text-stone-300">{hero.className}</span>
    </div>

    <h2 id="how-to-get">How to get</h2>
    <p>{hero.howToGet}</p>

    <h2 id="skills">Skills that matter</h2>
    <div class="not-prose my-4 space-y-3">
      {hero.skills.map((s) => (
        <div class="rounded-lg border border-stone-800 bg-stone-900 p-4">
          <p class="font-bold text-plague-200">{s.name}</p>
          <p class="mt-1 text-sm text-stone-400">{s.desc}</p>
        </div>
      ))}
    </div>

    <h2 id="build">Build priorities</h2>
    <ul>
      {hero.buildTips.map((tip) => <li>{tip}</li>)}
    </ul>

    <h2 id="teams">Team notes</h2>
    <p>{hero.teamNotes}</p>

    {hero.video && (
      <div class="not-prose my-8">
        <h2 class="mb-4 text-2xl font-bold text-plague-200">Video guide</h2>
        <div class="js-video-facade max-w-lg" data-video-id={hero.video} role="button" tabindex="0" aria-label="Play video">
          <span class="block aspect-video overflow-hidden rounded-lg border border-stone-800">
            <img src={`https://i.ytimg.com/vi/${hero.video}/hqdefault.jpg`} alt="Video guide" loading="lazy" class="h-full w-full object-cover" />
          </span>
        </div>
      </div>
    )}

    <p class="mt-8"><a href="/codex/">← All heroes</a></p>

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>

<script>
  document.querySelectorAll('.js-video-facade').forEach((el) => {
    el.addEventListener('click', () => {
      const id = (el as HTMLElement).dataset.videoId;
      if (!id) return;
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
      frame.title = 'Video guide';
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      frame.allowFullscreen = true;
      frame.className = 'aspect-video w-full max-w-lg rounded-lg';
      el.replaceWith(frame);
    });
  });
</script>