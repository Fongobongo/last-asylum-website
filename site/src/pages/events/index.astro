---
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'en';
const events = [
  { slug: 'alliance-duel', name: 'Alliance Duel', icon: '⚔️', desc: 'Six-day alliance competition with daily point categories, exact point values and the save-everything economy.' },
  { slug: 'elixir', name: 'Elixir Scramble', icon: '🧪', desc: '30-minute AvA point battlefield where control, not kills, wins — Healing Tents, castle priority and teleport rules.' },
  { slug: 'kvk', name: 'Kingdom War (KvK)', icon: '🏰', desc: 'Server-versus-server war for the Royal City: turret-first attacks, stall-tactic defense and real troop risk.' },
  { slug: 'undead', name: 'Undead Siege', icon: '🧟', desc: 'Alliance defense against infected waves — the hidden multi-squad mechanic, persistent HP and reward milestones.' },
  { slug: 'cheese', name: 'Cheese Trap', icon: '🧀', desc: 'Alliance rally vs the giant rat: five-phase personal rewards, shared alliance HP pool and level-scaling math.' },
  { slug: 'thief', name: 'Thief Hunt', icon: '💰', desc: 'Spend stamina to spawn Thief Leader bosses — spawn mechanics, the nonstop-kill technique and exchange priorities.' },
  { slug: 'survival', name: 'Survival Battle', icon: '🛡️', desc: 'Weekly mission event worth ~60,000 free Skill Badges — cheap completions and the Alliance Duel overlap.' },
  { slug: 'canyon', name: 'Canyon Conquest', icon: '🏜️', desc: 'Three-lane relay battle where staying power beats power — lane priority strategy in a zero-risk event.' },
  { slug: 'mythic', name: 'Mythic Treasure', icon: '🗺️', desc: 'The seven-tab pirate event decoded for F2P: market priorities, the 300-fish cap and the Buried Treasure play.' },
  { slug: 'royal', name: 'Royal Castle Scramble', icon: '👑', desc: 'Weekly castle capture race — one march per player, 30-slot reinforcement and the full Royal City title system.' },
  { slug: 'arena', name: 'Triangle Arena', icon: '🔺', desc: 'Three lineups, attacker picks two to beat — even defense, sacrifice matchups and the Arena of Fate trap squad.' },
  { slug: 'wagon', name: 'Guild Wagon & Caravans', icon: '🚚', desc: 'Daily free wagon runs, Guard chest rules, Golden Wagon refreshes and the caravan UR-shard farm.' },
  { slug: 'supreme-healer', name: 'Supreme Healer', icon: '🩺', desc: '7-day competitive scoring schedule, day-by-day resource management, stamina stockpiling, and Antitoxin timing.' },
];
---
<Base lang={lang} path="/events/" title="Event Guides" description="Complete breakdowns of every Last Asylum: Plague event: schedules, scoring, strategy and mistakes to avoid.">
  <section class="py-12">
    <h1 class="mb-3 text-4xl font-bold text-plague-100">Event Guides</h1>
    <p class="mb-10 text-lg text-stone-400">Complete breakdowns of every event: schedules, scoring, strategy and mistakes to avoid.</p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {events.map(e => (
        <a href={`/events/${e.slug}/`} class="group rounded-lg border border-stone-800 bg-stone-900 p-5 transition-colors hover:border-plague-600">
          <span class="text-3xl">{e.icon}</span>
          <h2 class="mt-3 text-lg font-bold text-plague-200 group-hover:text-plague-100">{e.name}</h2>
          <p class="mt-2 text-sm text-stone-400">{e.desc}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
