---
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'fr';

const sections = [
  { href: '/fr/beginners/', icon: '🌱', title: 'Guide débutant', key: 'home.sections.beginners.desc', color: 'from-green-900/40' },
  { href: '/fr/buildings/', icon: '🏰', title: 'Bâtiments', key: 'home.sections.buildings.desc', color: 'from-amber-900/40' },
  { href: '/fr/heroes/', icon: '⚔️', title: 'Héros', key: 'home.sections.heroes.desc', color: 'from-red-900/40' },
  { href: '/fr/economy/', icon: '💰', title: 'Économie', key: 'home.sections.economy.desc', color: 'from-yellow-900/40' },
  { href: '/fr/raven/', icon: '🐦‍⬛', title: 'Corbeau et épigraphes', key: 'home.sections.raven.desc', color: 'from-purple-900/40' },
  { href: '/fr/era/', icon: '☣️', title: 'Ère du Renouveau', key: 'home.sections.era.desc', color: 'from-lime-900/40' },
  { href: '/fr/codes/', icon: '🎁', title: 'Codes cadeaux', key: 'home.sections.codes.desc', color: 'from-toxic-900/40' },
  { href: '/fr/patch-notes/', icon: '📜', title: 'Notes de mise à jour', key: 'home.sections.patchnotes.desc', color: 'from-stone-700/40' },
];

const popular = [
  { href: '/fr/beginners/', title: 'Vos premières 24 heures', desc: 'La checklist du premier jour qui décide du destin de tout votre compte.' },
  { href: '/fr/economy/', title: 'Priorités diamants et boutiques', desc: 'L&apos;ordre d&apos;achat exact pour chaque boutique, et ce qu&apos;il ne faut jamais acheter.' },
  { href: '/fr/heroes/', title: 'L&apos;escouade F2P', desc: 'Arthur, Daskal, Marlena, Harper, Claire — le chemin canonique.' },
  { href: '/fr/events/undead/', title: 'Siège des morts-vivants', desc: 'La mécanique cachée des 2 escouades par vague qui tue les joueurs à 9.5M.' },
  { href: '/fr/events/alliance-duel/', title: 'Duel d&apos;Alliances', desc: 'Gardez les parchemins pour la Phase 3, les fragments pour la Phase 4, les accélérations pour la Phase 5.' },
  { href: '/fr/era/', title: 'Claire SSR→UR', desc: 'Évitez la chute 6★–9★ grâce aux niveaux du Hall d&apos;Honneur.' },
];
---

<Base lang={lang} path="/fr/">
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-stone-800">
    <div class="absolute inset-0 bg-gradient-to-b from-plague-950/80 to-transparent"></div>
    <div class="relative py-20 sm:py-28">
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-toxic-400">Last Asylum: Plague — Fan Hub</p>
      <h1 class="mb-5 text-4xl font-bold tracking-tight text-plague-100 sm:text-6xl">
        Survivez à la peste
      </h1>
      <p class="mb-8 max-w-2xl text-lg leading-relaxed text-stone-300">
        La base de connaissances de la communauté : parcours pour débutants, priorités de construction, stratégies F2P, priorités de boutiques et analyses complètes des événements — tout issu des guides du Discord officiel et vérifié par les joueurs.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/fr/beginners/" class="rounded-lg bg-plague-700 px-6 py-3 font-semibold text-plague-50 hover:bg-plague-600 transition-colors">
          Voir les guides →
        </a>
        <a href="/fr/events/" class="rounded-lg border border-stone-700 px-6 py-3 font-semibold text-stone-200 hover:bg-stone-800 transition-colors">
          Guides d&apos;événements →
        </a>
      </div>
    </div>
  </section>

  <!-- Sections grid -->
  <section class="py-14">
    <h2 class="mb-8 text-2xl font-bold text-plague-200">Guides</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {sections.map((s) => (
        <a href={s.href} class={`group rounded-xl border border-stone-800 bg-gradient-to-br ${s.color} to-stone-900 p-6 transition-colors hover:border-plague-500`}>
          <span class="text-3xl">{s.icon}</span>
          <h3 class="mt-3 text-lg font-bold text-plague-200 group-hover:text-plague-100">{s.title}</h3>
          <p class="mt-2 text-sm text-stone-400">{t(lang, s.key as any)}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Events banner -->
  <section class="mb-14 rounded-xl border border-plague-800 bg-plague-950/50 p-8">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-plague-200">⚔️ Événements</h2>
        <p class="mt-1 text-stone-400">Duel d&apos;Alliances, KvK, Siège des morts-vivants et tous les autres événements.</p>
      </div>
      <a href="/fr/events/" class="rounded-lg bg-plague-700 px-5 py-2.5 font-semibold text-plague-50 hover:bg-plague-600 transition-colors">
        Guides d&apos;événements →
      </a>
    </div>
  </section>

  <!-- Popular guides -->
  <section class="mb-16">
    <h2 class="mb-8 text-2xl font-bold text-plague-200">Guides populaires</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {popular.map((p) => (
        <a href={p.href} class="group rounded-lg border border-stone-800 bg-stone-900 p-5 transition-colors hover:border-plague-600">
          <h3 class="font-bold text-stone-100 group-hover:text-plague-200" set:html={p.title} />
          <p class="mt-2 text-sm text-stone-400" set:html={p.desc} />
        </a>
      ))}
    </div>
  </section>

  <!-- Support banner -->
  <section class="mb-16 rounded-xl border border-stone-800 bg-stone-900 p-8">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-plague-200">❤️ Soutenir le projet</h2>
        <p class="mt-1 text-stone-400">Soutenez le projet et recevez de la valeur en jeu.</p>
      </div>
      <a href="/fr/support/" class="rounded-lg bg-blood-600 px-5 py-2.5 font-semibold text-white hover:bg-blood-500 transition-colors">
        Nous soutenir →
      </a>
    </div>
  </section>
</Base>
