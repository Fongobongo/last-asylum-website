  { href: '/fr/heroes/', title: 'L&apos;escouade F2P', desc: 'Arthur, Daskal, Marlena, Harper, Claire — le chemin canonique.' },
  { href: '/fr/events/undead/', title: 'Siège des morts-vivants', desc: 'La mécanique cachée des 2 escouades par vague qui tue les joueurs à 9.5M.' },
  { href: '/fr/events/alliance-duel/', title: 'Duel d&apos;Alliances', desc: 'Gardez les parchemins pour la Phase 3, les fragments pour la Phase 4, les accélérations pour la Phase 5.' },
  { href: '/fr/era/', title: 'Claire SSR→UR', desc: 'Évitez la chute 6★–9★ grâce aux niveaux du Hall d&apos;Honneur.' },
];
---

<Home lang={lang} path="/fr/" sections={sections} popular={popular} />
