---
import Home from '../../components/Home.astro';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'fr';

const sections = [
  { href: '/fr/beginners/', icon: '🌱', title: 'Guide débutant', key: 'home.sections.beginners.desc', color: 'from-green-900/40' },
  { href: "/fr/tips/", icon: "🧠", title: "Astuces & Secrets", key: "home.sections.tips.desc", color: "from-fuchsia-900/40" },
