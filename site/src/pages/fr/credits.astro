];
---

<Base lang={lang} path="/fr/credits/" title="Crédits et sources" description="Crédits aux auteurs des guides communautaires de Last Asylum: Plague dont le travail alimente ce hub.">
  <GuidePage title="🙏 Crédits et sources" description="Ce hub est une compilation de connaissances communautaires. Les guides ont été écrits gratuitement par des membres de la communauté — respect et crédit à tous." lang={lang}>
    <h2 id="authors">Auteurs des guides</h2>
    <div class="not-prose my-6 grid gap-3 sm:grid-cols-2">
      {authors.map((a) => (
        <div class="rounded-lg border border-stone-800 bg-stone-900 p-4">
          <p class="font-bold text-plague-200">{a.name} <span class="ml-1 rounded bg-stone-800 px-1.5 py-0.5 text-xs font-medium text-stone-400">{a.tag}</span></p>
          <p class="mt-1 text-sm text-stone-400" set:html={a.contributions.join(' · ')} />
        </div>
      ))}
    </div>

    <h2 id="sources">Sources</h2>
    <ul>
      {sources.map((s) => (
        <li>
          {s.url
            ? <a href={s.url} target="_blank" rel="noopener noreferrer">{s.name}</a>
            : <strong>{s.name}</strong>}
          {' — '}{s.desc}
        </li>
      ))}
    </ul>

    <p class="mt-6 text-sm text-stone-500">Si vous êtes un auteur et souhaitez voir votre nom ajusté ou retiré, contactez-nous — nous corrigerons rapidement.</p>
  </GuidePage>
</Base>
