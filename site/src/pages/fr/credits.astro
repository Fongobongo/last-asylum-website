  { name: 'skyyzies', tag: 'communauté', contributions: ['Règles de défense et d&apos;attaque de l&apos;Arène Triangulaire'] },
  { name: 'verratvonwindir', tag: 'S2', contributions: ['Mécaniques de la Mêlée du Château Royal'] },
