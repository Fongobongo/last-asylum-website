  { name: 'DrGayLord / HOLY', tag: 'S247', contributions: ['Bases pour débutants : bâtiments, équipement, factions'] },
  { name: '뀨잉이 (jjuingyi)', tag: 'communauté', contributions: ['Guide Guild Wagon (KO)'] },
  { name: 'bulheba', tag: 'communauté RU', contributions: ['RU : mécaniques PVP, ordre de build, vidéos Duel d&apos;Alliances'] },
  { name: 'LapBase / ikona_in', tag: 'communauté RU', contributions: ['RU : escouade F2P d&apos;infanterie, guides d&apos;événements'] },
  { name: 'oψsvge英俊的', tag: 'K250', contributions: ['ID : Ère du Renouveau, Siège des morts-vivants, premières semaines'] },
