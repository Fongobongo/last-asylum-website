const sources = [
  { name: 'Discord officiel — #official-guide', url: null, desc: 'Guides officiels bâtiments/héros/Puissance/antitoxine' },
  { name: 'Discord officiel — #player-guide', url: null, desc: '520+ fils communautaires en ~15 langues (extraits avec discord.py-self)' },
  { name: 'Sirox’s LAP Hub', url: 'https://thelaphub.com', desc: 'Planificateur de recherches, calculatrices, codex héros/bâtiments' },
  { name: 'Strategic Game Guide', url: 'https://strategic-game-guide.netlify.app', desc: 'Priorités de boutiques en 5 langues' },
