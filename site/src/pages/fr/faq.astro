---
import Base from '../../layouts/Base.astro';
import GuidePage from '../../components/GuidePage.astro';
import DiscordBanner from '../../components/DiscordBanner.astro';
import { faqFr } from '../../data/faqFr';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'fr';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqFr.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});
---

<Base lang={lang} path="/fr/faq/" title="FAQ" description="Réponses aux questions les plus courantes sur Last Asylum: Plague : meilleure équipe F2P, ordre d&apos;amélioration, limites de pillage, priorités des boutiques, codes cadeaux.">
  <GuidePage
    title="❓ Questions fréquentes"
    description="Les questions que les joueurs posent vraiment, avec les réponses consensuelles de la communauté."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/fr/' }, { label: 'FAQ' }]}
  >
    <script slot="faq-schema" type="application/ld+json" set:html={schema} />

    <div class="not-prose my-6 space-y-3">
      {faqFr.map((f) => (
        <details class="group rounded-lg border border-stone-800 bg-stone-900">
          <summary class="cursor-pointer select-none px-4 py-3 font-semibold text-plague-200 group-open:text-plague-100">
            {f.q}
          </summary>
          <p class="border-t border-stone-800 px-4 py-3 text-sm leading-relaxed text-stone-300">{f.a}</p>
        </details>
      ))}
    </div>

    <p>Votre question n&apos;est pas traitée ? Consultez les guides spécifiques : <a href="/fr/beginners/">débutants</a>, <a href="/fr/economy/">économie</a>, <a href="/fr/heroes/">héros</a>, <a href="/fr/gear/">équipement</a>, <a href="/fr/raven/">Corbeau</a>, <a href="/fr/era/">Ère du Renouveau</a> — ou posez la question sur le Discord officiel.</p>

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>
