---
import Base from '../../layouts/Base.astro';
import GuidePage from '../../components/GuidePage.astro';
import InfographicGallery from '../../components/InfographicGallery.astro';
import DiscordBanner from '../../components/DiscordBanner.astro';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'fr';
---

<Base lang={lang} path="/infographics/" title="Infographies — Last Asylum: Plague" description="Toutes les affiches, schémas visuels et antisèches de Last Asylum: Plague en haute résolution.">
  <GuidePage
    title="📊 Infographies"
    description="Toutes les affiches, schémas visuels et antisèches de Last Asylum: Plague en haute résolution."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/fr/' }, { label: 'Infographies' }]}
  >
    <InfographicGallery lang={lang} />

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>
