---
import Base from '../../../../layouts/Base.astro';
import GuidePage from '../../../../components/GuidePage.astro';
import DiscordBanner from '../../../../components/DiscordBanner.astro';
import { heroCodex } from '../../../../data/heroCodex';
import type { Lang } from '../../../../i18n/utils';

const lang: Lang = 'fr';

export function getStaticPaths() {
  return heroCodex.map((hero) => ({
    params: { slug: hero.slug },
    props: { hero },
  }));
}

const { hero } = Astro.props;
---

<Base lang={lang} path={`/codex/${hero.slug}/`} title={`${hero.name} вЂ” Hero Guide`} description={hero.role}>
  <GuidePage
    title={hero.name}
    description={hero.role}
    lang={lang}
    breadcrumbs={[{ label: 'Accueil', href: '/fr/' }, { label: 'Codex des hГ©ros', href: '/fr/codex/' }, { label: hero.name }]}
  >
    <div class="not-prose mb-6 flex flex-wrap items-center gap-2">
      <span class={`rounded px-2.5 py-1 text-sm font-bold ${hero.tier === 'S' ? 'bg-red-900/40 text-red-300' : hero.tier === 'A' ? 'bg-amber-900/40 text-amber-300' : 'bg-sky-900/40 text-sky-300'}`}>{hero.tier}</span>
      <span class="rounded bg-stone-800 px-2.5 py-1 text-sm text-plague-200">{hero.rarity}</span>
      <span class="rounded bg-stone-800 px-2.5 py-1 text-sm text-stone-300">{hero.faction}</span>
      <span class="rounded bg-stone-800 px-2.5 py-1 text-sm text-stone-300">{hero.className}</span>
    </div>
    <p class="text-sm text-stone-500">Termes selon la version anglaise du jeu.</p>

    <h2 id="how-to-get">Comment lвЂ™obtenir</h2>
    <p>{hero.howToGet}</p>

    <h2 id="skills">CompГ©tences clГ©s</h2>
    <div class="not-prose my-4 space-y-3">
      {hero.skills.map((s) => (
        <div class="rounded-lg border border-stone-800 bg-stone-900 p-4">
          <p class="font-bold text-plague-200">{s.name}</p>
          <p class="mt-1 text-sm text-stone-400">{s.desc}</p>
        </div>
      ))}
    </div>

    <h2 id="build">PrioritГ©s</h2>
    <ul>
      {hero.buildTips.map((tip) => <li>{tip}</li>)}
    </ul>

    <h2 id="teams">Notes dвЂ™Г©quipe</h2>
    <p>{hero.teamNotes}</p>

    <p class="mt-8"><a href="/fr/codex/">в†ђ Tous les hГ©ros</a></p>

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>
