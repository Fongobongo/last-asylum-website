---
import Base from '../../../layouts/Base.astro';
import GuidePage from '../../../components/GuidePage.astro';
import CodexGrid from '../../../components/CodexGrid.astro';
import DiscordBanner from '../../../components/DiscordBanner.astro';
import { heroCodex } from '../../../data/heroCodex';
import { t } from '../../../i18n/ui';
import type { Lang } from '../../../i18n/utils';

const lang: Lang = 'fr';
const base = lang === 'en' ? '' : `/${lang}`;
---

<Base lang={lang} path="/fr/codex/" title="Codex des héros" description="Tous les héros clés de Last Asylum: Plague — compétences, builds, notes d&apos;équipe et comment les obtenir.">
  <GuidePage
    title="📖 Codex des héros"
    description="Compétences, priorités de build et notes d&apos;équipe pour chaque héros qui compte — compilé à partir des guides de la communauté."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/fr/' }, { label: 'Codex des héros' }]}
  >
    <p>Sur chaque page : le rôle, comment obtenir le héros, les compétences qui comptent vraiment, les priorités de build et les compositions d&apos;équipe où il apparaît. Pour les classements, voir la <a href="/fr/tier-list/">tier list</a>.</p>

    <CodexGrid heroes={heroCodex} lang={lang} base={base} />

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>
