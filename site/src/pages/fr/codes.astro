---
import Base from '../../layouts/Base.astro';
import GuidePage from '../../components/GuidePage.astro';
import GiftCodes from '../../components/GiftCodes.astro';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'fr';
---

<Base lang={lang} path="/fr/codes/" title={t(lang, 'codes.title')} description={t(lang, 'codes.desc')}>
  <GuidePage title={`🎁 ${t(lang, 'codes.title')}`} description={t(lang, 'codes.desc')} lang={lang}>
    <p class="text-sm text-stone-300 mt-2">Guide détaillé (<b>dans le jeu</b> et <b>via UID + mot de passe à usage unique sur la page web officielle</b>) — <a href="#how-to-redeem" class="text-toxic-400 underline">plus bas sur cette page</a>.</p>

    <h2 id="latest-codes">{t(lang, 'codes.active')}</h2>
    <GiftCodes lang={lang} />

    <h2 id="how-to-redeem">{t(lang, 'codes.redeem')}</h2>
    <p>{t(lang, 'codes.redeem.android')}</p>
    <p>{t(lang, 'codes.redeem.ios')}</p>

    <h2 id="notes">{t(lang, 'codes.note')}</h2>
  </GuidePage>
</Base>
