---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/utils';

const lang: Lang = 'en';

const sections = [
  { href: '/beginners/', icon: '🌱', title: 'Beginner Guide', key: 'home.sections.beginners.desc', color: 'from-emerald-900/30' },
  { href: '/buildings/', icon: '🏗️', title: 'Buildings', key: 'home.sections.buildings.desc', color: 'from-amber-900/30' },
  { href: '/heroes/', icon: '🦸', title: 'Heroes', key: 'home.sections.heroes.desc', color: 'from-red-900/30' },
  { href: '/economy/', icon: '💎', title: 'Economy', key: 'home.sections.economy.desc', color: 'from-yellow-900/30' },
  { href: '/raven/', icon: '🐦', title: 'Raven & Epigraphs', key: 'home.sections.raven.desc', color: 'from-violet-900/30' },
  { href: '/era/', icon: '🌅', title: 'Era of Revival', key: 'home.sections.era.desc', color: 'from-lime-900/30' },
  { href: '/codes/', icon: '🎁', title: 'Gift Codes', key: 'home.sections.codes.desc', color: 'from-cyan-900/30' },
  { href: '/patch-notes/', icon: '📝', title: 'Patch Notes', key: 'home.sections.patchnotes.desc', color: 'from-stone-700/30' },
  { href: '/calendar/', icon: '📅', title: 'Event Calendar', key: 'home.sections.patchnotes.desc', color: 'from-indigo-900/30' },
  { href: '/tier-list/', icon: '🏆', title: 'Tier List', key: 'home.sections.events.desc', color: 'from-rose-900/30' },
  { href: '/codex/', icon: '📖', title: 'Hero Codex', key: 'home.sections.heroes.desc', color: 'from-sky-900/30' },
];

const popular = [
  { href: '/beginners/', title: 'Your First 24 Hours', desc: 'The day-one checklist that decides your whole account.' },
  { href: '/economy/', title: 'Diamond & Shop Priorities', desc: 'Exact buy order for every shop, and what never to buy.' },
  { href: '/heroes/', title: 'The F2P Squad', desc: 'Arthur, Daskal, Marlena, Harper, Claire — the canonical path.' },
  { href: '/events/undead/', title: 'Undead Siege', desc: 'The hidden 2-squad wave mechanic that kills 9.5M players.' },
  { href: '/events/alliance-duel/', title: 'Alliance Duel', desc: 'Save scrolls for Phase 3, shards for Phase 4, speedups for Phase 5.' },
  { href: '/era/', title: 'Claire SSR→UR', desc: 'Skip the 6★–9★ dip with Hall of Honor levels.' },
];
---
<Base lang={lang} path="/">
  <!-- Hero - refined plague -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <div class="absolute inset-0 bg-gradient-to-b from-stone-900 via-stone-950 to-[#0c0c0a]"></div>
      <div class="absolute -top-32 -left-32 h-[520px] w-[520px] rounded-full bg-plague-700/10 blur-[90px]"></div>
      <div class="absolute -top-20 right-0 h-[480px] w-[480px] rounded-full bg-toxic-500/5 blur-[80px]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.015)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.015)_1px,transparent_1px)] bg-[size:32px_32px] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,#000_70%,transparent_110%)]"></div>
    </div>

    <div class="relative py-16 sm:py-20">
      <div class="inline-flex items-center gap-2 rounded-full border border-plague-800/50 bg-plague-950/40 px-3 py-1 text-xs font-medium tracking-wide text-plague-200 backdrop-blur">
        <span class="h-1.5 w-1.5 rounded-full bg-toxic-400 animate-pulse"></span>
        Community verified • 532 pages • 9 languages
      </div>

      <h1 class="mt-5 max-w-3xl text-4xl font-bold tracking-[-0.03em] text-stone-100 sm:text-[54px] sm:leading-[0.95]">
        <span class="bg-gradient-to-br from-stone-100 via-plague-100 to-stone-300 bg-clip-text text-transparent">{t(lang, 'home.hero.title')}</span>
      </h1>

      <p class="mt-4 max-w-2xl text-[17px] leading-7 text-stone-300/90">
        {t(lang, 'home.hero.subtitle')}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="/beginners/" class="inline-flex items-center gap-2 rounded-full bg-gradient-to-br from-plague-600 to-plague-700 px-6 py-3 text-sm font-semibold text-white shadow-[0_4px_20px_rgba(100,92,27,0.35),inset_0_1px_0_rgba(255,255,255,0.08)] hover:from-plague-500 hover:to-plague-600 transition">
          {t(lang, 'home.cta.guides')} <span class="text-white/70">→</span>
        </a>
        <a href="/events/" class="inline-flex items-center gap-2 rounded-full border border-stone-700 bg-stone-900/60 px-6 py-3 text-sm font-semibold text-stone-200 backdrop-blur hover:bg-stone-800 hover:border-stone-600 hover:text-white transition">
          {t(lang, 'home.cta.events')} <span class="text-stone-500">↗</span>
        </a>
        <span class="hidden sm:inline-flex items-center gap-2 text-xs text-stone-500 ml-2">
          <span class="h-px w-6 bg-stone-700"></span>
          Updated from Discord daily
        </span>
      </div>

      <div class="mt-10 flex flex-wrap gap-6 border-t border-stone-800/60 pt-6 text-sm">
        <div class="flex items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-stone-900 border border-stone-800 text-stone-400">◈</span>
          <div><div class="font-semibold text-stone-200">28 heroes</div><div class="text-xs text-stone-500">codex & builds</div></div>
        </div>
        <div class="flex items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-stone-900 border border-stone-800 text-stone-400">⚡</span>
          <div><div class="font-semibold text-stone-200">12 events</div><div class="text-xs text-stone-500">full breakdowns</div></div>
        </div>
        <div class="flex items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-stone-900 border border-stone-800 text-stone-400">◆</span>
          <div><div class="font-semibold text-stone-200">F2P first</div><div class="text-xs text-stone-500">verified paths</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sections - bento -->
  <section class="py-12">
    <div class="flex items-end justify-between gap-4 mb-6">
      <h2 class="text-xl font-semibold tracking-tight text-stone-100">Guides</h2>
      <span class="text-xs tracking-widest uppercase text-stone-500">11 sections • RU + EN</span>
    </div>
    <div class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
      {sections.map((s) => (
        <a href={s.href} class="group relative overflow-hidden rounded-2xl border border-stone-800/60 bg-gradient-to-b from-stone-900/60 to-stone-900 p-[1px] hover:border-plague-700/40 transition">
          <div class="relative rounded-[15px] bg-gradient-to-br from-stone-900 to-stone-950 p-5 h-full">
            <div class={`absolute inset-0 rounded-[15px] bg-gradient-to-br ${s.color} opacity-0 group-hover:opacity-100 transition duration-500`}></div>
            <div class="relative">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-stone-800 border border-stone-700/50 text-lg group-hover:scale-105 transition">{s.icon}</div>
              <h3 class="mt-4 text-[15px] font-semibold tracking-tight text-stone-100 group-hover:text-plague-100 transition">{s.title}</h3>
              <p class="mt-1.5 text-[13.5px] leading-5 text-stone-400 line-clamp-2">{t(lang, s.key as any)}</p>
              <div class="mt-4 inline-flex items-center gap-1 text-xs font-medium text-stone-500 group-hover:text-plague-300 transition">Explore <span class="transition-transform group-hover:translate-x-0.5">→</span></div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Events banner - refined -->
  <section class="relative overflow-hidden rounded-2xl border border-plague-900/40 bg-gradient-to-br from-plague-950/60 via-stone-900 to-stone-950 p-[1px] mb-12">
    <div class="rounded-[15px] bg-gradient-to-br from-plague-950/30 to-transparent p-7 sm:p-8">
      <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-plague-700/10 blur-2xl"></div>
      <div class="relative flex flex-col sm:flex-row sm:items-center justify-between gap-5">
        <div class="flex gap-4">
          <div class="hidden sm:flex h-10 w-10 items-center justify-center rounded-xl bg-plague-900/50 border border-plague-800/50 text-plague-200">⚔️</div>
          <div>
            <h2 class="text-[15px] font-semibold tracking-tight text-plague-100">{t(lang, 'nav.events')}</h2>
            <p class="mt-1 text-sm leading-5 text-stone-400 max-w-xl">{t(lang, 'home.sections.events.desc')}</p>
          </div>
        </div>
        <a href="/events/" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-plague-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-plague-500 transition">
          {t(lang, 'home.cta.events')} <span>↗</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Popular -->
  <section class="mb-12">
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="text-xl font-semibold tracking-tight text-stone-100">{t(lang, 'home.latest.title')}</h2>
      <a href="/patch-notes/" class="text-xs font-medium text-stone-500 hover:text-stone-300 transition">All updates →</a>
    </div>
    <div class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
      {popular.map((p) => (
        <a href={p.href} class="group relative rounded-2xl border border-stone-800/60 bg-stone-900/40 p-5 hover:bg-stone-900 hover:border-stone-700/60 hover:shadow-[0_8px_30px_rgba(0,0,0,0.3)] transition">
          <div class="text-[13px] font-medium tracking-wide text-plague-300/80 uppercase">Featured</div>
          <h3 class="mt-1.5 text-[15px] font-semibold leading-tight text-stone-100 group-hover:text-white transition line-clamp-2">{p.title}</h3>
          <p class="mt-2 text-[13.5px] leading-5 text-stone-400 line-clamp-2">{p.desc}</p>
          <div class="mt-3 text-xs font-medium text-stone-500 group-hover:text-stone-300 transition">Read →</div>
        </a>
      ))}
    </div>
  </section>

  <!-- Support - refined -->
  <section class="relative overflow-hidden rounded-2xl border border-stone-800 bg-stone-900/40 p-[1px] mb-12">
    <div class="rounded-[15px] bg-gradient-to-br from-stone-900 via-stone-900 to-stone-950 p-7 sm:p-8">
      <div class="flex flex-col sm:flex-row gap-6 sm:items-center justify-between">
        <div class="flex gap-4">
          <div class="hidden sm:flex h-10 w-10 items-center justify-center rounded-xl bg-blood-600/20 border border-blood-500/20 text-blood-400">♥</div>
          <div>
            <h2 class="text-[15px] font-semibold tracking-tight text-stone-100">{t(lang, 'nav.support')}</h2>
            <p class="mt-1 text-sm leading-5 text-stone-400 max-w-xl">{t(lang, 'home.sections.support.desc')}</p>
          </div>
        </div>
        <a href="/support/" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-stone-900 hover:bg-stone-100 transition">
          {t(lang, 'nav.support')} <span class="text-stone-500">→</span>
        </a>
      </div>
    </div>
  </section>
</Base>