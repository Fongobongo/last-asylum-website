---
import Base from '../../layouts/Base.astro';
import GuidePage from '../../components/GuidePage.astro';
import PatchNotes from '../../components/PatchNotes.astro';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'th';
---

<Base lang={lang} path="/th/patch-notes/" title="บันทึกแพตช์" description="สรุปการบำรุงรักษาและการอัปเดตเซิร์ฟเวอร์ทั้งหมดของ Last Asylum: Plague โดยเรียงจากล่าสุด">
  <GuidePage title={`📜 ${t(lang, 'patchnotes.title')}`} description={t(lang, 'patchnotes.desc')} lang={lang}>
    <PatchNotes />
  </GuidePage>
</Base>