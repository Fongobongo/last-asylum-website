---
import Base from '../../../layouts/Base.astro';
import GuidePage from '../../../components/GuidePage.astro';
import CodexGrid from '../../../components/CodexGrid.astro';
import DiscordBanner from '../../../components/DiscordBanner.astro';
import { heroCodex } from '../../../data/heroCodex';
import { t } from '../../../i18n/ui';
import type { Lang } from '../../../i18n/utils';

const lang: Lang = 'th';
const base = lang === 'en' ? '' : `/${lang}`;
---

<Base lang={lang} path="/th/codex/" title="Helden-Kodex" description="Jeder wichtige Held in Last Asylum: Plague — Skills, Builds, Team-Notizen und wie man ihn bekommt.">
  <GuidePage
    title="📖 Helden-Kodex"
    description="Skills, Build-Prioritäten und Team-Notizen für jeden Helden, der zählt — zusammengestellt aus den Community-Guides."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/th/' }, { label: 'Helden-Kodex' }]}
  >
    <p>แต่ละหน้าประกอบด้วย: บทบาท, วิธีได้รับฮีโร่, สกิลที่สำคัญจริงๆ, ลำดับความสำคัญในการจัดบิลด์ และทีมที่ฮีโร่ตัวนั้นปรากฏอยู่ สำหรับอันดับดูได้ที่ <a href="/th/tier-list/">Tier List</a>.</p>

    <CodexGrid heroes={heroCodex} lang={lang} base={base} />

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>
