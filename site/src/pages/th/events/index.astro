---
import Base from '../../../../layouts/Base.astro';
import { t } from '../../../../i18n/ui';
import type { Lang } from '../../../../i18n/utils';

const lang: Lang = 'th';
const events = [
  { slug: 'alliance-duel', name: 'Alliance Duel', icon: '⚔️', desc: 'การแข่งขันพันธมิตร 6 วันพร้อมหมวดหมู่คะแนนรายวัน ค่าคะแนนที่แน่นอน และกลยุทธ์การประหยัดทรัพยากรทุกอย่าง' },
  { slug: 'elixir', name: 'Elixir Scramble', icon: '🧪', desc: 'สมรภูมิ AvA 30 นาทีที่เน้นการควบคุมพื้นที่มากกว่าการสังหาร — กฎเรื่องเต็นท์พยาบาล การลำดับความสำคัญของปราสาท และกฎการเทเลพอร์ต' },
  { slug: 'kvk', name: 'Kingdom War (KvK)', icon: '🏰', desc: 'สงครามระหว่างเซิร์ฟเวอร์เพื่อชิง Royal City: การโจมตีป้อมปราการก่อน การป้องกันแบบถ่วงเวลา และความเสี่ยงต่อกองทัพจริง' },
  { slug: 'undead', name: 'Undead Siege', icon: '🧟', desc: 'การป้องกันพันธมิตรจากฝูงซอมบี้ — กลไกการใช้หลายกองทัพที่ซ่อนอยู่, HP ที่คงอยู่ถาวร และเป้าหมายรางวัล' },
  { slug: 'cheese', name: 'Cheese Trap', icon: '🧀', desc: 'การระดมพลพันธมิตรปะทะหนูยักษ์: รางวัลส่วนตัว 5 ระยะ, พูล HP พันธมิตรร่วมกัน และคณิตศาสตร์การปรับระดับตามเลเวล' },
  { slug: 'thief', name: 'Thief Hunt', icon: '💰', desc: 'ใช้ค่าความเหนื่อยเพื่อเรียกบอส Thief Leader — กลไกการเกิด, เทคนิคการฆ่าแบบต่อเนื่อง และลำดับความสำคัญในการแลกเปลี่ยน' },
  { slug: 'survival', name: 'Survival Battle', icon: '🛡️', desc: 'กิจกรรมภารกิจรายสัปดาห์ที่คุ้มค่า Skill Badges ฟรีประมาณ 60,000 อัน — การทำภารกิจให้สำเร็จแบบประหยัดและการทับซ้อนกับ Alliance Duel' },
  { slug: 'canyon', name: 'Canyon Conquest', icon: '🏜️', desc: 'การต่อสู้แบบผลัดเปลี่ยน 3 เลนที่ความอึดสำคัญกว่าพลัง — กลยุทธ์การจัดลำดับความสำคัญของเลนในกิจกรรมที่ไร้ความเสี่ยง' },
  { slug: 'mythic', name: 'Mythic Treasure', icon: '🗺️', desc: 'ถอดรหัสกิจกรรมโจรสลัด 7 แท็บสำหรับสาย F2P: ลำดับความสำคัญของตลาด, ขีดจำกัดปลา 300 ตัว และการเล่น Buried Treasure' },
  { slug: 'royal', name: 'Royal Castle Scramble', icon: '👑', desc: 'การแข่งขันชิงปราสาทรายสัปดาห์ — 1 กองทัพต่อผู้เล่น, การเสริมกำลัง 30 ช่อง และระบบตำแหน่ง Royal City เต็มรูปแบบ' },
  { slug: 'arena', name: 'Triangle Arena', icon: '🔺', desc: '3 ทีมจัดทัพที่ผู้โจมตีเลือก 2 ทีมเพื่อเอาชนะ — การป้องกันที่สมดุล, การเสียสละตัวละคร และทีมกับดัก Arena of Fate' },
  { slug: 'wagon', name: 'Guild Wagon & Caravans', icon: '🚚', desc: 'การวิ่งรถเสบียงฟรีรายวัน, กฎหีบสมบัติผู้คุ้มกัน, การรีเฟรช Golden Wagon และการฟาร์ม UR-shard จากคาราวาน' },
  { slug: 'supreme-healer', name: 'Supreme Healer', icon: '🩺', desc: 'ตารางการทำคะแนนแข่งขัน 7 วัน, การจัดการทรัพยากรรายวัน, การสะสมค่าความเหนื่อย และจังหวะการใช้ Antitoxin' },
  { slug: 'strike-first', name: 'Strike First', icon: '⚡', desc: 'การวิ่งสปรินต์สำหรับเซิร์ฟเวอร์ใหม่ — เป้าหมาย Sanctuary, การกวาดล้าง Blight, การระดมพลทหาร และเพชรช่วงต้นเกม' },
  { slug: 'final-dawn', name: 'Final Dawn', icon: '🌅', desc: 'การวิ่งสปรินต์พัฒนาฐาน 7 วัน — 4 ระยะ (จากรากฐานสู่การผลักดันครั้งสุดท้าย), คิวลำดับความสำคัญ และจังหวะการใช้ไอเทมเร่งความเร็ว' },
  { slug: 'path-to-healing', name: 'Path to Healing', icon: '🕊️', desc: 'เส้นทางภารกิจต้อนรับผู้เล่นใหม่ 5 วัน — ภารกิจรายวัน, กฎบังคับการปลดล็อก VIP 5 และการรับเศษชิ้นส่วน UR Arthur 15 ชิ้น' },
  { slug: 'supreme-duel', name: 'Supreme Duel', icon: '🏆', desc: 'โหมดทัวร์นาเมนต์ข้ามโซนสงคราม — 16 โซนสงคราม, การต่อสู้เสมือนจริงแบบ 3 ทีม (ชนะ 2 ใน 3), ร้านค้า Prediction Coins และตำแหน่งแชมเปี้ยน' },
  { slug: 'quiz-of-wisdom', name: 'Quiz of Wisdom', icon: '🧠', desc: 'กิจกรรมตอบคำถามพร้อมเฉลย 15/15 ข้อ: ค้นหาคำตอบทันทีครอบคลุมกลไกเกม, สิ่งก่อสร้าง, ฝ่าย, VIP และเนื้อเรื่อง' },
  { slug: 'demon-king', name: 'Demon King', icon: '👹', desc: 'บอสโลกรายปักษ์ (วันอังคารและวันศุกร์) — จุดอ่อนธาตุ Mage, โจมตีได้ 10 ครั้งต่อวัน และเทคนิคการเรียกกองทัพกลับภายใน 30 วินาที' },
  { slug: 'secret-operations', name: 'Secret Operations Center', icon: '🕵️', desc: 'ภารกิจลับรายวัน: โอกาสการสุ่ม (UR 8%, SSR 24%), การการันตีหีบที่ 16 และแผนที่สมบัติ 7 ชิ้นส่วน' },
  { slug: 'dwarven-mine', name: 'Dwarven Mine', icon: '⛏️', desc: 'กิจกรรมขุดเหมือง 7 วัน: กฎการสะสมจอบ 750 อัน, รางวัลสมุนไพรเทียบกับ Gearstone และพิมพ์เขียว MR ที่ชั้น 100' },
  { slug: 'pandemic-experience', name: 'Pandemic Experience', icon: '🧪', desc: 'บันไดความยาก 1–9 รายปักษ์, การปลดล็อกบอสพันธมิตร (เคลียร์ 40 ครั้ง) และเทคนิคการระดมพลด้วยฮีโร่ที่อ่อนแอ' },
  { slug: 'crystal-cluster', name: 'Crystal Cluster Valley', icon: '🔮', desc: 'การตะลุมบอนในแผนที่จำกัดเวลา: ฟาร์มมอนสเตอร์แดงตัวละ 1.5K คะแนน, ยึดเหมืองคริสตัลเพื่อรับ 5K/นาที และเทคนิคการจับเวลา' },
];
---
<Base lang={lang} path="/th/events/" title="คู่มือกิจกรรม" description="เจาะลึกรายละเอียดกิจกรรมทุกอย่างของ Last Asylum: Plague ทั้งตารางเวลา การทำคะแนน กลยุทธ์ และข้อผิดพลาดที่ควรหลีกเลี่ยง">
  <section class="py-12">
    <h1 class="mb-3 text-4xl font-bold text-plague-100">คู่มือกิจกรรม</h1>
    <p class="mb-10 text-lg text-stone-400">เจาะลึกรายละเอียดกิจกรรมทุกอย่างของ Last Asylum: Plague ทั้งตารางเวลา การทำคะแนน กลยุทธ์ และข้อผิดพลาดที่ควรหลีกเลี่ยง</p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {events.map(e => (
        <a href={`/th/events/${e.slug}/`} class="group rounded-lg border border-stone-800 bg-stone-900 p-5 transition-colors hover:border-plague-600">
          <span class="text-3xl">{e.icon}</span>
          <h2 class="mt-3 text-lg font-bold text-plague-200 group-hover:text-plague-100">{e.name}</h2>
          <p class="mt-2 text-sm text-stone-400">{e.desc}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
