---
import Base from '../layouts/Base.astro';
import GuidePage from '../components/GuidePage.astro';
import DiscordBanner from '../components/DiscordBanner.astro';
import { statusUpdates } from '../data/status';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/utils';

const lang: Lang = 'en';

const statusStyles = {
  fixed: 'border-toxic-500/40 bg-toxic-500/10 text-toxic-400',
  investigating: 'border-amber-500/40 bg-amber-900/20 text-amber-300',
  info: 'border-sky-500/40 bg-sky-900/20 text-sky-300',
};
const statusIcons = { fixed: '✅', investigating: '⚠️', info: 'ℹ️' };
---

<Base lang={lang} path="/status/" title="Server Status & Known Issues" description="Known bugs, fixes and official notices for Last Asylum: Plague — summarized from the official status channel.">
  <GuidePage
    title="🛡️ Server Status & Known Issues"
    description="Summarized from the official #status-update channel. For live updates join the official Discord."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/' }, { label: 'Status' }]}
  >
    <p>This page lists every notable official notice: bugs, fixes, compensation waves and security alerts. Newest first. If your issue is not listed, report it in-game: Avatar → Account → User Center → Feedback.</p>

    <div class="not-prose my-8 space-y-3">
      {statusUpdates.map((s) => (
        <article class="rounded-lg border border-stone-800 bg-stone-900 p-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h3 class="font-bold text-stone-100">{s.title}</h3>
            <div class="flex items-center gap-2">
              <time class="text-xs text-stone-500">{s.date}</time>
              <span class={`rounded px-2 py-0.5 text-xs font-semibold ${statusStyles[s.status]}`}>{statusIcons[s.status]} {s.status}</span>
            </div>
          </div>
          <p class="mt-2 text-sm text-stone-400">{s.detail}</p>
        </article>
      ))}
    </div>

    <h2 id="scam-alert">Scam alert (important)</h2>
    <p>Scammers impersonate officials to steal accounts. Real staff <strong>never</strong> ask for passwords, verification codes, or payments outside official channels. Enable Facebook/Google account linking in Settings.</p>

    <h2 id="login-fixes">Can't log in? Quick fixes</h2>
    <ul>
      <li>Restart the game fully</li>
      <li>Clear the game cache (may require re-login)</li>
      <li>Disable VPN if you use one</li>
      <li>Use the <strong>Repair</strong> button (top-right corner on the loading screen)</li>
    </ul>

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>