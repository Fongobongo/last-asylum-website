---
import Base from '../../layouts/Base.astro';
import GuidePage from '../../components/GuidePage.astro';
import DiscordBanner from '../../components/DiscordBanner.astro';
import { faqId } from '../../data/faqId';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'id';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqId.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});
---

<Base lang={lang} path="/faq/" title="FAQ" description="Jawaban untuk pertanyaan Last Asylum: Plague yang paling umum: tim F2P terbaik, urutan upgrade, batas menjarah, prioritas toko, kode hadiah.">
  <GuidePage
    title="❓ Pertanyaan yang Sering Diajukan"
    description="Pertanyaan yang benar-benar ditanyakan pemain, dengan jawaban konsensus komunitas."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/id/' }, { label: 'FAQ' }]}
  >
    <script slot="faq-schema" type="application/ld+json" set:html={schema} />

    <div class="not-prose my-6 space-y-3">
      {faqId.map((f) => (
        <details class="group rounded-lg border border-stone-800 bg-stone-900">
          <summary class="cursor-pointer select-none px-4 py-3 font-semibold text-plague-200 group-open:text-plague-100">
            {f.q}
          </summary>
          <p class="border-t border-stone-800 px-4 py-3 text-sm leading-relaxed text-stone-300">{f.a}</p>
        </details>
      ))}
    </div>

    <p>Pertanyaan belum terjawab? Lihat panduan spesifiknya: <a href="/id/beginners/">pemula</a>, <a href="/id/economy/">ekonomi</a>, <a href="/id/heroes/">hero</a>, <a href="/id/gear/">perlengkapan</a>, <a href="/id/raven/">raven</a>, <a href="/id/era/">Era Kebangkitan</a> — atau tanyakan di Discord resmi.</p>

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>
