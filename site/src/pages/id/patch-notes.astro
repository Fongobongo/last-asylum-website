---
import Base from '../../layouts/Base.astro';
import GuidePage from '../../components/GuidePage.astro';
import PatchNotes from '../../components/PatchNotes.astro';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'id';
---

<Base lang={lang} path="/id/patch-notes/" title="Catatan Patch" description="Setiap pemeliharaan server dan pembaruan Last Asylum: Plague, dirangkum — terbaru lebih dulu.">
  <GuidePage title={`📜 ${t(lang, 'patchnotes.title')}`} description={t(lang, 'patchnotes.desc')} lang={lang}>
    <PatchNotes />
  </GuidePage>
</Base>
