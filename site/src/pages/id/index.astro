---
import Home from '../../components/Home.astro';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'id';

const sections = [
  { href: '/id/beginners/', icon: '🌱', title: 'Panduan Pemula', key: 'home.sections.beginners.desc', color: 'from-green-900/40' },
  { href: "/id/tips/", icon: "🧠", title: "Tips & Rahasia", key: "home.sections.tips.desc", color: "from-fuchsia-900/40" },
  { href: '/id/buildings/', icon: '🏰', title: 'Bangunan', key: 'home.sections.buildings.desc', color: 'from-amber-900/40' },
  { href: '/id/heroes/', icon: '⚔️', title: 'Hero', key: 'home.sections.heroes.desc', color: 'from-red-900/40' },
  { href: '/id/economy/', icon: '💰', title: 'Ekonomi', key: 'home.sections.economy.desc', color: 'from-yellow-900/40' },
  { href: '/id/raven/', icon: '🐦‍⬛', title: 'Gagak & Epigraf', key: 'home.sections.raven.desc', color: 'from-purple-900/40' },
  { href: '/id/era/', icon: '☣️', title: 'Era Kebangkitan', key: 'home.sections.era.desc', color: 'from-lime-900/40' },
  { href: '/id/codes/', icon: '🎁', title: 'Kode Hadiah', key: 'home.sections.codes.desc', color: 'from-toxic-900/40' },
  { href: '/id/patch-notes/', icon: '📜', title: 'Catatan Patch', key: 'home.sections.patchnotes.desc', color: 'from-stone-700/40' },
];

const popular = [
  { href: "/id/tips/", title: "Mekanisme Tersembunyi & Tips", desc: "Snapshot buff, ghost rally, bahaya rumah sakit dan trik pre-farming." },
  { href: '/id/beginners/', title: '24 Jam Pertama Anda', desc: 'Checklist hari pertama yang menentukan seluruh akun Anda.' },
  { href: '/id/economy/', title: 'Prioritas Intan & Toko', desc: 'Urutan beli pasti untuk setiap toko, dan yang tidak pernah dibeli.' },
  { href: '/id/heroes/', title: 'Pasukan F2P', desc: 'Arthur, Daskal, Marlena, Harper, Claire — jalur kanoniknya.' },
  { href: '/id/events/undead/', title: 'Undead Siege', desc: 'Mekanik gelombang 2 pasukan tersembunyi yang menumbangkan 9,5 juta pemain.' },
  { href: '/id/events/alliance-duel/', title: 'Alliance Duel', desc: 'Simpan scroll untuk Fase 3, shard untuk Fase 4, percepatan untuk Fase 5.' },
  { href: '/id/era/', title: 'Claire SSR→UR', desc: 'Lewati jebakan 6★–9★ dengan level Hall of Honor.' },
];
---

<Home lang={lang} path="/id/" sections={sections} popular={popular} />
