---
import Base from '../../layouts/Base.astro';
import GuidePage from '../../components/GuidePage.astro';
import InfographicGallery from '../../components/InfographicGallery.astro';
import DiscordBanner from '../../components/DiscordBanner.astro';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'id';
---

<Base lang={lang} path="/infographics/" title="Infografis — Last Asylum: Plague" description="Semua poster, skema visual, dan contekan Last Asylum: Plague dalam resolusi tinggi.">
  <GuidePage
    title="📊 Infografis"
    description="Semua poster, skema visual, dan contekan Last Asylum: Plague dalam resolusi tinggi."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/id/' }, { label: 'Infografis' }]}
  >
    <InfographicGallery lang={lang} />

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>
