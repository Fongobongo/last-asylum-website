---
import Base from '../../layouts/Base.astro';
import GuidePage from '../../components/GuidePage.astro';
import PatchNotes from '../../components/PatchNotes.astro';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'pl';
---

<Base lang={lang} path="/pl/patch-notes/" title="Informacje o aktualizacjach" description="Każda konserwacja serwera i aktualizacja Last Asylum: Plague w podsumowaniu — najnowsze na początku.">
  <GuidePage title={`📜 ${t(lang, 'patchnotes.title')}`} description={t(lang, 'patchnotes.desc')} lang={lang}>
    <PatchNotes />
  </GuidePage>
</Base>