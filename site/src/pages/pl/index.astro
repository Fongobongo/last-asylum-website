  { href: '/pl/events/alliance-duel/', title: 'Alliance Duel', desc: 'Zachowaj zwoje na fazę 3, odłamki na fazę 4, a przyspieszacze na fazę 5.' },
  { href: '/pl/events/dwarven-mine/', title: 'Dwarven Mine', desc: 'Zasada gromadzenia 750 kilofów i schemat MR na 100. piętrze.' },
  { href: '/pl/events/pandemic-experience/', title: 'Pandemic Experience', desc: 'Drabina trudności 1–9, odblokowania sojuszu i trik z rajdem słabym bohaterem.' },
  { href: '/pl/events/crystal-cluster/', title: 'Crystal Cluster Valley', desc: 'Czerwone moby za 1,5 tys. pkt, kopalnie za 5 tys./min — F2P wygrywa z płacącymi dzięki dyscyplinie.' },
