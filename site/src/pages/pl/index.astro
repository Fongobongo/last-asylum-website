  { href: '/pl/heroes/', icon: '🦸', title: 'Bohaterowie', key: 'home.sections.heroes.desc', color: 'from-red-900/30' },
  { href: '/pl/economy/', icon: '💎', title: 'Ekonomia', key: 'home.sections.economy.desc', color: 'from-yellow-900/30' },
  { href: '/pl/raven/', icon: '🐦', title: 'Raven i Epigrafy', key: 'home.sections.raven.desc', color: 'from-violet-900/30' },
