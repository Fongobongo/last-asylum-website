const popular = [
  { href: '/pl/might/', title: 'Formuła potęgi i strategia rozwoju', desc: 'Oficjalny poradnik z Discord: farmienie antytoksyn, awans sprzętu na 60 poziom i rzeczywista siła bojowa.' },
  { href: '/pl/alliance/', title: 'Przewodnik po systemie sojuszy', desc: 'Formuły pomocy sojuszu, darowizny na technologię, przywilej prezentów 25 poziomu oraz role oficerów R4/R5.' },
  { href: '/pl/events/supreme-duel/', title: 'Przewodnik po wydarzeniu Supreme Duel', desc: 'Turniej 16 stref: 3 oddziały, system best-of-3, zero strat, monety do obstawiania i nagrody dla mistrzów.' },
  { href: '/pl/tips/', title: 'Pro porady i ukryte mechaniki', desc: 'Snap-shotting wzmocnień, Ghost Rally, przepełnienie szpitala i sekretne zasady resetu.' },
  { href: '/pl/beginners/', title: 'Twoje pierwsze 24 godziny', desc: 'Lista zadań na pierwszy dzień, która decyduje o całym twoim koncie.' },
  { href: '/pl/economy/', title: 'Diamenty i priorytety w sklepie', desc: 'Dokładna kolejność zakupów w każdym sklepie oraz przedmioty, których nigdy nie należy kupować.' },
  { href: '/pl/heroes/', title: 'Oddział F2P', desc: 'Arthur, Daskal, Marlena, Harper, Claire — kanoniczna ścieżka rozwoju.' },
