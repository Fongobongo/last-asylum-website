---
import Base from '../../../layouts/Base.astro';
import GuidePage from '../../../components/GuidePage.astro';
import CodexGrid from '../../../components/CodexGrid.astro';
import DiscordBanner from '../../../components/DiscordBanner.astro';
import { heroCodex } from '../../../data/heroCodex';
import { t } from '../../../i18n/ui';
import type { Lang } from '../../../i18n/utils';

const lang: Lang = 'pl';
const base = lang === 'en' ? '' : `/${lang}`;
---

<Base lang={lang} path="/pl/codex/" title="Kodeks Bohaterów" description="Każdy kluczowy bohater w Last Asylum: Plague — umiejętności, buildy, notatki o drużynach i sposoby ich zdobycia.">
  <GuidePage
    title="📖 Kodeks Bohaterów"
    description="Umiejętności, priorytety buildów i notatki o drużynach dla każdego ważnego bohatera — opracowane na podstawie poradników społeczności."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/pl/' }, { label: 'Kodeks Bohaterów' }]}
  >
    <p>Każda strona: rola, jak zdobyć bohatera, umiejętności, priorytety rozwoju i składy. Rankingi znajdziesz w <a href="/pl/tier-list/">Lista rankingowa</a>.</p>

    <CodexGrid heroes={heroCodex} lang={lang} base={base} />

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>
