---
import Base from '../layouts/Base.astro';
import ShopPage from '../components/ShopPage.astro';
import type { Lang } from '../i18n/utils';

const lang: Lang = 'en';
---

<Base lang={lang} path="/shop/" title="Game Store & Top-Up | Last Asylum" description="Top up Last Asylum: Plague diamonds and packs via partner platform LDShop. Instant delivery via UID, best deals, and community support.">
  <ShopPage lang={lang} />
</Base>
