---
import Base from '../layouts/Base.astro';
import GuidePage from '../components/GuidePage.astro';
import PatchNotes from '../components/PatchNotes.astro';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/utils';

const lang: Lang = 'en';
---

<Base lang={lang} path="/patch-notes/" title="Patch Notes" description="Every Last Asylum: Plague server maintenance and update, summarized — newest first.">
  <GuidePage title={`📜 ${t(lang, 'patchnotes.title')}`} description={t(lang, 'patchnotes.desc')} lang={lang}>
    <PatchNotes />
  </GuidePage>
</Base>