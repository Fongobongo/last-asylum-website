---
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'es';

const sections = [
  { href: '/es/beginners/', icon: '🌱', title: 'Guía para principiantes', key: 'home.sections.beginners.desc', color: 'from-green-900/40' },
  { href: '/es/buildings/', icon: '🏰', title: 'Edificios', key: 'home.sections.buildings.desc', color: 'from-amber-900/40' },
  { href: '/es/heroes/', icon: '⚔️', title: 'Héroes', key: 'home.sections.heroes.desc', color: 'from-red-900/40' },
  { href: '/es/economy/', icon: '💰', title: 'Economía', key: 'home.sections.economy.desc', color: 'from-yellow-900/40' },
  { href: '/es/raven/', icon: '🐦‍⬛', title: 'Cuervo y epígrafes', key: 'home.sections.raven.desc', color: 'from-purple-900/40' },
  { href: '/es/era/', icon: '☣️', title: 'Era del Renacimiento', key: 'home.sections.era.desc', color: 'from-lime-900/40' },
  { href: '/es/codes/', icon: '🎁', title: 'Códigos de regalo', key: 'home.sections.codes.desc', color: 'from-toxic-900/40' },
  { href: '/es/patch-notes/', icon: '📜', title: 'Notas de parche', key: 'home.sections.patchnotes.desc', color: 'from-stone-700/40' },
];

const popular = [
  { href: '/es/beginners/', title: 'Tus primeras 24 horas', desc: 'La checklist del primer día que decide el destino de toda tu cuenta.' },
  { href: '/es/economy/', title: 'Prioridades de diamantes y tiendas', desc: 'El orden exacto de compras en cada tienda, y qué no comprar jamás.' },
  { href: '/es/heroes/', title: 'El escuadrón F2P', desc: 'Arthur, Daskal, Marlena, Harper, Claire — la ruta canónica.' },
  { href: '/es/events/undead/', title: 'Asedio no-muertos', desc: 'La mecánica oculta de 2 escuadrones por oleada que mata a jugadores de 9.5M.' },
  { href: '/es/events/alliance-duel/', title: 'Duelo de Alianzas', desc: 'Guarda pergaminos para la Fase 3, fragmentos para la Fase 4, aceleraciones para la Fase 5.' },
  { href: '/es/era/', title: 'Claire SSR→UR', desc: 'Salta el bache de 6★–9★ con niveles del Salón del Honor.' },
];
---

<Base lang={lang} path="/es/">
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-stone-800">
    <div class="absolute inset-0 bg-gradient-to-b from-plague-950/80 to-transparent"></div>
    <div class="relative py-20 sm:py-28">
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-toxic-400">Last Asylum: Plague — Fan Hub</p>
      <h1 class="mb-5 text-4xl font-bold tracking-tight text-plague-100 sm:text-6xl">
        Sobrevive a la plaga
      </h1>
      <p class="mb-8 max-w-2xl text-lg leading-relaxed text-stone-300">
        La base de conocimiento de la comunidad: rutas para principiantes, prioridades de construcción, estrategias F2P, prioridades de tiendas y análisis completos de eventos — todo extraído de las guías del Discord oficial y verificado por jugadores.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/es/beginners/" class="rounded-lg bg-plague-700 px-6 py-3 font-semibold text-plague-50 hover:bg-plague-600 transition-colors">
          Ver guías →
        </a>
        <a href="/es/events/" class="rounded-lg border border-stone-700 px-6 py-3 font-semibold text-stone-200 hover:bg-stone-800 transition-colors">
          Guías de eventos →
        </a>
      </div>
    </div>
  </section>

  <!-- Sections grid -->
  <section class="py-14">
    <h2 class="mb-8 text-2xl font-bold text-plague-200">Guías</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {sections.map((s) => (
        <a href={s.href} class={`group rounded-xl border border-stone-800 bg-gradient-to-br ${s.color} to-stone-900 p-6 transition-colors hover:border-plague-500`}>
          <span class="text-3xl">{s.icon}</span>
          <h3 class="mt-3 text-lg font-bold text-plague-200 group-hover:text-plague-100">{s.title}</h3>
          <p class="mt-2 text-sm text-stone-400">{t(lang, s.key as any)}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Events banner -->
  <section class="mb-14 rounded-xl border border-plague-800 bg-plague-950/50 p-8">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-plague-200">⚔️ Eventos</h2>
        <p class="mt-1 text-stone-400">Duelo de Alianzas, KvK, Asedio no-muertos y todos los demás eventos.</p>
      </div>
      <a href="/es/events/" class="rounded-lg bg-plague-700 px-5 py-2.5 font-semibold text-plague-50 hover:bg-plague-600 transition-colors">
        Guías de eventos →
      </a>
    </div>
  </section>

  <!-- Popular guides -->
  <section class="mb-16">
    <h2 class="mb-8 text-2xl font-bold text-plague-200">Guías populares</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {popular.map((p) => (
        <a href={p.href} class="group rounded-lg border border-stone-800 bg-stone-900 p-5 transition-colors hover:border-plague-600">
          <h3 class="font-bold text-stone-100 group-hover:text-plague-200">{p.title}</h3>
          <p class="mt-2 text-sm text-stone-400">{p.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Support banner -->
  <section class="mb-16 rounded-xl border border-stone-800 bg-stone-900 p-8">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-plague-200">❤️ Apóyanos</h2>
        <p class="mt-1 text-stone-400">Apoya el proyecto y recibe valor dentro del juego.</p>
      </div>
      <a href="/es/support/" class="rounded-lg bg-blood-600 px-5 py-2.5 font-semibold text-white hover:bg-blood-500 transition-colors">
        Apóyanos →
      </a>
    </div>
  </section>
</Base>
