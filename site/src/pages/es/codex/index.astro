---
import Base from '../../../layouts/Base.astro';
import GuidePage from '../../../components/GuidePage.astro';
import CodexGrid from '../../../components/CodexGrid.astro';
import DiscordBanner from '../../../components/DiscordBanner.astro';
import { heroCodex } from '../../../data/heroCodex';
import { t } from '../../../i18n/ui';
import type { Lang } from '../../../i18n/utils';

const lang: Lang = 'es';
const base = lang === 'en' ? '' : `/${lang}`;
---

<Base lang={lang} path="/es/codex/" title="Códice de héroes" description="Todos los héroes clave de Last Asylum: Plague — habilidades, builds, notas de equipo y cómo conseguirlos.">
  <GuidePage
    title="📖 Códice de héroes"
    description="Habilidades, prioridades de build y notas de equipo para cada héroe que importa — recopilado de las guías de la comunidad."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/es/' }, { label: 'Códice de héroes' }]}
  >
    <p>En cada página: el rol, cómo conseguir al héroe, las habilidades que de verdad importan, las prioridades de build y las composiciones de equipo donde aparece. Para los rankings, consulta la <a href="/es/tier-list/">tier list</a>.</p>

    <CodexGrid heroes={heroCodex} lang={lang} base={base} />

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>
