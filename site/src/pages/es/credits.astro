  { name: 'chuppergaming', tag: 'YouTube', contributions: ['Guía inicial de Era', 'Entrenamiento de tropas', 'Mythic Treasure', 'Supreme Duel', 'Guild Wagon'] },
  { name: 'merlyn', tag: 'comunidad', contributions: ['Composición de escuadrones + sección F2P', 'Consejos de epígrafes del Cuervo', 'Prioridades de tiendas'] },
  { name: 'lucifer_burnsyou', tag: 'comunidad', contributions: ['Guía de prioridades de tiendas (5 idiomas)', 'strategic-game-guide.netlify.app'] },
  { name: 'callikoneko', tag: 'comunidad', contributions: ['Análisis profundo del daño al Rey Demonio', 'Recorridos de sinergias de habilidades'] },
  { name: 'kellerfaust', tag: 'comunidad', contributions: ['Formaciones contra Boss Blight (todas las facciones)'] },
  { name: 'DrAction', tag: 'S12', contributions: ['Orden de promoción de epígrafes', 'Consejos PvP de escuadrones'] },
  { name: 'skyyzies', tag: 'comunidad', contributions: ['Reglas de defensa y ataque de la Arena Triangular'] },
  { name: 'verratvonwindir', tag: 'S2', contributions: ['Mecánicas de la Escaramuza del Castillo Real'] },
  { name: 'mu_013', tag: 'comunidad', contributions: ['Hunt Battle', 'Wandering Phantom', 'Guild Wagon', 'Acopio de Falcon Tower'] },
  { name: 'linde2000', tag: 'comunidad', contributions: ['Apariciones de ladrones', 'Habilidades de Crystal Cluster', 'Respuestas F2P'] },
  { name: 'elsiika57', tag: 'comunidad', contributions: ['Hoja de ruta de edificios del Santuario 1–29'] },
  { name: 'zoidseo', tag: 'K159', contributions: ['Progresión del juego temprano'] },
  { name: 'ruitea', tag: 'comunidad', contributions: ['Consejos generales / F2P / guías Shrimp', 'Análisis de habilidades de Marlena'] },
  { name: '_.dot._', tag: 'comunidad', contributions: ['Eficiencia de insignias de Marlena', 'Correcciones de Mythic Treasure', 'Prioridades de habilidades'] },
  { name: 'dunidunduni', tag: 'S7', contributions: ['Detalles del evento Survival Battle'] },
  { name: 'Aesy', tag: 'comunidad', contributions: ['Infografías de Thief Hunt y Crystal Cluster'] },
  { name: 'katherineclover', tag: 'S131', contributions: ['Compendio de Lucky Clovers'] },
  { name: 'DrGayLord / HOLY', tag: 'S247', contributions: ['Básicos para principiantes: edificios, equipo, facciones'] },
  { name: '뀨잉이 (jjuingyi)', tag: 'comunidad', contributions: ['Guía de Guild Wagon (KO)'] },
  { name: 'bulheba', tag: 'comunidad RU', contributions: ['RU: mecánicas PVP, orden de construcción, videos del Duelo de Alianzas'] },
  { name: 'LapBase / ikona_in', tag: 'comunidad RU', contributions: ['RU: escuadrón F2P de infantería, guías de eventos'] },
  { name: 'oψsvge英俊的', tag: 'K250', contributions: ['ID: Era del Renacimiento, Asedio no-muertos, primeras semanas'] },
  { name: 'hunalulu0503', tag: 'comunidad', contributions: ['Mythic Treasure F2P', 'TOP-10 edificios'] },
  { name: 'Sirox', tag: 'thelaphub.com', contributions: ['LAP Hub — planificador de investigaciones, calculadoras, códice', 'Análisis de Claire UR y límites de saqueo'] },
