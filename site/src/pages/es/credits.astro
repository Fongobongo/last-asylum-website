const sources = [
  { name: 'Discord oficial — #official-guide', url: null, desc: 'Guías oficiales de edificios/héroes/Poder/antitoxina' },
  { name: 'Discord oficial — #player-guide', url: null, desc: '520+ hilos de la comunidad en ~15 idiomas (extraídos con discord.py-self)' },
  { name: 'Sirox’s LAP Hub', url: 'https://thelaphub.com', desc: 'Planificador de investigaciones, calculadoras, códice de héroes/edificios' },
  { name: 'Strategic Game Guide', url: 'https://strategic-game-guide.netlify.app', desc: 'Prioridades de tiendas en 5 idiomas' },
  { name: 'Canales de YouTube de la comunidad', url: null, desc: 'korpez, HottChoklit, chuppergaming, KrrissGaming, quanybean y más' },
