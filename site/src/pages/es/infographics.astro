---
import Base from '../../layouts/Base.astro';
import GuidePage from '../../components/GuidePage.astro';
import InfographicGallery from '../../components/InfographicGallery.astro';
import DiscordBanner from '../../components/DiscordBanner.astro';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'es';
---

<Base lang={lang} path="/infographics/" title="Infografías — Last Asylum: Plague" description="Todos los pósters, esquemas visuales y chuletas de Last Asylum: Plague en alta resolución.">
  <GuidePage
    title="📊 Infografías"
    description="Todos los pósters, esquemas visuales y chuletas de Last Asylum: Plague en alta resolución."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/es/' }, { label: 'Infografías' }]}
  >
    <InfographicGallery lang={lang} />

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>
