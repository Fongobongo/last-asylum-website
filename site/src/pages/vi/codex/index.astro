---
import Base from '../../../layouts/Base.astro';
import GuidePage from '../../../components/GuidePage.astro';
import CodexGrid from '../../../components/CodexGrid.astro';
import DiscordBanner from '../../../components/DiscordBanner.astro';
import { heroCodex } from '../../../data/heroCodex';
import { t } from '../../../i18n/ui';
import type { Lang } from '../../../i18n/utils';

const lang: Lang = 'vi';
const base = lang === 'en' ? '' : `/${lang}`;
---

<Base lang={lang} path="/vi/codex/" title="Helden-Kodex" description="Jeder wichtige Held in Last Asylum: Plague — Skills, Builds, Team-Notizen und wie man ihn bekommt.">
  <GuidePage
    title="📖 Helden-Kodex"
    description="Skills, Build-Prioritäten und Team-Notizen für jeden Helden, der zählt — zusammengestellt aus den Community-Guides."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/vi/' }, { label: 'Helden-Kodex' }]}
  >
    <p>Mỗi trang bao gồm: vai trò, cách sở hữu anh hùng, các kỹ năng thực sự quan trọng, ưu tiên xây dựng và các đội hình mà họ xuất hiện. Để xem xếp hạng, hãy truy cập <a href="/vi/tier-list/">Bảng xếp hạng</a>.</p>

    <CodexGrid heroes={heroCodex} lang={lang} base={base} />

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>
