---
import Base from '../../layouts/Base.astro';
import GuidePage from '../../components/GuidePage.astro';
import PatchNotes from '../../components/PatchNotes.astro';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'tr';
---

<Base lang={lang} path="/tr/patch-notes/" title="Yama Notları" description="Her Last Asylum: Plague sunucu bakımı ve güncellemesi, özetlenmiş haliyle — en yeniden eskiye.">
  <GuidePage title={`📜 ${t(lang, 'patchnotes.title')}`} description={t(lang, 'patchnotes.desc')} lang={lang}>
    <PatchNotes />
  </GuidePage>
</Base>