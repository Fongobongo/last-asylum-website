---
import Base from '../../../../layouts/Base.astro';
import { t } from '../../../../i18n/ui';
import type { Lang } from '../../../../i18n/utils';

const lang: Lang = 'tr';
const events = [
  { slug: 'alliance-duel', name: 'İttifak Düellosu', icon: '⚔️', desc: 'Günlük puan kategorileri, kesin puan değerleri ve her şeyi biriktirme ekonomisi içeren altı günlük ittifak yarışması.' },
  { slug: 'elixir', name: 'İksir Kapışması', icon: '🧪', desc: 'Öldürmelerin değil kontrolün kazandırdığı 30 dakikalık AvA puan savaş alanı — İyileştirme Çadırları, kale önceliği ve ışınlanma kuralları.' },
  { slug: 'kvk', name: 'Krallık Savaşı (KvK)', icon: '🏰', desc: 'Kraliyet Şehri için sunucular arası savaş: kule öncelikli saldırılar, oyalama taktikli savunma ve gerçek birlik riski.' },
  { slug: 'undead', name: 'Ölümsüz Kuşatması', icon: '🧟', desc: 'Enfekte dalgalarına karşı ittifak savunması — gizli çoklu birlik mekaniği, kalıcı HP ve ödül kilometre taşları.' },
  { slug: 'cheese', name: 'Peynir Tuzağı', icon: '🧀', desc: 'Dev fareye karşı ittifak rallisi: beş aşamalı kişisel ödüller, paylaşımlı ittifak HP havuzu ve seviye ölçekleme matematiği.' },
  { slug: 'thief', name: 'Hırsız Avı', icon: '💰', desc: 'Hırsız Lideri patronlarını ortaya çıkarmak için dayanıklılık harcayın — ortaya çıkma mekanikleri, durmaksızın öldürme tekniği ve takas öncelikleri.' },
  { slug: 'survival', name: 'Hayatta Kalma Savaşı', icon: '🛡️', desc: '~60.000 ücretsiz Beceri Rozeti değerinde haftalık görev etkinliği — ucuz tamamlamalar ve İttifak Düellosu ile çakışması.' },
  { slug: 'canyon', name: 'Kanyon Fethi', icon: '🏜️', desc: 'Dayanıklılığın güçten üstün olduğu üç şeritli röle savaşı — sıfır riskli bir etkinlikte şerit önceliği stratejisi.' },
  { slug: 'mythic', name: 'Efsanevi Hazine', icon: '🗺️', desc: 'F2P için çözümlenmiş yedi sekmeli korsan etkinliği: pazar öncelikleri, 300 balık sınırı ve Gömülü Hazine oyunu.' },
  { slug: 'royal', name: 'Kraliyet Kalesi Kapışması', icon: '👑', desc: 'Haftalık kale ele geçirme yarışı — oyuncu başına bir yürüyüş, 30 yuvalı takviye ve tam Kraliyet Şehri unvan sistemi.' },
  { slug: 'arena', name: 'Üçgen Arena', icon: '🔺', desc: 'Üç kadro, saldıranın yenmek için ikisini seçtiği sistem — dengeli savunma, feda eşleşmeleri ve Kader Arenası tuzak kadrosu.' },
  { slug: 'wagon', name: 'Lonca Arabası & Kervanlar', icon: '🚚', desc: 'Günlük ücretsiz araba seferleri, Muhafız sandığı kuralları, Altın Araba yenilemeleri ve kervan UR-parçası çiftliği.' },
  { slug: 'supreme-healer', name: 'Yüce Şifacı', icon: '🩺', desc: '7 günlük rekabetçi puanlama programı, günlük kaynak yönetimi, dayanıklılık stoklama ve Antitoksin zamanlaması.' },
  { slug: 'strike-first', name: 'İlk Vuruş', icon: '⚡', desc: 'Yeni sunucu başlangıç sprinti — Sığınak kilometre taşları, Salgın temizliği, askeri seferberlik ve erken elmaslar.' },
  { slug: 'final-dawn', name: 'Son Şafak', icon: '🌅', desc: '7 günlük üs geliştirme sprinti — 4 aşama (Temellerden Son Hamleye), öncelik sırası ve hızlandırma zamanlaması.' },
  { slug: 'path-to-healing', name: 'İyileşme Yolu', icon: '🕊️', desc: '5 günlük başlangıç görev takibi — günlük görevler, zorunlu VIP 5 kilidi açma kuralı ve 15 adet UR Arthur parçası kazanma.' },
  { slug: 'supreme-duel', name: 'Yüce Düello', icon: '🏆', desc: 'Savaş bölgesi arası turnuva modu — 16 Savaş Bölgesi, 3 kadrolu 3'te 2 galibiyetli sanal savaşlar, Tahmin Parası dükkanı ve Şampiyon unvanı.' },
  { slug: 'quiz-of-wisdom', name: 'Bilgelik Sınavı', icon: '🧠', desc: '15/15 Soru-Cevap kopya kağıdı içeren bilgi yarışması: mekanikler, binalar, gruplar, VIP ve hikaye hakkında anında cevap arama.' },
  { slug: 'demon-king', name: 'İblis Kral', icon: '👹', desc: 'İki haftada bir düzenlenen dünya patronu (Salı ve Cuma) — Büyücü zayıflığı, günlük 10 saldırı ve 30 saniyelik yürüyüş geri çağırma hilesi.' },
  { slug: 'secret-operations', name: 'Gizli Operasyonlar Merkezi', icon: '🕵️', desc: 'Günlük gizli görevler: yeniden zar atma oranları (UR %8, SSR %24), 16. sandık acıma garantisi ve 7 parçalı hazine haritaları.' },
  { slug: 'dwarven-mine', name: 'Cüce Madeni', icon: '⛏️', desc: '7 günlük madencilik etkinliği: 750 kazma biriktirme kuralı, bitki vs dişli taşı ödülleri ve 100. Katta MR planı.' },
  { slug: 'pandemic-experience', name: 'Pandemi Deneyimi', icon: '🧪', desc: 'İki haftada bir 1–9 zorluk merdiveni, ittifak patronu kilit açma (40 temizleme) ve zayıf kahraman rallisi hilesi.' },
  { slug: 'crystal-cluster', name: 'Kristal Küme Vadisi', icon: '🔮', desc: 'Süreli harita kavgası: her biri 1.5K puan değerindeki kırmızı yaratıkları kesin, kristal madenlerini dakikada 5K için tutun ve kronometre hilesi.' },
];
---
<Base lang={lang} path="/tr/events/" title="Etkinlik Rehberleri" description="Her Last Asylum: Plague etkinliğinin tam dökümü: programlar, puanlama, strateji ve kaçınılması gereken hatalar.">
  <section class="py-12">
    <h1 class="mb-3 text-4xl font-bold text-plague-100">Etkinlik Rehberleri</h1>
    <p class="mb-10 text-lg text-stone-400">Her Last Asylum: Plague etkinliğinin tam dökümü: programlar, puanlama, strateji ve kaçınılması gereken hatalar.</p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {events.map(e => (
        <a href={`/tr/events/${e.slug}/`} class="group rounded-lg border border-stone-800 bg-stone-900 p-5 transition-colors hover:border-plague-600">
          <span class="text-3xl">{e.icon}</span>
          <h2 class="mt-3 text-lg font-bold text-plague-200 group-hover:text-plague-100">{e.name}</h2>
          <p class="mt-2 text-sm text-stone-400">{e.desc}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
