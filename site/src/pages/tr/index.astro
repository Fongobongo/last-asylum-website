  { href: '/tr/events/alliance-duel/', title: 'Alliance Duel', desc: 'Parşömenleri 3. Aşama için, parçaları 4. Aşama için, hızlandırmaları 5. Aşama için saklayın.' },
  { href: '/tr/events/dwarven-mine/', title: 'Dwarven Mine', desc: '750 kazma biriktirme kuralı ve 100. Katta MR planı.' },
  { href: '/tr/events/pandemic-experience/', title: 'Pandemic Experience', desc: '1–9 arası zorluk kademesi, ittifak kilit açmaları ve zayıf kahraman ralli hilesi.' },
  { href: '/tr/events/crystal-cluster/', title: 'Crystal Cluster Valley', desc: '1.5K puanda kırmızı yaratıklar, dakikada 5K maden — disiplinle F2P oyuncular balinaları geçer.' },
