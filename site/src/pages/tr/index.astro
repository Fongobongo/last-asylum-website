  { href: '/tr/heroes/', icon: '🦸', title: 'Kahramanlar', key: 'home.sections.heroes.desc', color: 'from-red-900/30' },
  { href: '/tr/economy/', icon: '💎', title: 'Ekonomi', key: 'home.sections.economy.desc', color: 'from-yellow-900/30' },
