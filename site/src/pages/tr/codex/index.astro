---
import Base from '../../../layouts/Base.astro';
import GuidePage from '../../../components/GuidePage.astro';
import CodexGrid from '../../../components/CodexGrid.astro';
import DiscordBanner from '../../../components/DiscordBanner.astro';
import { heroCodex } from '../../../data/heroCodex';
import { t } from '../../../i18n/ui';
import type { Lang } from '../../../i18n/utils';

const lang: Lang = 'tr';
const base = lang === 'en' ? '' : `/${lang}`;
---

<Base lang={lang} path="/tr/codex/" title="Helden-Kodex" description="Jeder wichtige Held in Last Asylum: Plague — Skills, Builds, Team-Notizen und wie man ihn bekommt.">
  <GuidePage
    title="📖 Helden-Kodex"
    description="Skills, Build-Prioritäten und Team-Notizen für jeden Helden, der zählt — zusammengestellt aus den Community-Guides."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/tr/' }, { label: 'Helden-Kodex' }]}
  >
    <p>Her sayfa: rol, kahramanın nasıl elde edileceği, gerçekten önemli olan yetenekler, dizilim öncelikleri ve yer aldıkları takım kompozisyonları. Sıralamalar için şuraya bakın: <a href="/tr/tier-list/">Kademe Listesi</a>.</p>

    <CodexGrid heroes={heroCodex} lang={lang} base={base} />

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>
