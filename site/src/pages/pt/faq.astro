---
import Base from '../../layouts/Base.astro';
import GuidePage from '../../components/GuidePage.astro';
import DiscordBanner from '../../components/DiscordBanner.astro';
import { faqPt } from '../../data/faqPt';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'pt';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqPt.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});
---

<Base lang={lang} path="/pt/faq/" title="Perguntas frequentes" description="Respostas às perguntas mais comuns de Last Asylum: Plague: melhor time F2P, ordem de melhoria, limites de saque, prioridades de lojas, códigos de presente.">
  <GuidePage
    title="❓ Perguntas frequentes"
    description="As perguntas que os jogadores realmente fazem, com as respostas de consenso da comunidade."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/pt/' }, { label: 'FAQ' }]}
  >
    <script slot="faq-schema" type="application/ld+json" set:html={schema} />

    <div class="not-prose my-6 space-y-3">
      {faqPt.map((f) => (
        <details class="group rounded-lg border border-stone-800 bg-stone-900">
          <summary class="cursor-pointer select-none px-4 py-3 font-semibold text-plague-200 group-open:text-plague-100">
            {f.q}
          </summary>
          <p class="border-t border-stone-800 px-4 py-3 text-sm leading-relaxed text-stone-300">{f.a}</p>
        </details>
      ))}
    </div>

    <p>Sua pergunta não está aqui? Consulte os guias específicos: <a href="/pt/beginners/">iniciantes</a>, <a href="/pt/economy/">economia</a>, <a href="/pt/heroes/">heróis</a>, <a href="/pt/gear/">equipamento</a>, <a href="/pt/raven/">Corvo</a>, <a href="/pt/era/">Era do Renascimento</a> — ou pergunte no Discord oficial.</p>

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>
