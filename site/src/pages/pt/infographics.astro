---
import Base from '../../layouts/Base.astro';
import GuidePage from '../../components/GuidePage.astro';
import InfographicGallery from '../../components/InfographicGallery.astro';
import DiscordBanner from '../../components/DiscordBanner.astro';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'pt';
---

<Base lang={lang} path="/infographics/" title="Infográficos — Last Asylum: Plague" description="Todos os pôsteres, esquemas visuais e colas de Last Asylum: Plague em alta resolução.">
  <GuidePage
    title="📊 Infográficos"
    description="Todos os pôsteres, esquemas visuais e colas de Last Asylum: Plague em alta resolução."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/pt/' }, { label: 'Infográficos' }]}
  >
    <InfographicGallery lang={lang} />

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>
