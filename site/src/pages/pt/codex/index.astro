---
import Base from '../../../layouts/Base.astro';
import GuidePage from '../../../components/GuidePage.astro';
import CodexGrid from '../../../components/CodexGrid.astro';
import DiscordBanner from '../../../components/DiscordBanner.astro';
import { heroCodex } from '../../../data/heroCodex';
import { t } from '../../../i18n/ui';
import type { Lang } from '../../../i18n/utils';

const lang: Lang = 'pt';
const base = lang === 'en' ? '' : `/${lang}`;
---

<Base lang={lang} path="/pt/codex/" title="Códice de heróis" description="Todos os heróis-chave de Last Asylum: Plague — habilidades, builds, notas de equipe e como obtê-los.">
  <GuidePage
    title="📖 Códice de heróis"
    description="Habilidades, prioridades de build e notas de equipe para cada herói que importa — compilado dos guias da comunidade."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/pt/' }, { label: 'Códice de heróis' }]}
  >
    <p>Em cada página: a função, como obter o herói, as habilidades que realmente importam, as prioridades de build e as composições de equipe em que ele aparece. Para rankings, veja a <a href="/pt/tier-list/">tier list</a>.</p>

    <CodexGrid heroes={heroCodex} lang={lang} base={base} />

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>
