---
import Base from '../../../layouts/Base.astro';
import GuidePage from '../../../components/GuidePage.astro';
import DiscordBanner from '../../../components/DiscordBanner.astro';
import { heroCodex } from '../../../data/heroCodex';
import { t } from '../../../i18n/ui';
import type { Lang } from '../../../i18n/utils';

const lang: Lang = 'pt';
---

<Base lang={lang} path="/pt/codex/" title="Códice de heróis" description="Todos os heróis-chave de Last Asylum: Plague — habilidades, builds, notas de equipe e como obtê-los.">
  <GuidePage
    title="📖 Códice de heróis"
    description="Habilidades, prioridades de build e notas de equipe para cada herói que importa — compilado dos guias da comunidade."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/pt/' }, { label: 'Códice de heróis' }]}
  >
    <p>Em cada página: a função, como obter o herói, as habilidades que realmente importam, as prioridades de build e as composições de equipe em que ele aparece. Para rankings, veja a <a href="/pt/tier-list/">tier list</a>.</p>

    <div class="not-prose my-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {heroCodex.map((h) => (
        <a href={`/pt/codex/${h.slug}/`} class="group rounded-xl border border-stone-800 bg-stone-900 p-5 transition-colors hover:border-plague-600">
          <div class="flex items-baseline justify-between">
            <h3 class="text-lg font-bold text-plague-200 group-hover:text-plague-100">{h.name}</h3>
            <span class={`rounded px-1.5 py-0.5 text-xs font-bold ${h.tier === 'S' ? 'bg-red-900/40 text-red-300' : h.tier === 'A' ? 'bg-amber-900/40 text-amber-300' : 'bg-sky-900/40 text-sky-300'}`}>{h.tier}</span>
          </div>
          <p class="mt-0.5 text-xs text-stone-500">{h.rarity} · {h.faction} · {h.className}</p>
          <p class="mt-2 line-clamp-3 text-sm text-stone-400">{h.role}</p>
        </a>
      ))}
    </div>

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>
