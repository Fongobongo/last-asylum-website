---
import Base from '../../../layouts/Base.astro';
import GuidePage from '../../../components/GuidePage.astro';
import CodexGrid from '../../../components/CodexGrid.astro';
import DiscordBanner from '../../../components/DiscordBanner.astro';
import { heroCodex } from '../../../data/heroCodex';
import { t } from '../../../i18n/ui';
import type { Lang } from '../../../i18n/utils';

const lang: Lang = 'ar';
const base = lang === 'en' ? '' : `/${lang}`;
---

<Base lang={lang} path="/ar/codex/" title="سجل الأبطال" description="كل بطل رئيسي في Last Asylum: Plague — المهارات، التجهيزات، ملاحظات الفريق وكيفية الحصول عليهم.">
  <GuidePage
    title="📖 سجل الأبطال"
    description="المهارات، أولويات التجهيز وملاحظات الفريق لكل بطل مهم — مجمعة من أدلة المجتمع."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/ar/' }, { label: 'سجل الأبطال' }]}
  >
    <p>كل صفحة تتضمن: الدور، كيفية الحصول على البطل، المهارات المهمة فعلياً، أولويات التجهيز وتشكيلات الفرق التي يظهرون فيها. للاطلاع على التصنيفات، راجع <a href="/ar/tier-list/">قائمة المستويات</a>.</p>

    <CodexGrid heroes={heroCodex} lang={lang} base={base} />

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>
