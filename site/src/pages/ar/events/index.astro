---
import Base from '../../../layouts/Base.astro';
import { t } from '../../../i18n/ui';
import type { Lang } from '../../../i18n/utils';

const lang: Lang = 'ar';
const events = [
  { slug: 'alliance-duel', name: 'مبارزة التحالف', icon: '⚔️', desc: 'منافسة تحالف لمدة ستة أيام مع فئات نقاط يومية، وقيم نقاط دقيقة، واقتصاديات توفير كل شيء.' },
  { slug: 'elixir', name: 'صراع الإكسير', icon: '🧪', desc: 'ساحة معركة AvA مدتها 30 دقيقة حيث السيطرة، وليس القتل، هي مفتاح الفوز — خيام العلاج، أولوية القلعة، وقواعد الانتقال الآني.' },
  { slug: 'kvk', name: 'حرب المملكة (KvK)', icon: '🏰', desc: 'حرب بين الخوادم من أجل المدينة الملكية: هجمات تستهدف الأبراج أولاً، دفاع تكتيكي للمماطلة، ومخاطر حقيقية على القوات.' },
  { slug: 'undead', name: 'حصار الموتى', icon: '🧟', desc: 'دفاع التحالف ضد موجات المصابين — ميكانيكية الفرق المتعددة الخفية، نقاط الصحة المستمرة، ومعالم المكافآت.' },
  { slug: 'cheese', name: 'فخ الجبن', icon: '🧀', desc: 'حشد التحالف ضد الجرذ العملاق: مكافآت شخصية من خمس مراحل، مخزون نقاط صحة مشترك للتحالف، وحسابات مقياس المستوى.' },
  { slug: 'thief', name: 'صيد اللصوص', icon: '💰', desc: 'إنفاق القدرة (Stamina) لاستدعاء زعماء اللصوص — ميكانيكيات الاستدعاء، تقنية القتل المستمر، وأولويات التبادل.' },
  { slug: 'survival', name: 'معركة البقاء', icon: '🛡️', desc: 'حدث مهمة أسبوعي يساوي حوالي 60,000 شارة مهارة مجانية — إكمال رخيص وتداخل مع مبارزة التحالف.' },
  { slug: 'canyon', name: 'غزو الوادي', icon: '🏜️', desc: 'معركة تتابع من ثلاثة مسارات حيث القدرة على الصمود تتفوق على القوة — استراتيجية أولوية المسار في حدث بدون مخاطر.' },
  { slug: 'mythic', name: 'الكنز الأسطوري', icon: '🗺️', desc: 'حدث القراصنة ذو السبع علامات تبويب مشروح للاعبي F2P: أولويات السوق، حد الـ 300 سمكة، ولعبة الكنز المدفون.' },
  { slug: 'royal', name: 'صراع القلعة الملكية', icon: '👑', desc: 'سباق أسبوعي للاستيلاء على القلعة — مسيرة واحدة لكل لاعب، تعزيز بـ 30 خانة، ونظام ألقاب المدينة الملكية الكامل.' },
  { slug: 'arena', name: 'ساحة المثلث', icon: '🔺', desc: 'ثلاث تشكيلات، يختار المهاجم اثنتين للفوز — دفاع متوازن، تضحيات في المواجهات، وفريق فخ ساحة القدر.' },
  { slug: 'wagon', name: 'عربة التحالف والقوافل', icon: '🚚', desc: 'رحلات عربة يومية مجانية، قواعد صندوق الحارس، تحديثات العربة الذهبية، ومزرعة شظايا UR للقوافل.' },
  { slug: 'supreme-healer', name: 'المعالج الأسمى', icon: '🩺', desc: 'جدول تسجيل تنافسي لمدة 7 أيام، إدارة الموارد يوماً بيوم، تخزين القدرة، وتوقيت مضاد السموم.' },
  { slug: 'strike-first', name: 'اضرب أولاً', icon: '⚡', desc: 'سباق بداية الخادم الجديد — معالم الملاذ، تطهير الآفة، التعبئة العسكرية، والماس المبكر.' },
  { slug: 'final-dawn', name: 'الفجر الأخير', icon: '🌅', desc: 'سباق تقدم القاعدة لمدة 7 أيام — المراحل الأربع (من التأسيس إلى الدفعة الأخيرة)، قائمة الانتظار ذات الأولوية، وتوقيت التسريع.' },
  { slug: 'path-to-healing', name: 'طريق العلاج', icon: '🕊️', desc: 'مسار مهمة تأهيل لمدة 5 أيام — مهام يومية، قاعدة فتح VIP 5 الإلزامية، وتأمين 15 شظية UR Arthur.' },
  { slug: 'supreme-duel', name: 'المبارزة العليا', icon: '🏆', desc: 'نمط بطولة عبر مناطق الحرب — 16 منطقة حرب، معارك افتراضية بـ 3 فرق (الأفضل من 3)، متجر عملات التوقعات، ولقب البطل.' },
  { slug: 'quiz-of-wisdom', name: 'اختبار الحكمة', icon: '🧠', desc: 'حدث أسئلة مع ورقة غش 15/15: بحث فوري عن الإجابات يغطي الميكانيكيات، المباني، الفصائل، VIP، والقصة.' },
  { slug: 'demon-king', name: 'ملك الشياطين', icon: '👹', desc: 'زعيم عالمي نصف أسبوعي (الثلاثاء والجمعة) — نقاط ضعف السحرة، 10 هجمات يومياً، وخدعة استدعاء المسيرة لمدة 30 ثانية.' },
  { slug: 'secret-operations', name: 'مركز العمليات السرية', icon: '🕵️', desc: 'مهام سرية يومية: احتمالات إعادة التدوير (UR 8%, SSR 24%)، ضمان الصندوق السادس عشر، وخرائط الكنز ذات الـ 7 شظايا.' },
  { slug: 'dwarven-mine', name: 'منجم الأقزام', icon: '⛏️', desc: 'حدث تعدين لمدة 7 أيام: قاعدة تخزين 750 معولاً، مكافآت الأعشاب مقابل أحجار التروس، ومخطط MR في الطابق 100.' },
  { slug: 'pandemic-experience', name: 'تجربة الوباء', icon: '🧪', desc: 'سلم صعوبة نصف أسبوعي من 1 إلى 9، فتح زعيم التحالف (40 مسحاً)، وخدعة حشد الأبطال الضعفاء.' },
  { slug: 'crystal-cluster', name: 'وادي عنقود الكريستال', icon: '🔮', desc: 'مشاجرة خريطة موقوتة: زراعة الوحوش الحمراء بـ 1.5 ألف نقطة لكل منها، السيطرة على مناجم الكريستال بـ 5 آلاف/دقيقة، وخدعة ساعة الإيقاف.' },
];
---
<Base lang={lang} path="/ar/events/" title="أدلة الفعاليات" description="تحليلات كاملة لكل فعالية في Last Asylum: Plague: الجداول الزمنية، نظام النقاط، الاستراتيجيات، والأخطاء التي يجب تجنبها.">
  <section class="py-12">
    <h1 class="mb-3 text-4xl font-bold text-plague-100">أدلة الفعاليات</h1>
    <p class="mb-10 text-lg text-stone-400">تحليلات كاملة لكل فعالية في Last Asylum: Plague: الجداول الزمنية، نظام النقاط، الاستراتيجيات، والأخطاء التي يجب تجنبها.</p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {events.map(e => (
        <a href={`/ar/events/${e.slug}/`} class="group rounded-lg border border-stone-800 bg-stone-900 p-5 transition-colors hover:border-plague-600">
          <span class="text-3xl">{e.icon}</span>
          <h2 class="mt-3 text-lg font-bold text-plague-200 group-hover:text-plague-100">{e.name}</h2>
          <p class="mt-2 text-sm text-stone-400">{e.desc}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
