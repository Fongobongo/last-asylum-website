---
import Base from '../layouts/Base.astro';
import type { Lang } from '../i18n/utils';

const lang: Lang = 'en';
---

<Base lang={lang} path="/404/" title="404 — Not Found" noindex={true}>
  <section class="flex min-h-[65vh] flex-col items-center justify-center py-20 text-center">
    <div class="relative">
      <div class="aurora absolute -inset-6 rounded-full bg-toxic-500/10 blur-3xl"></div>
      <span class="relative text-7xl select-none floaty inline-block">🧟</span>
    </div>
    <h1 class="mt-6 text-4xl sm:text-5xl font-bold tracking-tight text-white display">404 — Page not found</h1>
    <p class="mt-3 text-stone-400 max-w-md text-[15px] leading-relaxed">The plague took this page. Choose a safe path back:</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-glow inline-flex items-center gap-2 rounded-full bg-toxic-400 px-6 py-3 text-sm font-semibold text-black hover:bg-toxic-300 transition">
        Home (EN) <span>→</span>
      </a>
      <a href="/ru/" class="inline-flex items-center gap-2 rounded-full glass px-6 py-3 text-sm font-semibold text-stone-200 hover:text-white hover:border-white/20 transition">
        На главную (RU) <span>→</span>
      </a>
      <a href="/guides/" class="inline-flex items-center gap-2 rounded-full glass px-6 py-3 text-sm font-semibold text-stone-200 hover:text-white hover:border-white/20 transition">
        All guides <span>→</span>
      </a>
    </div>
    <div class="mt-10 grid w-full max-w-2xl gap-3 text-left sm:grid-cols-3">
      <a href="/beginners/" class="rounded-2xl border border-white/10 bg-stone-900/60 p-4 hover:border-toxic-500/50 transition">
        <div class="text-sm font-bold text-white">🌱 Beginners</div>
        <div class="mt-1 text-xs text-stone-400">Day-one checklist & mistakes</div>
      </a>
      <a href="/alliance/" class="rounded-2xl border border-white/10 bg-stone-900/60 p-4 hover:border-toxic-500/50 transition">
        <div class="text-sm font-bold text-white">🤝 Alliance</div>
        <div class="mt-1 text-xs text-stone-400">Help formula, tech & gifts</div>
      </a>
      <a href="/codes/" class="rounded-2xl border border-white/10 bg-stone-900/60 p-4 hover:border-toxic-500/50 transition">
        <div class="text-sm font-bold text-white">🎁 Gift codes</div>
        <div class="mt-1 text-xs text-stone-400">Active redeem codes</div>
      </a>
    </div>
    <p class="mt-6 text-xs text-stone-500">
      Spotted a broken link from outside? Search the site or open <a href="/support/" class="underline hover:text-stone-300">Support</a> to report it.
    </p>
  </section>
</Base>