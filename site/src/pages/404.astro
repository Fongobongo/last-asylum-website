---
import Base from '../layouts/Base.astro';

const lang: Lang = 'en';
---

<Base lang={lang} path="/404" title="404">
  <section class="flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <span class="text-7xl">🧟</span>
    <h1 class="mt-6 text-4xl font-bold text-plague-100">404 — Page not found</h1>
    <p class="mt-3 text-stone-400">The plague took this page. Try the way back:</p>
    <div class="mt-8 flex gap-3">
      <a href="/" class="rounded-lg bg-plague-700 px-6 py-3 font-semibold text-plague-50 hover:bg-plague-600 transition-colors">
        Home
      </a>
      <a href="/ru/" class="rounded-lg border border-stone-700 px-6 py-3 font-semibold text-stone-200 hover:bg-stone-800 transition-colors">
        На главную (RU)
      </a>
    </div>
  </section>
</Base>

<script>
  // @ts-ignore
  const lang: Lang = 'en';
</script>