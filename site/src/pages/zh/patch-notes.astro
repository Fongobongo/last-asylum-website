---
import Base from '../../layouts/Base.astro';
import GuidePage from '../../components/GuidePage.astro';
import PatchNotes from '../../components/PatchNotes.astro';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'zh';
---

<Base lang={lang} path="/zh/patch-notes/" title="更新日志" description="《Last Asylum: Plague》历次服务器维护与更新汇总——按最新时间排序。">
  <GuidePage title={`📜 ${t(lang, 'patchnotes.title')}`} description={t(lang, 'patchnotes.desc')} lang={lang}>
    <PatchNotes />
  </GuidePage>
</Base>