---
import Base from '../../../layouts/Base.astro';
import GuidePage from '../../../components/GuidePage.astro';
import CodexGrid from '../../../components/CodexGrid.astro';
import DiscordBanner from '../../../components/DiscordBanner.astro';
import { heroCodex } from '../../../data/heroCodex';
import { t } from '../../../i18n/ui';
import type { Lang } from '../../../i18n/utils';

const lang: Lang = 'ja';
const base = lang === 'en' ? '' : `/${lang}`;
---

<Base lang={lang} path="/codex/" title="ヒーロー図鑑" description="Last Asylum: Plague の主要ヒーロー全員 — スキル、ビルド、チームノートと入手方法。">
  <GuidePage
    title="📖 ヒーロー図鑑"
    description="重要なすべてのヒーローのスキル、ビルド優先度、チームノート — コミュニティガイドから編集。"
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/ja/' }, { label: 'ヒーロー図鑑' }]}
  >
    <p>各ページ:役割、入手方法、本当に重要なスキル、ビルド優先度、そして登場するチーム編成。ランキングは<a href="/ja/tier-list/">ティアリスト</a>を参照してください。</p>

    <CodexGrid heroes={heroCodex} lang={lang} base={base} />

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>
