---
import Base from '../../layouts/Base.astro';
import GuidePage from '../../components/GuidePage.astro';
import GiftCodes from '../../components/GiftCodes.astro';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'ja';
---

<Base lang={lang} path="/ja/codes/" title={t(lang, 'codes.title')} description={t(lang, 'codes.desc')}>
  <GuidePage title={`🎁 ${t(lang, 'codes.title')}`} description={t(lang, 'codes.desc')} lang={lang}>
    <p class="text-sm text-stone-300 mt-2">詳しい入力手順（<b>ゲーム内</b> と <b>UID＋ワンタイムパスワードでのWeb入力</b>）は <a href="#how-to-redeem" class="text-toxic-400 underline">このページ下部</a> にあります。</p>

    <h2 id="latest-codes">{t(lang, 'codes.active')}</h2>
    <GiftCodes lang={lang} />

    <h2 id="how-to-redeem">{t(lang, 'codes.redeem')}</h2>
    <p>{t(lang, 'codes.redeem.android')}</p>
    <p>{t(lang, 'codes.redeem.ios')}</p>

    <h2 id="notes">{t(lang, 'codes.note')}</h2>
  </GuidePage>
</Base>
