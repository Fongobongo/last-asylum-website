---
import Base from '../../layouts/Base.astro';
import GuidePage from '../../components/GuidePage.astro';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'ja';

const authors = [
  { name: 'HottChoklit', tag: 'K34', contributions: ['ダイヤの使い方', '戦力(Might)の成長', 'ヒーローアカデミーシリーズ', 'KvK戦略', 'Undead/略奪ガイド'] },
  { name: 'korpez / Korpez Gaming', tag: 'YouTube', contributions: ['Alliance Duel 完全ガイド', 'Survival Battle', '建設速度', 'Era of Revival', 'Mythic Treasure'] },
  { name: 'chuppergaming', tag: 'YouTube', contributions: ['Era スターターガイド', '部隊訓練', 'Mythic Treasure', 'Supreme Duel', 'Guild Wagon'] },
  { name: 'merlyn', tag: 'community', contributions: ['部隊編成 + F2Pセクション', 'カラスのエピグラフのコツ', 'ショップ優先度(エピグラフ)'] },
  { name: 'lucifer_burnsyou', tag: 'community', contributions: ['ショップ優先度ガイド(5言語)', 'strategic-game-guide.netlify.app'] },
  { name: 'callikoneko', tag: 'community', contributions: ['Demon King ダメージの徹底解剖', 'スキルシナジーの解説'] },
  { name: 'kellerfaust', tag: 'community', contributions: ['Boss Blight の編成(全陣営)'] },
  { name: 'DrAction', tag: 'S12', contributions: ['エピグラフ昇格順序', 'PvP部隊の助言'] },
  { name: 'skyyzies', tag: 'community', contributions: ['Triangle Arena の防衛と攻撃ルール'] },
  { name: 'verratvonwindir', tag: 'S2', contributions: ['Royal Castle Scramble のメカニズム'] },
  { name: 'mu_013', tag: 'community', contributions: ['Hunt Battle', 'Wandering Phantom', 'Guild Wagon', 'Falcon Tower の備蓄'] },
  { name: 'linde2000', tag: 'community', contributions: ['Thief Hunt のスポーン', 'Crystal Cluster のスキル', 'F2Pの回答'] },
  { name: 'elsiika57', tag: 'community', contributions: ['教会1〜29の建設ロードマップ'] },
  { name: 'zoidseo', tag: 'K159', contributions: ['序盤の進め方'] },
  { name: 'ruitea', tag: 'community', contributions: ['General Tips / F2P / Shrimp ガイド', 'Marlena スキル分析'] },
  { name: '_.dot._', tag: 'community', contributions: ['Marlena スキルバッジ効率', 'Mythic Treasure の訂正', 'ヒーロースキル優先度'] },
  { name: 'dunidunduni', tag: 'S7', contributions: ['Survival Battle のイベント詳細'] },
  { name: 'Aesy', tag: 'community', contributions: ['Thief Hunt と Crystal Cluster のインフォグラフィック'] },
  { name: 'katherineclover', tag: 'S131', contributions: ['Lucky Clovers の大全'] },
  { name: 'DrGayLord / HOLY', tag: 'S247', contributions: ['初心者の基本:建物、装備、陣営'] },
  { name: '뀨잉이 (jjuingyi)', tag: 'community', contributions: ['Guild Wagon ガイド(KO)'] },
  { name: 'bulheba', tag: 'RU community', contributions: ['RU: PVPのメカニズム、建設順序、Alliance Duel 動画'] },
  { name: 'LapBase / ikona_in', tag: 'RU community', contributions: ['RU: F2P歩兵部隊、イベントガイド'] },
  { name: 'oψsvge英俊的', tag: 'K250', contributions: ['ID: Era of Revival、Undead Siege、序盤週'] },
  { name: 'hunalulu0503', tag: 'community', contributions: ['Mythic Treasure F2P、TOP-10建物'] },
  { name: 'Sirox', tag: 'thelaphub.com', contributions: ['LAP Hub — 研究プランナー、コスト計算機、図鑑', 'Claire UR と略奪収入の解説'] },
];

const sources = [
  { name: 'SiroxのLAP Hub', url: 'https://thelaphub.com', desc: '研究プランナー、コスト計算機、ヒーロー/建物の図鑑' },
  { name: 'Strategic Game Guide', url: 'https://strategic-game-guide.netlify.app', desc: '5言語のショップ優先度' },
  { name: 'コミュニティのYouTubeチャンネル', url: null, desc: 'korpez、HottChoklit、chuppergaming、KrrissGaming、quanybean など' },
];
---

<Base lang={lang} path="/ja/credits/" title="クレジットと情報源" description="このサイトを支える Last Asylum: Plague コミュニティのガイド作者へのクレジット。">
  <GuidePage title="🙏 クレジットと情報源" description="このハブはコミュニティの知識の編纂です。ガイドはコミュニティメンバーが無償で書きました — すべての方に敬意と感謝を。" lang={lang}>
    <h2 id="authors">ガイド作者</h2>
    <div class="not-prose my-6 grid gap-3 sm:grid-cols-2">
      {authors.map((a) => (
        <div class="rounded-lg border border-stone-800 bg-stone-900 p-4">
          <p class="font-bold text-plague-200">{a.name} <span class="ml-1 rounded bg-stone-800 px-1.5 py-0.5 text-xs font-medium text-stone-400">{a.tag}</span></p>
          <p class="mt-1 text-sm text-stone-400">{a.contributions.join(' · ')}</p>
        </div>
      ))}
    </div>

    <h2 id="sources">情報源</h2>
    <ul>
      {sources.map((s) => (
        <li>
          {s.url
            ? <a href={s.url} target="_blank" rel="noopener noreferrer">{s.name}</a>
            : <strong>{s.name}</strong>}
          {' — '}{s.desc}
        </li>
      ))}
    </ul>

    <p class="mt-6 text-sm text-stone-500">もしあなたが作者で、お名前の修正や削除を希望される場合はご連絡ください — 迅速に対応します。</p>
  </GuidePage>
</Base>
