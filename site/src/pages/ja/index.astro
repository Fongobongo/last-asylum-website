---
import Home from '../../components/Home.astro';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'ja';

const sections = [
  { href: '/ja/beginners/', icon: '🌱', title: '初心者ガイド', key: 'home.sections.beginners.desc', color: 'from-green-900/40' },
  { href: "/ja/tips/", icon: "🧠", title: "裏ワザ・隠し仕様", key: "home.sections.tips.desc", color: "from-fuchsia-900/40" },
  { href: '/ja/buildings/', icon: '🏰', title: '建物', key: 'home.sections.buildings.desc', color: 'from-amber-900/40' },
  { href: '/ja/heroes/', icon: '⚔️', title: 'ヒーロー', key: 'home.sections.heroes.desc', color: 'from-red-900/40' },
  { href: '/ja/economy/', icon: '💰', title: '経済', key: 'home.sections.economy.desc', color: 'from-yellow-900/40' },
  { href: '/ja/raven/', icon: '🐦‍⬛', title: 'カラスとエピグラフ', key: 'home.sections.raven.desc', color: 'from-purple-900/40' },
  { href: '/ja/era/', icon: '☣️', title: 'Era of Revival', key: 'home.sections.era.desc', color: 'from-lime-900/40' },
  { href: '/ja/codes/', icon: '🎁', title: 'ギフトコード', key: 'home.sections.codes.desc', color: 'from-toxic-900/40' },
  { href: '/ja/patch-notes/', icon: '📜', title: 'パッチノート', key: 'home.sections.patchnotes.desc', color: 'from-stone-700/40' },
];

const popular = [
  { href: "/ja/tips/", title: "隠し仕様と上級テクニック", desc: "建設スナップショット、ゴースト集結、病院上限死、事前採取テクニック。" },
  { href: '/ja/beginners/', title: '最初の24時間', desc: 'アカウントの命運を決める初日のチェックリスト。' },
  { href: '/ja/economy/', title: 'ダイヤとショップ', desc: '各ショップでの正確な購入順序 — そして絶対に買ってはいけないもの。' },
  { href: '/ja/heroes/', title: 'F2P部隊', desc: 'Arthur、Daskal、Marlena、Harper、Claire — 定番の進め方。' },
  { href: '/ja/events/undead/', title: 'Undead Siege', desc: '戦力9.5Mのプレイヤーを落とす、ウェーブごとに2部隊出現する隠しメカニズム。' },
  { href: '/ja/events/alliance-duel/', title: 'Alliance Duel', desc: '巻物はフェーズ3、シャードはフェーズ4、加速はフェーズ5で使う。' },
  { href: '/ja/era/', title: 'Claire SSR→UR', desc: '名誉の殿堂レベルで星6〜星9の失敗をスキップする方法。' },
];
---

<Home lang={lang} path="/ja/" sections={sections} popular={popular} />
