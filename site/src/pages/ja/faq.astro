---
import Base from '../../layouts/Base.astro';
import GuidePage from '../../components/GuidePage.astro';
import DiscordBanner from '../../components/DiscordBanner.astro';
import { faqJa } from '../../data/faqJa';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'ja';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqJa.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});
---

<Base lang={lang} path="/faq/" title="FAQ" description="Last Asylum: Plague の最も一般的な質問への回答：最良の無課金編成、アップグレード順序、略奪上限、ショップ優先度、ギフトコード。">
  <GuidePage
    title="❓ よくある質問"
    description="プレイヤーが実際に尋ねる質問と、コミュニティコンセンサスの回答。"
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/ja/' }, { label: 'FAQ' }]}
  >
    <script slot="faq-schema" type="application/ld+json" set:html={schema} />

    <div class="not-prose my-6 space-y-3">
      {faqJa.map((f) => (
        <details class="group rounded-lg border border-stone-800 bg-stone-900">
          <summary class="cursor-pointer select-none px-4 py-3 font-semibold text-plague-200 group-open:text-plague-100">
            {f.q}
          </summary>
          <p class="border-t border-stone-800 px-4 py-3 text-sm leading-relaxed text-stone-300">{f.a}</p>
        </details>
      ))}
    </div>

    <p>質問が見つからない？各ガイドをチェック：<a href="/ja/beginners/">初心者</a>、<a href="/ja/economy/">経済</a>、<a href="/ja/heroes/">ヒーロー</a>、<a href="/ja/gear/">装備</a>、<a href="/ja/raven/">カラス</a>、<a href="/ja/era/">Era of Revival</a> — または公式Discordで質問してください。</p>

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>
