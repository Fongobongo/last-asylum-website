---
import Base from '../../layouts/Base.astro';
import GuidePage from '../../components/GuidePage.astro';
import InfographicGallery from '../../components/InfographicGallery.astro';
import DiscordBanner from '../../components/DiscordBanner.astro';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'ja';
---

<Base lang={lang} path="/infographics/" title="インフォグラフィック — Last Asylum: Plague" description="Last Asylum: Plague のポスター・図解・チートシートを高解像度で。">
  <GuidePage
    title="📊 インフォグラフィック"
    description="Last Asylum: Plague のポスター・図解・チートシートを高解像度で。"
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/ja/' }, { label: 'インフォグラフィック' }]}
  >
    <InfographicGallery lang={lang} />

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>
