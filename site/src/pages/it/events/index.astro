---
import Base from '../../../layouts/Base.astro';
import { t } from '../../../i18n/ui';
import type { Lang } from '../../../i18n/utils';

const lang: Lang = 'it';
const events = [
  { slug: 'alliance-duel', name: 'Duello tra Alleanze', icon: '⚔️', desc: 'Competizione tra alleanze di sei giorni con categorie di punti giornaliere, valori di punti esatti e l\'economia del risparmio totale.' },
  { slug: 'elixir', name: 'Corsa all\'Elisir', icon: '🧪', desc: 'Campo di battaglia AvA di 30 minuti dove il controllo, non le uccisioni, porta alla vittoria: tende di guarigione, priorità del castello e regole di teletrasporto.' },
  { slug: 'kvk', name: 'Guerra tra Regni (KvK)', icon: '🏰', desc: 'Guerra tra server per la Città Reale: attacchi prima alle torrette, difesa con tattiche di stallo e rischio reale per le truppe.' },
  { slug: 'undead', name: 'Assedio dei Non Morti', icon: '🧟', desc: 'Difesa dell\'alleanza contro ondate di infetti: la meccanica nascosta delle squadre multiple, HP persistenti e traguardi di ricompensa.' },
  { slug: 'cheese', name: 'Trappola del Formaggio', icon: '🧀', desc: 'Raduno dell\'alleanza contro il ratto gigante: ricompense personali in cinque fasi, pool di HP condiviso dell\'alleanza e calcoli di scala dei livelli.' },
  { slug: 'thief', name: 'Caccia al Ladro', icon: '💰', desc: 'Spendi stamina per evocare i boss Capo Ladro: meccaniche di spawn, tecnica di uccisione continua e priorità di scambio.' },
  { slug: 'survival', name: 'Battaglia di Sopravvivenza', icon: '🛡️', desc: 'Evento di missione settimanale che vale circa 60.000 Badge Abilità gratuiti: completamenti economici e sovrapposizione con il Duello tra Alleanze.' },
  { slug: 'canyon', name: 'Conquista del Canyon', icon: '🏜️', desc: 'Battaglia a staffetta su tre corsie dove la resistenza batte la potenza: strategia di priorità delle corsie in un evento a rischio zero.' },
  { slug: 'mythic', name: 'Tesoro Mitico', icon: '🗺️', desc: 'L\'evento pirata a sette schede decodificato per F2P: priorità di mercato, limite di 300 pesci e la strategia del Tesoro Sepolto.' },
  { slug: 'royal', name: 'Corsa al Castello Reale', icon: '👑', desc: 'Gara settimanale di cattura del castello: una marcia per giocatore, rinforzi da 30 slot e il sistema completo dei titoli della Città Reale.' },
  { slug: 'arena', name: 'Arena Triangolare', icon: '🔺', desc: 'Tre formazioni, l\'attaccante ne sceglie due per vincere: difesa equilibrata, scontri sacrificali e la squadra trappola dell\'Arena del Destino.' },
  { slug: 'wagon', name: 'Carro della Gilda e Carovane', icon: '🚚', desc: 'Corse giornaliere gratuite con il carro, regole dei forzieri della Guardia, aggiornamenti del Carro d\'Oro e farming di frammenti UR delle carovane.' },
  { slug: 'supreme-healer', name: 'Guaritore Supremo', icon: '🩺', desc: 'Programma di punteggio competitivo di 7 giorni, gestione giornaliera delle risorse, accumulo di stamina e tempismo per l\'Antitossina.' },
  { slug: 'strike-first', name: 'Colpisci per Primo', icon: '⚡', desc: 'Sprint iniziale per i nuovi server: traguardi del Santuario, purificazione del Flagello, mobilitazione militare e diamanti iniziali.' },
  { slug: 'final-dawn', name: 'Alba Finale', icon: '🌅', desc: 'Sprint di progressione della base di 7 giorni: le 4 fasi (Fondamenta fino alla Spinta Finale), coda di priorità e tempismo delle accelerazioni.' },
  { slug: 'path-to-healing', name: 'Sentiero verso la Guarigione', icon: '🕊️', desc: 'Percorso di missione di onboarding di 5 giorni: compiti giornalieri, la regola obbligatoria dello sblocco VIP 5 e l\'ottenimento di 15 frammenti UR di Arthur.' },
  { slug: 'supreme-duel', name: 'Duello Supremo', icon: '🏆', desc: 'Modalità torneo tra zone di guerra: 16 zone di guerra, battaglie virtuali al meglio delle 3 squadre, negozio di Monete di Previsione e titolo di Campione.' },
  { slug: 'quiz-of-wisdom', name: 'Quiz della Saggezza', icon: '🧠', desc: 'Evento a quiz con foglio di risposte 15/15: consultazione istantanea che copre meccaniche, edifici, fazioni, VIP e lore.' },
  { slug: 'demon-king', name: 'Re Demone', icon: '👹', desc: 'Boss mondiale bisettimanale (martedì e venerdì): vulnerabilità ai Maghi, 10 attacchi giornalieri e il trucco del richiamo della marcia di 30 secondi.' },
  { slug: 'secret-operations', name: 'Centro Operazioni Segrete', icon: '🕵️', desc: 'Compiti clandestini giornalieri: probabilità di reroll (UR 8%, SSR 24%), garanzia di pietà al 16° forziere e mappe del tesoro da 7 frammenti.' },
  { slug: 'dwarven-mine', name: 'Miniera dei Nani', icon: '⛏️', desc: 'Evento minerario di 7 giorni: la regola dell\'accumulo di 750 picconi, ricompense erbe vs pietre dell\'equipaggiamento e il progetto MR al piano 100.' },
  { slug: 'pandemic-experience', name: 'Esperienza Pandemica', icon: '🧪', desc: 'Scala di difficoltà bisettimanale 1–9, sblocco boss dell\'alleanza (40 eliminazioni) e il trucco del raduno con eroi deboli.' },
  { slug: 'crystal-cluster', name: 'Valle del Cluster di Cristallo', icon: '🔮', desc: 'Rissa su mappa a tempo: farma i mob rossi a 1,5K punti ciascuno, mantieni le miniere di cristallo per 5K/min e il trucco del cronometro.' },
];
---
<Base lang={lang} path="/it/events/" title="Guide agli Eventi" description="Analisi complete di ogni evento di Last Asylum: Plague: programmi, punteggi, strategie ed errori da evitare.">
  <section class="py-12">
    <h1 class="mb-3 text-4xl font-bold text-plague-100">Guide agli Eventi</h1>
    <p class="mb-10 text-lg text-stone-400">Analisi complete di ogni evento di Last Asylum: Plague: programmi, punteggi, strategie ed errori da evitare.</p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {events.map(e => (
        <a href={`/it/events/${e.slug}/`} class="group rounded-lg border border-stone-800 bg-stone-900 p-5 transition-colors hover:border-plague-600">
          <span class="text-3xl">{e.icon}</span>
          <h2 class="mt-3 text-lg font-bold text-plague-200 group-hover:text-plague-100">{e.name}</h2>
          <p class="mt-2 text-sm text-stone-400">{e.desc}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
