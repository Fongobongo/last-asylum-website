---
import Base from '../../layouts/Base.astro';
import GuidePage from '../../components/GuidePage.astro';
import GiftCodes from '../../components/GiftCodes.astro';
import { REDEEM_URL } from '../../data/giftcodes';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'it';
---

<Base lang={lang} path="/it/codes/" title="Codici Regalo" description="Codici regalo attivi e funzionanti per Last Asylum: Plague.">
  <GuidePage title={`🎁 ${t(lang, 'codes.title')}`} description={t(lang, 'codes.desc')} lang={lang}>
    <p class="text-[15px] leading-6 text-stone-400 -mt-2 mb-2">Guida completa al riscatto — qui sotto in questa pagina ↓</p>

    <h2 id="latest-codes">{t(lang, 'codes.active')}</h2>
    <GiftCodes lang={lang} />

    <h2 id="how-to-redeem">{t(lang, 'codes.redeem')}</h2>
    <h3 class="mt-6">🤖 Android</h3>
    <p>{t(lang, 'codes.redeem.android')}</p>
    <h3 class="mt-4">🍏 iOS</h3>
    <p>{t(lang, 'codes.redeem.ios')} <a class="text-toxic-400 underline break-all" href={REDEEM_URL} target="_blank" rel="noopener noreferrer">{REDEEM_URL} ↗</a></p>

    <h2 id="notes">{t(lang, 'codes.note')}</h2>
    <p>I codici non hanno restrizioni regionali ma solitamente sono utilizzabili una sola volta per account.</p>
  </GuidePage>
</Base>