---
import Base from '../../../layouts/Base.astro';
import GuidePage from '../../../components/GuidePage.astro';
import CodexGrid from '../../../components/CodexGrid.astro';
import DiscordBanner from '../../../components/DiscordBanner.astro';
import { heroCodex } from '../../../data/heroCodex';
import { t } from '../../../i18n/ui';
import type { Lang } from '../../../i18n/utils';

const lang: Lang = 'it';
const base = lang === 'en' ? '' : `/${lang}`;
---

<Base lang={lang} path="/it/codex/" title="Codex Eroi" description="Ogni eroe chiave in Last Asylum: Plague — abilità, build, note sulla squadra e come ottenerli.">
  <GuidePage
    title="📖 Codex Eroi"
    description="Abilità, priorità di build e note sulla squadra per ogni eroe importante — compilate dalle guide della community."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/it/' }, { label: 'Codex Eroi' }]}
  >
    <p>Ogni pagina: ruolo, come ottenere l'eroe, le abilità che contano davvero, le priorità di build e le composizioni di squadra in cui appaiono. Per le classifiche vedi la <a href="/it/tier-list/">Tier List</a>.</p>

    <CodexGrid heroes={heroCodex} lang={lang} base={base} />

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>
