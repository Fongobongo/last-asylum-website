---
import Base from '../layouts/Base.astro';
import GuidePage from '../components/GuidePage.astro';
import DiscordBanner from '../components/DiscordBanner.astro';
import { heroTiers, tierColors } from '../data/tiers';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/utils';

const lang: Lang = 'en';
const tiers: ('S' | 'A' | 'B' | 'C')[] = ['S', 'A', 'B', 'C'];
---

<Base lang={lang} path="/tier-list/" title="Hero Tier List" description="Last Asylum: Plague hero tier list — S/A/B/C rankings with context for F2P and mid-spender progression.">
  <GuidePage
    title="🏆 Hero Tier List"
    description="Community consensus rankings, weighted for a typical F2P / mid-spender progression path. Tier context matters: a 'B' SSR you own today beats an 'S' UR you will own in three months."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/' }, { label: 'Tier List' }]}
  >
    <p>Compiled from the squad-composition guides, boss-fight breakdowns and PvP threads in the official Discord. Tiers reflect <strong>overall account value</strong> — not raw stats.</p>

    {tiers.map((tier) => (
      <section class="not-prose my-6">
        <h3 class={`mb-3 inline-block rounded-lg border px-3 py-1 text-xl font-bold ${tierColors[tier]}`}>
          {tier} tier
        </h3>
        <div class="grid gap-3 sm:grid-cols-2">
          {heroTiers.filter((h) => h.tier === tier).map((h) => (
            <div class="rounded-lg border border-stone-800 bg-stone-900 p-4">
              <div class="flex items-baseline justify-between gap-2">
                <p class="font-bold text-plague-200">{h.name}</p>
                <span class="text-xs text-stone-500">{h.rarity} · {h.faction} · {h.class}</span>
              </div>
              <p class="mt-1 text-sm text-stone-400">{h.note}</p>
            </div>
          ))}
        </div>
      </section>
    ))}

    <h2 id="how-to-read">How to read this list</h2>
    <ul>
      <li><strong>S</strong> — long-term core investments: build them first, keep them forever</li>
      <li><strong>A</strong> — strong carries and event heroes: worth building when your S-core is stable</li>
      <li><strong>B</strong> — situational/budget: good while you are building the S/A roster, in boss comps, or for mono-faction squads</li>
      <li><strong>C</strong> — very early placeholders only</li>
    </ul>
    <blockquote>Mono-faction meta: UR epigraphs buff ONE faction only. 3 same-faction heroes = +5%, 4 = +15%, 5 = +20% HP/ATK/DEF. Faction counter: Warrior > Warlock > Ranger > Warrior.</blockquote>

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>