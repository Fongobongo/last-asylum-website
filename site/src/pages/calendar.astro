---
import Base from '../layouts/Base.astro';
import GuidePage from '../components/GuidePage.astro';
import DiscordBanner from '../components/DiscordBanner.astro';
import { weeklySchedule, recurring } from '../data/calendar';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/utils';

const lang: Lang = 'en';
---

<Base lang={lang} path="/calendar/" title="Event Calendar" description="The weekly rhythm of Last Asylum: Plague — Falcon claim days, Alliance Duel phases, resets and recurring events.">
  <GuidePage
    title="📅 Event Calendar"
    description="The weekly rhythm every efficient player follows. NOTE: exact rotations differ per server — always check your in-game calendar."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/' }, { label: 'Calendar' }]}
  >
    <h2 id="weekly-rhythm">The weekly rhythm</h2>
    <div class="not-prose my-6 overflow-x-auto rounded-lg border border-stone-800">
      <table class="w-full text-sm">
        <thead class="bg-stone-900 text-left text-plague-300">
          <tr><th class="p-3">Day</th><th class="p-3">Event</th><th class="p-3">What to do</th></tr>
        </thead>
        <tbody>
          {weeklySchedule.map((e) => (
            <tr class="border-t border-stone-800">
              <td class="p-3 font-bold text-plague-200 whitespace-nowrap">{e.icon} {e.day}</td>
              <td class="p-3 text-stone-200 whitespace-nowrap">{e.event}</td>
              <td class="p-3 text-stone-400">{e.what}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 id="recurring">Resets & recurring schedules</h2>
    <div class="not-prose my-6 grid gap-3 sm:grid-cols-2">
      {recurring.map((e) => (
        <div class="rounded-lg border border-stone-800 bg-stone-900 p-4">
          <p class="text-sm font-bold text-plague-200">{e.icon} {e.event}</p>
          <p class="mt-0.5 text-xs text-stone-500">{e.day}</p>
          <p class="mt-1 text-sm text-stone-400">{e.what}</p>
        </div>
      ))}
    </div>

    <h2 id="claim-days">The claim-day trick (Mon/Wed/Fri)</h2>
    <p>Falcon Tower quests completed but <strong>not claimed</strong> keep their red dot and don't expire. The double-strength days are Monday, Wednesday and Friday:</p>
    <ul>
      <li>Complete quests Sunday → claim Monday</li>
      <li>Complete Tuesday → claim Wednesday</li>
      <li>Complete Thursday → claim Friday</li>
    </ul>
    <p><strong>Stacking Max − 1:</strong> a full quest board freezes the timer. Complete one quest of the max to keep new quests spawning — control your quest flow day by day.</p>
    <p class="text-sm text-stone-500">⚠️ Queue limit: ALL quests (completed or not) count toward the queue counter (x/x). When full, the next quest is lost.</p>

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>