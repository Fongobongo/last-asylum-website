---
import Base from '../../layouts/Base.astro';
import GuidePage from '../../components/GuidePage.astro';
import PatchNotes from '../../components/PatchNotes.astro';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'ms';
---

<Base lang={lang} path="/ms/patch-notes/" title="Nota Tampalan" description="Setiap penyelenggaraan dan kemas kini pelayan Last Asylum: Plague, diringkaskan — yang terbaharu didahulukan.">
  <GuidePage title={`📜 ${t(lang, 'patchnotes.title')}`} description={t(lang, 'patchnotes.desc')} lang={lang}>
    <PatchNotes />
  </GuidePage>
</Base>