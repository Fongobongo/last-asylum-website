---
import Base from '../../../layouts/Base.astro';
import GuidePage from '../../../components/GuidePage.astro';
import CodexGrid from '../../../components/CodexGrid.astro';
import DiscordBanner from '../../../components/DiscordBanner.astro';
import { heroCodex } from '../../../data/heroCodex';
import { t } from '../../../i18n/ui';
import type { Lang } from '../../../i18n/utils';

const lang: Lang = 'ms';
const base = lang === 'en' ? '' : `/${lang}`;
---

<Base lang={lang} path="/ms/codex/" title="Helden-Kodex" description="Jeder wichtige Held in Last Asylum: Plague — Skills, Builds, Team-Notizen und wie man ihn bekommt.">
  <GuidePage
    title="📖 Helden-Kodex"
    description="Skills, Build-Prioritäten und Team-Notizen für jeden Helden, der zählt — zusammengestellt aus den Community-Guides."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/ms/' }, { label: 'Helden-Kodex' }]}
  >
    <p>Setiap halaman: peranan, cara untuk mendapatkan wira, kemahiran yang benar-benar penting, keutamaan binaan dan komposisi pasukan di mana mereka muncul. Untuk kedudukan lihat <a href="/ms/tier-list/">Senarai Tier</a>.</p>

    <CodexGrid heroes={heroCodex} lang={lang} base={base} />

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>
