---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import GuidePage from '../components/GuidePage.astro';
import VideoSection from '../components/VideoSection.astro';
import Calculators from '../components/Calculators.astro';
import Infographic from '../components/Infographic.astro';
import DiscordBanner from '../components/DiscordBanner.astro';
import ShopPromoBanner from '../components/ShopPromoBanner.astro';
import AllianceDuelCalc from '../components/AllianceDuelCalc.astro';
import SquadBuilder from '../components/SquadBuilder.astro';
import DailyChecklist from '../components/DailyChecklist.astro';
import WeeklyCheatSheet from '../components/WeeklyCheatSheet.astro';
import SanctuaryCalc from '../components/SanctuaryCalc.astro';
import PvPMatrix from '../components/PvPMatrix.astro';
import SquadQuiz from '../components/SquadQuiz.astro';
import QuizSearch from '../components/QuizSearch.astro';
import FaqSection from '../components/FaqSection.astro';
import GuildHub from '../components/GuildHub.astro';
import MonumentTimeline from '../components/MonumentTimeline.astro';
import VipCalculator from '../components/VipCalculator.astro';
import TroopProgression from '../components/TroopProgression.astro';
import RavenSystem from '../components/RavenSystem.astro';
import AllianceTechTree from '../components/AllianceTechTree.astro';
import OfficialTipsWidget from '../components/OfficialTipsWidget.astro';
import CollegeTechExplorer from '../components/CollegeTechExplorer.astro';
import SurvivorsGuide from '../components/SurvivorsGuide.astro';
import HeroGearGuide from '../components/HeroGearGuide.astro';
import MonsterRadar from '../components/MonsterRadar.astro';
import AgeOfRebirthGuide from '../components/AgeOfRebirthGuide.astro';
import LordJobsGuide from '../components/LordJobsGuide.astro';
import AllianceRanksGuide from '../components/AllianceRanksGuide.astro';
import ElixirFortsGuide from '../components/ElixirFortsGuide.astro';
import CrystalMineGuide from '../components/CrystalMineGuide.astro';
import TierListGrid from '../components/TierListGrid.astro';
import TroopCalc from '../components/TroopCalc.astro';
import GearCalc from '../components/GearCalc.astro';
import HeroCompare from '../components/HeroCompare.astro';
import GuidesIndex from '../components/GuidesIndex.astro';
import RelatedGuides, { type RelatedItem } from '../components/RelatedGuides.astro';
import type { Lang } from '../i18n/utils';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  // Static .astro hub pages take precedence over the dynamic [...slug] route
  // in Astro. Without filtering, every hub + event slug for de/es/fr/id/ja/ko/pt
  // generates a "conflicting route" warning (~245 duplicates) and builds dead
  // stub pages shadowed by src/pages/{lang}/*.astro. Skip them here.
  const STATIC_HUBS = new Set([
    'alliance', 'beginners', 'buildings', 'calendar', 'compare', 'economy',
    'era', 'gear', 'heroes', 'might', 'raven', 'status', 'tier-list', 'tips',
    'codes', 'credits', 'support', 'shop', 'atlas', 'infographics', 'patch-notes',
  ]);
  const STATIC_EVENTS = new Set([
    'alliance-duel', 'arena', 'canyon', 'cheese', 'crystal-cluster', 'dwarven-mine',
    'elixir', 'final-dawn', 'kvk', 'mythic', 'pandemic-experience', 'path-to-healing',
    'quiz-of-wisdom', 'royal', 'strike-first', 'supreme-duel', 'supreme-healer',
    'survival', 'thief', 'undead', 'wagon',
  ]);
  const STATIC_LANGS = new Set(['de', 'es', 'fr', 'id', 'ja', 'ko', 'pt']);
  return guides
    .filter((entry) => {
      const [lang, ...rest] = entry.id.split('/');
      const slug = rest.join('/').replace(/\.md$/, '');
      if (!STATIC_LANGS.has(lang)) return true;
      if (STATIC_HUBS.has(slug)) return false;
      if (slug.startsWith('events/')) {
        const ev = slug.split('/')[1];
        if (ev === 'index' || STATIC_EVENTS.has(ev)) return false;
      }
      return true;
    })
    .map((entry) => {
      const [lang, ...rest] = entry.id.split('/');
      const slug = rest.join('/').replace(/\.md$/, '');
      // English is the default language: served at /{slug}/
      // Others: /{lang}/{slug}/
      const url = lang === 'en' ? `/${slug}/` : `/${lang}/${slug}/`;
      return {
        params: { slug: url.replace(/^\//, '').replace(/\/$/, '') },
        props: { entryId: entry.id, lang, slug },
      };
    });
}

interface Props {
  entryId: string;
  lang: Lang;
  slug: string;
}

const { entryId, lang, slug } = Astro.props;
const entry = await getEntry('guides', entryId);
if (!entry) return Astro.rewrite('/404');
const { Content } = await render(entry);

const all = await getCollection('guides');
const supportedLangs = [...new Set(all.filter(e => e.id.replace(/\.md$/, '').split('/').slice(1).join('/') === slug).map(e => e.id.split('/')[0] as Lang))];
const data = entry.data as any;
const path = lang === 'en' ? `/${slug}/` : `/${lang}/${slug}/`;
const showDiscord = slug !== 'support' && slug !== 'credits';

// "Read next" cross-links: hub-aware picks resolved against the content
// collection (current lang, EN fallback) so cards never point at a 404.
const RELATED: Record<string, string[]> = {
  beginners: ['buildings', 'economy', 'tier-list'],
  buildings: ['economy', 'might', 'calendar'],
  alliance: ['events/alliance-duel', 'events/kvk', 'calendar'],
  economy: ['buildings', 'tips', 'events/wagon'],
  heroes: ['tier-list', 'gear', 'compare'],
  gear: ['heroes', 'economy', 'tier-list'],
  might: ['heroes', 'gear', 'buildings'],
  raven: ['heroes', 'economy', 'gear'],
  era: ['calendar', 'events/kvk', 'might'],
  tips: ['beginners', 'economy', 'events/quiz-of-wisdom'],
  calendar: ['events/alliance-duel', 'era', 'tips'],
  'tier-list': ['heroes', 'compare', 'gear'],
  compare: ['heroes', 'tier-list', 'gear'],
  'alliance-league': ['alliance', 'events/alliance-duel', 'calendar'],
  'alliance-tech': ['alliance', 'buildings', 'calendar'],
  'alliance-expedition': ['alliance', 'calendar', 'tips'],
  'alliance-dig': ['alliance', 'economy', 'tips'],
};
const relatedSlugs =
  RELATED[slug] ?? (slug.startsWith('events/') ? ['calendar', 'alliance', 'tips'] : ['guides']);
const relatedItems: RelatedItem[] = relatedSlugs.flatMap((s) => {
  // Note: collection entry ids carry no .md extension (e.g. "en/economy").
  const hit =
    all.find((e) => e.id === `${lang}/${s}`) ?? all.find((e) => e.id === `en/${s}`);
  if (!hit) return [];
  const d = hit.data as any;
  const hitLang = hit.id.split('/')[0];
  return [
    {
      title: d.title as string,
      url: hitLang === 'en' ? `/${s}/` : `/${hitLang}/${s}/`,
      description: d.description as string | undefined,
    },
  ];
});

// Breadcrumbs: section-aware so /alliance/* reference blocks don't all read «Alliance».
// Top-level hub -> single crumb; sub-article -> hub + page; events -> Events + page.
const prefix = lang === 'en' ? '' : `/${lang}`;
const HUB_LABELS: Record<string, Record<string, string>> = {
  alliance: { en: 'Alliance', ru: 'Альянс', ar: 'التحالف', it: 'Alleanza', ms: 'Pakatan', nl: 'Alliantie', th: 'พันธมิตร', tr: 'İttifak', vi: 'Liên minh', zh: '联盟' },
  beginners: { en: 'Beginners', ru: 'Новичкам', ar: 'للمبتدئين', it: 'Principianti', ms: 'Pemula', nl: 'Beginners', th: 'ผู้เริ่มต้น', tr: 'Yeni Başlayanlar', vi: 'Người mới bắt đầu', zh: '新手指南' },
  buildings: { en: 'Buildings', ru: 'Здания', ar: 'المباني', it: 'Edifici', ms: 'Bangunan', nl: 'Gebouwen', th: 'สิ่งก่อสร้าง', tr: 'Binalar', vi: 'Công trình', zh: '建筑' },
  economy: { en: 'Economy', ru: 'Экономика', ar: 'الاقتصاد', it: 'Economia', ms: 'Ekonomi', nl: 'Economie', th: 'เศรษฐกิจ', tr: 'Ekonomi', vi: 'Kinh tế', zh: '经济' },
  heroes: { en: 'Heroes', ru: 'Герои', ar: 'الأبطال', it: 'Eroi', ms: 'Wira', nl: 'Helden', th: 'ฮีโร่', tr: 'Kahramanlar', vi: 'Anh hùng', zh: '英雄' },
  events: { en: 'Events', ru: 'События', ar: 'الفعاليات', it: 'Eventi', ms: 'Acara', nl: 'Evenementen', th: 'กิจกรรม', tr: 'Etkinlikler', vi: 'Sự kiện', zh: '活动' },
  era: { en: 'Era of Rebirth', ru: 'Эра Возрождения', ar: 'Era of Rebirth', it: 'Era of Rebirth', ms: 'Era of Rebirth', nl: 'Era of Rebirth', th: 'Era of Rebirth', tr: 'Era of Rebirth', vi: 'Era of Rebirth', zh: '重生纪元' },
  gear: { en: 'Gear', ru: 'Снаряжение', ar: 'العتاد', it: 'Equipaggiamento', ms: 'Peralatan', nl: 'Uitrusting', th: 'อุปกรณ์', tr: 'Ekipman', vi: 'Trang bị', zh: '装备' },
  might: { en: 'Might', ru: 'Мощь', ar: 'القوة', it: 'Potenza', ms: 'Kekuatan', nl: 'Kracht', th: 'พลัง', tr: 'Güç', vi: 'Sức mạnh', zh: '战力' },
  raven: { en: 'Raven', ru: 'Ворон', ar: 'Raven', it: 'Raven', ms: 'Raven', nl: 'Raven', th: 'Raven', tr: 'Raven', vi: 'Raven', zh: '乌鸦' },
  tips: { en: 'Tips', ru: 'Советы', ar: 'نصائح', it: 'Suggerimenti', ms: 'Petua', nl: 'Tips', th: 'เคล็ดลับ', tr: 'İpuçları', vi: 'Mẹo', zh: '小贴士' },
  calendar: { en: 'Calendar', ru: 'Календарь', ar: 'التقويم', it: 'Calendario', ms: 'Kalendar', nl: 'Kalender', th: 'ปฏิทิน', tr: 'Takvim', vi: 'Lịch', zh: '日历' },
  'tier-list': { en: 'Tier List', ru: 'Тир-лист', ar: 'قائمة المستويات', it: 'Tier List', ms: 'Senarai Tier', nl: 'Tierlijst', th: 'Tier List', tr: 'Kademe Listesi', vi: 'Bảng xếp hạng', zh: '强度榜' },
  guides: { en: 'Guides', ru: 'Гайды', ar: 'جميع الأدلة', it: 'Tutte le guide', ms: 'Semua panduan', nl: 'Alle gidsen', th: 'คู่มือทั้งหมด', tr: 'Tüm rehberler', vi: 'Tất cả hướng dẫn', zh: '所有攻略' },
  'alliance-league': { en: 'Alliance League', ru: 'Лига альянсов', ar: 'دوري التحالف', it: 'Lega delle Alleanze', ms: 'Liga Pakatan', nl: 'Alliantiecompetitie', th: 'ลีกพันธมิตร', tr: 'İttifak Ligi', vi: 'Giải đấu Liên minh', zh: '联盟联赛' },
  'alliance-tech': { en: 'Alliance Tech', ru: 'Технологии альянса', ar: 'تكنولوجيا التحالف', it: 'Tecnologia Alleanza', ms: 'Teknologi Pakatan', nl: 'Alliantietechnologie', th: 'เทคโนโลยีพันธมิตร', tr: 'İttifak Teknolojisi', vi: 'Công nghệ Liên minh', zh: '联盟科技' },
  'alliance-expedition': { en: 'Alliance Expedition', ru: 'Экспедиция альянса', ar: 'بعثة التحالف', it: 'Spedizione Alleanza', ms: 'Ekspedisi Pakatan', nl: 'Alliantie-expeditie', th: 'การสำรวจของพันธมิตร', tr: 'İttifak Seferi', vi: 'Viễn chinh Liên minh', zh: '联盟远征' },
  'alliance-dig': { en: 'Alliance Digs', ru: 'Раскопки альянса', ar: 'تنقيب التحالف', it: 'Scavi Alleanza', ms: 'Galian Pakatan', nl: 'Alliantie-opgravingen', th: 'การขุดของพันธมิตร', tr: 'İttifak Kazıları', vi: 'Khai thác Liên minh', zh: '联盟挖掘' },
};
const hubLabel = (hub: string) =>
  HUB_LABELS[hub]?.[lang] ?? HUB_LABELS[hub]?.['en'] ?? hub;
const parts = slug.split('/');
const ALLIANCE_SUBS = new Set(['alliance-league', 'alliance-tech', 'alliance-expedition', 'alliance-dig']);
let breadcrumbs: { label: string; href?: string }[] = [];
if (ALLIANCE_SUBS.has(slug)) {
  breadcrumbs = [
    { label: hubLabel('alliance'), href: `${prefix}/alliance/` },
    { label: data.title },
  ];
} else if (parts.length === 1) {
  breadcrumbs = [{ label: hubLabel(parts[0]) }];
} else if (parts[0] === 'events') {
  breadcrumbs = [
    { label: hubLabel('events'), href: `${prefix}/events/` },
    { label: data.title },
  ];
} else if (parts[0] === 'beginners' || parts[0] === 'buildings') {
  breadcrumbs = [
    { label: hubLabel(parts[0]), href: `${prefix}/${parts[0]}/` },
    { label: data.title },
  ];
} else {
  breadcrumbs = [
    { label: hubLabel(parts[0]), href: `${prefix}/${parts[0]}/` },
    { label: data.title },
  ];
}
// FAQ hubs: tips always + collective hubs that win from 3-4 Q&A (events, alliance, beginners, calendar)
const showFaq =
  slug === 'tips' ||
  slug === 'alliance' ||
  slug === 'beginners' ||
  slug === 'calendar' ||
  slug === 'heroes' ||
  slug.startsWith('events/');
---

<Base lang={lang} path={path} title={data.title} description={data.description} langs={supportedLangs}>
  {data.noindex && <meta slot="head" name="robots" content="noindex, nofollow" />}
  {!data.noindex && data.updated && (
    <script
      slot="head"
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: data.title,
        description: data.description,
        inLanguage: lang,
        dateModified: data.updated,
        mainEntityOfPage: { '@type': 'WebPage', '@id': path },
        publisher: { '@type': 'Organization', name: 'Last Asylum Plague Hub' },
      })}
    />
  )}
  <GuidePage title={data.title} description={data.description} lang={lang} breadcrumbs={breadcrumbs}>
    {data.updated && (
      <p class="mb-4 text-xs text-stone-500">
        🗓 {lang === 'ru' ? 'Обновлено' : 'Updated'}: {data.updated}
      </p>
    )}

    {slug === 'alliance' && (
      <div class="not-prose mb-10">
        <GuildHub lang={lang} />
      </div>
    )}

    <Content />

    {slug === 'guides' && (
      <div class="not-prose">
        <GuidesIndex lang={lang} />
      </div>
    )}

    {data.calculators?.map((c: string) => <Calculators calc={c as any} lang={lang} />)}

    {data.infographics?.map((i: string) => (
      <Infographic src={i} alt="Guide infographic" />
    ))}

    {data.videoTopic && <VideoSection topic={data.videoTopic} lang={lang} />}

    {slug === 'events/alliance-duel' && (
      <>
        <AllianceDuelCalc lang={lang} />
        <TroopCalc lang={lang} />
      </>
    )}

    {slug === 'calendar' && (
      <>
        <MonumentTimeline lang={lang} />
        <DailyChecklist lang={lang} />
        <WeeklyCheatSheet lang={lang} />
      </>
    )}

    {slug === 'buildings' && <SanctuaryCalc lang={lang} />}

    {slug === 'gear' && <GearCalc lang={lang} />}

    {slug === 'tier-list' && <TierListGrid lang={lang} />}

    {(slug === 'heroes' || slug === 'compare') && <PvPMatrix lang={lang} />}

    {slug === 'compare' && <HeroCompare lang={lang} />}

    {slug === 'heroes' && <SquadQuiz lang={lang} />}

    {slug === 'heroes' && <SquadBuilder lang={lang} />}

    {slug === 'events/quiz-of-wisdom' && <QuizSearch lang={lang} />}

    {slug === 'alliance' && (
      <>
        <AllianceRanksGuide lang={lang} />
        <AllianceTechTree lang={lang} />
        <MonsterRadar lang={lang} />
      </>
    )}
    {slug === 'era' && (
      <>
        <AgeOfRebirthGuide lang={lang} />
        <LordJobsGuide lang={lang} />
      </>
    )}
    {slug === 'events/elixir' && <ElixirFortsGuide lang={lang} />}
    {(slug === 'economy' || slug === 'events/canyon') && <CrystalMineGuide lang={lang} />}
    {(slug === 'economy' || slug === 'beginners') && <VipCalculator lang={lang} />}
    {(slug === 'economy' || slug === 'beginners') && <SurvivorsGuide lang={lang} />}
    {(slug === 'economy' || slug === 'might') && <CollegeTechExplorer lang={lang} />}
    {slug === 'might' && (
      <>
        <LordJobsGuide lang={lang} />
        <TroopProgression lang={lang} />
      </>
    )}
    {(slug === 'might' || slug === 'gear') && <HeroGearGuide lang={lang} />}
    {slug === 'beginners' && <MonsterRadar lang={lang} />}
    {slug === 'raven' && <RavenSystem lang={lang} />}
    {slug === 'tips' && (
      <>
        <OfficialTipsWidget lang={lang} />
        <QuizSearch lang={lang} />
      </>
    )}

    {showFaq && <FaqSection lang={lang} />}

    {slug === 'heroes' && <ShopPromoBanner variant="marlena" lang={lang} />}
    {slug === 'buildings' && <ShopPromoBanner variant="speedup" lang={lang} />}
    {slug === 'gear' && <ShopPromoBanner variant="gear" lang={lang} />}
    {slug === 'beginners' && <ShopPromoBanner variant="general" lang={lang} />}

    {slug !== 'guides' && relatedItems.length > 0 && (
      <RelatedGuides lang={lang} items={relatedItems} />
    )}

    {showDiscord && <DiscordBanner lang={lang} />}
  </GuidePage>
</Base>