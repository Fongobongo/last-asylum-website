---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import GuidePage from '../components/GuidePage.astro';
import VideoSection from '../components/VideoSection.astro';
import Calculators from '../components/Calculators.astro';
import Infographic from '../components/Infographic.astro';
import DiscordBanner from '../components/DiscordBanner.astro';
import ShopPromoBanner from '../components/ShopPromoBanner.astro';
import AllianceDuelCalc from '../components/AllianceDuelCalc.astro';
import SquadBuilder from '../components/SquadBuilder.astro';
import DailyChecklist from '../components/DailyChecklist.astro';
import WeeklyCheatSheet from '../components/WeeklyCheatSheet.astro';
import SanctuaryCalc from '../components/SanctuaryCalc.astro';
import PvPMatrix from '../components/PvPMatrix.astro';
import SquadQuiz from '../components/SquadQuiz.astro';
import QuizSearch from '../components/QuizSearch.astro';
import FaqSection from '../components/FaqSection.astro';
import GuildHub from '../components/GuildHub.astro';
import MonumentTimeline from '../components/MonumentTimeline.astro';
import VipCalculator from '../components/VipCalculator.astro';
import TroopProgression from '../components/TroopProgression.astro';
import RavenSystem from '../components/RavenSystem.astro';
import AllianceTechTree from '../components/AllianceTechTree.astro';
import OfficialTipsWidget from '../components/OfficialTipsWidget.astro';
import type { Lang } from '../i18n/utils';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((entry) => {
    const [lang, ...rest] = entry.id.split('/');
    const slug = rest.join('/').replace(/\.md$/, '');
    // English is the default language: served at /{slug}/
    // Others: /{lang}/{slug}/
    const url = lang === 'en' ? `/${slug}/` : `/${lang}/${slug}/`;
    return {
      params: { slug: url.replace(/^\//, '').replace(/\/$/, '') },
      props: { entryId: entry.id, lang, slug },
    };
  });
}

interface Props {
  entryId: string;
  lang: Lang;
  slug: string;
}

const { entryId, lang, slug } = Astro.props;
const entry = await getEntry('guides', entryId);
if (!entry) return Astro.rewrite('/404');
const { Content } = await render(entry);

const data = entry.data as any;
const path = lang === 'en' ? `/${slug}/` : `/${lang}/${slug}/`;
const showDiscord = slug !== 'support' && slug !== 'credits';
---

<Base lang={lang} path={path} title={data.title} description={data.description}>
  {data.noindex && <meta slot="head" name="robots" content="noindex, nofollow" />}
  <GuidePage title={data.title} description={data.description} lang={lang}>
    {data.updated && (
      <p class="mb-4 text-xs text-stone-500">
        🗓 {lang === 'ru' ? 'Обновлено' : 'Updated'}: {data.updated}
      </p>
    )}

    {slug === 'alliance' && (
      <div class="not-prose mb-10">
        <GuildHub lang={lang} />
      </div>
    )}

    <Content />

    {data.calculators?.map((c: string) => <Calculators calc={c as any} lang={lang} />)}

    {data.infographics?.map((i: string) => (
      <Infographic src={i} alt="Guide infographic" />
    ))}

    {data.videoTopic && <VideoSection topic={data.videoTopic} lang={lang} />}

    {slug === 'events/alliance-duel' && <AllianceDuelCalc lang={lang} />}

    {slug === 'calendar' && (
      <>
        <MonumentTimeline lang={lang} />
        <DailyChecklist lang={lang} />
        <WeeklyCheatSheet lang={lang} />
      </>
    )}

    {slug === 'buildings' && <SanctuaryCalc lang={lang} />}

    {(slug === 'heroes' || slug === 'compare') && <PvPMatrix lang={lang} />}

    {slug === 'heroes' && <SquadQuiz lang={lang} />}

    {slug === 'heroes' && <SquadBuilder lang={lang} />}

    {slug === 'events/quiz-of-wisdom' && <QuizSearch lang={lang} />}

    {slug === 'alliance' && <AllianceTechTree lang={lang} />}
    {(slug === 'economy' || slug === 'beginners') && <VipCalculator lang={lang} />}
    {slug === 'might' && <TroopProgression lang={lang} />}
    {slug === 'raven' && <RavenSystem lang={lang} />}
    {slug === 'tips' && <OfficialTipsWidget lang={lang} />}

    {slug === 'tips' && <FaqSection lang={lang} />}

    {slug === 'heroes' && <ShopPromoBanner variant="marlena" lang={lang} />}
    {slug === 'buildings' && <ShopPromoBanner variant="speedup" lang={lang} />}
    {slug === 'gear' && <ShopPromoBanner variant="gear" lang={lang} />}
    {slug === 'beginners' && <ShopPromoBanner variant="general" lang={lang} />}

    {showDiscord && <DiscordBanner lang={lang} />}
  </GuidePage>
</Base>