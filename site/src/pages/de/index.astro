---
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'de';

const sections = [
  { href: '/de/beginners/', icon: '🌱', title: 'Anfänger-Guide', key: 'home.sections.beginners.desc', color: 'from-green-900/40' },
  { href: '/de/buildings/', icon: '🏰', title: 'Gebäude', key: 'home.sections.buildings.desc', color: 'from-amber-900/40' },
  { href: '/de/heroes/', icon: '⚔️', title: 'Helden', key: 'home.sections.heroes.desc', color: 'from-red-900/40' },
  { href: '/de/economy/', icon: '💰', title: 'Wirtschaft', key: 'home.sections.economy.desc', color: 'from-yellow-900/40' },
  { href: '/de/raven/', icon: '🐦‍⬛', title: 'Rabe und Epigraphe', key: 'home.sections.raven.desc', color: 'from-purple-900/40' },
  { href: '/de/era/', icon: '☣️', title: 'Ära der Wiedergeburt', key: 'home.sections.era.desc', color: 'from-lime-900/40' },
  { href: '/de/codes/', icon: '🎁', title: 'Geschenkcodes', key: 'home.sections.codes.desc', color: 'from-toxic-900/40' },
  { href: '/de/patch-notes/', icon: '📜', title: 'Patch Notes', key: 'home.sections.patchnotes.desc', color: 'from-stone-700/40' },
];

const popular = [
  { href: '/de/beginners/', title: 'Deine ersten 24 Stunden', desc: 'Die Day-One-Checkliste, die über dein gesamtes Konto entscheidet.' },
  { href: '/de/economy/', title: 'Diamant- und Shop-Prioritäten', desc: 'Die exakte Kaufreihenfolge für jeden Shop — und was du nie kaufen solltest.' },
  { href: '/de/heroes/', title: 'Das F2P-Truppentrio', desc: 'Arthur, Daskal, Marlena, Harper, Claire — der kanonische Weg.' },
  { href: '/de/events/undead/', title: 'Untoten-Belagerung', desc: 'Die versteckte 2-Truppen-Mechanik pro Welle, die 9.5M-Spieler tötet.' },
  { href: '/de/events/alliance-duel/', title: 'Allianz-Duell', desc: 'Schriftrollen für Phase 3, Splitter für Phase 4, Beschleunigungen für Phase 5 sparen.' },
  { href: '/de/era/', title: 'Claire SSR→UR', desc: 'Überspringe den 6★–9★-Einbruch mit Ehrenhalle-Stufen.' },
];
---

<Base lang={lang} path="/de/">
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-stone-800">
    <div class="absolute inset-0 bg-gradient-to-b from-plague-950/80 to-transparent"></div>
    <div class="relative py-20 sm:py-28">
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-toxic-400">Last Asylum: Plague — Fan Hub</p>
      <h1 class="mb-5 text-4xl font-bold tracking-tight text-plague-100 sm:text-6xl">
        Überlebe die Seuche
      </h1>
      <p class="mb-8 max-w-2xl text-lg leading-relaxed text-stone-300">
        Die Wissensdatenbank der Community: Wege für Anfänger, Bauprioritäten, F2P-Strategien, Shop-Prioritäten und komplette Event-Analysen — alles aus den offiziellen Discord-Guides zusammengetragen und von Spielern verifiziert.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/de/beginners/" class="rounded-lg bg-plague-700 px-6 py-3 font-semibold text-plague-50 hover:bg-plague-600 transition-colors">
          Guides ansehen →
        </a>
        <a href="/de/events/" class="rounded-lg border border-stone-700 px-6 py-3 font-semibold text-stone-200 hover:bg-stone-800 transition-colors">
          Event-Guides →
        </a>
      </div>
    </div>
  </section>

  <!-- Sections grid -->
  <section class="py-14">
    <h2 class="mb-8 text-2xl font-bold text-plague-200">Guides</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {sections.map((s) => (
        <a href={s.href} class={`group rounded-xl border border-stone-800 bg-gradient-to-br ${s.color} to-stone-900 p-6 transition-colors hover:border-plague-500`}>
          <span class="text-3xl">{s.icon}</span>
          <h3 class="mt-3 text-lg font-bold text-plague-200 group-hover:text-plague-100">{s.title}</h3>
          <p class="mt-2 text-sm text-stone-400">{t(lang, s.key as any)}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Events banner -->
  <section class="mb-14 rounded-xl border border-plague-800 bg-plague-950/50 p-8">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-plague-200">⚔️ Events</h2>
        <p class="mt-1 text-stone-400">Allianz-Duell, KvK, Untoten-Belagerung und alle anderen Events.</p>
      </div>
      <a href="/de/events/" class="rounded-lg bg-plague-700 px-5 py-2.5 font-semibold text-plague-50 hover:bg-plague-600 transition-colors">
        Event-Guides →
      </a>
    </div>
  </section>

  <!-- Popular guides -->
  <section class="mb-16">
    <h2 class="mb-8 text-2xl font-bold text-plague-200">Beliebte Guides</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {popular.map((p) => (
        <a href={p.href} class="group rounded-lg border border-stone-800 bg-stone-900 p-5 transition-colors hover:border-plague-600">
          <h3 class="font-bold text-stone-100 group-hover:text-plague-200">{p.title}</h3>
          <p class="mt-2 text-sm text-stone-400">{p.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Support banner -->
  <section class="mb-16 rounded-xl border border-stone-800 bg-stone-900 p-8">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-plague-200">❤️ Uns unterstützen</h2>
        <p class="mt-1 text-stone-400">Unterstütze das Projekt und erhalte Gegenwert im Spiel.</p>
      </div>
      <a href="/de/support/" class="rounded-lg bg-blood-600 px-5 py-2.5 font-semibold text-white hover:bg-blood-500 transition-colors">
        Uns unterstützen →
      </a>
    </div>
  </section>
</Base>
