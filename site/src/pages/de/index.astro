  { href: '/de/might/', title: 'Macht-Formel & Wachstumsstrategie', desc: 'Offizieller Guide: Gegengift-Farmen, Ausrüstungs-Promotion bis Stufe 60 und echte Kampfkraft.' },
  { href: '/de/alliance/', title: 'Allianz-System-Guide', desc: 'Allianz-Hilfe-Formeln, Tech-Spenden, Stufe 25 Geschenk-Privileg und R4/R5-Rollen.' },
  { href: '/de/events/supreme-duel/', title: 'Oberstes Duell (Supreme Duel)', desc: '16-Kriegszonen-Turnier: 3-Trupps Best-of-3, verlustfreie Gefechte, Wettmünzen und Champion-Belohnungen.' },
  { href: "/de/tips/", title: "Verborgene Mechaniken & Tipps", desc: "Snap-Shotting, Geister-Rallyes, Spital-Überlauf und Pre-Farming-Tricks." },
