---
import Base from '../layouts/Base.astro';
import GuidePage from '../components/GuidePage.astro';
import GiftCodes from '../components/GiftCodes.astro';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/utils';

const lang: Lang = 'en';
---

<Base lang={lang} path="/codes/" title="Gift Codes" description="Active and working gift codes for Last Asylum: Plague.">
  <GuidePage title={`🎁 ${t(lang, 'codes.title')}`} description={t(lang, 'codes.desc')} lang={lang}>
    <p class="text-sm text-stone-300 mt-2">Full redemption guide — <a href="#how-to-redeem" class="text-toxic-400 underline">below on this page ↓</a></p>

    <h2 id="latest-codes">{t(lang, 'codes.active')}</h2>
    <GiftCodes lang={lang} />

    <h2 id="how-to-redeem">{t(lang, 'codes.redeem')}</h2>
    <h3 class="mt-6">🤖 Android</h3>
    <p>{t(lang, 'codes.redeem.android')}</p>
    <h3 class="mt-4">🍏 iOS</h3>
    <p>{t(lang, 'codes.redeem.ios')}</p>

    <h2 id="notes">{t(lang, 'codes.note')}</h2>
    <p>Codes are region-free but usually one-per-account.</p>
  </GuidePage>
</Base>