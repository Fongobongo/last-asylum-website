---
import Base from '../../layouts/Base.astro';
import GuidePage from '../../components/GuidePage.astro';
import DiscordBanner from '../../components/DiscordBanner.astro';
import { heroTiers, tierColors } from '../../data/tiers';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'ru';
const tiers: ('S' | 'A' | 'B' | 'C')[] = ['S', 'A', 'B', 'C'];
---

<Base lang={lang} path="/tier-list/" title="Тир-лист героев" description="Тир-лист героев Last Asylum: Plague — ранги S/A/B/C с контекстом F2P-прогрессии.">
  <GuidePage
    title="🏆 Тир-лист героев"
    description="Консенсус сообщества, взвешенный под типичный путь F2P / умеренного донатера. Контекст важен: «B»-SSR, который у тебя уже есть, лучше «S»-UR, который появится через три месяца."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/ru/' }, { label: 'Тир-лист' }]}
  >
    <p>Составлено по гайдам составов отрядов, разборам боссов и PvP-тредам официального Discord. Тиры отражают <strong>общую ценность для аккаунта</strong>, а не голые статы.</p>

    {tiers.map((tier) => (
      <section class="not-prose my-6">
        <h3 class={`mb-3 inline-block rounded-lg border px-3 py-1 text-xl font-bold ${tierColors[tier]}`}>
          {tier} тир
        </h3>
        <div class="grid gap-3 sm:grid-cols-2">
          {heroTiers.filter((h) => h.tier === tier).map((h) => (
            <div class="rounded-lg border border-stone-800 bg-stone-900 p-4">
              <div class="flex items-baseline justify-between gap-2">
                <p class="font-bold text-plague-200">{h.name}</p>
                <span class="text-xs text-stone-500">{h.rarity} · {h.faction} · {h.class}</span>
              </div>
              <p class="mt-1 text-sm text-stone-400">{h.note}</p>
            </div>
          ))}
        </div>
      </section>
    ))}

    <h2 id="how-to-read">Как читать тир-лист</h2>
    <ul>
      <li><strong>S</strong> — долгосрочные кэрри-инвестиции: качай первыми, навсегда в отряде</li>
      <li><strong>A</strong> — сильные кэрри и ивентовые герои: качай, когда S-ядро стабильно</li>
      <li><strong>B</strong> — ситуативные/бюджетные: хороши, пока строишь S/A-ростер, в босс-компах или моно-фракциях</li>
      <li><strong>C</strong> — только очень ранние заглушки</li>
    </ul>
    <blockquote>Моно-фракционная мета: UR-эпиграфы бафают ОДНУ фракцию. 3 героя одной фракции = +5%, 4 = +15%, 5 = +20% HP/ATK/DEF. Контры: Warrior > Warlock > Ranger > Warrior.</blockquote>

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>