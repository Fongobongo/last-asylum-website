---
import Base from '../../../layouts/Base.astro';
import HeroCodexDetail from '../../../components/HeroCodexDetail.astro';
import { heroCodex } from '../../../data/heroCodex';
import type { Lang } from '../../../i18n/utils';
import officialHeroesData from '../../../data/officialHeroes.json';

const lang: Lang = 'ru';

export function getStaticPaths() {
  return heroCodex.map((hero) => ({
    params: { slug: hero.slug },
    props: { hero },
  }));
}

const { hero } = Astro.props;
const officialData = hero.officialId ? (officialHeroesData as any)[hero.officialId.toString()] : null;
const heroDisplayName = officialData?.names?.[lang] || hero.names?.[lang] || hero.name;
---

<Base
  lang={lang}
  path={`/ru/codex/${hero.slug}/`}
  title={`${heroDisplayName} — гайд и официальные навыки героя`}
  description={hero.role}
>
  <HeroCodexDetail
    hero={hero}
    lang={lang}
    breadcrumbs={[
      { label: 'Главная', href: '/ru/' },
      { label: 'Кодекс героев', href: '/ru/codex/' },
      { label: heroDisplayName }
    ]}
  />
</Base>