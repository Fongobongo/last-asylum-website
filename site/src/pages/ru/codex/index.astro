---
import Base from '../../../layouts/Base.astro';
import GuidePage from '../../../components/GuidePage.astro';
import CodexGrid from '../../../components/CodexGrid.astro';
import DiscordBanner from '../../../components/DiscordBanner.astro';
import { heroCodex } from '../../../data/heroCodex';
import { t } from '../../../i18n/ui';
import type { Lang } from '../../../i18n/utils';

const lang: Lang = 'ru';
const base = lang === 'en' ? '' : `/${lang}`;
---

<Base lang={lang} path="/codex/" title="Кодекс героев" description="Все ключевые герои Last Asylum: Plague — навыки, билды, составы и способы получения.">
  <GuidePage
    title="📖 Кодекс героев"
    description="Навыки, приоритеты прокачки и командные заметки по каждому значимому герою — из гайдов сообщества."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/ru/' }, { label: 'Кодекс героев' }]}
  >
    <p>На каждой странице: роль героя, способ получения, действительно важные навыки, приоритеты прокачки и составы, где он используется. Для рангов смотри <a href="/ru/tier-list/">тир-лист</a>.</p>

    <CodexGrid heroes={heroCodex} lang={lang} base={base} />

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>