---
import Base from '../../../layouts/Base.astro';
import { t } from '../../../i18n/ui';
import type { Lang } from '../../../i18n/utils';

const lang: Lang = 'ru';
const events = [
  { slug: 'alliance-duel', name: 'Дуэль альянсов', icon: '⚔️', desc: 'Шестидневное соревнование альянсов с ежедневными категориями очков, точными значениями очков и экономикой «копи всё».' },
  { slug: 'elixir', name: 'Битва за эликсир', icon: '🧪', desc: '30-минутное AvA-поле битвы за очки, где побеждает контроль, а не убийства — Лечебные палатки, приоритет замка и правила телепортации.' },
  { slug: 'kvk', name: 'Война королевств (KvK)', icon: '🏰', desc: 'Война сервер против сервера за Королевский город: атаки через башни, оборона на истощение и реальный риск потерять войска.' },
  { slug: 'undead', name: 'Осада зомби', icon: '🧟', desc: 'Оборона альянса против волн заражённых — скрытая механика нескольких отрядов, сохраняющееся HP и вехи наград.' },
  { slug: 'cheese', name: 'Сырная ловушка', icon: '🧀', desc: 'Ралли альянса против гигантской крысы: личные награды за пять фаз, общий пул HP альянса и математика уровней.' },
  { slug: 'thief', name: 'Охота на воров', icon: '💰', desc: 'Тратим выносливость на боссов Вожаков воров — механика спавна, техника непрерывных убийств и приоритеты обмена.' },
  { slug: 'survival', name: 'Битва выживания', icon: '🛡️', desc: 'Еженедельное ивент-событие с миссиями на ~60 000 бесплатных значков навыков — дешёвые выполнения и пересечение с Дуэлью альянсов.' },
  { slug: 'canyon', name: 'Захват каньона', icon: '🏜️', desc: 'Трёхлейновая эстафетная битва, где выносливость бьёт силу — стратегия приоритетов лейнов в событии без риска.' },
  { slug: 'mythic', name: 'Мифическое сокровище', icon: '🗺️', desc: 'Пиратский ивент из семи вкладок, разобранный для F2P: приоритеты рынка, лимит 300 рыб и игра «Сокровища в земле».' },
  { slug: 'royal', name: 'Королевская схватка', icon: '👑', desc: 'Еженедельная гонка за захват замка — один марш на игрока, подкрепление на 30 слотов и полная система титулов Королевского города.' },
  { slug: 'arena', name: 'Треугольная арена', icon: '🔺', desc: 'Три состава, атакующий выбирает два, чтобы победить — равная оборона, жертва-матчап и ловушка-отряд на Арене судьбы.' },
  { slug: 'wagon', name: 'Гильдейский вагон и караваны', icon: '🚚', desc: 'Ежедневные бесплатные вагоны, правила сундуков Стражей, освежения Золотого вагона и фарм UR-осколков в караванах.' },
  { slug: 'supreme-healer', name: 'Лучший целитель', icon: '🩺', desc: '7-дневный соревновательный график набора очков, распределение ресурсов по дням, стакинг выносливости и антитоксина.' },
];
---
<Base lang={lang} path="/ru/events/" title="Гайды по событиям" description="Полные разборы всех событий Last Asylum: Plague: расписания, очки, стратегия и ошибки, которых стоит избегать.">
  <section class="py-12">
    <h1 class="mb-3 text-4xl font-bold text-plague-100">Гайды по событиям</h1>
    <p class="mb-10 text-lg text-stone-400">Полные разборы всех событий: расписания, очки, стратегия и ошибки.</p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {events.map(e => (
        <a href={`/ru/events/${e.slug}/`} class="group rounded-lg border border-stone-800 bg-stone-900 p-5 transition-colors hover:border-plague-600">
          <span class="text-3xl">{e.icon}</span>
          <h2 class="mt-3 text-lg font-bold text-plague-200 group-hover:text-plague-100">{e.name}</h2>
          <p class="mt-2 text-sm text-stone-400">{e.desc}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
