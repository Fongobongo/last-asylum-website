---
import Base from '../../layouts/Base.astro';
import GuidePage from '../../components/GuidePage.astro';
import VideoSection from '../../components/VideoSection.astro';
import Infographic from '../../components/Infographic.astro';
import DiscordBanner from '../../components/DiscordBanner.astro';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'ru';
---

<Base lang={lang} path="/gear/" title="Гайд по снаряжению" description="Система снаряжения Last Asylum: Plague — крафти только UR, вехи промоушена, приоритеты слотов и фарм gearstone.">
  <GuidePage
    title="⚔️ Снаряжение: крафт, промоушен, приоритеты"
    description="Правила сообщества по системе гира — что крафтить, что переплавлять, что пропускать и откуда брать материалы."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/ru/' }, { label: 'Снаряжение' }]}
  >
    <h2 id="cardinal-rules">Кардинальные правила</h2>
    <ul>
      <li><strong>Крафти только UR (оранжевое).</strong> Зелень и синева падают бесплатно — никогда не трать материалы на их апгрейд. Устаревший низкоуровневый гир разбирай (dismantle).</li>
      <li><strong>Один отряд за раз.</strong> Для быстрого прогресса одевай только Отряд 1 — мечи и перчатки кэрри, нагрудники и ботинки танкам.</li>
      <li><strong>UR-героям раньше SSR</strong> при раздаче гира.</li>
      <li>Лестница качества: <strong>Золото (UR) &gt; Фиолет (SSR) &gt; Синий (SR) &gt; Зелёный (R) &gt; Серый</strong>.</li>
    </ul>

    <h2 id="slot-priorities">Приоритеты слотов</h2>
    <table class="w-full mb-6 text-sm">
      <tr><th>Роль героя</th><th>Первым</th><th>Вторым</th><th>Заметки</th></tr>
      <tr><td>Кэрри (DPS)</td><td>Оружие (меч)</td><td>Перчатки</td><td>Атака и крит масштабируют урон</td></tr>
      <tr><td>Танк</td><td>Ботинки</td><td>Нагрудник</td><td>HP/DEF держат фронт</td></tr>
      <tr><td>Порядок для кэрри (Annie/Jester)</td><td>Меч → Перчатки → Броня → Ботинки</td><td></td><td>Порядок сообщества для варлок-кэрри</td></tr>
    </table>

    <h2 id="promotion">Промоушен гира (система мая 2026)</h2>
    <p>С обновления мая 2026 снаряжение можно <strong>повышать</strong> (Promotion) за Blueprints на уровнях <strong>10, 20, 30 и 40</strong>, и апгрейдить выше 40 вплоть до <strong>60</strong> — суммарная стоимость материалов осталась прежней. Промоушены открывают дополнительные бонусы; их вехи — главная долгосрочная цель гира.</p>

    <h2 id="boss-gear">Гир против боссов (Demon King)</h2>
    <p>Против боссов, которые не отвечают, обычные правила переворачиваются:</p>
    <ul>
      <li><strong>Оружие: UR-мечи максимального уровня</strong> — «UR +0 даёт больше урона, чем SSR +30» (атака + шанс крита масштабируют базу скиллов)</li>
      <li><strong>Перчатки: SSR, НЕ UR!</strong> SSR-перчатки 30 ур. дают <strong>+12.25% урона по монстрам</strong>, и модификаторы SSR применяются к финальному урону — UR бустают ATK (слабее) и добавляют бесполезное сопротивление урону</li>
      <li><strong>Ботинки и броня неважны</strong> против боссов — любой уровень</li>
    </ul>

    <h2 id="raven-gear">Снаряжение Ворона</h2>
    <p>У Ворона свой сет (левая сторона: HP/снижение крит-урона, правая: ATK/крит-урон). Толкай к <strong>уровню 8</strong>, где включаются процентные бафы. <strong>Сундуки гира Ворона береги до дней Дуэли альянсов</strong> — открытие даёт очки ивента.</p>
    <p>Сеты со спец-эффектами (Night Raven Mask, Raven Feather Cloak) активируются на заданных уровнях частей — добавлены в марте 2026.</p>

    <h2 id="materials">Откуда материалы</h2>
    <ul>
      <li><strong>Gear Workshop</strong> — крафт и разбор; <strong>Smelting Workshop</strong> производит gearstone для уровней; <strong>Weaving Workshop</strong> — ткани для крафта</li>
      <li><strong>Фарм gearstone для F2P:</strong> есть устойчивый маршрут (видео ниже) — gearstone главное узкое место, планируй заранее</li>
      <li><strong>Магазины:</strong> Gear Stones в Sanctuary и Expedition (приоритет 3 покупок)</li>
      <li><strong>Blueprints:</strong> №1 в Honor-магазине — этот магазин существует для чертежей гира (никаких сундуков эпиграфов там)</li>
    </ul>

    <Infographic src="/infographics/skill-scaling.webp" alt="Skill and gear scaling" caption="Масштабирование навыков и гира" credit="HottChoklit" />

    <VideoSection topic="gear" lang={lang} />

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>