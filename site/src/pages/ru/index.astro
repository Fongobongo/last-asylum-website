  { href: '/ru/buildings/', icon: '🏰', title: 'Постройки', key: 'home.sections.buildings.desc', color: 'from-amber-900/40' },
  { href: '/ru/heroes/', icon: '⚔️', title: 'Герои', key: 'home.sections.heroes.desc', color: 'from-red-900/40' },
  { href: '/ru/economy/', icon: '💰', title: 'Экономика', key: 'home.sections.economy.desc', color: 'from-yellow-900/40' },
  { href: '/ru/raven/', icon: '🐦‍⬛', title: 'Ворон и эпиграфы', key: 'home.sections.raven.desc', color: 'from-purple-900/40' },
  { href: '/ru/era/', icon: '☣️', title: 'Эра Возрождения', key: 'home.sections.era.desc', color: 'from-lime-900/40' },
