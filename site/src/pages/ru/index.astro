  { href: '/ru/patch-notes/', icon: '📜', title: 'Патчноуты', key: 'home.sections.patchnotes.desc', color: 'from-stone-700/40' },
  { href: '/ru/calendar/', icon: '📅', title: 'Календарь событий', key: 'home.sections.calendar.desc', color: 'from-indigo-900/40' },
  { href: '/ru/tier-list/', icon: '🏆', title: 'Тир-лист', key: 'home.sections.tierlist.desc', color: 'from-rose-900/40' },
  { href: '/ru/codex/', icon: '📖', title: 'Кодекс героев', key: 'home.sections.codex.desc', color: 'from-cyan-900/40' },
];

const popular = [
  { href: '/ru/beginners/', title: 'Первые 24 часа', desc: 'Чек-лист первого дня, который решает судьбу аккаунта.' },
  { href: '/ru/economy/', title: 'Алмазы и магазины', desc: 'Точный порядок покупок в каждом магазине — и что никогда не покупать.' },
  { href: '/ru/heroes/', title: 'F2P-отряд', desc: 'Arthur, Daskal, Marlena, Harper, Claire — каноничный путь.' },
  { href: '/ru/events/undead/', title: 'Осада зомби', desc: 'Скрытая механика 2 отрядов за волну, убивающая игроков 9.5M.' },
  { href: '/ru/events/alliance-duel/', title: 'Дуэль альянсов', desc: 'Свитки — фаза 3, шарды — фаза 4, ускорения — фаза 5.' },
  { href: '/ru/era/', title: 'Claire SSR→UR', desc: 'Как пропустить провал 6★–9★ через уровни Зала Чести.' },
];
---

<Home lang={lang} path="/ru/" sections={sections} popular={popular} />