import Base from '../layouts/Base.astro';
import GuildHub from '../components/GuildHub.astro';
import type { Lang } from '../i18n/utils';

const lang: Lang = 'en';
---

<Base lang={lang} path="/dnd/" title="Alliance Live Info | Last Asylum" description="Alliance coordination, tactical polls, battle protocols, and event schedules">
  <section class="py-8 sm:py-12">
    <GuildHub lang={lang} />
  </section>
</Base>