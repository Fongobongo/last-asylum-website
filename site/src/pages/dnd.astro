---
// DND gate page: /dnd/
// - Not in sitemap (see sitemap.xml.ts - dnd is excluded)
// - noindex meta
// - Content encrypted at BUILD time with AES-GCM; the browser decrypts
//   with the passphrase the visitor enters. Without the passphrase the
//   build output contains only ciphertext.
import Base from '../layouts/Base.astro';
import type { Lang } from '../i18n/utils';

const lang: Lang = 'en';

// Encrypted payload is generated into public/dnd/payload.enc at build time
// by scripts/encrypt-dnd.mjs (runs in the build pipeline when DND_SECRET is set).
---

<Base lang={lang} path="/dnd/" title="DND" description="Restricted area" noindex={true}>
  <section class="mx-auto max-w-3xl py-16">
    <div id="dnd-locked">
      <h1 class="mb-3 text-3xl font-bold text-plague-100">🛡️ Restricted area</h1>
      <p class="mb-6 text-stone-400">
        This section contains alliance intel. Enter the access phrase to decrypt it.
      </p>
      <div class="rounded-xl border border-stone-800 bg-stone-900 p-6">
        <label class="block">
          <span class="mb-2 block text-sm font-medium text-stone-300">Access phrase</span>
          <input
            id="dnd-key"
            type="password"
            autocomplete="off"
            placeholder="••••••••••••"
            class="w-full rounded-lg border border-stone-700 bg-stone-950 px-4 py-3 text-stone-100 outline-none focus:border-plague-500"
          />
        </label>
        <button
          id="dnd-unlock"
          class="mt-4 rounded-lg bg-plague-700 px-6 py-3 font-semibold text-plague-50 hover:bg-plague-600 transition-colors"
        >
          Unlock
        </button>
        <p id="dnd-error" class="mt-3 hidden text-sm text-red-400">
          Wrong phrase or the payload is missing.
        </p>
      </div>
    </div>

    <div id="dnd-content" class="prose-la hidden"></div>
  </section>
</Base>

<script>
  // ---- AES-GCM decryption (WebCrypto) ----
  // Payload format: base64( salt[16] | iv[12] | ciphertext )
  // Key derivation: PBKDF2-SHA256, 150k iterations, 256-bit key.

  async function deriveKey(pass: string, salt: Uint8Array): Promise<CryptoKey> {
    const enc = new TextEncoder();
    const base = await crypto.subtle.importKey('raw', enc.encode(pass), 'PBKDF2', false, ['deriveKey']);
    return crypto.subtle.deriveKey(
      { name: 'PBKDF2', salt: salt as any, iterations: 150000, hash: 'SHA-256' },
      base,
      { name: 'AES-GCM', length: 256 },
      false,
      ['decrypt']
    );
  }

  async function decrypt(payloadB64: string, pass: string): Promise<string> {
    const raw = Uint8Array.from(atob(payloadB64), (c) => c.charCodeAt(0));
    const salt = raw.slice(0, 16);
    const iv = raw.slice(16, 28);
    const data = raw.slice(28);
    const key = await deriveKey(pass, salt);
    const plain = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: iv as any }, key, data as any);
    return new TextDecoder().decode(plain);
  }

  document.getElementById('dnd-unlock')?.addEventListener('click', async () => {
    const pass = (document.getElementById('dnd-key') as HTMLInputElement)?.value;
    const err = document.getElementById('dnd-error');
    err?.classList.add('hidden');
    try {
      const res = await fetch('/dnd/payload.enc');
      if (!res.ok) throw new Error('no payload');
      const payload = (await res.text()).trim();
      const md = await decrypt(payload, pass);

      // Minimal markdown render (headings, bold, lists, tables stay simple)
      const html = md
        .split(/\n{2,}/)
        .map((block) => {
          if (block.startsWith('### ')) return `<h3>${block.slice(4)}</h3>`;
          if (block.startsWith('## ')) return `<h2>${block.slice(3)}</h2>`;
          if (block.startsWith('# ')) return `<h2>${block.slice(2)}</h2>`;
          if (block.startsWith('- ') || block.startsWith('* ')) {
            const items = block.split('\n').map((l) => `<li>${l.replace(/^[-*] /, '')}</li>`).join('');
            return `<ul>${items}</ul>`;
          }
          if (/^\|/.test(block)) {
            const rows = block.split('\n').filter((r) => !/^\|[\s-|]+\|$/.test(r));
            const cells = rows.map((r) => {
              const tds = r.split('|').slice(1, -1).map((c) => c.trim());
              return `<tr>${tds.map((c) => `<td>${c}</td>`).join('')}</tr>`;
            });
            return `<table>${cells.join('')}</table>`;
          }
          const p = block
            .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
            .replace(/\*(.+?)\*/g, '<em>$1</em>')
            .replace(/`(.+?)`/g, '<code>$1</code>');
          return `<p>${p}</p>`;
        })
        .join('\n');

      document.getElementById('dnd-locked')?.classList.add('hidden');
      const content = document.getElementById('dnd-content');
      if (content) {
        content.innerHTML = html;
        content.classList.remove('hidden');
      }
    } catch {
      err?.classList.remove('hidden');
    }
  });
</script>