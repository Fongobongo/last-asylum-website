---
import Base from '../../../layouts/Base.astro';
import GuidePage from '../../../components/GuidePage.astro';
import VideoSection from '../../../components/VideoSection.astro';
import type { Lang } from '../../../i18n/utils';

const lang: Lang = 'ko';
---

<Base lang={lang} path="/ko/events/strike-first/" title="선제타격 (Strike First): 신규 서버 초반 육성 스프린트" description="신규 서버 스타터 이벤트 «선제타격»(Strike First) 완벽 공략: 성역 마일스톤, 감염자 토벌, 병력 양성 및 초보자가 피해야 할 실수.">
  <GuidePage title="선제타격 (Strike First): 신규 서버 초반 육성 스프린트" description="신규 서버 스타터 이벤트 «선제타격»(Strike First) 완벽 공략: 성역 마일스톤, 감염자 토벌, 병력 양성 및 초보자가 피해야 할 실수." lang={lang}>
    <p>**«선제타격»(Strike First)** 이벤트는 신규 서버에서 시작하는 사령관을 위한 핵심 스타트업 이벤트입니다. 기지 발전, 병력 훈련, 몬스터 토벌을 통해 대량의 다이아와 모집 티켓, 영웅 조각을 지급합니다.</p>

    <h2 id="milestones">퀘스트 및 마일스톤 구성</h2>
    <ul>
      <li><strong>성역 마일스톤:</strong> 성역을 5, 8, 10, 12, 15레벨로 올려 대량의 자원과 가속 아이템 획득.</li>
      <li><strong>감염자 정화:</strong> 자연 회복 스태미나로 필드 언데드 토벌.</li>
      <li><strong>군사 동원:</strong> T1~T3 병력 훈련 및 막사 확장.</li>
      <li><strong>주점 모집:</strong> 티켓을 소모하여 셀리아, 벨라, 아서 획득.</li>
      <li><strong>운명의 투기장:</strong> 투기장 대전 참여 및 랭킹 점수 획득.</li>
    </ul>

    <h2 id="rewards">마일스톤 보상</h2>
    <p>5,000개 이상의 무료 다이아, 20장 이상의 고급 모집 티켓, UR 아서 및 SSR 셀리아 조각, 필수 항독소.</p>

    <h2 id="mistakes">반드시 피해야 할 4가지 실수</h2>
    <ul>
      <li><strong>일반 주점에 다이아를 낭비하지 마세요:</strong> 8일 차에 열리는 신시아 룰렛을 위해 다이아를 전액 저축하세요!</li>
      <li><strong>필요한 건물만 업그레이드:</strong> 다음 성역 레벨에 요구되는 선행 건물만 집중 건설하세요.</li>
      <li><strong>스태미나 낭비 금지:</strong> 이벤트 점수를 주는 목표만 골라서 사냥하세요.</li>
      <li><strong>초반 PvP 금지:</strong> 타 플레이어 공격은 병원만 채우고 성장을 지체시킵니다.</li>
    </ul>

    <VideoSection topic="strike_first" lang={lang} />
  </GuidePage>
</Base>
