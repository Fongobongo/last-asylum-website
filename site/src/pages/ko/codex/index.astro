---
import Base from '../../../layouts/Base.astro';
import GuidePage from '../../../components/GuidePage.astro';
import CodexGrid from '../../../components/CodexGrid.astro';
import DiscordBanner from '../../../components/DiscordBanner.astro';
import { heroCodex } from '../../../data/heroCodex';
import { t } from '../../../i18n/ui';
import type { Lang } from '../../../i18n/utils';

const lang: Lang = 'ko';
const base = lang === 'en' ? '' : `/${lang}`;
---

<Base lang={lang} path="/codex/" title="영웅 도감" description="Last Asylum: Plague의 모든 핵심 영웅 — 스킬, 빌드, 부대 노트와 획득 방법.">
  <GuidePage
    title="📖 영웅 도감"
    description="중요한 모든 영웅의 스킬, 빌드 우선순위와 부대 노트 — 커뮤니티 가이드에서 집편."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/ko/' }, { label: '영웅 도감' }]}
  >
    <p>각 페이지: 역할, 영웅 획득 방법, 실제로 중요한 스킬, 빌드 우선순위, 그리고 해당 영웅이 등장하는 부대 구성. 등급은 <a href="/ko/tier-list/">티어 목록</a>을 참고하세요.</p>

    <CodexGrid heroes={heroCodex} lang={lang} base={base} />

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>
