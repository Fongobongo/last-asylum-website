---
import Base from '../../layouts/Base.astro';
import GuidePage from '../../components/GuidePage.astro';
import GiftCodes from '../../components/GiftCodes.astro';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n/utils';

const lang: Lang = 'ko';
---

<Base lang={lang} path="/ko/codes/" title={t(lang, 'codes.title')} description={t(lang, 'codes.desc')}>
  <GuidePage title={`🎁 ${t(lang, 'codes.title')}`} description={t(lang, 'codes.desc')} lang={lang}>
    <p class="text-sm text-stone-300 mt-2">자세한 사용법(<b>게임 내</b> 및 <b>UID + 일회용 비밀번호로 공식 페이지 입력</b>)은 <a href="#how-to-redeem" class="text-toxic-400 underline">아래 섹션</a>에서 확인하세요.</p>

    <h2 id="latest-codes">{t(lang, 'codes.active')}</h2>
    <GiftCodes lang={lang} />

    <h2 id="how-to-redeem">{t(lang, 'codes.redeem')}</h2>
    <p>{t(lang, 'codes.redeem.android')}</p>
    <p>{t(lang, 'codes.redeem.ios')}</p>

    <h2 id="notes">{t(lang, 'codes.note')}</h2>
  </GuidePage>
</Base>
