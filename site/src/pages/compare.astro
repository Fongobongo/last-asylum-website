---
import Base from '../layouts/Base.astro';
import GuidePage from '../components/GuidePage.astro';
import DiscordBanner from '../components/DiscordBanner.astro';
import VideoSection from '../components/VideoSection.astro';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/utils';

const lang: Lang = 'en';

const comparisons = [
  {
    slug: 'marlena-vs-zoya',
    title: 'Marlena vs Zoya — which UR carry?',
    verdict: 'Marlena first, Zoya later',
    points: [
      ['Availability', 'Free-ish ($1 top-up), day 66 free', 'Paid only (10 fragments to start)'],
      ['Damage share', '~85% of squad damage alone', 'Splits ~50/50 with a maxed Marlena'],
      ['Damage type', 'Physical/energy mix per build', 'Energy whirlwind — needs energy supports'],
      ['Synergy', 'Buffed 4× in the standard comp (Harper ult + Bell + Claire passive)', 'Does not stack with physical Jester'],
      ['F2P verdict', 'The main carry of the whole F2P path', 'Only swap Claire out if your Zoya is high-star'],
    ],
    video: 'XktNJ6u4sWo',
  },
  {
    slug: 'cynthia-vs-marlena-f2p',
    title: 'Cynthia vs Marlena for F2P',
    verdict: 'Pay the $1 — but Cynthia works if you truly cannot',
    points: [
      ['Cost', '~11,500 diamonds (day-8 wheel)', '$1 top-up'],
      ['Early power', 'Strong early carry (ranger UR)', 'Late bloomer — weak until high stars'],
      ['Late game', 'Lose 5% faction bonus + Harper/epigraph synergy', 'Core of the mono-Warrior meta'],
      ['Wheel timing', 'Must save diamonds days 1–8', 'No diamond cost'],
      ['Verdict', 'Viable early spike, falls off', 'Universally advised over Cynthia'],
    ],
  },
  {
    slug: 'annie-vs-joker',
    title: 'Annie vs Joker — which warlock carry?',
    verdict: 'Annie for value, Joker for PvP finishing',
    points: [
      ['Role', 'Sustained carry + team value at 8★', 'Executioner — targets lowest-HP enemies'],
      ['F2P access', 'Hero Pass (the community pick)', 'Wishing Wheel after day 15'],
      ['Synergy', 'Pairs with energy supports', 'Physical — does NOT pair with Zoya'],
      ['Best at', 'Long fights, monster content', 'PvP cleanup after Marlena softens'],
    ],
    video: 'ekodq_Wh2_I',
  },
  {
    slug: 'claire-vs-keep-ssr',
    title: 'Claire SSR→UR — convert now or wait?',
    verdict: 'Always convert — the question is timing',
    points: [
      ['Personal damage', '9★ UR ≈ 1.70× maxed SSR; 10★ ≈ 2.20×', '—'],
      ['Team buff', 'Dips 16% → 10% at 6★ (couple of % real loss)', '—'],
      ['Skip the dip', 'Bank Hall of Honor: Lv.60→8★, Lv.100→9★, Lv.160→instant 10★', '—'],
      ['PvP', 'Adv. Tenacity at 8★ = +20% ATK/HP/DEF +10% CDR', '—'],
      ['Cost', '1,600 SSR shards at 2× price (6★→10★)', '—'],
    ],
    video: '-9Nysk8pcns',
  },
  {
    slug: 'shadow-vs-lucius',
    title: 'Shadow vs Lucius — second tank',
    verdict: 'Lucius free now; Shadow if you buy the Hero Pass',
    points: [
      ['Cost', 'Hero Pass (paid)', 'Free shards'],
      ['Scaling', '8★/10★ significantly better than 6★', 'Steady placeholder'],
      ['Rule', 'If bought: treat as TEMP hero — 8★ max, skills 15–20', 'Swap in freely while building Daskal'],
      ['Endgame', 'Daskal replaces both', '—'],
    ],
  },
];
---

<Base lang={lang} path="/compare/" title="Hero Comparisons" description="Marlena vs Zoya, Annie vs Joker, Claire conversion timing — side-by-side verdicts from the community guides.">
  <GuidePage
    title="⚖️ Hero Comparisons"
    description="The debates players actually have — settled by the community guides with exact numbers."
    lang={lang}
    breadcrumbs={[{ label: t(lang, 'nav.home'), href: '/' }, { label: 'Comparisons' }]}
  >
    {comparisons.map((c) => (
      <section class="not-prose mb-10">
        <h2 id={c.slug} class="mb-1 text-2xl font-bold text-plague-200">{c.title}</h2>
        <p class="mb-4 text-sm font-semibold text-toxic-400">✓ {c.verdict}</p>
        <div class="overflow-x-auto rounded-lg border border-stone-800">
          <table class="w-full text-sm">
            {c.points.map((row) => (
              <tr class="border-t border-stone-800 first:border-t-0">
                <td class="w-40 bg-stone-900 p-3 font-semibold text-plague-300">{row[0]}</td>
                <td class="p-3 text-stone-300">{row[1]}</td>
                <td class="p-3 text-stone-400">{row[2]}</td>
              </tr>
            ))}
          </table>
        </div>
        {c.video && (
          <div class="js-video-facade mt-4 max-w-md cursor-pointer" data-video-id={c.video} role="button" tabindex="0" aria-label="Play comparison video">
            <span class="block aspect-video overflow-hidden rounded-lg border border-stone-800">
              <img src={`https://i.ytimg.com/vi/${c.video}/hqdefault.jpg`} alt="Video comparison" loading="lazy" class="h-full w-full object-cover" />
            </span>
          </div>
        )}
      </section>
    ))}

    <DiscordBanner lang={lang} />
  </GuidePage>
</Base>

<script>
  document.querySelectorAll('.js-video-facade').forEach((el) => {
    el.addEventListener('click', () => {
      const id = (el as HTMLElement).dataset.videoId;
      if (!id) return;
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
      frame.title = 'Video';
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      frame.allowFullscreen = true;
      frame.className = 'aspect-video w-full max-w-md rounded-lg';
      el.replaceWith(frame);
    });
  });
</script>