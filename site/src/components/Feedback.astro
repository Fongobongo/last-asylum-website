---
interface Props {
  lang: string;
}

const { lang } = Astro.props;

const L =
  lang === 'ru'
    ? { title: 'Гайд помог?', yes: '👍 Да', no: '👎 Нет', thanks: 'Спасибо за отзыв!' }
    : lang === 'es' ? { title: '¿Te sirvió esta guía?', yes: '👍 Sí', no: '👎 No', thanks: '¡Gracias!' }
    : lang === 'pt' ? { title: 'Esta guia ajudou?', yes: '👍 Sim', no: '👎 Não', thanks: 'Obrigado!' }
    : lang === 'fr' ? { title: 'Ce guide vous a aidé ?', yes: '👍 Oui', no: '👎 Non', thanks: 'Merci !' }
    : lang === 'de' ? { title: 'Hat diese Anleitung geholfen?', yes: '👍 Ja', no: '👎 Nein', thanks: 'Danke!' }
    : lang === 'id' ? { title: 'Panduan ini membantu?', yes: '👍 Ya', no: '👎 Tidak', thanks: 'Terima kasih!' }
    : lang === 'ko' ? { title: '이 가이드가 도움이 되었나요?', yes: '👍 네', no: '👎 아니요', thanks: '감사합니다!' }
    : lang === 'ja' ? { title: 'このガイドは役に立ちましたか？', yes: '👍 はい', no: '👎 いいえ', thanks: 'ありがとうございます！' }
    : { title: 'Did this guide help?', yes: '👍 Yes', no: '👎 No', thanks: 'Thanks for the feedback!' };
---

<section class="not-prose my-8 rounded-xl border border-stone-800 bg-stone-900 p-4 js-feedback">
  <p class="mb-3 text-sm font-semibold text-stone-300">{L.title}</p>
  <div class="flex gap-2">
    <button class="js-fb-yes rounded-lg border border-stone-700 px-4 py-2 text-sm text-stone-200 hover:border-toxic-500 hover:text-toxic-400" data-value="yes">
      {L.yes} <span class="js-fb-yes-count ml-1 font-mono text-xs text-stone-500">0</span>
    </button>
    <button class="js-fb-no rounded-lg border border-stone-700 px-4 py-2 text-sm text-stone-200 hover:border-blood-500 hover:text-red-400" data-value="no">
      {L.no} <span class="js-fb-no-count ml-1 font-mono text-xs text-stone-500">0</span>
    </button>
  </div>
  <p class="js-fb-thanks mt-3 hidden text-sm text-toxic-400">{L.thanks}</p>
</section>

<script>
  function initFeedback() {
    const W = window as any;
    interface VoteState { likes: number; dislikes: number; mine: string | null }
    const V = W.LAVotes as
      | {
          read(key: string): VoteState;
          vote(key: string, val: string): VoteState;
          refresh(key: string): void;
          subscribe(key: string, fn: (st: VoteState) => void): void;
        }
      | undefined;
    if (!V) return;
    document.querySelectorAll('.js-feedback').forEach((node) => {
      const sec = node as HTMLElement;
      if (sec.dataset.fbBound === 'true') return;
      sec.dataset.fbBound = 'true';
      const url = window.location.pathname;
      const key = 'guide:' + url;
      const yesBtn = sec.querySelector('.js-fb-yes') as HTMLElement | null;
      const noBtn = sec.querySelector('.js-fb-no') as HTMLElement | null;
      const yesCount = sec.querySelector('.js-fb-yes-count');
      const noCount = sec.querySelector('.js-fb-no-count');
      const thanks = sec.querySelector('.js-fb-thanks');

      const render = (st: { likes: number; dislikes: number; mine: string | null }) => {
        if (yesCount) yesCount.textContent = String(st.likes);
        if (noCount) noCount.textContent = String(st.dislikes);
        if (yesBtn) yesBtn.classList.toggle('border-toxic-400', st.mine === 'yes');
        if (noBtn) noBtn.classList.toggle('border-red-400', st.mine === 'no');
        if (thanks) thanks.classList.toggle('hidden', !st.mine);
      };

      render(V.read(key));
      V.subscribe(key, render);
      V.refresh(key);

      const onVote = (val: string) => {
        const st = V.vote(key, val);
        render(st);
        if (W.umami) W.umami.track('guide_feedback', { path: url, value: val });
      };
      if (yesBtn) yesBtn.addEventListener('click', () => onVote('yes'));
      if (noBtn) noBtn.addEventListener('click', () => onVote('no'));
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFeedback);
  } else {
    initFeedback();
  }
  document.addEventListener('astro:page-load', initFeedback);
</script>
