---
import { faqEn } from '../data/faq';
import { faqRu } from '../data/faqRu';
import { faqDe } from '../data/faqDe';
import { faqEs } from '../data/faqEs';
import { faqFr } from '../data/faqFr';
import { faqId } from '../data/faqId';
import { faqJa } from '../data/faqJa';
import { faqKo } from '../data/faqKo';
import { faqPt } from '../data/faqPt';
import { faqAr } from '../data/faqAr';
import { faqIt } from '../data/faqIt';
import { faqMs } from '../data/faqMs';
import { faqNl } from '../data/faqNl';
import { faqTh } from '../data/faqTh';
import { faqTr } from '../data/faqTr';
import { faqVi } from '../data/faqVi';
import { faqZh } from '../data/faqZh';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const faqByLang: Record<string, { q: string; a: string }[]> = {
  en: faqEn,
  ru: faqRu,
  de: faqDe,
  es: faqEs,
  fr: faqFr,
  id: faqId,
  ja: faqJa,
  ko: faqKo,
  pt: faqPt,
  ar: faqAr,
  it: faqIt,
  ms: faqMs,
  nl: faqNl,
  th: faqTh,
  tr: faqTr,
  vi: faqVi,
  zh: faqZh,
};

const faq = faqByLang[lang] ?? faqEn;

const headings: Record<string, string> = {
  en: '❓ FAQ — Frequently Asked Questions',
  ru: '❓ FAQ — Частые вопросы',
  de: '❓ FAQ — Häufig gestellte Fragen',
  es: '❓ FAQ — Preguntas frecuentes',
  fr: '❓ FAQ — Questions fréquentes',
  id: '❓ FAQ — Pertanyaan Umum',
  ja: '❓ FAQ — よくある質問',
  ko: '❓ FAQ — 자주 묻는 질문',
  pt: '❓ FAQ — Perguntas frequentes',
  ar: '❓ الأسئلة الشائعة',
  it: '❓ FAQ — Domande frequenti',
  ms: '❓ FAQ — Soalan Lazim',
  nl: '❓ FAQ — Veelgestelde vragen',
  th: '❓ FAQ — คำถามที่พบบ่อย',
  tr: '❓ FAQ — Sık sorulan sorular',
  vi: '❓ FAQ — Câu hỏi thường gặp',
  zh: '❓ FAQ — 常见问题',
};

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});
---

<section class="faq-section">
  <h2 id="faq">{headings[lang] ?? headings.en}</h2>

  <div class="not-prose my-6 space-y-3">
    {faq.map((f) => (
      <details class="group rounded-lg border border-stone-800 bg-stone-900">
        <summary class="cursor-pointer select-none px-4 py-3 font-semibold text-plague-200 group-open:text-plague-100">
          {f.q}
        </summary>
        <p class="border-t border-stone-800 px-4 py-3 text-sm leading-relaxed text-stone-300">{f.a}</p>
      </details>
    ))}
  </div>

  <script is:inline type="application/ld+json" set:html={schema} />
</section>
