    commander: 'Legion Commander (Warlord)',
    cooldown: 'Cooldown:',
    activeSkill: 'Active Skill',
    passiveSkill: 'Passive Skill',
    craftsmanAdvise: 'Ideal for F2P players and rapid base development. Grants instant construction and research time reduction, free resource bursts, ally peace shields, and free survivors.',
    commanderAdvise: 'Top choice for alliance wars, King\'s Castle clash, and KvK. Instantly trains highest-tier troops, instantly cures wounded soldiers, and inflicts massive damage on burning bases.',
  },
  de: {
    title: '👑 Fürstenberufe & Spezialisierungsfertigkeiten',
    subtitle: '34 Fertigkeiten für Handwerker und Legionskommandanten.',
    craftsman: 'Handwerker (Ingenieur)',
    commander: 'Legionskommandant (Krieger)',
    cooldown: 'Abklingzeit:',
    activeSkill: 'Aktiv',
    passiveSkill: 'Passiv',
    craftsmanAdvise: 'Ideal für F2P und schnellen Basisausbau.',
    commanderAdvise: 'Ideal für Kriege und KvK-Kämpfe.',
  },
  es: {
    title: '👑 Profesiones del Señor y Habilidades',
    subtitle: '34 habilidades únicas: Artesano o Comandante de Legión.',
    craftsman: 'Artesano (Ingeniero)',
    commander: 'Comandante de Legión',
    cooldown: 'Recarga:',
    activeSkill: 'Activa',
    passiveSkill: 'Pasiva',
    craftsmanAdvise: 'Ideal para desarrollo y jugadores F2P.',
    commanderAdvise: 'Ideal para guerras y batallas de reino.',
  },
  fr: {
    title: '👑 Professions de Seigneur & Compétences',
    subtitle: '34 compétences : Artisan ou Commandant de Légion.',
    craftsman: 'Artisan (Ingénieur)',
    commander: 'Commandant de Légion',
    cooldown: 'Recharge :',
    activeSkill: 'Active',
    passiveSkill: 'Passive',
    craftsmanAdvise: 'Parfait pour le développement rapide.',
    commanderAdvise: 'Parfait pour les guerres et le KvK.',
  },
  id: {
    title: '👑 Profesi Lord & Keahlian Khusus',
    subtitle: '34 keahlian resmi: Pengrajin atau Komandan Legiun.',
    craftsman: 'Pengrajin (Teknisi)',
    commander: 'Komandan Legiun',
    cooldown: 'Cooldown:',
    activeSkill: 'Aktif',
    passiveSkill: 'Pasif',
    craftsmanAdvise: 'Terbaik untuk pembangunan markas.',
    commanderAdvise: 'Terbaik untuk perang dan KvK.',
  },
  ja: {
    title: '👑 領主の天職と専門スキルシステム',
    subtitle: '職人（内政・技術）と軍団司令官（軍事・戦争）の全34スキル一覧。',
    craftsman: '職人（エンジニア・内政）',
    commander: '軍団司令官（武官・戦争）',
    cooldown: 'クールダウン：',
