---
import lordData from '../data/officialLordJobs.json';
import type { Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = 'ru' } = Astro.props;

const i18n = {
  ru: {
    title: '👑 Профессии Лорда и Навыки Специализации',
    subtitle: 'Выбор пути развития Мэра: мирный строитель-умелец или грозный командующий армией. 34 уникальных активных и пассивных навыка из клиента игры.',
    craftsman: 'Умелец (Инженер/Строитель)',
    commander: 'Командир легиона (Военачальник)',
    cooldown: 'Перезарядка:',
    activeSkill: 'Активный навык',
    passiveSkill: 'Пассивный навык',
    craftsmanAdvise: 'Идеален для F2P игроков и периода быстрого развития. Дает мгновенные завершения строительства и исследований (-час очереди), бесплатные ресурсы, щиты мира для союзников и призыв выживших.',
    commanderAdvise: 'Выбор для войн альянсов, Королевского переполоха и KvK. Позволяет МГНОВЕННО обучать сотни солдат высшего T-ранга, бесплатно лечить раненых и наносить сокрушительный урон по горящим базам.',
  },
  en: {
    title: '👑 Lord Professions & Specialization Skills',
    subtitle: 'Choose your mayoral path: peaceful craftsman engineer or ruthless legion commander. 34 unique active and passive skills from game data.',
