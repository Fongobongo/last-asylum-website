---
import { patchNotes } from '../data/patchnotes';
---

<div class="not-prose my-6 space-y-4">
  {patchNotes.map((p) => (
    <article class="rounded-lg border border-stone-800 bg-stone-900 p-5">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h3 class="text-lg font-bold text-plague-200">{p.title}</h3>
        <time class="text-sm text-stone-500" datetime={p.date}>{p.date}</time>
      </div>
      <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-stone-300">
        {p.highlights.map((h) => <li>{h}</li>)}
      </ul>
    </article>
  ))}
</div>