---
import { patchNotes } from '../data/patchnotes';
import type { Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
---

<div class="not-prose my-6 space-y-4">
  {patchNotes.map((p) => {
    const isRu = lang === 'ru' && p.ru;
    const title = isRu ? p.ru!.title : p.title;
    const highlights = isRu ? p.ru!.highlights : p.highlights;

    return (
      <article class="rounded-lg border border-stone-800 bg-stone-900 p-5 transition-all hover:border-stone-700">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h3 class="text-lg font-bold text-plague-200">{title}</h3>
          <time class="text-sm text-stone-500" datetime={p.date}>{p.date}</time>
        </div>
        <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-stone-300">
          {highlights.map((h) => <li>{h}</li>)}
        </ul>
      </article>
    );
  })}
</div>