badgePayDesc: Lpick('МИР, СБП, Карты, QIWI, PayPal, Крипта', 'Credit Cards, PayPal, Crypto & E-wallets', 'badgePayDesc'),

catalogTitle: Lpick('Каталог внутриигровых товаров', 'In-Game Items & Packs Catalog', 'catalogTitle'),
catalogSubtitle: Lpick('Выберите категорию для быстрого перехода к оформлению со скидкой на LDShop:', 'Choose a category to open the discounted LDShop catalog directly:', 'catalogSubtitle'),

card1Tag: Lpick('Хит продаж • x2 бонус', 'Best Seller • x2 Bonus', 'card1Tag'),
card1Title: Lpick('Алмазы (Diamonds)', 'Diamonds Packs', 'card1Title'),
card1Desc: Lpick('Пакеты от 60 до 6480+ алмазов. Двойной бонус на первое пополнение каждого пакета!', 'Packs from 60 to 6,480+ Diamonds. Double bonus on each first purchase tier!', 'card1Desc'),
  card1Items: (lang === 'ru' ? ['60 Алмазов', '300 Алмазов', '980 Алмазов', '1980 Алмазов', '3280 Алмазов', '6480 Алмазов'] : ((STR as any)[lang]?.card1 ?? ['60 Diamonds', '300 Diamonds', '980 Diamonds', '1980 Diamonds', '3280 Diamonds', '6480 Diamonds'])),
card1Cta: Lpick('Купить алмазы ↗', 'Buy Diamonds ↗', 'card1Cta'),

card2Tag: Lpick('Максимальная выгода', 'High Value Pass', 'card2Tag'),
card2Title: Lpick('Боевой пропуск и карты', 'Battle Pass & Monthly Cards', 'card2Title'),
card2Desc: Lpick('Ежедневные алмазы, пропуск сезона Эры Возрождения (+250 Сопротивления) и бонусы снабжения.', 'Daily diamonds, Era of Revival Battle Pass (+250 Resistance), and monthly supply perks.', 'card2Desc'),
  card2Items: (lang === 'ru' ? ['Месячная карта снабжения', 'Еженедельный пропуск', 'Battle Pass Эры Возрождения', 'Премиум подписка'] : ((STR as any)[lang]?.card2 ?? ['Monthly Supply Card', 'Weekly Era Pass', 'Era of Revival Battle Pass', 'VIP Privilege Cards'])),
card2Cta: Lpick('Оформить пропуск ↗', 'Get Season Pass ↗', 'card2Cta'),

card3Tag: Lpick('Лучший старт', 'Starter Essential', 'card3Tag'),
card3Title: Lpick('Наборы новичка и ускорения', 'Starter Packs & Speedups', 'card3Title'),
card3Desc: Lpick('Стартовый пак  с Марленой (Marlena), строительные наборы и универсальные ускорения для быстрого пуша Святилища.', ' Marlena starter top-up, building packs, and universal speedup bundles for rapid Sanctuary growth.', 'card3Desc'),
  card3Items: (lang === 'ru' ? ['Стартовый пак Marlena ()', 'Пакет строителя', 'Универсальные ускорения', 'Наборы ресурсов'] : ((STR as any)[lang]?.card3 ?? [' Marlena Starter Pack', 'Builder Expansion Pack', 'Universal Speedup Bundles', 'Resource Reserves'])),
card3Cta: Lpick('Выбрать наборы ↗', 'Browse Bundles ↗', 'card3Cta'),

card4Tag: Lpick('Герои и снаряжение', 'Hero Progression', 'card4Tag'),
card4Title: Lpick('Материалы и призыв', 'Hero & Gear Materials', 'card4Title'),
card4Desc: Lpick('Билеты призыва (Recruit Tickets), Камни снаряжения и Вороний плод для развития ваших лучших отрядов.', 'Recruit Tickets, Gearstones, and Raven Fruits to power up your squads and equipment.', 'card4Desc'),
  card4Items: (lang === 'ru' ? ['Билеты призыва (Recruit Tickets)', 'Камни снаряжения (Gearstones)', 'Вороний плод (Raven Fruit)', 'Эксклюзивное оружие'] : ((STR as any)[lang]?.card4 ?? ['Recruit Tickets', 'Gearstones', 'Raven Fruits', 'Exclusive Weapon Packs'])),
card4Cta: Lpick('Купить материалы ↗', 'Get Materials ↗', 'card4Cta'),

bannerTitle: Lpick('Готовы усилить свой отряд прямо сейчас?', 'Ready to strengthen your squads right now?', 'bannerTitle'),
bannerDesc: Lpick('Перейдите в наш партнёрский магазин LDShop, укажите ваш игровой UID и получите алмазы и наборы за пару минут со скидкой!', 'Visit our partner LDShop store, enter your player UID, and receive diamonds and bundles with exclusive discounts in minutes!', 'bannerDesc'),
bannerBtn: Lpick('Открыть магазин Last Asylum на LDShop ↗', 'Open Last Asylum Shop on LDShop ↗', 'bannerBtn'),

howTitle: Lpick('Как пополнить счет в игре за 3 простых шага', 'How to Top-Up in 3 Easy Steps', 'howTitle'),
  step1Num: '01',
step1Title: Lpick('Скопируйте ваш игровой UID', 'Copy your in-game UID', 'step1Title'),
step1Desc: Lpick('В игре Last Asylum нажмите на аватар вашего профиля в левом верхнем углу и скопируйте цифровой ID (UID).', 'In Last Asylum, tap your player avatar in the top-left corner and copy your numeric User ID (UID).', 'step1Desc'),
  step2Num: '02',
step2Title: Lpick('Выберите товар на сайте LDShop', 'Select your item on LDShop', 'step2Title'),
step2Desc: Lpick('Перейдите по нашей ссылке в магазин LDShop, выберите нужный пак алмазов или набор и вставьте скопированный UID.', 'Follow our link to LDShop, pick your desired diamond package or pack, and paste your copied UID.', 'step2Desc'),
  step3Num: '03',
step3Title: Lpick('Оплатите и проверьте почту в игре', 'Pay and check your in-game mail', 'step3Title'),
step3Desc: Lpick('Оплатите заказ любым удобным способом (карты, СБП, кошельки, крипта). Алмазы поступят на аккаунт за 1–3 минуты!', 'Complete payment using credit card, PayPal, or local methods. Items arrive in your in-game mailbox within 1–3 minutes!', 'step3Desc'),

guaranteeTitle: Lpick('Гарантия безопасности и поддержка фан-хаба', 'Security Guarantee & Fan Hub Support', 'guaranteeTitle'),
guaranteeText: Lpick('Пополнение осуществляется через защищённый шлюз LDShop без необходимости передавать логин и пароль от аккаунта. Совершая покупки по нашей партнёрской ссылке, вы получаете скидки и бонусы, а наш фан-сайт получает небольшую комиссию на поддержание работы серверов и регулярное написание гайдов без каких-либо дополнительных затрат для вас.', 'Top-ups are processed through LDShop\'s secure gateway using UID only — no passwords or account credentials are ever required. When you purchase via our affiliate link, you get best prices and bonuses while helping support server hosting and guide updates at zero additional cost to you.', 'guaranteeText'),
disclosureNote: Lpick('Партнёрский сервис LDShop. Покупки производятся напрямую в игре Last Asylum: Plague через защищенный API.', 'Partner service by LDShop. In-game currency is delivered directly to Last Asylum: Plague via secure APIs.', 'disclosureNote'),
};
---

<div class="shop-page not-prose mx-auto max-w-5xl py-4 sm:py-8 space-y-12">
  <!-- Hero Section -->
  <div class="relative overflow-hidden rounded-3xl border border-toxic-500/30 bg-gradient-to-b from-stone-900/90 via-stone-950 to-stone-950 p-6 sm:p-12 shadow-[0_0_50px_rgba(180,255,57,0.08)] backdrop-blur-2xl">
    <div class="pointer-events-none absolute -right-20 -top-20 h-80 w-80 rounded-full bg-toxic-500/15 blur-3xl"></div>
    <div class="pointer-events-none absolute -left-20 -bottom-20 h-80 w-80 rounded-full bg-plague-500/15 blur-3xl"></div>

    <div class="relative z-10 max-w-3xl space-y-4">
      <div class="inline-flex items-center gap-2 rounded-full border border-toxic-400/40 bg-toxic-500/15 px-3.5 py-1 text-xs font-mono font-bold tracking-wider text-toxic-300 uppercase shadow-[0_0_15px_rgba(180,255,57,0.2)]">
        <span class="h-2 w-2 rounded-full bg-toxic-400 animate-pulse"></span>
        {T.heroBadge}
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight">
        {T.title}
      </h1>

      <p class="text-sm sm:text-base leading-relaxed text-stone-300 max-w-2xl">
        {T.subtitle}
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-4">
        <a
          href={AFF_LINK}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-glow inline-flex items-center gap-2 rounded-2xl bg-gradient-to-r from-plague-500 via-toxic-400 to-toxic-300 px-6 py-3.5 text-sm sm:text-base font-bold text-black shadow-[0_0_25px_rgba(180,255,57,0.35)] hover:brightness-110 hover:scale-[1.02] active:scale-[0.99] transition"
        >
          <span>⚡ {T.openStoreLdBtn}</span>
        </a>

        <a
          href={LOOTBAR_LINK}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-2xl border border-stone-700 bg-stone-900/80 px-5 py-3.5 text-sm font-semibold text-stone-200 hover:border-stone-500 hover:text-white transition"
        >
          <span>🛒 {T.openStoreBtn}</span>
        </a>

        <a
          href="#how-to-topup"
          class="inline-flex items-center gap-2 rounded-2xl border border-stone-700 bg-stone-900/80 px-5 py-3.5 text-sm font-semibold text-stone-200 hover:border-stone-500 hover:text-white transition"
        >
          <span>{T.howItWorksBtn}</span>
        </a>
      </div>

      <p class="mt-3 text-xs text-stone-400">
        {isRu
          ? '💡 Зарегистрируйтесь на LootBar по нашей ссылке — 2 купона на скидку до $20. Безопасные пополнения, быстрая доставка и выгодные цены.'
          : '💡 Sign up on LootBar via our link to get 2 discount coupons worth up to $20. Safe top-ups, fast delivery, and great prices.'}
      </p>
    </div>
  </div>

  <!-- Trust Highlights Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="rounded-2xl border border-stone-800 bg-stone-900/60 p-5 backdrop-blur-md hover:border-toxic-500/40 transition">
      <span class="text-2xl mb-2 block">⚡</span>
      <h3 class="text-sm font-bold text-white mb-1">{T.badgeFastTitle}</h3>
      <p class="text-xs text-stone-400 leading-relaxed">{T.badgeFastDesc}</p>
    </div>

    <div class="rounded-2xl border border-stone-800 bg-stone-900/60 p-5 backdrop-blur-md hover:border-toxic-500/40 transition">
      <span class="text-2xl mb-2 block">🔒</span>
      <h3 class="text-sm font-bold text-white mb-1">{T.badgeSecureTitle}</h3>
      <p class="text-xs text-stone-400 leading-relaxed">{T.badgeSecureDesc}</p>
    </div>

    <div class="rounded-2xl border border-stone-800 bg-stone-900/60 p-5 backdrop-blur-md hover:border-toxic-500/40 transition">
      <span class="text-2xl mb-2 block">💰</span>
      <h3 class="text-sm font-bold text-white mb-1">{T.badgeDiscountTitle}</h3>
      <p class="text-xs text-stone-400 leading-relaxed">{T.badgeDiscountDesc}</p>
    </div>

    <div class="rounded-2xl border border-stone-800 bg-stone-900/60 p-5 backdrop-blur-md hover:border-toxic-500/40 transition">
      <span class="text-2xl mb-2 block">🌍</span>
      <h3 class="text-sm font-bold text-white mb-1">{T.badgePayTitle}</h3>
      <p class="text-xs text-stone-400 leading-relaxed">{T.badgePayDesc}</p>
    </div>
  </div>

  <!-- Catalog Categories Section -->
  <div class="space-y-6">
    <div class="text-center sm:text-left">
      <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">{T.catalogTitle}</h2>
      <p class="mt-1 text-sm text-stone-400">{T.catalogSubtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <!-- Card 1: Diamonds -->
      <div class="group flex flex-col justify-between rounded-3xl border border-stone-800 bg-gradient-to-b from-stone-900/80 to-stone-950 p-6 backdrop-blur-xl hover:border-toxic-500/50 hover:shadow-[0_0_30px_rgba(180,255,57,0.1)] transition">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-cyan-500/15 border border-cyan-400/30 text-2xl shadow-[0_0_15px_rgba(6,182,212,0.2)]">
              💎
            </span>
            <span class="rounded-full bg-toxic-500/15 border border-toxic-500/30 px-3 py-1 text-[11px] font-mono font-semibold text-toxic-300">
              {T.card1Tag}
            </span>
          </div>
          <h3 class="text-xl font-bold text-white group-hover:text-toxic-300 transition">{T.card1Title}</h3>
          <p class="mt-2 text-xs sm:text-sm text-stone-400 leading-relaxed">{T.card1Desc}</p>

          <div class="mt-4 flex flex-wrap gap-1.5">
            {T.card1Items.map((item: string) => (
              <span class="rounded-lg bg-stone-950 border border-stone-800 px-2.5 py-1 text-xs font-mono text-stone-300">
                {item}
              </span>
            ))}
          </div>
        </div>

        <div class="pt-6 mt-6 border-t border-stone-800/80">
          <a
            href={AFF_LINK}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-toxic-400 py-3 text-sm font-bold text-black hover:bg-toxic-300 hover:shadow-[0_0_20px_rgba(180,255,57,0.3)] transition cursor-pointer"
          >
            <span>{T.card1Cta}</span>
          </a>
        </div>
      </div>

      <!-- Card 2: Battle Pass & Monthly Cards -->
      <div class="group flex flex-col justify-between rounded-3xl border border-stone-800 bg-gradient-to-b from-stone-900/80 to-stone-950 p-6 backdrop-blur-xl hover:border-amber-500/50 hover:shadow-[0_0_30px_rgba(245,158,11,0.1)] transition">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-500/15 border border-amber-400/30 text-2xl shadow-[0_0_15px_rgba(245,158,11,0.2)]">
              📜
            </span>
            <span class="rounded-full bg-amber-500/15 border border-amber-500/30 px-3 py-1 text-[11px] font-mono font-semibold text-amber-300">
              {T.card2Tag}
            </span>
          </div>
          <h3 class="text-xl font-bold text-white group-hover:text-amber-300 transition">{T.card2Title}</h3>
          <p class="mt-2 text-xs sm:text-sm text-stone-400 leading-relaxed">{T.card2Desc}</p>

          <div class="mt-4 flex flex-wrap gap-1.5">
            {T.card2Items.map((item: string) => (
              <span class="rounded-lg bg-stone-950 border border-stone-800 px-2.5 py-1 text-xs font-mono text-stone-300">
                {item}
              </span>
            ))}
          </div>
        </div>

        <div class="pt-6 mt-6 border-t border-stone-800/80">
          <a
            href={AFF_LINK}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-amber-400 to-amber-500 py-3 text-sm font-bold text-black hover:brightness-110 hover:shadow-[0_0_20px_rgba(245,158,11,0.3)] transition cursor-pointer"
          >
            <span>{T.card2Cta}</span>
          </a>
        </div>
      </div>

      <!-- Card 3: Starter Packs & Speedups -->
      <div class="group flex flex-col justify-between rounded-3xl border border-stone-800 bg-gradient-to-b from-stone-900/80 to-stone-950 p-6 backdrop-blur-xl hover:border-emerald-500/50 hover:shadow-[0_0_30px_rgba(16,185,129,0.1)] transition">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-500/15 border border-emerald-400/30 text-2xl shadow-[0_0_15px_rgba(16,185,129,0.2)]">
              📦
            </span>
            <span class="rounded-full bg-emerald-500/15 border border-emerald-500/30 px-3 py-1 text-[11px] font-mono font-semibold text-emerald-300">
              {T.card3Tag}
            </span>
          </div>
          <h3 class="text-xl font-bold text-white group-hover:text-emerald-300 transition">{T.card3Title}</h3>
          <p class="mt-2 text-xs sm:text-sm text-stone-400 leading-relaxed">{T.card3Desc}</p>

          <div class="mt-4 flex flex-wrap gap-1.5">
            {T.card3Items.map((item: string) => (
              <span class="rounded-lg bg-stone-950 border border-stone-800 px-2.5 py-1 text-xs font-mono text-stone-300">
                {item}
              </span>
            ))}
          </div>
        </div>

        <div class="pt-6 mt-6 border-t border-stone-800/80">
          <a
            href={AFF_LINK}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-emerald-400 to-emerald-500 py-3 text-sm font-bold text-black hover:brightness-110 hover:shadow-[0_0_20px_rgba(16,185,129,0.3)] transition cursor-pointer"
          >
            <span>{T.card3Cta}</span>
          </a>
        </div>
      </div>

      <!-- Card 4: Hero & Gear Materials -->
      <div class="group flex flex-col justify-between rounded-3xl border border-stone-800 bg-gradient-to-b from-stone-900/80 to-stone-950 p-6 backdrop-blur-xl hover:border-purple-500/50 hover:shadow-[0_0_30px_rgba(168,85,247,0.1)] transition">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-purple-500/15 border border-purple-400/30 text-2xl shadow-[0_0_15px_rgba(168,85,247,0.2)]">
              ⚔️
            </span>
            <span class="rounded-full bg-purple-500/15 border border-purple-500/30 px-3 py-1 text-[11px] font-mono font-semibold text-purple-300">
              {T.card4Tag}
            </span>
          </div>
          <h3 class="text-xl font-bold text-white group-hover:text-purple-300 transition">{T.card4Title}</h3>
          <p class="mt-2 text-xs sm:text-sm text-stone-400 leading-relaxed">{T.card4Desc}</p>

          <div class="mt-4 flex flex-wrap gap-1.5">
            {T.card4Items.map((item: string) => (
              <span class="rounded-lg bg-stone-950 border border-stone-800 px-2.5 py-1 text-xs font-mono text-stone-300">
                {item}
              </span>
            ))}
          </div>
        </div>

        <div class="pt-6 mt-6 border-t border-stone-800/80">
          <a
            href={AFF_LINK}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-purple-400 to-purple-500 py-3 text-sm font-bold text-black hover:brightness-110 hover:shadow-[0_0_20px_rgba(168,85,247,0.3)] transition cursor-pointer"
          >
            <span>{T.card4Cta}</span>
          </a>
        </div>
      </div>
    </div>
  </div>


  <!-- Top-Up Savings Calculator -->
  <div class="my-16 rounded-3xl border border-toxic-500/30 bg-stone-900/60 p-6 sm:p-8 backdrop-blur-xl shadow-2xl" id="savings-calc">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b border-white/[0.06] pb-6 mb-6">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xl">💰</span>
          <h3 class="text-xl sm:text-2xl font-bold text-white">
            {Lpick('Калькулятор реальной экономии на LDShop', 'Real Top-Up Savings Calculator', 'calcTitle')}
          </h3>
        </div>
        <p class="mt-1 text-xs sm:text-sm text-stone-400">
          {Lpick('Выберите желаемый пак алмазов и сравните цену с официальным магазином в игре:', 'Choose your desired diamond pack and compare with standard in-game store prices:', 'calcSub')}
        </p>
      </div>

      <!-- Currency Switcher -->
      <div class="flex items-center gap-1.5 self-start md:self-auto rounded-xl border border-white/10 bg-black/40 p-1 text-xs">
        <button type="button" data-curr="USD" class="curr-btn active rounded-lg px-2.5 py-1 font-mono font-bold transition bg-white text-black">USD ($)</button>
        <button type="button" data-curr="RUB" class="curr-btn rounded-lg px-2.5 py-1 font-mono font-bold transition text-stone-400 hover:text-white">RUB (₽)</button>
        <button type="button" data-curr="EUR" class="curr-btn rounded-lg px-2.5 py-1 font-mono font-bold transition text-stone-400 hover:text-white">EUR (€)</button>
      </div>
    </div>

    <!-- Pack Selection Buttons -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5 mb-8" id="calc-pack-selector">
      <button type="button" data-diamonds="60" data-official-usd="0.99" data-ld-usd="0.82" data-official-rub="99" data-ld-rub="82" data-official-eur="0.99" data-ld-eur="0.82" class="pack-btn rounded-xl border border-stone-800 bg-stone-950 p-3 text-center transition hover:border-toxic-400/50">
        <div class="text-xs font-semibold text-stone-400">60 💎</div>
        <div class="mt-1 font-mono font-bold text-sm text-white pack-price">$0.82</div>
      </button>

      <button type="button" data-diamonds="300" data-official-usd="4.99" data-ld-usd="4.10" data-official-rub="499" data-ld-rub="410" data-official-eur="4.99" data-ld-eur="4.10" class="pack-btn rounded-xl border border-stone-800 bg-stone-950 p-3 text-center transition hover:border-toxic-400/50">
        <div class="text-xs font-semibold text-stone-400">300 💎</div>
        <div class="mt-1 font-mono font-bold text-sm text-white pack-price">$4.10</div>
      </button>

      <button type="button" data-diamonds="980" data-official-usd="14.99" data-ld-usd="12.30" data-official-rub="1490" data-ld-rub="1230" data-official-eur="14.99" data-ld-eur="12.30" class="pack-btn rounded-xl border border-stone-800 bg-stone-950 p-3 text-center transition hover:border-toxic-400/50">
        <div class="text-xs font-semibold text-stone-400">980 💎</div>
        <div class="mt-1 font-mono font-bold text-sm text-white pack-price">$12.30</div>
      </button>

      <button type="button" data-diamonds="1980" data-official-usd="29.99" data-ld-usd="24.60" data-official-rub="2990" data-ld-rub="2460" data-official-eur="29.99" data-ld-eur="24.60" class="pack-btn rounded-xl border border-stone-800 bg-stone-950 p-3 text-center transition hover:border-toxic-400/50">
