  <script>
    function initSavingsCalc() {
      const calcRoot = document.getElementById('savings-calc');
      if (!calcRoot) return;

      let currentCurrency = 'USD';
      let activeBtn = calcRoot.querySelector('.pack-btn.active') as HTMLElement | null;

      const currencySymbols: Record<string, string> = { USD: '$', RUB: '₽', EUR: '€' };

      const updateValues = () => {
        if (!activeBtn) return;
        const curr = currentCurrency.toLowerCase();
        const offPrice = activeBtn.dataset[`official${currentCurrency}`] ?? '';
        const ldPrice = activeBtn.dataset[`ld${currentCurrency}`] ?? '';
        const diamonds = activeBtn.dataset.diamonds ?? '0';

        const offNum = parseFloat(offPrice);
        const ldNum = parseFloat(ldPrice);
        const diff = (offNum - ldNum).toFixed(currentCurrency === 'RUB' ? 0 : 2);

        const sym = currencySymbols[currentCurrency] || '$';

        const offEl = document.getElementById('calc-official-price');
        const ldEl = document.getElementById('calc-ld-price');
        const saveEl = document.getElementById('calc-save-amount');
        const bonusEl = document.getElementById('calc-bonus-diamonds');

        if (offEl) offEl.textContent = currentCurrency === 'RUB' ? `${offPrice} ${sym}` : `${sym}${offPrice}`;
        if (ldEl) ldEl.textContent = currentCurrency === 'RUB' ? `${ldPrice} ${sym}` : `${sym}${ldPrice}`;
        if (saveEl) saveEl.textContent = currentCurrency === 'RUB' ? `-${diff} ${sym}` : `-${sym}${diff}`;
        if (bonusEl) bonusEl.textContent = `💎 +${diamonds} bonus x2`;

        // Update prices inside buttons
        calcRoot.querySelectorAll<HTMLElement>('.pack-btn').forEach((btn) => {
          const p = btn.dataset[`ld${currentCurrency}`];
          const prEl = btn.querySelector('.pack-price');
          if (prEl && p) {
            prEl.textContent = currentCurrency === 'RUB' ? `${p} ${sym}` : `${sym}${p}`;
          }
        });
      };

      // Currency toggling
      calcRoot.querySelectorAll<HTMLButtonElement>('.curr-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          calcRoot.querySelectorAll('.curr-btn').forEach((b) => {
            b.classList.remove('active', 'bg-white', 'text-black');
            b.classList.add('text-stone-400');
          });
          btn.classList.add('active', 'bg-white', 'text-black');
          btn.classList.remove('text-stone-400');
          currentCurrency = btn.dataset.curr || 'USD';
          updateValues();
        });
      });

      // Pack selection
      calcRoot.querySelectorAll<HTMLElement>('.pack-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          calcRoot.querySelectorAll('.pack-btn').forEach((b) => {
            b.classList.remove('active', 'border-toxic-400', 'bg-toxic-500/10', 'text-toxic-300');
            b.classList.add('border-stone-800', 'bg-stone-950');
          });
          btn.classList.add('active', 'border-toxic-400', 'bg-toxic-500/10');
          btn.classList.remove('border-stone-800', 'bg-stone-950');
          activeBtn = btn;
          updateValues();
        });
      });

      updateValues();
    }
    initSavingsCalc();
  </script>

