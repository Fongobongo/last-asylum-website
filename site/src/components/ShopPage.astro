          <p class="mt-2 text-xs sm:text-sm text-stone-400 leading-relaxed">{T.card1Desc}</p>

          <div class="mt-4 flex flex-wrap gap-1.5">
            {T.card1Items.map((item: string) => (
              <span class="rounded-lg bg-stone-950 border border-stone-800 px-2.5 py-1 text-xs font-mono text-stone-300">
                {item}
              </span>
            ))}
          </div>
        </div>

        <div class="pt-6 mt-6 border-t border-stone-800/80">
          <a
            href={AFF_LINK}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-toxic-400 py-3 text-sm font-bold text-black hover:bg-toxic-300 hover:shadow-[0_0_20px_rgba(180,255,57,0.3)] transition cursor-pointer"
          >
            <span>{T.card1Cta}</span>
          </a>
        </div>
      </div>

      <!-- Card 2: Battle Pass & Monthly Cards -->
