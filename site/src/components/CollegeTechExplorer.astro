const t = i18n[lang as keyof typeof i18n] || i18n.en;

// Format list of tech items with branch info
const branchMap = new Map(branchesData.map((b) => [b.id, b]));

const allTechs = Object.values(techsData).map((tech: any) => {
  const branchId = Math.floor(tech.id / 1000);
  const branch = branchMap.get(branchId);
  const name = tech.name?.[lang] || tech.name?.en || tech.name?.ru || `Tech #${tech.id}`;
  const desc = tech.desc?.[lang] || tech.desc?.en || tech.desc?.ru || '';
  const branchName = branch?.name?.[lang] || branch?.name?.en || branch?.name?.ru || `Branch ${branchId}`;

  return {
    id: tech.id,
    branchId,
    branchName,
    priority: branch?.priority || 'B',
    name,
    desc,
    advice: branch?.advice?.[lang] || branch?.advice?.ru || branch?.advice?.en || '',
  };
});
---

<section class="not-prose my-10 rounded-3xl border border-toxic-500/30 bg-stone-950/80 p-6 sm:p-8 backdrop-blur-xl shadow-[0_0_50px_rgba(0,0,0,0.6)]" id="college-tech-explorer">
  <div class="mb-6 flex flex-col gap-2">
    <div class="flex items-center gap-3">
      <span class="rounded-xl border border-toxic-500/40 bg-toxic-950/60 px-3 py-1 text-xs font-bold text-toxic-400">
        348 TECHNOLOGIES
      </span>
      <span class="text-xs text-stone-500 font-mono">APK CLIENT v1.0.102</span>
    </div>
    <h2 class="text-2xl font-bold tracking-tight text-toxic-400 sm:text-3xl">{t.title}</h2>
    <p class="text-sm text-stone-400 max-w-3xl">{t.subtitle}</p>
  </div>

  <!-- Priority Banner Callout -->
  <div class="mb-6 rounded-2xl border border-stone-800 bg-stone-900/60 p-4 sm:p-5">
    <div class="flex items-center gap-2 mb-2">
      <span class="text-lg">💡</span>
      <h3 class="text-sm font-bold text-stone-200">{t.sTierTitle}</h3>
    </div>
    <p class="text-xs text-stone-400 leading-relaxed">{t.sTierDesc}</p>
    
    <div class="mt-3 flex flex-wrap gap-2">
      {branchesData.filter((b) => b.priority === 'S').map((b) => {
        const bName = b.name?.[lang] || b.name?.en || b.name?.ru;
        return (
          <span class="inline-flex items-center gap-1.5 rounded-lg border border-toxic-500/30 bg-toxic-950/40 px-2.5 py-1 text-xs font-semibold text-toxic-300">
            <span class="text-toxic-400 font-bold">S</span>
            {bName}
            <span class="text-[10px] text-stone-500 font-normal">({b.techCount})</span>
          </span>
        );
      })}
    </div>
  </div>

  <!-- Search and Filters -->
  <div class="space-y-4">
    <div class="relative flex items-center">
      <input
        type="text"
        id="tech-search-input"
        class="w-full rounded-2xl border border-stone-800 bg-stone-900/90 px-4 py-3.5 pl-11 text-sm text-stone-100 placeholder-stone-500 transition-all focus:border-toxic-500 focus:bg-black focus:outline-none focus:ring-2 focus:ring-toxic-500/30"
        placeholder={t.placeholder}
        autocomplete="off"
      />
      <span class="absolute left-4 text-stone-400">🔍</span>
      <button
        id="tech-clear-btn"
        class="absolute right-3 hidden rounded-lg bg-stone-800 px-2.5 py-1 text-xs text-stone-400 hover:bg-stone-700 hover:text-white transition"
      >
        ✕
      </button>
    </div>

    <!-- Branch selector tabs -->
    <div class="flex flex-wrap gap-1.5 pt-1" id="tech-branch-tabs">
      <button
        type="button"
        data-branch="all"
        class="tech-branch-btn rounded-xl px-3 py-1.5 text-xs font-semibold bg-toxic-500 text-stone-950 shadow-[0_0_15px_rgba(180,255,57,0.3)] transition-all"
      >
        {t.allBranches} ({allTechs.length})
      </button>

      {branchesData.map((b) => {
        const bName = b.name?.[lang] || b.name?.en || b.name?.ru;
        const priorityColor = b.priority === 'S' ? 'text-toxic-400 border-toxic-500/40' : 'text-stone-400 border-stone-800';
        return (
          <button
            type="button"
            data-branch={b.id.toString()}
            class={`tech-branch-btn rounded-xl border bg-stone-900/60 px-3 py-1.5 text-xs font-semibold hover:border-toxic-500/40 hover:text-stone-200 transition-all ${priorityColor}`}
          >
            {b.priority === 'S' && <span class="text-toxic-400 mr-1">⭐</span>}
            {bName}
            <span class="ml-1 text-[10px] text-stone-500">({b.techCount})</span>
          </button>
        );
      })}
    </div>

    <!-- Stats & Counter bar -->
    <div class="flex items-center justify-between text-xs text-stone-400 px-1 pt-1">
      <div>
        {t.techsFound} <span id="tech-count" class="font-bold text-toxic-400">{allTechs.length}</span>
      </div>
      <div class="flex items-center gap-2">
        <label for="tech-priority-select" class="text-stone-500">{t.priorityFilter}</label>
        <select
          id="tech-priority-select"
          class="rounded-lg border border-stone-800 bg-stone-900 px-2 py-1 text-xs text-stone-300 focus:outline-none focus:border-toxic-500"
        >
          <option value="all">{t.allPriorities}</option>
          <option value="S">S-Tier</option>
          <option value="A">A-Tier</option>
          <option value="B">B-Tier</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Tech Cards Grid -->
  <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" id="tech-cards-container">
    {allTechs.map((tech) => {
      const isSTier = tech.priority === 'S';
      const borderClass = isSTier ? 'border-toxic-500/30 hover:border-toxic-500' : 'border-stone-800/80 hover:border-stone-700';
      const badgeClass = isSTier
        ? 'bg-toxic-950/70 border-toxic-500/40 text-toxic-300'
        : tech.priority === 'A'
        ? 'bg-blue-950/50 border-blue-500/30 text-blue-300'
        : 'bg-stone-800/60 border-stone-700/50 text-stone-400';

      return (
        <div
          class={`tech-card flex flex-col justify-between rounded-2xl border ${borderClass} bg-stone-900/40 p-4 transition-all hover:bg-stone-900/80 hover:shadow-lg`}
          data-branch={tech.branchId.toString()}
          data-priority={tech.priority}
          data-search={`${tech.name} ${tech.desc} ${tech.branchName} ${tech.id}`.toLowerCase()}
        >
          <div>
            <div class="mb-2 flex items-center justify-between">
              <span class="rounded-md border border-stone-800 bg-stone-950 px-2 py-0.5 text-[10px] font-mono text-stone-400">
                #{tech.id}
              </span>
              <span class={`rounded-md border px-2 py-0.5 text-[10px] font-bold ${badgeClass}`}>
                {tech.priority}-TIER
              </span>
            </div>

            <h3 class="text-sm font-bold text-stone-100 group-hover:text-toxic-200 leading-snug">
              {tech.name}
            </h3>

            <p class="mt-1 text-xs text-stone-400 leading-relaxed">
              {tech.desc}
            </p>
          </div>

          <div class="mt-3 pt-2 border-t border-stone-800/60 flex items-center justify-between text-[11px]">
            <span class="text-stone-500 truncate max-w-[170px]" title={tech.branchName}>
              📁 {tech.branchName}
            </span>
            {isSTier && (
              <span class="text-toxic-400 font-semibold flex items-center gap-1">
                ⭐ {lang === 'ru' ? 'Приоритет' : 'Priority'}
              </span>
            )}
          </div>
        </div>
      );
    })}
  </div>

  <!-- Empty Results State -->
  <div id="tech-no-results" class="hidden mt-8 rounded-2xl border border-dashed border-stone-800 p-8 text-center text-sm text-stone-400">
    <p class="text-3xl mb-2">🔬</p>
    <p>{t.noResults}</p>
  </div>
</section>

<script>
  function initCollegeExplorer() {
    const input = document.getElementById('tech-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('tech-clear-btn');
    const cards = document.querySelectorAll<HTMLElement>('.tech-card');
    const branchBtns = document.querySelectorAll<HTMLButtonElement>('.tech-branch-btn');
    const prioritySelect = document.getElementById('tech-priority-select') as HTMLSelectElement | null;
    const countSpan = document.getElementById('tech-count');
    const noResults = document.getElementById('tech-no-results');

    if (!cards.length) return;

    let activeBranch = 'all';
    let activePriority = 'all';

    function filterTechs() {
      const query = (input?.value || '').trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const b = card.dataset.branch || '';
        const p = card.dataset.priority || '';
        const searchTarget = card.dataset.search || '';

        const matchesBranch = activeBranch === 'all' || b === activeBranch;
        const matchesPriority = activePriority === 'all' || p === activePriority;
        const matchesQuery = !query || searchTarget.includes(query);

        if (matchesBranch && matchesPriority && matchesQuery) {
          card.style.display = 'flex';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });

      if (countSpan) countSpan.textContent = visible.toString();
      if (noResults) {
        noResults.style.display = visible === 0 ? 'block' : 'none';
      }
      if (clearBtn) {
        clearBtn.style.display = query.length > 0 ? 'block' : 'none';
      }
    }

    if (input) {
      input.addEventListener('input', filterTechs);
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (input) {
          input.value = '';
          input.focus();
          filterTechs();
        }
      });
    }

    if (prioritySelect) {
      prioritySelect.addEventListener('change', () => {
        activePriority = prioritySelect.value;
        filterTechs();
      });
    }

    branchBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeBranch = btn.dataset.branch || 'all';

        branchBtns.forEach((b) => {
          if (b === btn) {
            b.classList.remove('bg-stone-900/60', 'text-stone-400');
            b.classList.add('bg-toxic-500', 'text-stone-950', 'shadow-[0_0_15px_rgba(180,255,57,0.3)]');
          } else {
            b.classList.remove('bg-toxic-500', 'text-stone-950', 'shadow-[0_0_15px_rgba(180,255,57,0.3)]');
            b.classList.add('bg-stone-900/60', 'text-stone-400');
          }
        });

        filterTechs();
      });
    });
  }

  initCollegeExplorer();
  document.addEventListener('astro:page-load', initCollegeExplorer);
</script>
