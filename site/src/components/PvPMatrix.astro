    bonusText: '+25% d\'avantage de dégâts en combat',
    frontline: 'Première ligne recommandée (Tanks) :',
    backline: 'Arrière-garde recommandée (Carries / Support) :',
    tactics: 'Conseils tactiques clés :',
    chooseNone: '-- Choisir un carry (optionnel) --',
  },
  id: {
    title: 'Matriks Counter & Kalkulator PvP',
    subtitle: 'Pemilihan formasi taktis berdasarkan segitiga kelas dan counter hero lawan',
    selectClass: 'Kelas Utama Musuh:',
    selectCarry: 'ATAU Hero Carry Musuh:',
    warrior: '⚔️ Warrior (Prajurit)',
    ranger: '🏹 Ranger (Pemanah)',
    sorcerer: '🧙‍♂️ Sorcerer (Penyihir)',
    counterClass: 'Kelas Counter yang Direkomendasikan:',
    bonusText: '+25% keunggulan damage tempur',
    frontline: 'Garis Depan Direkomendasikan (Tank):',
    backline: 'Garis Belakang Direkomendasikan (Carry / Support):',
    tactics: 'Saran Taktis Kunci:',
    chooseNone: '-- Pilih Carry (Opsional) --',
  },
  ja: {
    title: 'PvP相性マトリクス＆カウンター計算機',
    subtitle: '兵種相性三角関係と敵エース英雄対策に基づく最適編成シミュレーター',
    selectClass: '敵の主要クラス：',
    selectCarry: 'または敵のエース英雄（Carry）：',
    warrior: '⚔️ 戦士（Warriors）',
    ranger: '🏹 射手（Rangers）',
    sorcerer: '🧙‍♂️ 魔導士（Sorcerers）',
    counterClass: '推奨カウンタークラス：',
    bonusText: '戦闘時ダメージ+25%有利ボーナス',
