  },
  fr: {
    title: 'Matrice de Contre PvP & Formations',
    subtitle: 'Sélection d\'équipe basée sur le triangle des classes et le contre des héros adverses',
    selectClass: 'Classe principale ennemie :',
    selectCarry: 'OU Héros carry adverse :',
