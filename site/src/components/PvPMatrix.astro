    subtitle: 'Taktische Teamauswahl basierend auf Klassen-Vorteilen und Helden-Kontern',
    selectClass: 'Hauptklasse des Gegners:',
    selectCarry: 'ODER gegnerischer Carry-Held:',
    warrior: '⚔️ Krieger (Warriors)',
    ranger: '🏹 Waldläufer (Rangers)',
    sorcerer: '🧙‍♂️ Zauberer (Sorcerers)',
    counterClass: 'Empfohlene Konter-Klasse:',
