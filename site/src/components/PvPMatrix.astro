  },
  es: {
    title: 'Matriz de Contraataque y Calculadora PvP',
    subtitle: 'Elección táctica de equipo basada en el triángulo de clases y héroes carry enemigos',
    selectClass: 'Clase principal enemiga:',
    selectCarry: 'O héroe carry enemigo:',
    warrior: '⚔️ Guerreros',
    ranger: '🏹 Tiradores',
    sorcerer: '🧙‍♂️ Hechiceros',
    counterClass: 'Clase recomendada de contraataque:',
    bonusText: '+25% de ventaja de daño en combate',
    frontline: 'Vanguardia recomendada (Tanques):',
    backline: 'Línea trasera recomendada (Carries / Soporte):',
