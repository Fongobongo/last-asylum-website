---

<section class="not-prose my-10 rounded-2xl border border-stone-800 bg-stone-950/80 p-5 shadow-2xl backdrop-blur-sm sm:p-8">
  <div class="border-b border-stone-800/80 pb-6">
    <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-950/60 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-emerald-400">
      🛡️ Alliance Technology
    </span>
    <h2 class="mt-2 text-2xl font-black tracking-tight text-stone-100 sm:text-3xl">
      {t.title}
    </h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-stone-400">
      {t.subtitle}
    </p>

    <!-- Auto Rally Spotlight -->
    <div class="mt-6 rounded-xl border border-emerald-500/40 bg-emerald-950/30 p-4 sm:p-5">
      <div class="flex items-start gap-3">
        <span class="text-2xl">🚨</span>
        <div>
          <h3 class="text-sm font-bold text-emerald-300 sm:text-base">
            {t.coreTitle}
          </h3>
          <p class="mt-1 text-xs leading-relaxed text-stone-300 sm:text-sm">
            {t.coreDesc}
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Tech Grid -->
  <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {techs.map((tech: any) => {
      const techName = tech.name?.[lang] || tech.name?.en;
      const techDesc = tech.desc?.[lang] || tech.desc?.en;
      const isCore = tech.isCore;

      return (
        <div class={`rounded-xl border p-4 transition-all hover:border-stone-700 ${isCore ? 'border-emerald-500/50 bg-emerald-950/20' : 'border-stone-800/90 bg-stone-900/60'}`}>
          <div class="flex items-center justify-between">
            <h4 class="font-bold text-stone-100 text-sm">
              {isCore ? '🔥 ' : '⚡ '}{techName}
            </h4>
            <span class="rounded bg-stone-800 px-2 py-0.5 text-[10px] font-mono text-stone-400">
              ID #{tech.id}
            </span>
          </div>
          <p class="mt-2 text-xs leading-relaxed text-stone-300">
            {techDesc}
          </p>
        </div>
      );
    })}
  </div>
</section>
