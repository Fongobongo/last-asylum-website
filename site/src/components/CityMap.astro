    background: rgba(255, 255, 255, 0.1); color: #fff;
  }
  #cm-app .cm-chip.is-on {
    background: #b4ff39; border-color: #b4ff39; color: #10130a; font-weight: 700;
  }
  #cm-app .cm-iconbtn { min-width: 34px; height: 32px; font-size: 16px; padding: 0 8px; }
  #cm-app .cm-btn {
    border: 1px solid rgba(180, 255, 57, 0.45); border-radius: 8px;
    background: linear-gradient(180deg, #b4ff39, #84cc16); color: #10130a;
    font-size: 12px; font-weight: 800; padding: 9px 12px; cursor: pointer;
    transition: filter .15s;
  }
  #cm-app .cm-btn:hover { filter: brightness(1.12); }
  #cm-app .cm-btn-ghost { justify-content: flex-start; }
  #cm-app .cm-seg { display: inline-flex; border: 1px solid rgba(255,255,255,.09); border-radius: 9px; overflow: hidden; }
  #cm-app .cm-seg button {
    border: 0; border-right: 1px solid rgba(255,255,255,.07);
    background: rgba(255,255,255,.03); color: #a8a29e;
    font-size: 11px; padding: 6px 10px; cursor: pointer; white-space: nowrap;
  }
  #cm-app .cm-seg button:last-child { border-right: 0; }
  #cm-app .cm-seg button.is-on { background: #b4ff39; color: #10130a; font-weight: 800; }
  #cm-app .cm-input, #cm-app .cm-select {
    border: 1px solid rgba(255,255,255,.1); border-radius: 8px;
    background: rgba(8,8,7,.75); color: #e7e5e4;
    font-size: 12px; padding: 7px 10px; outline: none; max-width: 220px;
  }
  #cm-app .cm-select { cursor: pointer; }
  #cm-app .cm-input:focus, #cm-app .cm-select:focus { border-color: #b4ff39; }
  #cm-app .cm-input::placeholder { color: #78716c; }

  #cm-app .cm-map-wrap {
    background: radial-gradient(circle at 50% 45%, #1b211a 0%, #0b0d0a 78%);
    padding: 8px; overflow: hidden;
  }
  #cm-svg { width: 100%; height: auto; display: block; cursor: grab; touch-action: none; user-select: none; }
  #cm-svg:active { cursor: grabbing; }
  #cm-app .cm-poly {
    stroke: #0b0e0a; stroke-width: 1.4; stroke-linejoin: round;
    cursor: pointer; transition: opacity .18s, fill .18s, stroke-width .18s;
    outline: none;
  }
  #cm-app .cm-poly:hover { filter: brightness(1.22); }
  #cm-app .cm-poly:focus-visible { stroke: #fff; stroke-width: 4; }
  #cm-app .cm-poly.cm-dim { opacity: .1; pointer-events: none; }
  #cm-app .cm-poly.cm-selected { stroke: #fff !important; stroke-width: 5 !important; stroke-dasharray: 9 5; }
  #cm-app .cm-label { transition: opacity .18s; direction: ltr; unicode-bidi: plaintext; }
  #cm-app .cm-label.cm-dim { opacity: .08; }
  #cm-app .cm-label text {
    text-anchor: middle; font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    fill: #fff; stroke: rgba(10, 14, 9, .78); stroke-width: 2.6px;
