---
import {
  CITIES, MAP_W, MAP_H, LEVEL_COLORS, LEVEL_HP, LEVEL_GARRISON,
  BONUS_KEYS, BONUS_LABELS, BONUS_HUES,
  BONUS_KIND, BONUS_SPRITE, BORDER_PATH,
  GENERIC_NAMES, NAMED_CITIES, UI,
  ALLIANCE_COLORS, ALLIANCE_ICONS,
  type BonusKey, type BonusKind,
} from '../data/cityMap';
import type { Lang } from '../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const S = UI[lang] ?? UI.en;
const B = BONUS_LABELS[lang] ?? BONUS_LABELS.en;
const G = GENERIC_NAMES[lang] ?? GENERIC_NAMES.en;
const levels = [1, 2, 3, 4, 5, 6];
const STAGES = 7;

const nameOf = (c: (typeof CITIES)[number]): string =>
  c.name
    ? (NAMED_CITIES[c.name]?.[lang] ?? NAMED_CITIES[c.name]?.en ?? c.name)
    : (G[c.lv] ?? GENERIC_NAMES.en[c.lv]);
const shortOf = (c: (typeof CITIES)[number]): string =>
  c.bonus ? B[c.bonus as BonusKey].short : '';
const fullOf = (c: (typeof CITIES)[number]): string =>
  c.bonus ? B[c.bonus as BonusKey].full : '';

/* In-cell badges carry almost no text: one sign for production, a different
   one for gathering, a third for the speed bonuses; then the real in-game
   resource sprite and just "+N%". The localized prose stays in the legend,
   the detail panel and the city directory. */
const SIGN_PATHS: Record<BonusKind, string> = {
  // an arrow leaving a tray = output / production
  output: 'M8 1 L13 6 H10.3 V10 H5.7 V6 H3 Z M2.5 11.4 H13.5 V14 H2.5 Z',
  // an arrow entering from above = gathering / collecting
  gather: 'M8 15 L3 10 H5.7 V6 H10.3 V10 H13 Z M2.5 2 H13.5 V4.6 H2.5 Z',
  speed: 'M9.2 1 L3.4 8.7 H7.1 L6.2 15 L12.6 7 H8.8 Z',
};
const SIGN_COLORS: Record<BonusKind, string> = {
  output: '#ffd166', gather: '#67e8f9', speed: '#c4b5fd',
};
const SIGN_TITLES: Record<BonusKind, string> = {
  output: S.kindOutput, gather: S.kindGather, speed: S.kindSpeed,
};
const kindOf = (c: (typeof CITIES)[number]): BonusKind | null =>
  c.bonus ? BONUS_KIND[c.bonus as BonusKey] : null;

// Bonus magnitude -> colour. +5% is a muted shade, +20% is vivid; saturation
// carries the strength so the value colour itself encodes the bonus size.
const ramp = (v: number) => Math.max(0, Math.min(1, (v - 5) / 15));
const fillFor = (k: BonusKey, v: number) =>
  `hsl(${BONUS_HUES[k]} ${Math.round(34 + 56 * ramp(v))}% ${Math.round(24 + 12 * ramp(v))}%)`;
const inkFor = (k: BonusKey, v: number) =>
  `hsl(${BONUS_HUES[k]} ${Math.round(50 + 45 * ramp(v))}% ${Math.round(62 + 14 * ramp(v))}%)`;

const payload = {
  s: S, b: B, keys: BONUS_KEYS, colors: LEVEL_COLORS,
  hp: LEVEL_HP, garrison: LEVEL_GARRISON,
  palette: ALLIANCE_COLORS, icons: ALLIANCE_ICONS,
  bhues: BONUS_HUES,
  kinds: BONUS_KIND, sprites: BONUS_SPRITE,
  signs: SIGN_PATHS, signInk: SIGN_COLORS, signTitles: SIGN_TITLES,
  mapW: MAP_W, mapH: MAP_H, lang,
};
---

<script is:inline define:vars={{ CM_DATA: payload }}>
  window.__CM_DATA__ = CM_DATA;
</script>

<div id="cm-app" class="mx-auto max-w-[1600px] px-3 sm:px-5 pb-16" data-lang={lang}>
  <!-- ══ Heading ══════════════════════════════════════════════════════ -->
  <header class="pt-8 sm:pt-12 pb-5">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <div class="mb-2 inline-flex items-center gap-2 rounded-full border border-toxic-400/25 bg-toxic-400/[0.06] px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.16em] text-toxic-300">
          🗺️ {S.legend} · {lang.toUpperCase()}
        </div>
        <h1 class="display text-3xl sm:text-5xl text-stone-50">{S.title}</h1>
        <p class="mt-3 max-w-3xl text-sm sm:text-base leading-relaxed text-stone-400">{S.subtitle}</p>
      </div>
      <div class="flex flex-wrap gap-2 text-xs">
        <div class="rounded-xl border border-white/[0.07] bg-white/[0.03] px-3 py-2"><span id="cm-stat-total" class="font-mono text-stone-500">87</span> <span class="text-stone-300">{S.cityList}</span></div>
        <div class="rounded-xl border border-white/[0.07] bg-white/[0.03] px-3 py-2"><span id="cm-stat-held" class="font-mono font-bold text-toxic-300">0</span> <span class="text-stone-300">{S.heldCities}</span></div>
        <div class="rounded-xl border border-white/[0.07] bg-white/[0.03] px-3 py-2"><span id="cm-stat-free" class="font-mono font-bold text-plague-300">87</span> <span class="text-stone-300">{S.freeCities}</span></div>
        <div class="rounded-xl border border-white/[0.07] bg-white/[0.03] px-3 py-2"><span id="cm-stat-alliances" class="font-mono font-bold text-sky-300">0</span> <span class="text-stone-300">{S.alliances}</span></div>
      </div>
    </div>
    <p class="mt-4 text-xs leading-relaxed text-stone-500">{S.sourceNote} <a href="/img/city-map-original.jpg" target="_blank" rel="noopener noreferrer" class="text-plague-300 underline decoration-dotted hover:text-plague-200">{S.original} ↗</a></p>
  </header>

  <!-- ══ Maps: library, sharing, access ══════════════════════════════ -->
  <section class="cm-panel mb-4 p-4">
    <div class="cm-stage-slot" data-slot="maps"></div>

    <div class="mt-2.5 flex flex-wrap items-end gap-2">
      <label class="cm-field w-[230px]">
        <span class="cm-cap">{S.maps}</span>
        <select id="cm-map-select" class="cm-select w-full"></select>
      </label>
      <button id="cm-new-map" class="cm-btn-ghost">＋ {S.newMap}</button>
      <button id="cm-save-online" class="cm-btn">💾 {S.saveOnline}</button>
      <button id="cm-fork" class="cm-btn-ghost" title={S.forkHint}>⑂ {S.forkMap}</button>
      <button id="cm-copy-link" class="cm-btn-ghost" title={S.shareHint}>🔗 {S.copyLink}</button>
      <button id="cm-delete-map" class="cm-btn-ghost cm-danger">🗑 {S.deleteMap}</button>
      <span id="cm-save-status" class="ml-auto text-[11px] text-stone-500"></span>
    </div>

    <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <label class="cm-field">
        <span class="cm-cap">{S.mapName}</span>
        <input id="cm-map-name" class="cm-input w-full" type="text" maxlength="80" placeholder={S.namePlaceholder} autocomplete="off" />
      </label>
      <label class="cm-field">
        <span class="cm-cap">{S.server}</span>
        <input id="cm-map-server" class="cm-input w-full" type="text" maxlength="40" placeholder="S1 · EU-3" autocomplete="off" />
      </label>
      <label class="cm-field">
        <span class="cm-cap">{S.readMode}</span>
        <select id="cm-read-mode" class="cm-select w-full">
          <option value="public">{S.accessPublic}</option>
          <option value="password">{S.password}</option>
          <option value="owner">{S.accessNone}</option>
        </select>
      </label>
      <label class="cm-field">
        <span class="cm-cap">{S.writeMode}</span>
        <select id="cm-write-mode" class="cm-select w-full">
          <option value="open">{S.accessPublic}</option>
          <option value="password">{S.password}</option>
          <option value="owner">{S.accessNone}</option>
        </select>
      </label>
    </div>

    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      <label class="cm-field" id="cm-read-pw-wrap">
        <span class="cm-cap">🔒 {S.readPassword}</span>
        <input id="cm-read-pw" class="cm-input w-full" type="password" autocomplete="new-password" placeholder={S.enterPassword} />
      </label>
      <label class="cm-field" id="cm-write-pw-wrap">
        <span class="cm-cap">✏️ {S.writePassword}</span>
        <input id="cm-write-pw" class="cm-input w-full" type="password" autocomplete="new-password" placeholder={S.enterPassword} />
      </label>
    </div>
    <p id="cm-pw-hint" class="mt-1.5 text-[11px] leading-snug text-stone-500">{S.passwordOptional}</p>

    <div class="mt-3 flex flex-wrap items-center gap-2 rounded-lg border border-white/[0.06] bg-black/25 px-3 py-2 text-[11px] text-stone-400">
      <span class="cm-cap">🔑 {S.ownerKey}</span>
      <code id="cm-owner-key" class="max-w-[240px] truncate font-mono text-[11px] text-stone-300">—</code>
      <button id="cm-copy-owner" class="cm-btn-ghost" title={S.copyOk}>⧉</button>
      <span class="ml-auto text-stone-600">{S.forkHint}</span>
    </div>

    <div id="cm-ro-banner" class="mt-3 hidden items-center gap-2 rounded-lg border border-amber-500/30 bg-amber-500/[0.07] px-3 py-2 text-[12px] text-amber-200">
      <span>🔒</span>
      <span id="cm-ro-text"></span>
      <button id="cm-unlock-write" class="cm-btn-ghost ml-auto hidden">🔓 {S.unlock}</button>
    </div>

    <details class="mt-3 group">
      <summary class="cursor-pointer select-none text-[11px] font-semibold uppercase tracking-widest text-stone-400 hover:text-stone-200">🌐 {S.publicMaps}</summary>
      <div id="cm-public-list" class="mt-2 space-y-1.5"></div>
    </details>
  </section>

  <!-- ══ Stage selector ══════════════════════════════════════════════ -->
  <section class="cm-panel mb-4 p-4">
    <div class="flex flex-wrap items-center gap-3">
      <span class="cm-cap">{S.stage}</span>
      <div id="cm-stages" class="flex flex-wrap gap-1">
        {[1, 2, 3, 4, 5, 6, 7].map((n) => (
          <button class="cm-stagebtn" data-stage={n} title={`${S.stage} ${n}`}>
            <span class="cm-stagebtn-pip" style={`background:${LEVEL_COLORS[n]}`}></span>{n}
          </button>
        ))}
      </div>
      <button id="cm-copy-prev" class="cm-btn-ghost">⧉ {S.copyPrev}</button>
      <span id="cm-stage-note" class="text-[11px] text-stone-500"></span>
    </div>
    <p class="mt-2 text-[11px] leading-snug text-stone-500">{S.paintHint}</p>
  </section>

  <!-- ══ Toolbar ══════════════════════════════════════════════════════ -->
  <div class="cm-panel mb-4 p-3 sm:p-4">
    <div class="cm-stage-slot mb-2.5" data-slot="toolbar"></div>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
      <div class="flex items-center gap-2">
        <span class="cm-cap">{S.filters}</span>
        <div id="cm-levels" class="flex flex-wrap gap-1">
          <button class="cm-chip is-on" data-level="all">{S.all}</button>
          {levels.map((l) => (
            <button class="cm-chip" data-level={l}>
              <span class="inline-block h-2 w-2 rounded-sm" style={`background:${LEVEL_COLORS[l]}`}></span>
              Lv.{l}
            </button>
          ))}
          <button class="cm-chip" data-level="7" title={S.royal}>👑</button>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <span class="cm-cap">{S.bonus}</span>
        <div id="cm-bonuses" class="flex flex-wrap gap-1">
          {BONUS_KEYS.map((k) => (
            <button class="cm-chip" data-bonus={k} title={B[k].full}>
              <svg class="cm-signicon" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
                <path d={SIGN_PATHS[BONUS_KIND[k]]} fill={SIGN_COLORS[BONUS_KIND[k]]} />
              </svg>
              <img class="cm-resicon" src={BONUS_SPRITE[k]} width="17" height="17" alt="" loading="lazy" />
              {B[k].short}
            </button>
          ))}
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <label class="cm-cap" for="cm-owner-filter">{S.owner}</label>
        <select id="cm-owner-filter" class="cm-select"></select>
        <input id="cm-search" class="cm-input" type="search" placeholder={S.search} autocomplete="off" />
      </div>
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-white/[0.06] pt-3">
      <div class="flex items-center gap-2">
        <span class="cm-cap">{S.viewLevels}</span>
        <div id="cm-view" class="cm-seg">
          <button class="is-on" data-view="levels">{S.viewLevels}</button>
          <button data-view="owners">{S.viewOwners}</button>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <span class="cm-cap">{S.labels}</span>
        <div id="cm-labelmode" class="cm-seg">
          <button class="is-on" data-label="full">{S.full}</button>
          <button data-label="compact">{S.compact}</button>
          <button data-label="off">{S.off}</button>
        </div>
      </div>
      <div class="flex items-center gap-1.5">
        <button id="cm-zoom-in" class="cm-iconbtn" title={S.zoomIn} aria-label={S.zoomIn}>＋</button>
        <button id="cm-zoom-out" class="cm-iconbtn" title={S.zoomOut} aria-label={S.zoomOut}>−</button>
        <button id="cm-fit" class="cm-iconbtn text-[11px] px-3" title={S.fit}>{S.fit}</button>
      </div>
      <label class="flex cursor-pointer items-center gap-2 text-xs text-stone-300">
        <input id="cm-paint-mode" type="checkbox" class="accent-toxic-400 h-4 w-4" />
        <span>{S.assignTo}</span>
      </label>
      <select id="cm-paint" class="cm-select"></select>
    </div>
  </div>

  <!-- ══ Map + side panel ═════════════════════════════════════════════ -->
  <div class="grid gap-4 xl:grid-cols-[minmax(0,1fr)_360px]">
    <section id="cm-map-card" class="cm-panel overflow-hidden">
      <div class="cm-stage-slot px-4 pt-3" data-slot="map"></div>
      <div class="cm-map-wrap">
        <svg id="cm-svg" viewBox={`0 0 ${MAP_W} ${MAP_H}`} role="img" aria-label={S.title}
             preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
          <g id="cm-territories">
            {CITIES.map((c) => (
              <polygon
                class:list={['cm-poly', c.tiny ? 'cm-tiny' : '']}
                points={c.poly}
                fill={LEVEL_COLORS[c.lv]}
                data-id={c.id}
                data-lv={c.lv}
                data-bonus={c.bonus}
                data-value={c.value}
                data-name={nameOf(c)}
                data-full={fullOf(c)}
                data-short={shortOf(c)}
                data-x={c.lx - 60}
                data-y={c.ly - 45}
                data-w="120"
                data-h="90"
                data-bx={c.bx}
                data-by={c.by}
                tabindex="0"
                role="button"
                aria-label={`${nameOf(c)} · ${c.id} · Lv.${c.lv}`}
              >
                <title>{nameOf(c)} · {c.id} · Lv.{c.lv}{c.bonus ? ` · ${fullOf(c)} +${c.value}%` : ''}</title>
              </polygon>
            ))}
          </g>
          <!-- Every shared border is drawn exactly once, from the straightened
               geometry, so there are no doubled antialiased strokes. -->
          <path id="cm-borders" d={BORDER_PATH} pointer-events="none" />
          <g id="cm-badges" pointer-events="none"></g>
          <g id="cm-labels" data-mode="full" pointer-events="none">
            {CITIES.map((c) => (
              <g class:list={['cm-label', c.tiny ? 'cm-tiny' : '']} data-id={c.id} data-cw={c.cw}>
                <text class="cm-name" x={c.lx} y={c.ly - 27}>{nameOf(c)}</text>
                <text class="cm-lv" x={c.lx} y={c.ly - 12}>Lv.{c.lv}</text>
                {c.lv === 7 ? (
                  <text class="cm-royal" x={c.lx} y={c.ly + 8}>👑</text>
                ) : !c.bonus ? (
                  <text class="cm-none" x={c.lx} y={c.ly + 6}>{S.noBonus}</text>
                ) : (
                  <g class="cm-bonus" data-id={c.id} data-cx={c.lx} data-cy={c.ly + 9}>
                    <title>{SIGN_TITLES[kindOf(c) as BonusKind]} · {fullOf(c)} +{c.value}%</title>
                    <path class="cm-sign"
                          d={SIGN_PATHS[kindOf(c) as BonusKind]}
                          transform={`translate(${c.lx - 37} ${c.ly + 3}) scale(.875)`}
                          fill={SIGN_COLORS[kindOf(c) as BonusKind]} />
                    <image class="cm-rico" href={BONUS_SPRITE[c.bonus as BonusKey]}
                           x={c.lx - 21} y={c.ly - 1} width="20" height="20"
                           preserveAspectRatio="xMidYMid meet" />
                    <text class="cm-val" x={c.lx + 18} y={c.ly + 16}
                          data-vx={c.lx + 18} data-cx={c.lx}
                          style={`fill:${inkFor(c.bonus as BonusKey, c.value)}`}>+{c.value}%</text>
                  </g>
                )}
              </g>
            ))}
          </g>
        </svg>
      </div>
      <div class="border-t border-white/[0.06] px-4 py-3">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <span class="cm-cap">{S.legend}</span>
          {levels.map((l) => (
            <span class="inline-flex items-center gap-1.5 text-[11px] text-stone-400">
              <span class="inline-block h-3 w-3 rounded-sm border border-black/40" style={`background:${LEVEL_COLORS[l]}`}></span>
              Lv.{l}
            </span>
          ))}
          <span class="inline-flex items-center gap-1.5 text-[11px] text-stone-400">
            <span class="inline-block h-3 w-3 rounded-sm border border-black/40" style={`background:${LEVEL_COLORS[7]}`}></span>
            {S.royal}
          </span>
          <span class="inline-flex items-center gap-1.5 text-[11px] text-stone-500">
            <span class="inline-block h-3 w-3 rounded-sm border border-dashed border-white/25"></span>
            {S.locked}
          </span>
        </div>
        <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1.5">
          <span class="cm-cap">{S.bonus}</span>
          {(Object.keys(SIGN_PATHS) as BonusKind[]).map((kind) => (
            <span class="inline-flex items-center gap-1.5 text-[11px] text-stone-400">
              <svg class="cm-signicon" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                <path d={SIGN_PATHS[kind]} fill={SIGN_COLORS[kind]} />
              </svg>
              <span>{SIGN_TITLES[kind]}</span>
            </span>
          ))}
        </div>
        <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1.5">
          {BONUS_KEYS.map((k) => (
            <span class="inline-flex items-center gap-1.5 text-[11px] text-stone-400" title={B[k].full}>
              <svg class="cm-signicon" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
                <path d={SIGN_PATHS[BONUS_KIND[k]]} fill={SIGN_COLORS[BONUS_KIND[k]]} />
              </svg>
              <img class="cm-resicon" src={BONUS_SPRITE[k]} width="17" height="17" alt="" loading="lazy" />
              <span>{B[k].short}</span>
              <span class="inline-flex gap-[3px]">
                {[5, 10, 15, 20].map((v) => (
                  <i class="cm-ramp" style={`background:${fillFor(k, v)}`} title={`+${v}%`}></i>
                ))}
              </span>
            </span>
          ))}
        </div>
      </div>
    </section>

    <aside class="flex flex-col gap-4">
      <!-- Alliances -->
      <section class="cm-panel p-4">
        <div class="cm-stage-slot" data-slot="alliances"></div>
        <div class="mb-3 mt-2 flex items-center justify-between">
          <h2 class="text-sm font-bold uppercase tracking-widest text-stone-300">🛡️ {S.alliances}</h2>
          <span id="cm-alliance-count" class="font-mono text-xs text-stone-500">0</span>
        </div>
        <div id="cm-alliance-list" class="space-y-1.5"></div>

        <div class="mt-4 rounded-xl border border-white/[0.07] bg-black/20 p-3">
          <input id="cm-new-name" class="cm-input w-full" type="text" maxlength="40" placeholder={S.namePlaceholder} />
          <div class="mt-2.5 text-[10px] uppercase tracking-widest text-stone-500">🎨 {S.colorLabel}</div>
          <div id="cm-colors" class="mt-1.5 flex flex-wrap gap-1.5">
            {ALLIANCE_COLORS.map((col, i) => (
              <button class="cm-swatch" data-color={col} style={`background:${col}`} aria-label={col} class:list={[i === 0 ? 'is-on' : '']}></button>
            ))}
          </div>
          <div class="mt-2.5 text-[10px] uppercase tracking-widest text-stone-500">🛡️ {S.iconLabel}</div>
          <div id="cm-icons" class="mt-1.5 flex flex-wrap gap-1">
            {ALLIANCE_ICONS.map((ic, i) => (
              <button class="cm-emoji" data-icon={ic} class:list={[i === 0 ? 'is-on' : '']}>{ic}</button>
            ))}
          </div>
          <div class="mt-3 flex gap-2">
            <button id="cm-save-alliance" class="cm-btn flex-1">{S.add}</button>
            <button id="cm-cancel-edit" class="cm-btn-ghost hidden">✕</button>
          </div>
        </div>

        <div class="mt-3 grid grid-cols-2 gap-2">
          <button id="cm-share" class="cm-btn-ghost" title={S.shareHint}>🔗 {S.copyLink}</button>
          <button id="cm-clear" class="cm-btn-ghost">🧹 {S.clearAll}</button>
          <button id="cm-export" class="cm-btn-ghost">⬇ {S.export}</button>
          <button id="cm-import" class="cm-btn-ghost">⬆ {S.import}</button>
          <input id="cm-file" type="file" accept="application/json,.json" class="hidden" />
        </div>
      </section>

      <!-- City details -->
      <section class="cm-panel p-4">
        <div class="cm-stage-slot" data-slot="details"></div>
        <h2 class="mb-3 mt-2 text-sm font-bold uppercase tracking-widest text-stone-300">📍 {S.colCity}</h2>
        <div id="cm-details" class="text-sm text-stone-400">{S.details}</div>
      </section>
    </aside>
  </div>

  <!-- ══ Bonus totals ═════════════════════════════════════════════════ -->
  <section class="mt-6">
    <div class="cm-stage-slot mb-3" data-slot="summary"></div>
    <h2 class="display mb-3 text-xl text-stone-100">📊 {S.bonusTotals}</h2>
    <div id="cm-summary" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"></div>
  </section>

  <!-- ══ City directory ══════════════════════════════════════════════ -->
  <section class="mt-8">
    <div class="cm-stage-slot mb-3" data-slot="directory"></div>
    <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="display text-xl text-stone-100">📋 {S.cityList}</h2>
      <span id="cm-table-count" class="font-mono text-xs text-stone-500">87</span>
    </div>
    <div class="cm-panel overflow-hidden">
      <div class="cm-table-scroll">
        <table class="w-full text-left text-sm">
          <thead class="sticky top-0 z-10 bg-[#14140f] text-[10px] uppercase tracking-widest text-stone-500">
            <tr>
              <th class="px-3 py-2.5 font-semibold">#</th>
              <th class="px-3 py-2.5 font-semibold">{S.colCity}</th>
              <th class="px-3 py-2.5 font-semibold">{S.level}</th>
              <th class="px-3 py-2.5 font-semibold">{S.colBonus}</th>
              <th class="px-3 py-2.5 font-semibold">{S.colOwner}</th>
            </tr>
          </thead>
          <tbody id="cm-table-body"></tbody>
        </table>
      </div>
      <p id="cm-no-match" class="hidden px-4 py-6 text-center text-sm text-stone-500">{S.noMatch}</p>
    </div>
  </section>

  <!-- ══ Password modal ══════════════════════════════════════════════ -->
  <div id="cm-modal" class="cm-modal hidden" role="dialog" aria-modal="true" aria-labelledby="cm-modal-title">
    <div class="cm-modal-box">
      <h3 id="cm-modal-title" class="text-sm font-bold uppercase tracking-widest text-stone-200"></h3>
      <p id="cm-modal-text" class="mt-2 text-xs leading-relaxed text-stone-400"></p>
      <input id="cm-modal-input" class="cm-input mt-3 w-full" type="password" autocomplete="current-password" placeholder={S.enterPassword} />
      <p id="cm-modal-error" class="mt-2 hidden text-[11px] text-rose-400">{S.badPassword}</p>
      <div class="mt-4 flex justify-end gap-2">
        <button id="cm-modal-cancel" class="cm-btn-ghost">{S.cancel}</button>
        <button id="cm-modal-ok" class="cm-btn">🔓 {S.unlock}</button>
      </div>
    </div>
  </div>

  <div id="cm-toast" class="cm-toast" role="status" aria-live="polite"></div>
</div>

<script>
  (function () {
    function init() {
      if (window.__cmReady) return;
      var D = window.__CM_DATA__;
      var root = document.getElementById('cm-app');
      if (!D || !root) return;
      window.__cmReady = true;

      var S = D.s, B = D.b, KEYS = D.keys, LCOL = D.colors, HP = D.hp, GAR = D.garrison;
      var BHUE = D.bhues;
      var KINDS = D.kinds, SPRITES = D.sprites, SIGNS = D.signs, SIGNINK = D.signInk;
      var MW = D.mapW, MH = D.mapH, RATIO = MH / MW;
      var STAGES = 7;
      var LS = 'lap_citymap_v2';

      var svg = document.getElementById('cm-svg');
      var polys = Array.prototype.slice.call(svg.querySelectorAll('.cm-poly'));
      var byId = new Map(polys.map(function (p) { return [p.dataset.id, p]; }));
      var TOTAL = byId.size;
      var badgeLayer = document.getElementById('cm-badges');
      var labelLayer = document.getElementById('cm-labels');
      var labels = Array.prototype.slice.call(labelLayer.querySelectorAll('.cm-label'));
      var labelById = new Map(labels.map(function (g) { return [g.dataset.id, g]; }));

      /* City names come from the game in 19 languages and can be long. The
         territories are traced from the in-game picture, so many are L-shaped:
         the old traced anchor often sits in a narrow neck while the broad body
         of the same cell is 40-100px lower. Search the whole polygon for the
         widest strip that can hold the name AND still leaves room for the
         level line and the bonus badge, then fit the text to that strip. */
      /* Vertical envelope above a text baseline. At 11px the SVG bbox is
         ~11px tall for Latin text, but accented scripts (Ś, ą, ẞ, Thai marks)
         reach ~14px, so the strip must be validated that far up as well. */
      var LABEL_TOP = 14;

      function parsePoints(poly) {
        if (!poly) return null;
        if (poly._pts) return poly._pts;
        var raw = (poly.getAttribute('points') || '').trim();
        if (!raw) return null;
        poly._pts = raw.split(/\s+/).map(function (pair) {
          var n = pair.split(',');
          return [Number(n[0]), Number(n[1])];
        });
        return poly._pts;
      }

      /* horizontal extent of a polygon at height y, or null if it misses.
         The rectified territories are horizontally convex, so min/max of the
         crossings is the exact interior interval. */
      function spanAt(pts, y) {
        var xs = [];
        for (var i = 0; i < pts.length; i++) {
          var a = pts[i], b = pts[(i + 1) % pts.length];
          if ((a[1] <= y && b[1] > y) || (b[1] <= y && a[1] > y)) {
            xs.push(a[0] + (y - a[1]) * (b[0] - a[0]) / (b[1] - a[1]));
          }
        }
        if (xs.length < 2) return null;
        return [Math.min.apply(null, xs), Math.max.apply(null, xs)];
      }

      /* Precompute every integer pixel row once. Sampling at y+0.5 avoids
         ambiguous vertices on horizontal borders. */
      function spanTable(poly) {
        if (!poly) return null;
        if (poly._spanTable) return poly._spanTable;
        var pts = parsePoints(poly);
        if (!pts) return null;
        var yMin = Infinity, yMax = -Infinity;
        for (var i = 0; i < pts.length; i++) {
          if (pts[i][1] < yMin) yMin = pts[i][1];
          if (pts[i][1] > yMax) yMax = pts[i][1];
        }
        var from = Math.floor(yMin), to = Math.ceil(yMax);
        var spans = new Array(to - from + 1);
        for (var y = from; y <= to; y++) spans[y - from] = spanAt(pts, y + 0.5);
        poly._spanTable = { from: from, spans: spans };
        return poly._spanTable;
      }

      /* narrowest span that is inside the cell across the WHOLE band [y0, y1].
         A band clipped by the top or bottom edge is rejected so the three
         label lines never hang outside their own territory. */
      function bandSpan(poly, y0, y1) {
        var tab = spanTable(poly);
        if (!tab) return null;
        var first = tab.from, last = tab.from + tab.spans.length - 1;
        var a = Math.ceil(y0), b = Math.floor(y1);
        if (a < first || b > last || a > b) return null;
        var lo = -Infinity, hi = Infinity;
        for (var y = a; y <= b; y++) {
          var s = tab.spans[y - first];
          if (!s) return null;
          if (s[0] > lo) lo = s[0];
          if (s[1] < hi) hi = s[1];
          if (hi - lo < 8) return null;
        }
        return lo < hi ? [lo, hi] : null;
      }

      /* single horizontal slice, used only as a last-resort fallback */
      function sliceSpan(poly, y) {
        var tab = spanTable(poly);
        if (!tab) return null;
        var i = Math.round(y - 0.5) - tab.from;
        return tab.spans[Math.max(0, Math.min(tab.spans.length - 1, i))] || null;
      }

      /* Find the widest name strip in the whole territory. Four stack orders
         are tried: name/Lv/bonus, bonus/Lv/name, a 6px tighter name/Lv/bonus,
         and a tight one with the bonus above the name but Lv below it. The
         tight orders let a wide strip near the bottom of an L-shaped cell be
         used without pushing the badge out of the shape, while the mixed one
         keeps the 20px-tall badge from overlapping the "Lv." glyphs. Every
         line keeps its own horizontal centre; the name gets the max width. */
      function widestLabelLayout(poly, x0, y0) {
        var tab = spanTable(poly);
        if (!tab) return null;
        var first = tab.from + 1, last = tab.from + tab.spans.length - 2;
        var orders = [
          { lv: 15, badge: 36, special: 35, penalty: 0 },
          { lv: -15, badge: -36, special: -35, penalty: 2 },
          { lv: 15, badge: 30, special: 29, penalty: 4 },
          { lv: 15, badge: -30, special: -29, penalty: 6 },
        ];
        var best = null;
        for (var ny = first; ny <= last; ny += 1) {
          for (var oi = 0; oi < orders.length; oi++) {
            var o = orders[oi];
            var ns = bandSpan(poly, ny - LABEL_TOP, ny + 2);
            var ls = bandSpan(poly, ny + o.lv - LABEL_TOP, ny + o.lv + 2);
            var bs = bandSpan(poly, ny + o.badge - 10, ny + o.badge + 10);
            if (!ns || !ls || !bs) continue;
            var nw = ns[1] - ns[0], lw = ls[1] - ls[0], bw = bs[1] - bs[0];
            if (nw < 40 || lw < 26 || bw < 36) continue;
            /* Width dominates; the small distance term only breaks ties
               between equally wide strips in favour of the old anchor. */
            var score = nw * 4 + Math.min(lw, 100) + Math.min(bw, 100)
              - Math.abs(ny - y0) * 0.5 - o.penalty;
            if (!best || score > best.score) {
              best = {
                score: score, ny: ny, lvY: ny + o.lv, badgeY: ny + o.badge,
                specialY: ny + o.special, nameSpan: ns, levelSpan: ls,
                badgeSpan: bs, reversed: o.lv < 0,
              };
            }
          }
        }
        if (best) return best;
        /* Defensive fallback for a shape that cannot hold all three lines:
           keep the original stack order and use the widest slice near the
           traced anchor. */
        for (var fy = y0 - 10; fy <= y0 + 6; fy += 1) {
          var fs = bandSpan(poly, fy - LABEL_TOP, fy + 2) || sliceSpan(poly, fy);
          if (!fs) continue;
          var fw = fs[1] - fs[0];
          if (!best || fw > best.nameSpan[1] - best.nameSpan[0]) {
            best = {
              score: fw, ny: fy, lvY: fy + 15, badgeY: fy + 36,
              specialY: fy + 35, nameSpan: fs,
              levelSpan: bandSpan(poly, fy + 4, fy + 17) || [x0 - 30, x0 + 30],
              badgeSpan: bandSpan(poly, fy + 26, fy + 46) || [x0 - 30, x0 + 30],
              reversed: false,
            };
          }
        }
        return best;
      }

      /* Move the whole three-line label to the chosen strip. The bonus group
         is translated instead of rewriting every child, so fitBonusBadges()
         can still add its own horizontal clamp on top. */
      function applyLabelLayout(g, t, poly, L) {
        var mid = function (s) { return (s[0] + s[1]) / 2; };
        t.setAttribute('x', mid(L.nameSpan));
        t.setAttribute('y', L.ny);
        var lv = g.querySelector('.cm-lv');
        if (lv) { lv.setAttribute('x', mid(L.levelSpan)); lv.setAttribute('y', L.lvY); }
        var special = g.querySelector('.cm-royal, .cm-none');
        if (special) {
          var ss = bandSpan(poly, L.specialY - LABEL_TOP, L.specialY + 2) || L.nameSpan;
          special.setAttribute('x', mid(ss));
          special.setAttribute('y', L.specialY);
        }
        var badge = g.querySelector('.cm-bonus');
        if (badge) {
          if (!badge.getAttribute('data-cx0')) badge.setAttribute('data-cx0', badge.getAttribute('data-cx'));
          if (!badge.getAttribute('data-cy0')) badge.setAttribute('data-cy0', badge.getAttribute('data-cy'));
          var oldCx = Number(badge.getAttribute('data-cx0'));
          var oldCy = Number(badge.getAttribute('data-cy0'));
          var bcx = mid(L.badgeSpan);
          badge.setAttribute('data-cy', L.badgeY);
          badge.setAttribute('data-shift-x', (bcx - oldCx).toFixed(1));
          badge.setAttribute('data-shift-y', (L.badgeY - oldCy).toFixed(1));
        }
        g.setAttribute('data-layout', L.reversed ? 'above' : 'below');
        g.setAttribute('data-stack', (L.lvY - L.ny) + ',' + (L.badgeY - L.ny));
      }

      function fitNames() {
        labels.forEach(function (g) {
          var t = g.querySelector('.cm-name');
          if (!t) return;
          /* A tiny territory has no name at all (.cm-tiny .cm-name is
             display:none on the text itself). getBBox() is zero there, so
             skip it instead of measuring a label nobody will ever see. */
          if (window.getComputedStyle(t).display === 'none') return;
          var full = t.getAttribute('data-full') || t.textContent || '';
          t.setAttribute('data-full', full);
          if (!t.getAttribute('data-x0')) t.setAttribute('data-x0', t.getAttribute('x'));
          if (!t.getAttribute('data-y0')) t.setAttribute('data-y0', t.getAttribute('y'));
          var x0 = Number(t.getAttribute('data-x0'));
          var y0 = Number(t.getAttribute('data-y0'));
          var poly = byId.get(g.dataset.id);

          /* Put the name in the widest part of the WHOLE territory and move
             the level/bonus lines with it, keeping all three inside the cell. */
          var L = widestLabelLayout(poly, x0, y0);
          if (L) applyLabelLayout(g, t, poly, L);

          /* locked labels are display:none on the group, and getBBox() is all
             zeroes for those — measure them visible, then put them back */
          var hidden = window.getComputedStyle(g).display === 'none';
          if (hidden) g.style.display = 'inline';

          var y = Number(t.getAttribute('y'));
          var span = bandSpan(poly, y - LABEL_TOP, y + 2) || sliceSpan(poly, y);
          var max = span
            ? (span[1] - span[0]) - 8
            : Math.max(40, Number(g.dataset.cw || 90) - 12);

          t.style.fontSize = '';
          t.textContent = full;

          /* Prefer shrinking the type over cutting the name. CJK and Thai
             glyphs do not scale exactly like Latin ones, so step down until
             the text really fits instead of trusting the predicted size. */
          var px = 11;
          if (max >= 30 && t.getBBox().width > max) {
            var w11 = t.getBBox().width;
            px = Math.max(7, Math.min(11, Math.floor((max / w11) * 11 * 2) / 2));
            t.style.fontSize = px + 'px';
            while (t.getBBox().width > max && px > 7) {
              px -= 0.5;
              t.style.fontSize = px + 'px';
            }
          }
          if (max < 30) t.style.fontSize = '7px';
          if (t.getBBox().width > max) {
            var s = full;
            while (s.length > 3) {
              s = s.slice(0, -1);
              t.textContent = s + '…';
              if (t.getBBox().width <= max) break;
            }
            if (t.getBBox().width > max) {
              /* A three-glyph name has nothing left to abbreviate. Keep it
                 whole at the smallest size rather than leaving a blank cell. */
              t.style.fontSize = '7px';
              t.textContent = full;
              if (t.getBBox().width > max) t.textContent = '';
            }
          }

          if (t.textContent) {
            var tw = t.getBBox().width;
            var x = Number(t.getAttribute('x'));
            if (span) {
              /* never let a name sit outside its own territory */
              if (tw > span[1] - span[0] - 4) { t.textContent = ''; }
              else {
                var half = tw / 2 + 2;
                x = Math.min(Math.max(x, span[0] + half), span[1] - half);
              }
            }
            if (t.textContent) t.setAttribute('x', x);
          }
          if (hidden) g.style.display = '';
        });
      }
      /* An in-cell badge is sign + game sprite + "+N%" (~72px). A few traced
         territories are narrower than that. Drop the sign first, then the
         sprite, then shrink the value, and finally nudge the whole badge
         sideways so it never spills into a neighbour. The badge may also have
         been moved vertically/horizontally by the widest-strip layout, so the
         clamp is applied ON TOP of that stored shift. Compact mode hides both
         pictures via CSS, so only "+N%" has to fit there. */
      function fitBonusBadges() {
        if (window.getComputedStyle(labelLayer).display === 'none') return;
        labels.forEach(function (g) {
          var badge = g.querySelector('.cm-bonus');
          if (!badge) return;
          var sign = badge.querySelector('.cm-sign');
          var ico = badge.querySelector('.cm-rico');
          var val = badge.querySelector('.cm-val');
          var poly = byId.get(g.dataset.id);
          if (!poly) return;
          var cy = Number(badge.getAttribute('data-cy'));
          var span = bandSpan(poly, cy - 10, cy + 10) || sliceSpan(poly, cy);
          if (!span) return;
          var shiftX = Number(badge.getAttribute('data-shift-x') || 0);
          var shiftY = Number(badge.getAttribute('data-shift-y') || 0);
          var hidden = window.getComputedStyle(g).display === 'none';
          if (hidden) g.style.display = 'inline';
          var avail = span[1] - span[0] - 6;

          sign.style.display = '';
          ico.style.display = '';
          val.style.fontSize = '';
          badge.removeAttribute('transform');
          var box = function () { return badge.getBBox(); };
          var bb = box();
          if (bb.width > avail) { sign.style.display = 'none'; bb = box(); }
          if (bb.width > avail) { ico.style.display = 'none'; bb = box(); }
          if (bb.width > avail) { val.style.fontSize = '10px'; bb = box(); }
          if (bb.width > avail) { val.style.fontSize = '8px'; bb = box(); }

          /* getBBox() ignores the group's own transform, so include the layout
             shift explicitly before clamping to the territory's span. */
          var left = bb.x + shiftX, right = left + bb.width;
          var dx = 0;
          if (right > span[1] - 3) dx = span[1] - 3 - right;
          if (left + dx < span[0] + 3) dx = span[0] + 3 - left;
          var tx = shiftX + dx, ty = shiftY;
          if (tx || ty) badge.setAttribute('transform', 'translate(' + tx.toFixed(1) + ' ' + ty.toFixed(1) + ')');
          else badge.removeAttribute('transform');
          if (hidden) g.style.display = '';
        });
      }
      fitNames();
      fitBonusBadges();
      window.addEventListener('load', function () { fitNames(); fitBonusBadges(); });

      /* ---------- state ---------- */
      var current = { meta: blankMeta(), doc: blankDoc() };
      var stage = 1;
      var isOwner = false;
      var canEdit = true;
      var readLocked = false;
      var writeUnlocked = false;
      var readPassword = '';
      var writePassword = '';
      var registry = { active: 'local', maps: {} };
      var dirty = false;
      var apiOnline = true;
      var pending = null;
      var editingId = '';
      var formColor = D.palette[0], formIcon = D.icons[0];
      var paintId = '', paintMode = false, selectedCity = '', viewMode = 'levels';
      var filters = { levels: new Set(), bonuses: new Set(), owner: '', q: '' };
      var view = { x: 0, y: 0, w: MW, h: MH };
      var suppressClick = false;

      /* ---------- helpers ---------- */
      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }
      function uid() { return 'a' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6); }
      function blankMeta() {
        return {
          id: '', name: '', server: '', rev: 0,
          readMode: 'public', writeMode: 'open',
          hasReadPassword: false, hasWritePassword: false,
          forkedFrom: '', ownerToken: '', updatedAt: 0,
        };
      }
      function blankDoc() {
        var stages = [];
        for (var i = 0; i < STAGES; i++) stages.push({ o: {} });
        return { v: 2, alliances: [], stages: stages };
      }
      function rampOf(v) { return Math.max(0, Math.min(1, (Number(v) - 5) / 15)); }
      function bonusFill(k, v) {
        if (!k || BHUE[k] == null) return '#3f4440';
        var t = rampOf(v);
        return 'hsl(' + BHUE[k] + ' ' + Math.round(34 + 56 * t) + '% ' + Math.round(24 + 12 * t) + '%)';
      }
      function bonusInk(k, v) {
        if (!k || BHUE[k] == null) return '#a8a29e';
        var t = rampOf(v);
        return 'hsl(' + BHUE[k] + ' ' + Math.round(50 + 45 * t) + '% ' + Math.round(62 + 14 * t) + '%)';
      }
      /* The same visual language as the map cells: a kind sign + the real
         in-game sprite, on the ramp colour that encodes the bonus size. Used
         in the detail panel, the alliance summary and the city table. */
      function bonusChip(k, v) {
        if (!k || !KINDS[k]) return '';
        var kind = KINDS[k];
        return '<span class="cm-bchip" style="background:' + bonusFill(k, v) + '">' +
          '<svg class="cm-signicon" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">' +
          '<path d="' + SIGNS[kind] + '" fill="' + SIGNINK[kind] + '"></path></svg>' +
          '<img class="cm-resicon" src="' + SPRITES[k] + '" width="15" height="15" alt="" loading="lazy">' +
          '</span>';
      }
      function stageLabel(n) {
        var txt = S.unlockedLevels.replace('{n}', String(n));
        return n <= 1 ? txt.replace('1–1', '1') : txt;
      }
      function curOwners() { return current.doc.stages[stage - 1].o; }
      function alliance(id) {
        return current.doc.alliances.find(function (a) { return a.id === id; });
      }
      function ownerOf(id) { return alliance(curOwners()[id]); }
      function bonusText(p) {
        if (!p.dataset.bonus) return '—';
        var b = B[p.dataset.bonus];
        return (b ? b.full : p.dataset.bonus) + ' +' + p.dataset.value + '%';
      }
      function isLocked(p) { return +p.dataset.lv > stage; }
      function unlockedPolys() { return polys.filter(function (p) { return !isLocked(p); }); }
      function readOnlyMessage() {
        if (readLocked) return S.readLockedMsg;
        if (current.meta.writeMode === 'owner' && !isOwner) return S.ownerOnlyMsg;
        if (current.meta.writeMode === 'password' && !writeUnlocked && !isOwner) return S.writeLockedMsg;
        return S.readOnly;
      }
      function toast(msg) {
        var t = document.getElementById('cm-toast');
        t.textContent = msg; t.classList.add('is-on');
        clearTimeout(toast._t); toast._t = setTimeout(function () { t.classList.remove('is-on'); }, 3200);
      }
      function encode(obj) {
        var bytes = new TextEncoder().encode(JSON.stringify(obj));
        var bin = ''; bytes.forEach(function (b) { bin += String.fromCharCode(b); });
        return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
      }
      function decode(str) {
        var b = atob(str.replace(/-/g, '+').replace(/_/g, '/'));
        var bytes = Uint8Array.from(b, function (c) { return c.charCodeAt(0); });
        return JSON.parse(new TextDecoder().decode(bytes));
      }

      /* ---------- document normalization ---------- */
      function normalizeDoc(raw) {
        var out = blankDoc();
        if (!raw || typeof raw !== 'object') return out;
        var arr = Array.isArray(raw.alliances) ? raw.alliances : (Array.isArray(raw.a) ? raw.a : []);
        var seen = {};
        out.alliances = arr.slice(0, 40).map(function (a, i) {
          var id = String(a && a.id ? a.id : uid() + i).slice(0, 40);
          seen[id] = 1;
          return {
            id: id,
            name: String(a && a.name ? a.name : 'Alliance ' + (i + 1)).slice(0, 40),
            color: /^#[0-9a-f]{6}$/i.test(a && a.color) ? a.color : D.palette[i % D.palette.length],
            icon: String(a && a.icon ? a.icon : D.icons[i % D.icons.length]).slice(0, 8),
          };
        });
        var stages = Array.isArray(raw.stages) ? raw.stages : null;
        for (var s = 0; s < STAGES; s++) {
          var src = stages ? stages[s] : (s === 0 ? (raw.o || raw.owners) : null);
          if (!src || typeof src !== 'object') continue;
          var owners = src.o && typeof src.o === 'object' ? src.o : (src.o ? null : src);
          if (!owners) continue;
          Object.keys(owners).forEach(function (cid) {
            if (!byId.has(cid)) return;
            var owner = owners[cid];
            if (typeof owner !== 'string' || !seen[owner]) return;
            out.stages[s].o[cid] = owner;
          });
        }
        return out;
      }

      /* ---------- local persistence ---------- */
      function persistLocal() {
        var key = current.meta.id || 'local';
        registry.maps[key] = { meta: current.meta, doc: current.doc, stage: stage };
        registry.active = key;
        var keys = Object.keys(registry.maps);
        if (keys.length > 12) {
          keys.sort(function (a, b) {
            return (registry.maps[b].meta.updatedAt || 0) - (registry.maps[a].meta.updatedAt || 0);
          });
          keys.slice(12).forEach(function (k) { if (k !== key) delete registry.maps[k]; });
        }
        try { localStorage.setItem(LS, JSON.stringify(registry)); } catch (e) {}
      }
      function markDirty() {
        dirty = true;
        persistLocal();
        updateStatus();
      }
      function updateStatus() {
        var el = document.getElementById('cm-save-status');
        var text;
        if (!current.meta.id) text = S.localDraft;
        else if (!apiOnline) text = S.offlineSaved;
        else text = S.onlineSaved;
        el.textContent = text + (dirty ? ' •' : '');
        el.className = 'ml-auto text-[11px] ' + (dirty ? 'text-amber-300' : 'text-stone-500');
      }

      /* ---------- stage badges ---------- */
      function stageTagHTML() {
        var pips = '';
        for (var i = 1; i <= STAGES; i++) {
          var on = i <= stage;
          pips += '<i class="cm-pip' + (on ? ' is-on' : '') + '" style="background:' +
            (on ? (LCOL[i] || LCOL[7]) : 'rgba(255,255,255,.09)') + '"></i>';
        }
        return '<div class="cm-stage-tag">' +
          '<span class="cm-stage-name">' + esc(S.stage) + ' <strong>' + stage + '</strong><span class="cm-stage-total">/' + STAGES + '</span></span>' +
          '<span class="cm-pips">' + pips + '</span>' +
          '<span class="cm-stage-sub">' + esc(stageLabel(stage)) + '</span>' +
          '</div>';
      }
      function renderStageTags() {
        document.querySelectorAll('.cm-stage-slot').forEach(function (el) { el.innerHTML = stageTagHTML(); });
      }
      function renderStages() {
        document.querySelectorAll('#cm-stages .cm-stagebtn').forEach(function (b) {
          b.classList.toggle('is-on', Number(b.dataset.stage) === stage);
        });
        document.getElementById('cm-copy-prev').disabled = stage < 2 || !canEdit;
        document.getElementById('cm-stage-note').textContent = stageLabel(stage);
      }

      /* ---------- map manager ---------- */
      function renderMapManager() {
        var sel = document.getElementById('cm-map-select');
        var opts = '<option value="local">💾 ' + esc(S.localDraft) + '</option>';
        var known = { local: 1 };
        Object.keys(registry.maps).forEach(function (k) {
          if (k === 'local') return;
          known[k] = 1;
          var m = registry.maps[k].meta;
          opts += '<option value="' + esc(k) + '">' + esc((m.name || k) + (m.server ? ' · ' + m.server : '')) + '</option>';
        });
        if (current.meta.id && !known[current.meta.id]) {
          opts += '<option value="' + esc(current.meta.id) + '">' + esc((current.meta.name || current.meta.id) + ' · ' + S.loading) + '</option>';
        }
        sel.innerHTML = opts;
        sel.value = current.meta.id || 'local';

        document.getElementById('cm-map-name').value = current.meta.name || '';
        document.getElementById('cm-map-server').value = current.meta.server || '';
        document.getElementById('cm-read-mode').value = current.meta.readMode;
        document.getElementById('cm-write-mode').value = current.meta.writeMode;
        document.getElementById('cm-read-pw-wrap').style.display = current.meta.readMode === 'password' ? '' : 'none';
        document.getElementById('cm-write-pw-wrap').style.display = current.meta.writeMode === 'password' ? '' : 'none';
        document.getElementById('cm-read-pw').value = '';
        document.getElementById('cm-write-pw').value = '';
        document.getElementById('cm-read-pw').placeholder = current.meta.hasReadPassword ? '••••••' : S.enterPassword;
        document.getElementById('cm-write-pw').placeholder = current.meta.hasWritePassword ? '••••••' : S.enterPassword;
        document.getElementById('cm-pw-hint').textContent = S.passwordOptional;

        var keyEl = document.getElementById('cm-owner-key');
        keyEl.textContent = current.meta.ownerToken || '—';
        document.getElementById('cm-copy-owner').disabled = !current.meta.ownerToken;
        document.getElementById('cm-delete-map').disabled = !current.meta.ownerToken;
        document.getElementById('cm-fork').disabled = !current.meta.id;
        document.getElementById('cm-copy-link').disabled = !current.meta.id;
        updateStatus();
      }

      /* ---------- permissions ---------- */
      function applyPermissions() {
        canEdit = !readLocked && (isOwner || current.meta.writeMode === 'open' || writeUnlocked);
        if (!current.meta.id) canEdit = true;
        root.classList.toggle('cm-readonly', !canEdit);

        var ids = ['cm-paint-mode', 'cm-paint', 'cm-new-name', 'cm-save-alliance', 'cm-clear',
          'cm-import', 'cm-save-online'];
        ids.forEach(function (id) {
          var el = document.getElementById(id);
          if (el) el.disabled = !canEdit;
        });
        document.getElementById('cm-copy-prev').disabled = !canEdit || stage < 2;
        document.getElementById('cm-paint-mode').disabled = !canEdit;
        var lock = canEdit ? '' : 'none';
        document.getElementById('cm-alliance-list').style.pointerEvents = lock;
        document.getElementById('cm-colors').style.pointerEvents = lock;
        document.getElementById('cm-icons').style.pointerEvents = lock;

        var banner = document.getElementById('cm-ro-banner');
        banner.classList.toggle('hidden', canEdit);
        banner.classList.toggle('flex', !canEdit);
        document.getElementById('cm-ro-text').textContent = canEdit ? '' : readOnlyMessage();
        document.getElementById('cm-unlock-write').classList.toggle(
          'hidden', !(!canEdit && (readLocked || (!isOwner && current.meta.writeMode === 'password')))
        );
        renderStages();
      }

      /* ---------- view / zoom ---------- */
      function setView(v) {
        view = v;
        svg.setAttribute('viewBox', v.x + ' ' + v.y + ' ' + v.w + ' ' + v.h);
      }
      function zoom(f, cx, cy) {
        var nw = Math.max(150, Math.min(MW * 1.15, view.w / f));
        var nh = nw * RATIO;
        var px = cx == null ? view.x + view.w / 2 : cx;
        var py = cy == null ? view.y + view.h / 2 : cy;
        var rx = (px - view.x) / view.w, ry = (py - view.y) / view.h;
        setView({ x: px - rx * nw, y: py - ry * nh, w: nw, h: nh });
      }
      document.getElementById('cm-zoom-in').addEventListener('click', function () { zoom(1.25); });
      document.getElementById('cm-zoom-out').addEventListener('click', function () { zoom(1 / 1.25); });
      document.getElementById('cm-fit').addEventListener('click', function () { setView({ x: 0, y: 0, w: MW, h: MH }); });
      svg.addEventListener('wheel', function (e) {
        e.preventDefault();
        var r = svg.getBoundingClientRect();
        var cx = view.x + ((e.clientX - r.left) / r.width) * view.w;
        var cy = view.y + ((e.clientY - r.top) / r.height) * view.h;
        zoom(e.deltaY < 0 ? 1.16 : 1 / 1.16, cx, cy);
      }, { passive: false });
      var drag = null;
      svg.addEventListener('pointerdown', function (e) {
        if (e.button !== 0) return;
        drag = { x: e.clientX, y: e.clientY, vx: view.x, vy: view.y, moved: false };
      });
      window.addEventListener('pointermove', function (e) {
        if (!drag) return;
        var dx = e.clientX - drag.x, dy = e.clientY - drag.y;
        if (Math.abs(dx) + Math.abs(dy) > 4) drag.moved = true;
        var r = svg.getBoundingClientRect();
        setView({ x: drag.vx - (dx / r.width) * view.w, y: drag.vy - (dy / r.height) * view.h, w: view.w, h: view.h });
      });
      window.addEventListener('pointerup', function () {
        if (!drag) return;
        if (drag.moved) { suppressClick = true; setTimeout(function () { suppressClick = false; }, 0); }
        drag = null;
      });

      /* ---------- filters ---------- */
      function matches(p) {
        if (isLocked(p)) return false;
        var lv = +p.dataset.lv, own = curOwners()[p.dataset.id] || '';
        if (filters.levels.size && !filters.levels.has(lv)) return false;
        if (filters.bonuses.size && !filters.bonuses.has(p.dataset.bonus)) return false;
        if (filters.owner === '__free__' && own) return false;
        if (filters.owner && filters.owner !== '__free__' && own !== filters.owner) return false;
        if (filters.q) {
          var hay = (p.dataset.name + ' ' + p.dataset.id + ' ' + p.dataset.full).toLowerCase();
          if (hay.indexOf(filters.q) === -1) return false;
        }
        return true;
      }
      function paintFilters() {
        polys.forEach(function (p) {
          var locked = isLocked(p);
          var ok = matches(p);
          p.classList.toggle('cm-locked', locked);
          p.classList.toggle('cm-dim', !ok && !locked);
          var g = labelById.get(p.dataset.id);
          if (g) {
            g.classList.toggle('cm-dim', !ok && !locked);
            g.classList.toggle('cm-locked', locked);
          }
        });
      }

      /* ---------- map visuals ---------- */
      function paintMap() {
        polys.forEach(function (p) {
          var a = ownerOf(p.dataset.id), lv = +p.dataset.lv;
          p.setAttribute('fill', viewMode === 'owners' ? (a ? a.color : '#252a26') : (LCOL[lv] || LCOL[7]));
          if (a) { p.style.stroke = a.color; p.style.strokeWidth = '4'; }
          else { p.style.stroke = ''; p.style.strokeWidth = ''; }
        });
        var html = '';
        polys.forEach(function (p) {
          if (isLocked(p)) return;
          var a = ownerOf(p.dataset.id);
          if (!a) return;
          html += '<g class="cm-badge"><circle cx="' + p.dataset.bx + '" cy="' + p.dataset.by +
            '" r="13" fill="' + a.color + '" stroke="#08090a" stroke-width="2.5"/><text x="' +
            p.dataset.bx + '" y="' + (Number(p.dataset.by) + 4.5) + '" text-anchor="middle" font-size="13">' +
            esc(a.icon) + '</text></g>';
        });
        badgeLayer.innerHTML = html;
        paintFilters();
      }
      function highlight() {
        polys.forEach(function (p) { p.classList.toggle('cm-selected', p.dataset.id === selectedCity); });
      }

      /* ---------- alliances ---------- */
      function countFor(id) {
        var owners = curOwners();
        return Object.keys(owners).filter(function (cid) {
          return owners[cid] === id && !isLocked(byId.get(cid));
        }).length;
      }
      function renderAlliances() {
        var list = document.getElementById('cm-alliance-list');
        if (!current.doc.alliances.length) {
          list.innerHTML = '<p class="rounded-lg border border-dashed border-white/10 px-3 py-4 text-center text-xs text-stone-500">' + esc(S.noAlliances) + '</p>';
        } else {
          list.innerHTML = current.doc.alliances.map(function (a) {
            return '<div class="cm-alliance' + (paintId === a.id ? ' is-active' : '') + '" data-id="' + esc(a.id) + '">' +
              '<button class="cm-pick" data-id="' + esc(a.id) + '" title="' + esc(S.assignTo) + '">' +
                '<span class="text-base leading-none">' + esc(a.icon) + '</span>' +
                '<span class="h-3.5 w-3.5 shrink-0 rounded-sm border border-black/40" style="background:' + a.color + '"></span>' +
                '<span class="min-w-0 flex-1 truncate text-left text-xs text-stone-200">' + esc(a.name) + '</span>' +
                '<span class="font-mono text-[11px] text-stone-500">' + countFor(a.id) + '</span>' +
              '</button>' +
              '<button class="cm-rowbtn" data-act="edit" data-id="' + esc(a.id) + '" title="' + esc(S.save) + '">✎</button>' +
              '<button class="cm-rowbtn cm-rowbtn-danger" data-act="del" data-id="' + esc(a.id) + '" title="' + esc(S.delete) + '">✕</button>' +
            '</div>';
          }).join('');
        }
        document.getElementById('cm-alliance-count').textContent = current.doc.alliances.length;
        document.getElementById('cm-stat-alliances').textContent = current.doc.alliances.length;

        var opts = '<option value="">— ' + esc(S.alliances) + ' —</option><option value="__free__">🧹 ' + esc(S.free) + '</option>' +
          current.doc.alliances.map(function (a) { return '<option value="' + esc(a.id) + '">' + esc(a.icon + ' ' + a.name) + '</option>'; }).join('');
        var paint = document.getElementById('cm-paint');
        paint.innerHTML = opts; paint.value = paintId;
        var own = document.getElementById('cm-owner-filter');
        var prev = filters.owner;
        own.innerHTML = '<option value="">' + esc(S.all) + '</option><option value="__free__">' + esc(S.freeCities) + '</option>' +
          current.doc.alliances.map(function (a) { return '<option value="' + esc(a.id) + '">' + esc(a.icon + ' ' + a.name) + '</option>'; }).join('');
        own.value = current.doc.alliances.some(function (a) { return a.id === prev; }) || prev === '__free__' || prev === '' ? prev : '';
        filters.owner = own.value;
      }
      function resetForm() {
        editingId = '';
        document.getElementById('cm-new-name').value = '';
        document.getElementById('cm-save-alliance').textContent = S.add;
        document.getElementById('cm-cancel-edit').classList.add('hidden');
        // Pick the first unused colour/icon so newly added alliances are always
        // visually distinguishable on the map (random picks could collide).
        var usedColors = current.doc.alliances.map(function (a) { return a.color; });
        var usedIcons = current.doc.alliances.map(function (a) { return a.icon; });
        formColor = D.palette.find(function (c) { return usedColors.indexOf(c) < 0; }) || D.palette[current.doc.alliances.length % D.palette.length];
        formIcon = D.icons.find(function (i) { return usedIcons.indexOf(i) < 0; }) || D.icons[current.doc.alliances.length % D.icons.length];
        syncFormSwatches();
      }
      function syncFormSwatches() {
        document.querySelectorAll('#cm-colors .cm-swatch').forEach(function (b) { b.classList.toggle('is-on', b.dataset.color === formColor); });
        document.querySelectorAll('#cm-icons .cm-emoji').forEach(function (b) { b.classList.toggle('is-on', b.dataset.icon === formIcon); });
      }
      function saveAlliance() {
        if (!canEdit) { toast(readOnlyMessage()); return; }
        var name = document.getElementById('cm-new-name').value.trim().slice(0, 40);
        if (!name) { document.getElementById('cm-new-name').focus(); return; }
        if (editingId) {
          var a = alliance(editingId);
          if (a) { a.name = name; a.color = formColor; a.icon = formIcon; }
        } else {
          var id = uid();
          current.doc.alliances.push({ id: id, name: name, color: formColor, icon: formIcon });
          paintId = id;
          document.getElementById('cm-paint').value = id;
          document.getElementById('cm-paint-mode').checked = true;
          paintMode = true;
        }
        markDirty(); resetForm(); renderAll();
      }

      /* ---------- details ---------- */
      function renderDetails() {
        var box = document.getElementById('cm-details');
        var p = byId.get(selectedCity);
        if (!p || isLocked(p)) {
          box.innerHTML = '<p class="text-xs text-stone-500">' + esc(S.details) + '</p>';
          return;
        }
        var a = ownerOf(selectedCity), lv = +p.dataset.lv;
        var rows = [
          '<div class="flex items-baseline justify-between gap-2"><span class="font-semibold text-stone-100">' + esc(p.dataset.name) + '</span><span class="font-mono text-[11px] text-stone-500">' + esc(p.dataset.id) + '</span></div>',
          '<div class="mt-2 flex flex-wrap gap-1.5 text-[11px]">' +
            '<span class="rounded-md border border-white/10 px-2 py-1" style="color:' + (LCOL[lv] || LCOL[7]) + '">' + S.level + ' ' + lv + '</span>' +
            (p.dataset.bonus
              ? '<span class="inline-flex items-center gap-1.5 rounded-md border border-white/10 px-2 py-1 text-stone-200">' +
                bonusChip(p.dataset.bonus, p.dataset.value) +
                esc(bonusText(p)) + '</span>'
              : '<span class="rounded-md border border-white/10 px-2 py-1">' + esc(S.royal) + '</span>') +
          '</div>',
          '<div class="mt-2 grid grid-cols-2 gap-2 text-[11px] text-stone-400">' +
            '<div>' + S.hp + ': <strong class="font-mono text-stone-200">' + (HP[lv] ? Number(HP[lv]).toLocaleString() : '—') + '</strong></div>' +
            '<div>' + S.garrison + ': <strong class="font-mono text-stone-200">' + (GAR[lv] || '—') + '</strong></div>' +
          '</div>',
          '<label class="mt-3 block text-[10px] uppercase tracking-widest text-stone-500">' + esc(S.assignTo) + '</label>',
          '<select id="cm-detail-owner" class="cm-select mt-1 w-full"' + (canEdit ? '' : ' disabled') + '>' +
            '<option value="">' + esc(S.free) + '</option>' +
            current.doc.alliances.map(function (x) { return '<option value="' + esc(x.id) + '"' + (a && a.id === x.id ? ' selected' : '') + '>' + esc(x.icon + ' ' + x.name) + '</option>'; }).join('') +
          '</select>'
        ];
        box.innerHTML = rows.join('');
        var sel = document.getElementById('cm-detail-owner');
        sel.addEventListener('change', function () {
          if (!canEdit) { toast(readOnlyMessage()); return; }
          var owners = curOwners();
          if (sel.value) owners[selectedCity] = sel.value;
          else delete owners[selectedCity];
          markDirty(); renderAll();
        });
      }

      /* ---------- summary ---------- */
      function renderSummary() {
        var box = document.getElementById('cm-summary');
        var list = unlockedPolys();
        var stat = {};
        current.doc.alliances.forEach(function (a) { stat[a.id] = { count: 0, byLevel: {}, byBonus: {} }; });
        var held = 0;
        var owners = curOwners();
        list.forEach(function (p) {
          var id = owners[p.dataset.id];
          if (!id || !stat[id]) return;
          var st = stat[id]; st.count++; held++;
          st.byLevel[p.dataset.lv] = (st.byLevel[p.dataset.lv] || 0) + 1;
          if (p.dataset.bonus) st.byBonus[p.dataset.bonus] = (st.byBonus[p.dataset.bonus] || 0) + Number(p.dataset.value);
        });
        document.getElementById('cm-stat-held').textContent = held;
        document.getElementById('cm-stat-free').textContent = list.length - held;
        document.getElementById('cm-stat-total').textContent = list.length;

        function bonusRows(st) {
          var rows = KEYS.filter(function (k) { return st.byBonus[k]; }).map(function (k) {
            return '<div class="flex items-center justify-between gap-2 border-b border-white/[0.04] py-1 last:border-0">' +
              '<span class="inline-flex items-center gap-1.5 text-[11px] text-stone-400">' +
                bonusChip(k, Math.min(20, st.byBonus[k])) +
                esc(B[k] ? B[k].full : k) + '</span>' +
              '<span class="font-mono text-xs font-bold text-toxic-300">+' + st.byBonus[k] + '%</span></div>';
          }).join('');
          return rows || '<p class="py-2 text-[11px] text-stone-600">—</p>';
        }
        function levelChips(st) {
          return Object.keys(st.byLevel).sort(function (a, b) { return a - b; }).map(function (l) {
            return '<span class="inline-flex items-center gap-1 rounded border border-white/[0.07] px-1.5 py-0.5 text-[10px] text-stone-400">' +
              '<span class="inline-block h-2 w-2 rounded-sm" style="background:' + (LCOL[l] || LCOL[7]) + '"></span>L' + l + ' ×' + st.byLevel[l] + '</span>';
          }).join('');
        }
        var cards = current.doc.alliances.map(function (a) {
          var st = stat[a.id];
          return '<article class="cm-card" style="border-top:3px solid ' + a.color + '">' +
            '<div class="flex items-center gap-2"><span class="text-lg">' + esc(a.icon) + '</span>' +
            '<strong class="min-w-0 flex-1 truncate text-sm text-stone-100">' + esc(a.name) + '</strong>' +
            '<span class="font-mono text-xs text-toxic-300">' + st.count + '</span></div>' +
            '<div class="mt-2 text-[10px] uppercase tracking-widest text-stone-500">' + esc(S.held + ' · ' + S.byLevel) + '</div>' +
            '<div class="mt-1.5 flex flex-wrap gap-1">' + levelChips(st) + '</div>' +
            '<div class="mt-3 text-[10px] uppercase tracking-widest text-stone-500">' + esc(S.bonus) + '</div>' +
            '<div class="mt-1">' + bonusRows(st) + '</div></article>';
        });
        var total = { byBonus: {} };
        list.forEach(function (p) {
          if (!owners[p.dataset.id] || !p.dataset.bonus) return;
          total.byBonus[p.dataset.bonus] = (total.byBonus[p.dataset.bonus] || 0) + Number(p.dataset.value);
        });
        cards.push('<article class="cm-card border-t-[3px] border-t-plague-400">' +
          '<div class="flex items-center gap-2"><span class="text-lg">📊</span><strong class="flex-1 text-sm text-stone-100">' + esc(S.total) + '</strong>' +
          '<span class="font-mono text-xs text-plague-300">' + held + '</span></div>' +
          '<div class="mt-2 text-[10px] uppercase tracking-widest text-stone-500">' + esc(S.heldCities + ' · ' + S.freeCities) + '</div>' +
          '<div class="mt-1 text-xs text-stone-400">' + held + ' / ' + (list.length - held) + '</div>' +
          '<div class="mt-3 text-[10px] uppercase tracking-widest text-stone-500">' + esc(S.bonus) + '</div>' +
          '<div class="mt-1">' + bonusRows(total) + '</div></article>');
        box.innerHTML = cards.join('');
      }

      /* ---------- table ---------- */
      function renderTable() {
        var body = document.getElementById('cm-table-body');
        var rows = polys.filter(matches).map(function (p) {
          var a = ownerOf(p.dataset.id), lv = +p.dataset.lv;
          return '<tr data-id="' + esc(p.dataset.id) + '" class="cm-row' + (p.dataset.id === selectedCity ? ' is-selected' : '') + '">' +
            '<td class="px-3 py-2 font-mono text-[11px] text-stone-600">' + esc(p.dataset.id) + '</td>' +
            '<td class="px-3 py-2"><span class="text-stone-200">' + esc(p.dataset.name) + '</span></td>' +
            '<td class="px-3 py-2"><span class="inline-flex items-center gap-1.5 whitespace-nowrap text-xs text-stone-300">' +
              '<span class="inline-block h-2.5 w-2.5 rounded-sm" style="background:' + (LCOL[lv] || LCOL[7]) + '"></span>Lv.' + lv + '</span></td>' +
            '<td class="px-3 py-2 text-xs text-stone-400" title="' + esc(bonusText(p)) + '">' +
              (p.dataset.bonus
                ? '<span class="inline-flex items-center gap-1.5">' +
                  bonusChip(p.dataset.bonus, p.dataset.value) +
                  '<span>' + esc(p.dataset.short) + '</span> <span class="font-mono" style="color:' + bonusInk(p.dataset.bonus, p.dataset.value) + '">+' + p.dataset.value + '%</span></span>'
                : '—') + '</td>' +
            '<td class="px-3 py-2 text-xs">' + (a
              ? '<span class="inline-flex items-center gap-1.5"><span class="inline-block h-2.5 w-2.5 rounded-full" style="background:' + a.color + '"></span><span class="text-stone-300">' + esc(a.icon + ' ' + a.name) + '</span></span>'
              : '<span class="text-stone-600">' + esc(S.free) + '</span>') + '</td></tr>';
        });
        body.innerHTML = rows.join('');
        document.getElementById('cm-table-count').textContent = rows.length + ' / ' + unlockedPolys().length;
        document.getElementById('cm-no-match').classList.toggle('hidden', rows.length > 0);
      }

      function renderAll() {
        renderStageTags(); renderStages(); renderAlliances(); paintMap(); highlight();
        renderSummary(); renderTable(); renderDetails(); applyPermissions();
      }

      /* ---------- api ---------- */
      async function api(method, body, query, headers) {
        var opts = { method: method, headers: Object.assign({ 'content-type': 'application/json' }, headers || {}) };
        if (body) opts.body = JSON.stringify(body);
        try {
          var res = await fetch('/api/maps' + (query || ''), opts);
          var data = null;
          try { data = await res.json(); } catch (e) { data = {}; }
          apiOnline = true;
          return { status: res.status, data: data || {} };
        } catch (e) {
          apiOnline = false;
          return { status: 0, data: { error: 'offline' } };
        }
      }
      function setBusy(on) {
        var b = document.getElementById('cm-save-online');
        b.disabled = on;
        b.textContent = on ? '⏳ ' + S.loading : '💾 ' + S.saveOnline;
      }

      function adopt(map, ownerToken, owner) {
        var prevId = current.meta.id;
        current.meta = {
          id: map.id, name: map.name || '', server: map.server || '', rev: map.rev,
          readMode: map.readMode, writeMode: map.writeMode,
          hasReadPassword: !!map.hasReadPassword, hasWritePassword: !!map.hasWritePassword,
          forkedFrom: map.forkedFrom || '', ownerToken: ownerToken || '', updatedAt: map.updatedAt || 0,
        };
        current.doc = normalizeDoc(map.doc);
        isOwner = !!owner;
        readLocked = false;
        writeUnlocked = false;
        dirty = false;
        if (prevId !== map.id) {
          stage = (registry.maps[map.id] && registry.maps[map.id].stage) || stage;
        }
        persistLocal();
        renderMapManager();
        renderAll();
        syncUrl();
      }
      function adoptCached(entry) {
        var prevId = current.meta.id;
        current.meta = Object.assign(blankMeta(), entry.meta);
        current.doc = normalizeDoc(entry.doc);
        isOwner = !!current.meta.ownerToken;
        readLocked = false;
        writeUnlocked = false;
        dirty = false;
        if (prevId !== current.meta.id) stage = entry.stage || stage;
        renderMapManager();
        renderAll();
      }
      function syncUrl() {
        var url = location.pathname + (current.meta.id ? '?map=' + current.meta.id : '');
        try { history.replaceState(null, '', url); } catch (e) {}
      }

      async function openMap(id) {
        var entry = registry.maps[id];
        var token = (entry && entry.meta.ownerToken) || '';
        var headers = token ? { 'x-map-owner': token } : {};
        if (readPassword) headers['x-map-read'] = readPassword;
        var r = await api('GET', null, '?id=' + encodeURIComponent(id), headers);
        if (r.status === 200) {
          adopt(r.data.map, token, r.data.isOwner);
          return;
        }
        if (r.status === 401) {
          if (entry) adoptCached(entry);
          else { renderMapManager(); renderAll(); }
          readLocked = true;
          renderMapManager();
          renderAll();
          pending = { kind: 'read', id: id };
          showModal('read');
          return;
        }
        if (entry) { adoptCached(entry); toast(S.apiOffline); }
        else toast(r.status === 404 ? S.noMaps : S.apiOffline);
      }

      async function saveOnline() {
        if (!canEdit) { toast(readOnlyMessage()); return; }
        var meta = current.meta;
        var readPw = document.getElementById('cm-read-pw').value;
        var writePw = document.getElementById('cm-write-pw').value;
        if (meta.readMode === 'password' && !meta.hasReadPassword && readPw.length < 3) {
          document.getElementById('cm-read-pw').focus(); return;
        }
        if (meta.writeMode === 'password' && !meta.hasWritePassword && writePw.length < 3) {
          document.getElementById('cm-write-pw').focus(); return;
        }

        var access = {
          readMode: meta.readMode,
          writeMode: meta.writeMode,
          readPassword: readPw,
          writePassword: writePw,
          clearReadPassword: meta.readMode !== 'password' && meta.hasReadPassword,
          clearWritePassword: meta.writeMode !== 'password' && meta.hasWritePassword,
        };

        var body;
        if (!meta.id) {
          body = {
            action: 'create', name: meta.name, server: meta.server, doc: current.doc,
            readMode: meta.readMode, writeMode: meta.writeMode,
            readPassword: readPw, writePassword: writePw,
          };
        } else {
          body = {
            action: 'save', id: meta.id, rev: meta.rev, name: meta.name, server: meta.server,
            doc: current.doc, ownerToken: meta.ownerToken || '',
            writePassword: writePassword || writePw,
            access: isOwner ? access : null,
          };
        }

        setBusy(true);
        var r = await api('POST', body);
        setBusy(false);

        if (r.status === 200 && r.data.ok) {
          adopt(r.data.map, r.data.ownerToken || meta.ownerToken, isOwner || !meta.id);
          toast(meta.id ? S.onlineSaved : S.mapSavedMsg);
          loadPublicMaps();
          return;
        }
        if (r.status === 409 && r.data.map) {
          adopt(r.data.map, meta.ownerToken, isOwner);
          toast(S.conflictMsg);
          return;
        }
        if (r.status === 401) {
          if (r.data.error === 'write-locked') {
            pending = { kind: 'write', id: meta.id };
            showModal('write');
          } else {
            toast(S.ownerOnlyMsg);
          }
          return;
        }
        if (r.status === 0) { toast(S.apiOffline); return; }
        toast(S.saveFailed);
      }

      async function forkCurrent() {
        if (!current.meta.id) { toast(S.saveOnline); return; }
        var headers = current.meta.ownerToken ? { 'x-map-owner': current.meta.ownerToken } : {};
        var r = await api('POST', { action: 'fork', id: current.meta.id, readPassword: readPassword }, null, headers);
        if (r.status === 200 && r.data.ok) {
          adopt(r.data.map, r.data.ownerToken, true);
          toast(S.forkDone);
          loadPublicMaps();
          return;
        }
        if (r.status === 401) { pending = { kind: 'read', id: current.meta.id }; showModal('read'); return; }
        toast(S.saveFailed);
      }

      async function deleteCurrent() {
        if (!current.meta.ownerToken) { toast(S.ownerOnlyMsg); return; }
        if (!window.confirm(S.deleteConfirm)) return;
        var r = await api('POST', { action: 'delete', id: current.meta.id, ownerToken: current.meta.ownerToken });
        if (r.status === 200) {
          delete registry.maps[current.meta.id];
          newMap(true);
          loadPublicMaps();
        } else {
          toast(S.saveFailed);
        }
      }

      function newMap(silent) {
        current = { meta: blankMeta(), doc: blankDoc() };
        isOwner = false; canEdit = true; readLocked = false; writeUnlocked = false; dirty = false;
        stage = 1; selectedCity = ''; paintId = ''; paintMode = false;
        document.getElementById('cm-paint-mode').checked = false;
        persistLocal();
        renderMapManager();
        renderAll();
        syncUrl();
        if (!silent) toast(S.localDraft);
      }

      async function loadPublicMaps() {
        var box = document.getElementById('cm-public-list');
        box.innerHTML = '<p class="text-[11px] text-stone-500">' + esc(S.loading) + '</p>';
        var r = await api('GET', null, '?list=1');
        if (r.status !== 200) {
          box.innerHTML = '<p class="text-[11px] text-stone-500">' + esc(S.apiOffline) + '</p>';
          return;
        }
        var maps = r.data.maps || [];
        if (!maps.length) {
          box.innerHTML = '<p class="text-[11px] text-stone-500">' + esc(S.noMaps) + '</p>';
          return;
        }
        box.innerHTML = maps.map(function (m) {
          var when = m.updatedAt ? new Date(m.updatedAt).toLocaleDateString(D.lang) : '';
          return '<div class="cm-map-row">' +
            '<span class="min-w-0 flex-1 truncate text-xs text-stone-200">' + esc(m.name || m.id) +
              (m.server ? ' <span class="text-stone-500">· ' + esc(m.server) + '</span>' : '') + '</span>' +
            '<span class="font-mono text-[10px] text-stone-600">' + esc(when) + '</span>' +
            '<button class="cm-btn-ghost" data-open="' + esc(m.id) + '">' + esc(S.openMap) + '</button>' +
            '</div>';
        }).join('');
      }

      function copy(text, msg) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(function () { toast(msg); }, function () { toast(msg); });
        } else {
          toast(msg);
        }
      }
      function copyLink() {
        if (!current.meta.id) { toast(S.saveOnline); return; }
        copy(location.origin + location.pathname + '?map=' + current.meta.id, S.copyOk + ' · ' + S.shareHint);
      }

      /* ---------- modal ---------- */
      function showModal(kind) {
        var m = document.getElementById('cm-modal');
        document.getElementById('cm-modal-title').textContent = kind === 'write' ? S.writePassword : S.readPassword;
        document.getElementById('cm-modal-text').textContent = kind === 'write' ? S.writeLockedMsg : S.readLockedMsg;
        document.getElementById('cm-modal-input').value = '';
        document.getElementById('cm-modal-error').classList.add('hidden');
        m.classList.remove('hidden');
        m.dataset.kind = kind;
        setTimeout(function () { document.getElementById('cm-modal-input').focus(); }, 30);
      }
      function hideModal() {
        document.getElementById('cm-modal').classList.add('hidden');
      }
      async function submitModal() {
        var m = document.getElementById('cm-modal');
        var kind = m.dataset.kind;
        var pw = document.getElementById('cm-modal-input').value;
        var err = document.getElementById('cm-modal-error');
        if (!pending || !pending.id) { hideModal(); return; }
        var body = { action: 'unlock', id: pending.id, kind: kind, ownerToken: current.meta.ownerToken || '' };
        if (kind === 'write') body.writePassword = pw; else body.readPassword = pw;
        var r = await api('POST', body);
        if (r.status === 200) {
          hideModal();
          if (kind === 'write') {
            writePassword = pw;
            writeUnlocked = true;
            applyPermissions();
            renderDetails();
            toast(S.canEdit);
          } else {
            readPassword = pw;
            var id = pending.id;
            pending = null;
            openMap(id);
          }
          return;
        }
        err.textContent = r.status === 429 ? S.badPassword : S.badPassword;
        err.classList.remove('hidden');
      }

      /* ---------- events: map manager ---------- */
      document.getElementById('cm-save-online').addEventListener('click', saveOnline);
      document.getElementById('cm-new-map').addEventListener('click', function () { newMap(); });
      document.getElementById('cm-fork').addEventListener('click', forkCurrent);
      document.getElementById('cm-copy-link').addEventListener('click', copyLink);
      document.getElementById('cm-delete-map').addEventListener('click', deleteCurrent);
      document.getElementById('cm-copy-owner').addEventListener('click', function () {
        if (current.meta.ownerToken) copy(current.meta.ownerToken, S.copyOk);
      });
      document.getElementById('cm-map-name').addEventListener('input', function (e) {
        current.meta.name = e.target.value.slice(0, 80); markDirty();
      });
      document.getElementById('cm-map-server').addEventListener('input', function (e) {
        current.meta.server = e.target.value.slice(0, 40); markDirty();
      });
      document.getElementById('cm-read-mode').addEventListener('change', function (e) {
        current.meta.readMode = e.target.value; markDirty();
        document.getElementById('cm-read-pw-wrap').style.display = e.target.value === 'password' ? '' : 'none';
      });
      document.getElementById('cm-write-mode').addEventListener('change', function (e) {
        current.meta.writeMode = e.target.value; markDirty(); applyPermissions();
        document.getElementById('cm-write-pw-wrap').style.display = e.target.value === 'password' ? '' : 'none';
      });
      document.getElementById('cm-map-select').addEventListener('change', function (e) {
        var id = e.target.value;
        if (id === 'local') {
          var entry = registry.maps.local;
          if (entry) { adoptCached(entry); syncUrl(); }
          else newMap(true);
          return;
        }
        openMap(id);
      });
      document.getElementById('cm-public-list').addEventListener('click', function (e) {
        var b = e.target.closest('button[data-open]');
        if (!b) return;
        openMap(b.dataset.open);
      });
      document.getElementById('cm-unlock-write').addEventListener('click', function () {
        pending = { kind: readLocked ? 'read' : 'write', id: current.meta.id };
        showModal(pending.kind);
      });
      document.getElementById('cm-modal-cancel').addEventListener('click', hideModal);
      document.getElementById('cm-modal-ok').addEventListener('click', submitModal);
      document.getElementById('cm-modal-input').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); submitModal(); }
        if (e.key === 'Escape') hideModal();
      });
      document.getElementById('cm-modal').addEventListener('click', function (e) {
        if (e.target.id === 'cm-modal') hideModal();
      });

      /* ---------- events: stages ---------- */
      document.getElementById('cm-stages').addEventListener('click', function (e) {
        var b = e.target.closest('button[data-stage]');
        if (!b) return;
        stage = Number(b.dataset.stage);
        selectedCity = '';
        persistLocal();
        renderAll();
      });
      document.getElementById('cm-copy-prev').addEventListener('click', function () {
        if (!canEdit) { toast(readOnlyMessage()); return; }
        if (stage < 2) return;
        current.doc.stages[stage - 1].o = Object.assign({}, current.doc.stages[stage - 2].o);
        markDirty(); renderAll();
      });

      /* ---------- events: cities ---------- */
      function cityClick(id) {
        if (suppressClick) return;
        var p = byId.get(id);
        if (!p) return;
        if (isLocked(p)) { toast(stageLabel(stage)); return; }
        if (!canEdit) { toast(readOnlyMessage()); return; }
        if (paintMode && paintId) {
          var owners = curOwners();
          if (paintId === '__free__') delete owners[id];
          else if (owners[id] === paintId) delete owners[id];
          else owners[id] = paintId;
          markDirty(); renderAll();
          return;
        }
        selectedCity = selectedCity === id ? '' : id;
        highlight(); renderDetails(); renderTable();
      }
      polys.forEach(function (p) {
        p.addEventListener('click', function () { cityClick(p.dataset.id); });
        p.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); cityClick(p.dataset.id); }
        });
      });

      document.getElementById('cm-table-body').addEventListener('click', function (e) {
        var tr = e.target.closest('tr[data-id]');
        if (!tr) return;
        var id = tr.dataset.id, p = byId.get(id);
        selectedCity = id; highlight(); renderDetails(); renderTable();
        var x = Number(p.dataset.x), y = Number(p.dataset.y), w = Number(p.dataset.w), h = Number(p.dataset.h);
        var nw = Math.max(w + 100, (h + 100) / RATIO), nh = nw * RATIO;
        setView({ x: x + w / 2 - nw / 2, y: y + h / 2 - nh / 2, w: nw, h: nh });
        document.getElementById('cm-map-card').scrollIntoView({ behavior: 'smooth', block: 'center' });
      });

      document.getElementById('cm-levels').addEventListener('click', function (e) {
        var b = e.target.closest('button[data-level]'); if (!b) return;
        var v = b.dataset.level;
        if (v === 'all') filters.levels.clear();
        else { var n = Number(v); if (filters.levels.has(n)) filters.levels.delete(n); else filters.levels.add(n); }
        document.querySelectorAll('#cm-levels .cm-chip').forEach(function (c) {
          c.classList.toggle('is-on', c.dataset.level === 'all' ? filters.levels.size === 0 : filters.levels.has(Number(c.dataset.level)));
        });
        paintFilters(); renderTable();
      });
      document.getElementById('cm-bonuses').addEventListener('click', function (e) {
        var b = e.target.closest('button[data-bonus]'); if (!b) return;
        var k = b.dataset.bonus;
        if (filters.bonuses.has(k)) filters.bonuses.delete(k); else filters.bonuses.add(k);
        b.classList.toggle('is-on', filters.bonuses.has(k));
        paintFilters(); renderTable();
      });
      document.getElementById('cm-owner-filter').addEventListener('change', function (e) {
        filters.owner = e.target.value; paintFilters(); renderTable();
      });
      document.getElementById('cm-search').addEventListener('input', function (e) {
        filters.q = e.target.value.trim().toLowerCase(); paintFilters(); renderTable();
      });
      document.getElementById('cm-view').addEventListener('click', function (e) {
        var b = e.target.closest('button[data-view]'); if (!b) return;
        viewMode = b.dataset.view;
        document.querySelectorAll('#cm-view button').forEach(function (c) { c.classList.toggle('is-on', c === b); });
        paintMap();
      });
      document.getElementById('cm-labelmode').addEventListener('click', function (e) {
        var b = e.target.closest('button[data-label]'); if (!b) return;
        labelLayer.dataset.mode = b.dataset.label;
        document.querySelectorAll('#cm-labelmode button').forEach(function (c) { c.classList.toggle('is-on', c === b); });
        if (b.dataset.label !== 'off') fitBonusBadges();
      });
      document.getElementById('cm-paint-mode').addEventListener('change', function (e) {
        if (!canEdit) { e.target.checked = false; toast(readOnlyMessage()); return; }
        paintMode = e.target.checked;
      });
      document.getElementById('cm-paint').addEventListener('change', function (e) {
        if (!canEdit) { e.target.value = ''; toast(readOnlyMessage()); return; }
        paintId = e.target.value;
        if (paintId) { paintMode = true; document.getElementById('cm-paint-mode').checked = true; }
        renderAlliances();
      });
      document.getElementById('cm-alliance-list').addEventListener('click', function (e) {
        var btn = e.target.closest('button'); if (!btn) return;
        var id = btn.dataset.id, act = btn.dataset.act;
        if (!canEdit) { toast(readOnlyMessage()); return; }
        if (act === 'del') {
          current.doc.alliances = current.doc.alliances.filter(function (a) { return a.id !== id; });
          current.doc.stages.forEach(function (s) {
            Object.keys(s.o).forEach(function (cid) { if (s.o[cid] === id) delete s.o[cid]; });
          });
          if (paintId === id) paintId = '';
          if (editingId === id) resetForm();
          markDirty(); renderAll(); return;
        }
        if (act === 'edit') {
          var a = alliance(id); if (!a) return;
          editingId = id;
          document.getElementById('cm-new-name').value = a.name;
          formColor = a.color; formIcon = a.icon; syncFormSwatches();
          document.getElementById('cm-save-alliance').textContent = S.save;
          document.getElementById('cm-cancel-edit').classList.remove('hidden');
          document.getElementById('cm-new-name').focus(); return;
        }
        paintId = paintId === id ? '' : id;
        if (paintId) { paintMode = true; document.getElementById('cm-paint-mode').checked = true; }
        document.getElementById('cm-paint').value = paintId;
        renderAlliances();
      });
      document.getElementById('cm-save-alliance').addEventListener('click', saveAlliance);
      document.getElementById('cm-new-name').addEventListener('keydown', function (e) { if (e.key === 'Enter') saveAlliance(); });
      document.getElementById('cm-cancel-edit').addEventListener('click', resetForm);
      document.getElementById('cm-colors').addEventListener('click', function (e) {
        var b = e.target.closest('.cm-swatch'); if (!b) return;
        formColor = b.dataset.color; syncFormSwatches();
      });
      document.getElementById('cm-icons').addEventListener('click', function (e) {
        var b = e.target.closest('.cm-emoji'); if (!b) return;
        formIcon = b.dataset.icon; syncFormSwatches();
      });
      document.getElementById('cm-clear').addEventListener('click', function () {
        if (!canEdit) { toast(readOnlyMessage()); return; }
        current.doc.stages[stage - 1].o = {};
        markDirty(); renderAll();
      });
      document.getElementById('cm-share').addEventListener('click', copyLink);
      document.getElementById('cm-export').addEventListener('click', function () {
        var payload = {
          v: 2, name: current.meta.name, server: current.meta.server,
          alliances: current.doc.alliances, stages: current.doc.stages,
        };
        var blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'last-asylum-city-map-' + D.lang + '.json';
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
      });
      document.getElementById('cm-import').addEventListener('click', function () {
        if (!canEdit) { toast(readOnlyMessage()); return; }
        document.getElementById('cm-file').click();
      });
      document.getElementById('cm-file').addEventListener('change', function (e) {
        var f = e.target.files && e.target.files[0]; if (!f) return;
        f.text().then(function (txt) {
          var raw = JSON.parse(txt);
          current.doc = normalizeDoc(raw);
          if (typeof raw.name === 'string') current.meta.name = raw.name.slice(0, 80);
          if (typeof raw.server === 'string') current.meta.server = raw.server.slice(0, 40);
          current.meta.id = '';
          current.meta.rev = 0;
          markDirty(); renderMapManager(); renderAll(); toast(S.importOk);
        }).catch(function () { toast('JSON error'); });
        e.target.value = '';
      });
      window.addEventListener('beforeunload', function (e) {
        if (dirty && current.meta.id) { e.preventDefault(); e.returnValue = ''; }
      });

      /* ---------- boot ---------- */
      try {
        var raw = localStorage.getItem(LS);
        if (raw) {
          var parsed = JSON.parse(raw);
          if (parsed && parsed.maps) registry = { active: parsed.active || 'local', maps: parsed.maps };
        }
      } catch (e) {}

      var params = new URLSearchParams(location.search);
      var mapId = params.get('map');
      var ownerFromHash = (location.hash.match(/#k=([a-f0-9]{32,64})/) || [])[1] || '';
      if (ownerFromHash && mapId && registry.maps[mapId]) registry.maps[mapId].meta.ownerToken = ownerFromHash;

      if (mapId && /^[a-z0-9]{8,16}$/.test(mapId)) {
        var cached = registry.maps[mapId];
        if (cached) adoptCached(cached);
        else {
          current.meta = Object.assign(blankMeta(), { id: mapId, name: mapId });
          readLocked = true;
          renderMapManager(); renderAll();
        }
        openMap(mapId);
      } else {
        var entry = registry.maps[registry.active];
        if (entry) adoptCached(entry);
        else { persistLocal(); renderMapManager(); renderAll(); }
        var legacy = location.hash.match(/#cm=([A-Za-z0-9\-_]+)/);
        if (legacy) {
          try {
            current.doc = normalizeDoc(decode(legacy[1]));
            current.meta.id = '';
            markDirty(); renderMapManager(); renderAll(); toast(S.importOk);
          } catch (e) {}
        }
      }
      resetForm();
      renderAll();
      loadPublicMaps();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
    document.addEventListener('astro:page-load', init);
  })();
</script>

<style is:global>
  #cm-app .cm-panel {
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 16px;
    background: linear-gradient(180deg, rgba(24, 24, 19, 0.92), rgba(12, 12, 10, 0.94));
    box-shadow: 0 18px 45px -30px rgba(0, 0, 0, 0.9);
  }
  #cm-app .cm-cap {
    font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase;
    color: #a8a29e; white-space: nowrap; font-weight: 600;
  }
  #cm-app .cm-field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  #cm-app .cm-chip,
  #cm-app .cm-iconbtn,
  #cm-app .cm-btn-ghost {
