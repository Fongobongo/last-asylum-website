---
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isRu = lang === 'ru';

const T = {
  title: isRu ? 'Нужна помощь? Свяжитесь с нами' : 'Need help? Contact us',
  subtitle: isRu
    ? 'Баги, битые ссылки, вопросы по гайдам — пишите, отвечаем в Discord и по почте.'
    : 'Bugs, broken links, guide questions — reach out via Discord or email.',
  discordTitle: 'Discord',
  discordDesc: isRu ? 'Быстрые вопросы и обсуждение гайдов' : 'Quick questions & guide discussion',
  discordBtn: isRu ? 'Открыть Discord ↗' : 'Open Discord ↗',
  emailTitle: 'Email',
  emailDesc: isRu ? 'Баги, DMCA, сотрудничество' : 'Bugs, DMCA, partnerships',
  guidesTitle: isRu ? 'Каталог гайдов' : 'Guides index',
  guidesDesc: isRu ? 'Все 60+ публикаций в одном месте' : 'All 60+ publications in one place',
  guidesBtn: isRu ? 'Открыть гайды →' : 'Browse guides →',
};

// Discord invite: community server (same as footer/DiscordBanner).
const DISCORD_URL = 'https://discord.gg/2PYWRyNtmU';
const CONTACT_EMAIL = 'support@lastasylum.example';
---

<section class="not-prose mx-auto max-w-5xl mt-12 rounded-3xl border border-white/10 bg-stone-900/60 p-6 sm:p-8">
  <h2 class="text-xl font-bold text-white">{T.title}</h2>
  <p class="mt-1 text-sm text-stone-400">{T.subtitle}</p>
  <div class="mt-6 grid gap-3 sm:grid-cols-3">
    <div class="rounded-2xl border border-white/10 bg-black/40 p-4">
      <div class="text-sm font-bold text-white">💬 {T.discordTitle}</div>
      <div class="mt-1 text-xs text-stone-400">{T.discordDesc}</div>
      <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex items-center gap-1.5 rounded-xl border border-toxic-500/40 bg-toxic-500/15 px-3 py-1.5 text-xs font-semibold text-toxic-300 hover:bg-toxic-500/25 transition">
        {T.discordBtn}
      </a>
    </div>
    <div class="rounded-2xl border border-white/10 bg-black/40 p-4">
      <div class="text-sm font-bold text-white">✉️ {T.emailTitle}</div>
      <div class="mt-1 text-xs text-stone-400">{T.emailDesc}</div>
      <a href={`mailto:${CONTACT_EMAIL}`} class="mt-3 inline-flex items-center gap-1.5 rounded-xl border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-stone-200 hover:bg-white/10 transition">
        {CONTACT_EMAIL}
      </a>
    </div>
    <div class="rounded-2xl border border-white/10 bg-black/40 p-4">
      <div class="text-sm font-bold text-white">📚 {T.guidesTitle}</div>
      <div class="mt-1 text-xs text-stone-400">{T.guidesDesc}</div>
      <a href={isRu ? '/ru/guides/' : '/guides/'} class="mt-3 inline-flex items-center gap-1.5 rounded-xl border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-stone-200 hover:bg-white/10 transition">
        {T.guidesBtn}
      </a>
    </div>
  </div>
</section>
