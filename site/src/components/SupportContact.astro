const s = (ru: string, en: string, k: string) =>
  lang === 'ru' ? ru : ((STR as any)[lang]?.[k] ?? en);

const T = {
  title: s('Нужна помощь? Свяжитесь с нами', 'Need help? Contact us', 'title'),
  subtitle: s('Баги, битые ссылки, вопросы по гайдам — пишите, отвечаем в Discord и по почте.', 'Bugs, broken links, guide questions — reach out via Discord or email.', 'subtitle'),
  discordTitle: 'Discord',
  discordDesc: s('Быстрые вопросы и обсуждение гайдов', 'Quick questions & guide discussion', 'discordDesc'),
  discordBtn: s('Открыть Discord ↗', 'Open Discord ↗', 'discordBtn'),
  emailTitle: 'Email',
  emailDesc: s('Баги, DMCA, сотрудничество', 'Bugs, DMCA, partnerships', 'emailDesc'),
  guidesTitle: s('Каталог гайдов', 'Guides index', 'guidesTitle'),
  guidesDesc: s('Все 60+ публикаций в одном месте', 'All 60+ publications in one place', 'guidesDesc'),
  guidesBtn: s('Открыть гайды →', 'Browse guides →', 'guidesBtn'),
