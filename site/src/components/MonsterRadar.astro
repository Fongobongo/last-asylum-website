};

const t = i18n[lang as keyof typeof i18n] || i18n.en;

// Известные виды монстров карты мира (из банка данных клиента игры).
// ids: [первый, последний] айди из банка данных; count — число записей (уровней/вариантов).
const bestiaryLabels: Record<string, { title: string; sub: string }> = {
  ru: { title: '📖 Бестиарий карты мира', sub: 'Все виды монстров и боссов, найденные в данных игрового клиента (полный список из SlgMonsterInfo).' },
  en: { title: '📖 World Map Bestiary', sub: 'Every monster and boss species found in the game client data (full SlgMonsterInfo table).' },
};
const bLabel = bestiaryLabels[lang] || bestiaryLabels.en;
const speciesShow = (monsterSpecies as any[])
  .filter((s) => !/^(Rat Horde|Rat Plague|Fang Guard|Giant Axe Warrior|Plague Blight|Giant Rat King|Menacing|Plague Rat)/.test(s.key))
  .map((s) => ({ count: s.count as number, label: (s.names?.[lang] as string) || s.names?.en || s.key }));

const soloMonsters = (monstersData.solo as any[]).map((m) => ({
  level: m.level,
  name: m.name?.[lang] || m.name?.ru || m.name?.en || `Monster Lv.${m.level}`,
  stamina: m.staminaCost,
  powerEst: Math.round(50000 * Math.pow(1.18, m.level - 1)).toLocaleString(),
}));

const rallyMonsters = (monstersData.rally as any[]).map((m) => ({
  level: m.level,
  name: m.name?.[lang] || m.name?.ru || m.name?.en || `Doom Elite Lv.${m.level}`,
  stamina: m.staminaCost,
  powerEst: Math.round(250000 * Math.pow(1.22, m.level - 1)).toLocaleString(),
}));
---

<section class="not-prose my-10 rounded-3xl border border-toxic-500/30 bg-stone-950/80 p-6 sm:p-8 backdrop-blur-xl shadow-[0_0_50px_rgba(0,0,0,0.6)]" id="monster-radar-app">
  <div class="mb-6 flex flex-col gap-2">
    <div class="flex items-center gap-3">
      <span class="rounded-xl border border-toxic-500/40 bg-toxic-950/60 px-3 py-1 text-xs font-bold text-toxic-400">
        PVE HUNTING RADAR
      </span>
      <span class="text-xs text-stone-500 font-mono">60 OFFICIAL TIERS</span>
    </div>
    <h2 class="text-2xl font-bold tracking-tight text-toxic-400 sm:text-3xl">{t.title}</h2>
    <p class="text-sm text-stone-400 max-w-3xl">{t.subtitle}</p>
  </div>

  <!-- Alliance Auto-Rally Callout -->
  <div class="mb-6 rounded-2xl border border-toxic-500/30 bg-toxic-950/30 p-4 sm:p-5">
    <div class="flex items-center gap-2 mb-2">
      <span class="text-lg">📢</span>
      <h3 class="text-sm font-bold text-toxic-300">{t.rallyAdviseTitle}</h3>
    </div>
    <p class="text-xs text-stone-300 leading-relaxed">{t.rallyAdviseText}</p>
  </div>

  <!-- Bestiary (all monster species from game data) -->
  <div class="mb-6">
    <div class="flex items-center gap-2 mb-1">
      <h3 class="text-sm font-bold text-toxic-300">{bLabel.title}</h3>
    </div>
    <p class="text-[11px] text-stone-500 mb-3">{bLabel.sub}</p>
    <div class="grid gap-1.5 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4">
      {speciesShow.map((s: any) => (
        <div class="rounded-lg border border-stone-800/70 bg-stone-900/40 px-2.5 py-1.5 flex items-center justify-between gap-2">
          <span class="text-[11px] text-stone-200 truncate">{s.label}</span>
          <span class="text-[10px] text-stone-500 font-mono shrink-0">×{s.count}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Mode Switcher -->
  <div class="flex flex-wrap gap-2 mb-6" id="monster-mode-switch">
    <button
      type="button"
      id="btn-mode-rally"
      class="rounded-xl bg-toxic-500 px-4 py-2 text-xs font-bold text-stone-950 shadow-[0_0_15px_rgba(180,255,57,0.3)] transition-all"
    >
      <img src="/game/monsters/boss_01.png" alt="" width="20" height="20" class="inline-block h-5 w-5 rounded align-[-4px]" onerror="this.remove()" /> ⚔️ {t.rallyTab} (30 Lv)
    </button>
    <button
      type="button"
      id="btn-mode-solo"
      class="rounded-xl border border-stone-800 bg-stone-900/60 px-4 py-2 text-xs font-bold text-stone-400 hover:border-toxic-500/40 hover:text-stone-200 transition-all"
    >
      <img src="/game/monsters/xiaoguai_01.png" alt="" width="20" height="20" class="inline-block h-5 w-5 rounded align-[-4px]" onerror="this.remove()" /> 🎯 {t.soloTab} (30 Lv)
    </button>
  </div>

  <!-- Rally Monsters Container -->
  <div id="container-rally-monsters">
    <div class="mb-3 text-xs text-stone-400 flex items-center justify-between">
      <span>{t.rallyMonsterDesc}</span>
      <span class="text-toxic-400 font-semibold">{t.stamina} 20</span>
    </div>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {rallyMonsters.map((m) => (
        <div class="rounded-2xl border border-stone-800/80 bg-stone-900/40 p-4 transition hover:border-toxic-500/40 hover:bg-stone-900/80">
          <div class="flex items-center justify-between mb-2">
            <span class="rounded-md border border-toxic-500/30 bg-toxic-950/60 px-2 py-0.5 text-xs font-bold text-toxic-400">
              Lv. {m.level}
            </span>
            <span class="text-[11px] text-stone-400 font-mono">
              ⚡ 20
            </span>
          </div>
          <h4 class="text-sm font-bold text-stone-100">{m.name}</h4>
          <div class="mt-2 space-y-1 text-xs">
            <div class="text-stone-400">
              <span class="text-stone-500">{t.powerReq}</span> ~{m.powerEst}
            </div>
            <div class="text-stone-400">
              <span class="text-stone-500">{t.drops}</span>
              <span class="text-toxic-300 font-medium ml-1">{t.dropsRally}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Solo Monsters Container -->
  <div id="container-solo-monsters" class="hidden">
    <div class="mb-3 text-xs text-stone-400 flex items-center justify-between">
      <span>{t.soloMonsterDesc}</span>
      <span class="text-toxic-400 font-semibold">{t.stamina} 10</span>
    </div>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {soloMonsters.map((m) => (
        <div class="rounded-2xl border border-stone-800/80 bg-stone-900/40 p-4 transition hover:border-toxic-500/40 hover:bg-stone-900/80">
          <div class="flex items-center justify-between mb-2">
            <span class="rounded-md border border-stone-700 bg-stone-950 px-2 py-0.5 text-xs font-bold text-stone-300">
              Lv. {m.level}
            </span>
            <span class="text-[11px] text-stone-400 font-mono">
              ⚡ 10
            </span>
          </div>
          <h4 class="text-sm font-bold text-stone-100">{m.name}</h4>
          <div class="mt-2 space-y-1 text-xs">
            <div class="text-stone-400">
              <span class="text-stone-500">{t.powerReq}</span> ~{m.powerEst}
            </div>
            <div class="text-stone-400">
              <span class="text-stone-500">{t.drops}</span>
              <span class="text-stone-300 ml-1">{t.dropsSolo}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function initMonsterRadar() {
    const btnRally = document.getElementById('btn-mode-rally');
    const btnSolo = document.getElementById('btn-mode-solo');
    const cRally = document.getElementById('container-rally-monsters');
    const cSolo = document.getElementById('container-solo-monsters');

    if (!btnRally || !btnSolo || !cRally || !cSolo) return;

    btnRally.addEventListener('click', () => {
      cRally.classList.remove('hidden');
      cSolo.classList.add('hidden');

      btnRally.className = 'rounded-xl bg-toxic-500 px-4 py-2 text-xs font-bold text-stone-950 shadow-[0_0_15px_rgba(180,255,57,0.3)] transition-all';
      btnSolo.className = 'rounded-xl border border-stone-800 bg-stone-900/60 px-4 py-2 text-xs font-bold text-stone-400 hover:border-toxic-500/40 hover:text-stone-200 transition-all';
    });

    btnSolo.addEventListener('click', () => {
      cSolo.classList.remove('hidden');
      cRally.classList.add('hidden');

      btnSolo.className = 'rounded-xl bg-toxic-500 px-4 py-2 text-xs font-bold text-stone-950 shadow-[0_0_15px_rgba(180,255,57,0.3)] transition-all';
      btnRally.className = 'rounded-xl border border-stone-800 bg-stone-900/60 px-4 py-2 text-xs font-bold text-stone-400 hover:border-toxic-500/40 hover:text-stone-200 transition-all';
    });
  }

  initMonsterRadar();
  document.addEventListener('astro:page-load', initMonsterRadar);
</script>
