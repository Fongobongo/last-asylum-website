  },
  pl: {
    title: '🧟 Radar Potworów i Rajdów (Blight poz. 1–30)',
    subtitle: 'Kompletna baza danych 30 poziomów solowych Plague Peasant oraz 30 sojuszniczych bossów rajdowych Doom Elite. Koszty staminy, tabele łupów i taktyki polowań.',
    soloTab: 'Potwory solowe (Plague Peasant)',
    rallyTab: 'Rajdy sojusznicze (Doom Elite)',
    stamina: 'Stamina:',
    powerReq: 'Zalecana siła:',
    drops: 'Kluczowe nagrody:',
    dropsSolo: 'PD Bohatera, Zboże, Drewno, Materiały do craftingu sprzętu',
    dropsRally: 'Skrzynie sojusznicze, Punkty VIP, Przyspieszacze, PD Bohatera wysokiego poziomu',
    rallyAdviseTitle: 'Strategia rajdów sojuszniczych:',
    rallyAdviseText: 'Zbadaj "Auto-Rally" w drzewku technologii sojuszu! Automatycznie wysyła twoje wojska do rajdów członków sojuszu, gdy jesteś offline, co pozwala zdobyć setki skrzyń z nagrodami dziennie.',
    levelLabel: 'Poziom',
    soloMonsterDesc: 'Potwory solowe na mapie świata. Atakowane przez jeden oddział bez czasu oczekiwania.',
    rallyMonsterDesc: 'Bossowie grupowi na mapie świata. Wymagają zainicjowania rajdu sojuszniczego (5 min) z udziałem co najmniej 2 graczy.',
