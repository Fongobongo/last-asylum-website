          );
        })}
      </div>
    </nav>

    <nav id="mobile-menu" class="hidden lg:hidden border-t border-white/5 py-4 max-h-[75vh] overflow-y-auto">
      <div class="sm:hidden mb-3 flex items-center justify-between rounded-xl border border-white/10 bg-stone-900/80 px-3 py-2 text-xs font-mono text-stone-400">
        <span class="flex items-center gap-1.5 text-stone-300">
          <span class="h-1.5 w-1.5 rounded-full bg-toxic-400 animate-pulse"></span>
          <span>{dictServer[lang] ?? 'Server:'} <strong id="utc-clock-m" class="text-white">--:--:--</strong></span>
        </span>
        <span>
          {dictReset[lang] ?? 'Reset:'} <strong id="utc-countdown-m" class="text-toxic-300 font-semibold">--h --m</strong>
        </span>
      </div>

      <a
        href={`${base}/events/alliance-duel/`}
        class="sm:hidden mb-3 flex items-center justify-between rounded-xl border border-toxic-500/20 bg-stone-900/60 px-3 py-2 text-xs font-mono text-stone-300 hover:border-toxic-400 transition"
      >
        <span class="flex items-center gap-1.5">
          <span>⚔️</span>
          <span>{H('duelLabel')}</span>
        </span>
        <strong id="ad-phase-badge-m" class="text-toxic-400 font-semibold">--</strong>
      </a>

      <a
        href={`${base}/alliance/`}
        class="mb-3 flex items-center justify-between rounded-xl border border-toxic-500/40 bg-gradient-to-r from-toxic-500/15 via-plague-500/10 to-stone-900/60 p-3 text-xs font-bold text-white transition hover:border-toxic-400"
      >
        <div class="flex items-center gap-2.5">
          <span class="text-base">🛡️</span>
          <div>
            <div class="font-bold text-toxic-300">{H('allianceInfo')}</div>
            <div class="text-[10px] text-stone-400 font-normal">{H('pollsTactics')}</div>
          </div>
        </div>
        <span class="rounded bg-stone-950/80 border border-toxic-500/30 px-2 py-0.5 font-mono text-[10px] text-toxic-400">{H('open')}</span>
      </a>
      <div class="grid grid-cols-2 gap-2">
        {navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a href={`${base}/${item.href}/`} class:list={['rounded-xl border px-3 py-2.5 text-xs font-medium transition flex items-center gap-2', active ? 'border-toxic-400 bg-toxic-400/10 text-toxic-300' : 'border-white/5 bg-white/[0.03] text-stone-300 hover:bg-white hover:text-black']}>
              <span class="text-[10px] font-mono opacity-50">{item.num}</span> <span class="truncate">{t(lang, item.key)}</span>
            </a>
          );
        })}
      </div>
      <div class="mt-3 pt-3 border-t border-white/5 flex items-center justify-between">
        <a href={`${base}/credits/`} class="text-xs text-stone-400 hover:text-white">{t(lang, 'nav.credits')}</a>
        <a href={`${base}/support/`} class="text-xs font-bold text-toxic-400 hover:text-toxic-300 inline-flex items-center gap-1">
          <span>💎</span>
          <span>{H('shopTopup')}</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<div id="search-modal" data-lang={lang} class="fixed inset-0 z-[60] hidden bg-black/80 backdrop-blur-xl" role="dialog" aria-modal="true">
  <div class="mx-auto mt-[10vh] max-w-2xl px-4">
    <div class="overflow-hidden rounded-[24px] border border-white/10 bg-[#0f0f0e] shadow-2xl">
      <div class="flex items-center gap-3 px-5 py-4 border-b border-white/5">
        <span class="text-stone-500">⌕</span>
        <input id="search-input" type="search" placeholder={t(lang, 'search.placeholder')} class="w-full bg-transparent text-lg text-white placeholder:text-stone-500 outline-none" autocomplete="off" />
        <button id="search-close" class="rounded-full bg-white/10 hover:bg-white hover:text-black px-3 py-1 text-xs font-semibold text-stone-300 transition">ESC</button>
      </div>
      <div class="flex flex-wrap items-center gap-1.5 px-4 py-2 bg-black/40 border-b border-white/5 text-xs text-stone-400 overflow-x-auto">
        <span class="text-[10px] font-mono text-stone-500 mr-1">{H('quick')}</span>
        <button type="button" class="js-search-chip rounded-md border border-white/10 bg-white/5 px-2 py-0.5 hover:border-toxic-400 hover:text-toxic-300 transition text-[11px]" data-query={H('chipDuelQ')}>⚔️ {H('chipDuel')}</button>
        <button type="button" class="js-search-chip rounded-md border border-white/10 bg-white/5 px-2 py-0.5 hover:border-toxic-400 hover:text-toxic-300 transition text-[11px]" data-query={H('chipCodesQ')}>🎁 {H('chipCodes')}</button>
        <button type="button" class="js-search-chip rounded-md border border-white/10 bg-white/5 px-2 py-0.5 hover:border-toxic-400 hover:text-toxic-300 transition text-[11px]" data-query={H('chipTierQ')}>🏆 {H('chipTier')}</button>
        <button type="button" class="js-search-chip rounded-md border border-white/10 bg-white/5 px-2 py-0.5 hover:border-toxic-400 hover:text-toxic-300 transition text-[11px]" data-query={H('chipRaven')}>🦅 {H('chipRaven')}</button>
        <button type="button" class="js-search-chip rounded-md border border-white/10 bg-white/5 px-2 py-0.5 hover:border-toxic-400 hover:text-toxic-300 transition text-[11px]" data-query={H('chipGear')}>🛡️ {H('chipGear')}</button>
        <button type="button" class="js-search-chip rounded-md border border-white/10 bg-white/5 px-2 py-0.5 hover:border-toxic-400 hover:text-toxic-300 transition text-[11px]" data-query={H('chipInfographics')}>📊 {H('chipInfographics')}</button>
      </div>
      <div id="search-results" class="max-h-[60vh] overflow-y-auto p-2"></div>
      <div class="flex items-center justify-between border-t border-white/5 px-4 py-3 text-xs text-stone-500">
        <span><kbd class="rounded bg-white/10 px-1.5 py-0.5">↑↓</kbd> navigate • <kbd class="rounded bg-white/10 px-1.5 py-0.5">↵</kbd> open</span>
        <span class="hidden sm:inline">Pagefind • 19 languages</span>
      </div>
    </div>
  </div>
</div>

<script>
  function initChrome() {
    const header = document.getElementById('site-header');
    const onScroll = () => { if (!header) return; header.classList.toggle('shadow-[0_10px_40px_rgba(0,0,0,0.5)]', window.scrollY > 10); };
    window.addEventListener('scroll', onScroll, { passive: true }); onScroll();

    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    menuToggle?.addEventListener('click', () => {
      const isHidden = mobileMenu?.classList.toggle('hidden');
      if (menuToggle) menuToggle.textContent = isHidden ? '☰' : '✕';
      if (!isHidden) {
        langMenu?.classList.add('hidden');
        bmDropdown?.classList.add('hidden');
      }
    });

    const langToggle = document.getElementById('lang-toggle');
    const langMenu = document.getElementById('lang-menu');
    const bmBtn = document.getElementById('btn-bookmarks-header');
    const bmDropdown = document.getElementById('bm-header-dropdown');
    const bmList = document.getElementById('bm-header-list');
    const bmBadge = document.getElementById('bm-header-badge');
    const bmCount = document.getElementById('bm-header-count');

    // Language Dropdown
    langToggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      langMenu?.classList.toggle('hidden');
      bmDropdown?.classList.add('hidden');
      if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
        mobileMenu.classList.add('hidden');
        if (menuToggle) menuToggle.textContent = '☰';
      }
    });

    // Bookmarks Dropdown & State
    const renderBookmarks = () => {
      let list: Array<{ url: string; title: string }> = [];
      try { list = JSON.parse(localStorage.getItem('lap_bookmarks') || '[]'); } catch {}

      if (bmBadge) {
        if (list.length > 0) {
          bmBadge.textContent = String(list.length);
          bmBadge.classList.remove('hidden');
        } else {
          bmBadge.classList.add('hidden');
        }
      }
      if (bmCount) bmCount.textContent = String(list.length);

      if (bmList) {
        if (list.length === 0) {
          const __bmLang = (document.documentElement.lang || 'en');
          const __bmEmpty: Record<string, string> = {ru:'Нет закладок. Нажмите ☆ в гайде.',en:'No bookmarks yet. Click ☆ on any guide.',es:'Sin marcadores. Pulsa ☆ en cualquier guía.',pt:'Sem salvos. Clique em ☆ em qualquer guia.',fr:'Aucun signet. Cliquez sur ☆ dans un guide.',de:'Keine Lesezeichen. Klicke auf ☆ in einem Guide.',id:'Belum ada markah. Klik ☆ di panduan mana pun.',ko:'북마크 없음. 가이드에서 ☆를 눌러 저장하세요.',ja:'ブックマークなし。ガイドの☆を押してください。',ar:'لا توجد عناصر محفوظة. اضغط ☆ في أي دليل.',it:'Nessun segnalibro. Premi ☆ in una guida.',ms:'Tiada tanda buku. Klik ☆ dalam mana-mana panduan.',nl:'Geen bladwijzers. Klik op ☆ in een gids.',th:'ยังไม่มีบุ๊กมาร์ก กด ☆ ในคู่มือ',tr:'Kayıtlı yok. Herhangi bir rehberde ☆ simgesine basın.',vi:'Chưa có đánh dấu. Nhấn ☆ trong bất kỳ hướng dẫn nào.',zh:'暂无收藏。点击任意指南中的☆。',pl:'Brak zakładek. Kliknij ☆ w dowolnym poradniku.','zh-tw':'尚無收藏。點擊任意指南中的☆。'};
          const __bmEmptyText = __bmEmpty[__bmLang] ?? __bmEmpty[__bmLang.slice(0,2)] ?? __bmEmpty.en;
          bmList.innerHTML = `<p class="text-xs text-stone-500 py-4 text-center">${__bmEmptyText}</p>`;
        } else {
          bmList.innerHTML = list.map((item, idx) => `
            <div class="flex items-center justify-between gap-2 rounded-xl p-2 hover:bg-white/5 transition group">
              <a href="${item.url}" class="min-w-0 flex-1 text-xs font-medium text-stone-200 hover:text-toxic-300 truncate">
                ${item.title || item.url}
              </a>
              <button type="button" data-idx="${idx}" class="bm-del-btn opacity-60 hover:opacity-100 text-stone-500 hover:text-red-400 text-xs px-1 cursor-pointer" title="Remove">
                ✕
              </button>
            </div>
          `).join('');

          bmList.querySelectorAll('.bm-del-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
              e.stopPropagation();
              const idx = parseInt((btn as HTMLElement).dataset.idx || '-1', 10);
              if (idx >= 0) {
                list.splice(idx, 1);
                localStorage.setItem('lap_bookmarks', JSON.stringify(list));
                renderBookmarks();
                window.dispatchEvent(new CustomEvent('lap-bookmarks-updated'));
              }
            });
          });
        }
      }
    };

    bmBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      bmDropdown?.classList.toggle('hidden');
      langMenu?.classList.add('hidden');
    });

    document.addEventListener('click', (e) => {
      langMenu?.classList.add('hidden');
      if (!bmDropdown?.contains(e.target as Node) && e.target !== bmBtn) {
        bmDropdown?.classList.add('hidden');
      }
    });

    window.addEventListener('lap-bookmarks-updated', renderBookmarks);
    window.addEventListener('storage', renderBookmarks);
    renderBookmarks();

    const modal = document.getElementById('search-modal');
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    let selectedIdx = -1;

    const updateSelection = () => {
      const items = document.querySelectorAll<HTMLAnchorElement>('#search-results a');
      items.forEach((item, idx) => {
        const isSelected = idx === selectedIdx;
        item.classList.toggle('bg-white/10', isSelected);
        item.classList.toggle('ring-1', isSelected);
        item.classList.toggle('ring-toxic-400/50', isSelected);
        if (isSelected) item.scrollIntoView({ block: 'nearest' });
      });
    };

    const open = async () => {
      modal?.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
      input?.focus();
      selectedIdx = -1;
      if (!(window as any).pagefind) {
        try {
          const imp = new Function('u','return import(u)') as any;
          (window as any).pagefind = await imp('/pagefind/pagefind.js');
        } catch {}
      }
    };

    const close = () => {
      modal?.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
      selectedIdx = -1;
    };

    document.getElementById('search-open')?.addEventListener('click', open);
    document.getElementById('search-open-m')?.addEventListener('click', open);
    document.getElementById('search-close')?.addEventListener('click', close);
    modal?.addEventListener('click', (e) => { if (e.target === modal) close(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
      const isK = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k';
      const t = (e.target as HTMLElement);
      const isTypingContext = t?.tagName === 'INPUT' || t?.tagName === 'TEXTAREA' || t?.tagName === 'SELECT' || t?.isContentEditable;
      const isSlash = e.key === '/' && !isTypingContext;
      if (isK || isSlash) {
        e.preventDefault();
        if (modal?.classList.contains('hidden')) {
          open();
        } else {
          close();
        }
      }
    });

    document.querySelectorAll('.js-search-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const query = chip.getAttribute('data-query');
        if (input && query) {
          input.value = query;
          input.dispatchEvent(new Event('input', { bubbles: true }));
          input.focus();
        }
      });
    });

    input?.addEventListener('keydown', (e) => {
      const items = document.querySelectorAll<HTMLAnchorElement>('#search-results a');
      if (!items.length) return;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIdx = (selectedIdx + 1) % items.length;
        updateSelection();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIdx = selectedIdx <= 0 ? items.length - 1 : selectedIdx - 1;
        updateSelection();
      } else if (e.key === 'Enter') {
        if (selectedIdx >= 0 && items[selectedIdx]) {
          e.preventDefault();
          items[selectedIdx].click();
          close();
        }
      }
    });

    let debounce: any;
    input?.addEventListener('input', () => {
      clearTimeout(debounce);
      selectedIdx = -1;
      debounce = setTimeout(async () => {
        const pf = (window as any).pagefind;
        const el = document.getElementById('search-results');
        if (!el) return;
        const curLang = modal?.dataset.lang || 'en';
        // 19-lang search modal messages (fallback: EN).
        const M_EMPTY: Record<string, string> = { ru: 'Введите запрос для поиска по руководствам…', en: 'Type to search guides…', de: 'Tippe, um Guides zu durchsuchen…', es: 'Escribe para buscar guías…', fr: 'Tapez pour rechercher des guides…', id: 'Ketik untuk mencari panduan…', ja: '入力してガイドを検索…', ko: '입력하여 가이드 검색…', pt: 'Digite para pesquisar guias…', ar: 'اكتب للبحث في الأدلة…', it: 'Digita per cercare guide…', ms: 'Taip untuk cari panduan…', nl: 'Typ om gidsen te zoeken…', th: 'พิมพ์เพื่อค้นหาคู่มือ…', tr: 'Rehberlerde aramak için yazın…', vi: 'Gõ để tìm hướng dẫn…', zh: '输入以搜索指南…', pl: 'Wpisz, aby szukać poradników…', 'zh-tw': '輸入以搜尋指南…' };
        const M_NONE: Record<string, string> = { ru: 'Ничего не найдено', en: 'No results found', de: 'Keine Ergebnisse', es: 'Sin resultados', fr: 'Aucun résultat', id: 'Tidak ada hasil', ja: '結果なし', ko: '결과 없음', pt: 'Nenhum resultado', ar: 'لا نتائج', it: 'Nessun risultato', ms: 'Tiada keputusan', nl: 'Geen resultaten', th: 'ไม่พบผลลัพธ์', tr: 'Sonuç yok', vi: 'Không có kết quả', zh: '未找到结果', pl: 'Brak wyników', 'zh-tw': '未找到結果' };
        const emptyMsg = M_EMPTY[curLang] ?? M_EMPTY.en;
        const noResultsMsg = M_NONE[curLang] ?? M_NONE.en;

        if (!pf || !input.value.trim()) {
          el.innerHTML = `<div class="p-10 text-center text-stone-500 text-sm">${emptyMsg}</div>`;
          return;
        }
        // Search only in the current language — a site with 19 locales must
        // not mix RU/EN/KO results for an Italian visitor.
        const s = await pf.search(input.value, { filters: { lang: curLang } });
        const items = await Promise.all(s.results.slice(0, 8).map((r: any) => r.data()));
        if (!items.length) {
          el.innerHTML = `<div class="p-10 text-center text-stone-500 text-sm">${noResultsMsg}</div>`;
          return;
        }
        el.innerHTML = items.map((d: any) => `
          <a href="${d.url}" class="flex items-center gap-3 rounded-xl p-3 hover:bg-white/5 transition">
            <span class="h-8 w-8 shrink-0 grid place-items-center rounded-full bg-toxic-400 text-black text-xs font-bold font-mono">↗</span>
            <div class="min-w-0">
              <div class="text-sm font-semibold text-white truncate">${d.meta.title ?? d.url}</div>
              <div class="text-xs text-stone-400 line-clamp-1 mt-0.5">${d.excerpt}</div>
            </div>
          </a>
        `).join('');
      }, 150);
    });

    const initUtcTimer = () => {
      const clockEl = document.getElementById('utc-clock');
      const countdownEl = document.getElementById('utc-countdown');
      const clockElM = document.getElementById('utc-clock-m');
      const countdownElM = document.getElementById('utc-countdown-m');
      const adBadgeEl = document.getElementById('ad-phase-badge');
      const adBadgeElM = document.getElementById('ad-phase-badge-m');
      if (!clockEl && !clockElM) return;

      // Game server runs at UTC-2; daily reset happens at its midnight (= 02:00 UTC)
      const SERVER_OFFSET_MS = -2 * 60 * 60 * 1000;
      const currentLang = document.documentElement.lang || 'en';

      const adPhaseNames: Record<string, string[]> = {
        ru: ['Вс: Отдых', 'Пн: Фаза 1 (Ворон)', 'Вт: Фаза 2 (Стройка)', 'Ср: Фаза 3 (Наука)', 'Чт: Фаза 4 (Герои)', 'Пт: Фаза 5 (Войска)', 'Сб: Фаза 6 (Килл-ивент)'],
        en: ['Sun: Rest', 'Mon: Phase 1 (Raven)', 'Tue: Phase 2 (Build)', 'Wed: Phase 3 (Tech)', 'Thu: Phase 4 (Heroes)', 'Fri: Phase 5 (Troops)', 'Sat: Phase 6 (PvP Final)'],
        es: ['Dom: Descanso', 'Lun: Fase 1 (Cuervo)', 'Mar: Fase 2 (Construcción)', 'Mié: Fase 3 (Ciencia)', 'Jue: Fase 4 (Héroes)', 'Vie: Fase 5 (Tropas)', 'Sáb: Fase 6 (PvP Final)'],
        de: ['So: Pause', 'Mo: Phase 1 (Rabe)', 'Di: Phase 2 (Bau)', 'Mi: Phase 3 (Forschung)', 'Do: Phase 4 (Helden)', 'Fr: Phase 5 (Truppen)', 'Sa: Phase 6 (PvP-Finale)'],
        fr: ['Dim : Repos', 'Lun : Phase 1 (Corbeau)', 'Mar : Phase 2 (Construction)', 'Mer : Phase 3 (Science)', 'Jeu : Phase 4 (Héros)', 'Ven : Phase 5 (Troupes)', 'Sam : Phase 6 (PvP Final)'],
        id: ['Min: Istirahat', 'Sen: Fase 1 (Gagak)', 'Sel: Fase 2 (Konstruksi)', 'Rab: Fase 3 (Riset)', 'Kam: Fase 4 (Hero)', 'Jum: Fase 5 (Pasukan)', 'Sab: Fase 6 (PvP Final)'],
        ja: ['日: 休息', '月: フェーズ1 (大鴉)', '火: フェーズ2 (建設)', '水: フェーズ3 (研究)', '木: フェーズ4 (英雄)', '金: フェーズ5 (兵士)', '土: フェーズ6 (決戦PvP)'],
        ko: ['일: 정비일', '월: 1단계 (까마귀)', '화: 2단계 (건설)', '수: 3단계 (연구)', '목: 4단계 (영웅)', '금: 5단계 (훈련)', '토: 6단계 (최종 PvP)'],
        pt: ['Dom: Descanso', 'Seg: Fase 1 (Corvo)', 'Ter: Fase 2 (Construção)', 'Qua: Fase 3 (Ciência)', 'Qui: Fase 4 (Heróis)', 'Sex: Fase 5 (Tropas)', 'Sáb: Fase 6 (PvP Final)'],
      };

      const tick = () => {
        const now = new Date();
        const serverNow = new Date(now.getTime() + SERVER_OFFSET_MS);
        const h = serverNow.getUTCHours();
        const m = serverNow.getUTCMinutes();
        const s = serverNow.getUTCSeconds();
        const timeStr = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
        if (clockEl) clockEl.textContent = timeStr;
        if (clockElM) clockElM.textContent = timeStr;

        const secServerDay = h * 3600 + m * 60 + s;
        const left = 86400 - secServerDay;
        const lh = Math.floor(left / 3600);
        const lm = Math.floor((left % 3600) / 60);
        const ls = left % 60;
        const cdStr = `${lh}h ${String(lm).padStart(2, '0')}m ${String(ls).padStart(2, '0')}s`;
        if (countdownEl) countdownEl.textContent = cdStr;
        if (countdownElM) countdownElM.textContent = cdStr;

        const day = serverNow.getUTCDay();
        const list = adPhaseNames[currentLang] || adPhaseNames.en;
        const phaseStr = list[day] || '';
        if (adBadgeEl) adBadgeEl.textContent = phaseStr;
        if (adBadgeElM) adBadgeElM.textContent = phaseStr;
      };
      tick();
      setInterval(tick, 1000);
    };
    initUtcTimer();
  }
  initChrome();
</script>