        <button id="menu-toggle" class="lg:hidden h-9 w-9 grid place-items-center rounded-full bg-white text-black text-sm font-bold transition" aria-label="Toggle menu">☰</button>
      </div>
    </div>

    <nav class="hidden lg:block border-t border-white/[0.04] py-2.5 text-xs">
      <div class="grid grid-cols-7 gap-1.5">
        {navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={`${base}/${item.href}/`}
              class:list={[
                'inline-flex items-center justify-center gap-1.5 rounded-lg px-2 py-1.5 transition font-medium text-[11px] xl:text-[12px] text-center border leading-tight',
                active
                  ? 'border-white/20 bg-white text-black font-semibold shadow-[0_0_16px_rgba(255,255,255,0.2)]'
                  : 'border-white/[0.04] bg-white/[0.03] text-stone-300 hover:text-white hover:bg-white/10 hover:border-white/10'
              ]}
            >
              <span class:list={['text-[10px] font-mono', active ? 'text-black/60 font-bold' : 'text-stone-500']}>{item.num}</span>
              <span class="truncate">{t(lang, item.key)}</span>
