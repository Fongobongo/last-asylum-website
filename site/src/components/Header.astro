---

<header id="site-header" class="sticky top-0 z-50 border-b border-white/[0.07] bg-[#080807]/75 backdrop-blur-2xl supports-[backdrop-filter]:bg-[#080807]/65 transition-shadow">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-toxic-400/40 to-transparent"></div>
  <div class="border-b border-white/[0.03] bg-white/[0.01]">
    <div class="mx-auto max-w-7xl px-4 h-7 flex items-center justify-between text-[11px] tracking-widest uppercase text-stone-500">
      <span class="hidden sm:inline-flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-toxic-400 animate-pulse"></span>
        {t(lang, 'header.status')}
      </span>
      <div class="hidden sm:flex items-center gap-2 font-mono text-[10px] text-stone-400 bg-stone-900/80 border border-white/[0.06] rounded-full px-3 py-0.5">
        <span class="flex items-center gap-1.5 text-stone-300">
          <span class="h-1.5 w-1.5 rounded-full bg-toxic-400"></span>
          <span>{dictServer[lang] ?? 'Server:'} <strong id="utc-clock" class="text-white">--:--:--</strong></span>
        </span>
        <span class="text-stone-700">|</span>
        <span class="text-stone-400">
          {dictReset[lang] ?? 'Reset:'} <strong id="utc-countdown" class="text-toxic-300 font-semibold">--h --m</strong>
        </span>
        <span class="text-stone-700">|</span>
        <a href={`${base}/events/alliance-duel/`} class="flex items-center gap-1 text-toxic-300 hover:text-white transition" title={H('duelLabel')}>
          <span>⚔️</span>
          <strong id="ad-phase-badge" class="font-semibold text-toxic-400">AD: --</strong>
        </a>
      </div>
      <span class="flex items-center gap-3">
        <a href={`${base}/alliance/`} class="inline-flex items-center gap-1 font-semibold text-toxic-400 hover:text-toxic-300 transition">
          🛡️ {H('allianceInfo')}
        </a>
        <span class="text-stone-700 hidden sm:inline">|</span>
        <span class="hidden sm:inline">{t(lang, 'header.stats')}</span>
        <a href={`${base}/credits/`} class="hover:text-stone-300 transition">{t(lang, 'nav.credits')}</a>
      </span>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4">
    <div class="flex h-[68px] items-center justify-between gap-4">
      <a href={`${base}/`} class="group flex items-center gap-3">
        <span class="flex h-9 w-9 items-center justify-center rounded-[10px] bg-gradient-to-br from-white via-stone-100 to-toxic-300 text-black font-heading font-bold text-sm leading-none shadow-[0_0_18px_rgba(180,255,57,0.25)] group-hover:shadow-[0_0_26px_rgba(180,255,57,0.5)] transition-shadow">LA</span>
        <div class="hidden sm:block leading-none">
          <div class="text-[15px] font-bold tracking-tight text-white group-hover:text-toxic-300 transition font-heading">Plague Hub</div>
          <div class="text-[10px] tracking-[0.16em] uppercase text-stone-500 mt-0.5">Last Asylum</div>
        </div>
      </a>

      <div class="flex items-center gap-2">
        <a
          href={`${base}/alliance/`}
          class="btn-glow inline-flex items-center gap-1.5 rounded-full border border-toxic-500/40 bg-stone-900/90 px-3 py-1.5 text-xs font-bold text-toxic-300 hover:border-toxic-400 hover:bg-toxic-500/15 shadow-[0_0_15px_rgba(180,255,57,0.15)] transition"
          title={H('allianceInfoTitle')}
        >
          <span>🛡️</span>
          <span>{H('allianceShort')}</span>
        </a>

        <button id="search-open" class="btn-glow hidden md:inline-flex items-center gap-2.5 rounded-full bg-white text-black px-4 py-2 text-sm font-medium hover:bg-stone-200">
          <span>⌕</span> {t(lang, 'nav.search').replace('…', '')} <kbd class="ml-1 rounded bg-black/10 px-1.5 py-0.5 text-xs font-mono">⌘K</kbd>
        </button>
        <button id="search-open-m" class="md:hidden h-9 w-9 grid place-items-center rounded-full border border-white/10 text-stone-300 hover:text-white" aria-label="Search">⌕</button>

        <!-- Bookmarks Button & Dropdown -->
        <div class="relative">
          <button
            id="btn-bookmarks-header"
            type="button"
            class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-white/[0.06] px-2.5 sm:px-3 py-2 text-sm text-stone-300 hover:bg-white/10 hover:border-toxic-400/40 transition cursor-pointer"
            aria-label="Bookmarks"
            title={H('savedGuides')}
          >
            <span>⭐</span>
            <span id="bm-header-badge" class="hidden rounded-full bg-toxic-400 px-1.5 py-0.2 text-[10px] font-bold text-black leading-none">0</span>
          </button>
          <div id="bm-header-dropdown" class="absolute right-0 top-full mt-3 hidden w-72 sm:w-80 overflow-hidden rounded-2xl border border-stone-800 bg-[#121211] p-3 shadow-2xl shadow-black/90 ring-1 ring-white/10 z-50">
            <div class="flex items-center justify-between border-b border-stone-800/80 pb-2 mb-2 px-1">
              <span class="text-xs font-bold text-white flex items-center gap-1.5">
                <span>⭐</span>
                <span>{H('savedGuides')}</span>
              </span>
              <span id="bm-header-count" class="text-[10px] font-mono text-stone-500">0</span>
            </div>
            <div id="bm-header-list" class="space-y-1 max-h-64 overflow-y-auto pr-1">
              <p class="text-xs text-stone-500 py-4 text-center">{H('bookmarksEmpty')}</p>
            </div>
          </div>
        </div>

        <div class="relative">
          <button id="lang-toggle" class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-white/[0.06] px-3 py-2 text-sm text-stone-300 hover:bg-white/10 transition" aria-label="Select language">
            🌐 <span class="hidden sm:inline">{langNames[lang]}</span> <span class="text-stone-500 text-xs">▾</span>
          </button>
          <div id="lang-menu" class="absolute right-0 top-full mt-3 hidden w-56 overflow-hidden rounded-2xl border border-stone-800 bg-[#121211] p-1.5 shadow-2xl shadow-black/90 ring-1 ring-white/10 z-50">
            {langHrefs.map((l) => (
              <a href={l.href} class:list={['flex items-center justify-between rounded-xl px-3 py-2 text-sm transition', l.lang === lang ? 'bg-white text-black font-semibold shadow-sm' : 'text-stone-300 hover:bg-white/10 hover:text-white']}>
                <span>{langNames[l.lang]}</span> <span class:list={['text-xs font-mono', l.lang === lang ? 'text-black/60 font-bold' : 'text-stone-500']}>{l.lang.toUpperCase()}</span>
              </a>
            ))}
          </div>
        </div>

        <a
          href={`${base}/support/`}
          class="btn-glow hidden sm:inline-flex items-center gap-1.5 rounded-full bg-toxic-400 px-4 py-2 text-xs sm:text-sm font-bold text-black hover:bg-toxic-300 shadow-[0_0_15px_rgba(180,255,57,0.3)] transition"
        >
          <span>💎</span>
