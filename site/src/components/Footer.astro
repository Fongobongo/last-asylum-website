---
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
const base = lang === 'en' ? '' : `/${lang}`;
---

<footer class="mt-16 border-t border-stone-800/60 bg-stone-950/50">
  <div class="mx-auto max-w-7xl px-4 py-10">
    <div class="grid gap-8 sm:grid-cols-3">
      <div>
        <div class="flex items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-plague-600 to-plague-800 text-sm ring-1 ring-white/10">☣️</span>
          <span class="text-sm font-semibold tracking-tight text-stone-100">LA<span class="font-light text-stone-500">:</span> Plague Hub</span>
        </div>
        <p class="mt-3 text-sm leading-5 text-stone-400 max-w-xs">{t(lang, 'footer.fansite')}</p>
        <p class="mt-2 text-xs leading-4 text-stone-500">{t(lang, 'footer.source')}</p>
      </div>

      <div>
        <h4 class="text-xs font-semibold uppercase tracking-widest text-stone-500 mb-3">Guides</h4>
        <ul class="space-y-1.5 text-sm">
          <li><a href={`${base}/beginners/`} class="text-stone-400 hover:text-plague-200 transition">{t(lang, 'nav.beginners')}</a></li>
          <li><a href={`${base}/heroes/`} class="text-stone-400 hover:text-plague-200 transition">{t(lang, 'nav.heroes')}</a></li>
          <li><a href={`${base}/economy/`} class="text-stone-400 hover:text-plague-200 transition">{t(lang, 'nav.economy')}</a></li>
          <li><a href={`${base}/events/`} class="text-stone-400 hover:text-plague-200 transition">{t(lang, 'nav.events')}</a></li>
          <li><a href={`${base}/codex/`} class="text-stone-400 hover:text-plague-200 transition">Codex</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-semibold uppercase tracking-widest text-stone-500 mb-3">Community</h4>
        <ul class="space-y-1.5 text-sm">
          <li><a href={`${base}/codes/`} class="text-stone-400 hover:text-plague-200 transition">{t(lang, 'nav.codes')}</a></li>
          <li><a href={`${base}/credits/`} class="text-stone-400 hover:text-plague-200 transition">{t(lang, 'nav.credits')}</a></li>
          <li><a href={`${base}/support/`} class="text-stone-400 hover:text-plague-200 transition">{t(lang, 'nav.support')}</a></li>
          <li><a href={`${base}/faq/`} class="text-stone-400 hover:text-plague-200 transition">FAQ</a></li>
          <li><a href="https://discord.gg/lastasylum" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-stone-400 hover:text-plague-200 transition">Discord ↗</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-stone-800/60 pt-6 text-xs text-stone-500">
      <p>☣️ {t(lang, 'site.title')} — © {year} • Fan-made • <span class="text-stone-600">Not affiliated</span></p>
      <p class="flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-toxic-400/60"></span>
        Built for survivors
      </p>
    </div>
  </div>
</footer>