---
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
const base = lang === 'en' ? '' : `/${lang}`;
---

<footer class="relative mt-16 border-t border-stone-800/60 bg-stone-950/50 overflow-hidden">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-toxic-400/30 to-transparent"></div>
  <div class="pointer-events-none absolute -top-24 left-1/2 h-48 w-[560px] -translate-x-1/2 rounded-full bg-plague-600/[0.08] blur-[100px]"></div>
  <div class="mx-auto max-w-7xl px-4 py-10">
    <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-4">
      <div>
        <div class="flex items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-plague-600 to-plague-800 text-sm ring-1 ring-white/10 shadow-[0_0_18px_rgba(168,152,24,0.3)]">☣️</span>
          <span class="text-sm font-semibold tracking-tight text-stone-100">LA<span class="font-light text-stone-500">:</span> Plague Hub</span>
        </div>
        <p class="mt-3 text-sm leading-5 text-stone-400 max-w-xs">{t(lang, 'footer.fansite')}</p>
        <p class="mt-2 text-xs leading-4 text-stone-500">{t(lang, 'footer.source')}</p>
        <div class="mt-4">
          <a
            href={`${base}/dnd/`}
            class="inline-flex items-center gap-1.5 rounded-lg border border-toxic-500/30 bg-toxic-500/10 px-2.5 py-1.5 text-xs font-semibold text-toxic-300 hover:border-toxic-400 hover:bg-toxic-500/20 transition"
          >
            <span>🛡️</span>
            <span>{lang === 'ru' ? 'Штаб DND [🔒 Пароль]' : 'DND Hub [🔒 Password]'}</span>
          </a>
        </div>
      </div>

      <div>
        <h4 class="text-xs font-semibold uppercase tracking-widest text-stone-500 mb-3">{t(lang, 'footer.guides')}</h4>
        <ul class="space-y-1.5 text-sm">
          <li><a href={`${base}/beginners/`} class="text-stone-400 hover:text-plague-200 transition">{t(lang, 'nav.beginners')}</a></li>
          <li><a href={`${base}/buildings/`} class="text-stone-400 hover:text-plague-200 transition">{t(lang, 'nav.buildings')}</a></li>
          <li><a href={`${base}/heroes/`} class="text-stone-400 hover:text-plague-200 transition">{t(lang, 'nav.heroes')}</a></li>
          <li><a href={`${base}/economy/`} class="text-stone-400 hover:text-plague-200 transition">{t(lang, 'nav.economy')}</a></li>
          <li><a href={`${base}/gear/`} class="text-stone-400 hover:text-plague-200 transition">{t(lang, 'nav.gear')}</a></li>
          <li><a href={`${base}/tier-list/`} class="text-stone-400 hover:text-plague-200 transition">{t(lang, 'nav.tierlist')}</a></li>
          <li><a href={`${base}/codex/`} class="text-stone-400 hover:text-plague-200 transition">{t(lang, 'nav.codex')}</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-semibold uppercase tracking-widest text-stone-500 mb-3">{t(lang, 'footer.features')}</h4>
        <ul class="space-y-1.5 text-sm">
          <li><a href={`${base}/events/`} class="text-stone-400 hover:text-plague-200 transition">{t(lang, 'nav.events')}</a></li>
          <li><a href={`${base}/raven/`} class="text-stone-400 hover:text-plague-200 transition">{t(lang, 'nav.raven')}</a></li>
          <li><a href={`${base}/era/`} class="text-stone-400 hover:text-plague-200 transition">{t(lang, 'nav.era')}</a></li>
          <li><a href={`${base}/calendar/`} class="text-stone-400 hover:text-plague-200 transition">{t(lang, 'nav.calendar')}</a></li>
          <li><a href={`${base}/patch-notes/`} class="text-stone-400 hover:text-plague-200 transition">{t(lang, 'nav.patchnotes')}</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-semibold uppercase tracking-widest text-stone-500 mb-3">{t(lang, 'footer.community')}</h4>
        <ul class="space-y-1.5 text-sm">
          <li><a href={`${base}/codes/`} class="text-stone-400 hover:text-plague-200 transition">{t(lang, 'nav.codes')}</a></li>
          <li><a href={`${base}/support/`} class="inline-flex items-center gap-1 font-semibold text-toxic-400 hover:text-toxic-300 transition">💎 {t(lang, 'nav.support')}</a></li>
          <li><a href={`${base}/dnd/`} class="text-stone-400 hover:text-plague-200 transition">🛡️ {lang === 'ru' ? 'Штаб альянса' : 'Alliance HQ'}</a></li>
          <li><a href={`${base}/faq/`} class="text-stone-400 hover:text-plague-200 transition">FAQ</a></li>
          <li><a href={`${base}/credits/`} class="text-stone-400 hover:text-plague-200 transition">{t(lang, 'nav.credits')}</a></li>
          <li><a href="https://discord.gg/2PYWRyNtmU" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-indigo-400 hover:text-indigo-300 transition">Discord ↗</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-stone-800/60 pt-6 text-xs text-stone-500">
      <p>☣️ {t(lang, 'site.title')} — © {year} • Fan-made • <span class="text-stone-600">Not affiliated</span></p>
      <p class="flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-toxic-400 pulse-ring"></span>
        Built for survivors
      </p>
    </div>
  </div>
</footer>
