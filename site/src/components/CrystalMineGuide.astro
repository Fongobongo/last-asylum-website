    passive: 'Umiejętność pasywna',
  },
};

const t = i18n[lang as keyof typeof i18n] || i18n.en;

const skills = (crystalData as any[]).map((s) => {
  const name = s.name[lang] || s.name.ru || s.name.en || `Skill #${s.id}`;
  const desc = s.desc[lang] || s.desc.ru || s.desc.en || '';
  
  const isCombat = [3, 4, 8, 9].includes(s.id);
  const icon = s.id === 1 ? '✨' :
               s.id === 2 ? '🐀' :
               s.id === 3 ? '⚔️' :
               s.id === 4 ? '👟' :
               s.id === 5 ? '🏴‍☠️' :
               s.id === 6 ? '🛡️' :
               s.id === 7 ? '⛏️' :
               s.id === 8 ? '🔥' :
               s.id === 9 ? '⚡' : '🔮';

  return {
    ...s,
    displayName: name,
    displayDesc: desc,
    isCombat,
    categoryLabel: isCombat ? t.typeCombat : t.typeGather,
    icon,
  };
});
---

<section class="not-prose my-12 rounded-2xl border border-cyan-500/20 bg-gradient-to-b from-stone-900 via-stone-900/90 to-stone-950 p-6 shadow-2xl backdrop-blur">
  <div class="mb-6 border-b border-stone-800 pb-5">
    <h2 class="text-2xl font-bold tracking-tight text-white flex items-center gap-2.5">
      <span>{t.title}</span>
    </h2>
    <p class="mt-1 text-sm text-stone-400 max-w-2xl">{t.subtitle}</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {skills.map((skill) => (
      <div class="flex items-start gap-3 rounded-xl border border-stone-800/80 bg-stone-900/50 p-4 transition-all hover:border-cyan-500/30 hover:bg-stone-800/50">
        <span class="text-2xl flex-shrink-0 mt-0.5">{skill.icon}</span>
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between gap-2">
            <h3 class="text-sm font-bold text-stone-200">{skill.displayName}</h3>
            <span class={`rounded px-2 py-0.5 text-[10px] font-semibold border ${
              skill.isCombat 
                ? 'bg-red-500/10 text-red-300 border-red-500/30' 
                : 'bg-cyan-500/10 text-cyan-300 border-cyan-500/30'
            }`}>
              {skill.categoryLabel}
            </span>
          </div>
          <p class="mt-1.5 text-xs text-stone-300 leading-relaxed">
            {skill.displayDesc}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>
