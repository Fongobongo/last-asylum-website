const t = i18n[lang as keyof typeof i18n] || i18n.en;

const structures = (elixirData as any[]).map((item) => {
  const name = item.name[lang] || item.name.ru || item.name.en || `Structure #${item.id}`;
  const desc = item.desc[lang] || item.desc.ru || item.desc.en || '';
  
  let category = 'outpost';
  let badgeColor = 'bg-stone-500/20 text-stone-300 border-stone-600/40';
  let priorityLabel = t.priorityLow;
  let icon = '📍';

  if (item.id === 1) {
    category = 'castle';
    badgeColor = 'bg-amber-500/20 text-amber-300 border-amber-500/40';
    priorityLabel = t.priorityHigh;
    icon = '👑';
  } else if (item.id === 4 || item.id === 5) {
    category = 'castle';
    badgeColor = 'bg-purple-500/20 text-purple-300 border-purple-500/40';
    priorityLabel = t.priorityMid;
    icon = '⚗️';
  } else if (item.id >= 8 && item.id <= 11) {
    category = 'tent';
    badgeColor = 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40';
    priorityLabel = t.priorityTents;
    icon = '⛺';
  } else if (item.id === 3) {
    icon = '⚡';
    badgeColor = 'bg-red-500/20 text-red-300 border-red-500/40';
  } else if (item.id === 6) {
    icon = '🚪';
  } else if (item.id === 7) {
    icon = '👁️';
  }

  return {
    ...item,
    displayName: name,
    displayDesc: desc,
    category,
    badgeColor,
    priorityLabel,
    icon,
  };
});
---

<section class="not-prose my-12 rounded-2xl border border-amber-500/20 bg-gradient-to-b from-stone-900 via-stone-900/90 to-stone-950 p-6 shadow-2xl backdrop-blur">
  <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b border-stone-800 pb-5">
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-white flex items-center gap-2.5">
        <span>{t.title}</span>
      </h2>
      <p class="mt-1 text-sm text-stone-400 max-w-2xl">{t.subtitle}</p>
    </div>

    <!-- Filter Buttons -->
    <div class="flex flex-wrap gap-2 text-xs" id="elixir-filter-group">
      <button
        type="button"
        data-filter="all"
        class="elixir-filter-btn active rounded-lg border border-amber-500/50 bg-amber-500/20 px-3 py-1.5 font-medium text-amber-300 transition hover:bg-amber-500/30"
      >
        {t.filterAll}
      </button>
      <button
        type="button"
        data-filter="castle"
        class="elixir-filter-btn rounded-lg border border-stone-700 bg-stone-800/60 px-3 py-1.5 font-medium text-stone-300 transition hover:bg-stone-700"
      >
        {t.filterCastles}
      </button>
      <button
        type="button"
        data-filter="tent"
        class="elixir-filter-btn rounded-lg border border-stone-700 bg-stone-800/60 px-3 py-1.5 font-medium text-stone-300 transition hover:bg-stone-700"
      >
        {t.filterTents}
      </button>
      <button
        type="button"
        data-filter="outpost"
        class="elixir-filter-btn rounded-lg border border-stone-700 bg-stone-800/60 px-3 py-1.5 font-medium text-stone-300 transition hover:bg-stone-700"
      >
        {t.filterOutposts}
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="elixir-structures-grid">
    {structures.map((s) => (
      <div
        class="elixir-card flex flex-col justify-between rounded-xl border border-stone-800 bg-stone-900/60 p-4 transition-all hover:border-amber-500/40 hover:bg-stone-800/50 hover:shadow-lg"
        data-category={s.category}
      >
        <div>
          <div class="flex items-start justify-between gap-2 mb-2">
            <span class="text-2xl">{s.icon}</span>
            <span class={`rounded-full border px-2.5 py-0.5 text-[11px] font-semibold ${s.badgeColor}`}>
              {s.priorityLabel}
            </span>
          </div>
          <h3 class="text-base font-bold text-stone-100">{s.displayName}</h3>
          <p class="mt-2 text-xs leading-relaxed text-stone-300">
            {s.displayDesc}
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-stone-800/80 flex items-center justify-between text-[11px] text-stone-400">
          <span>ID: #{s.id}</span>
          <span class="text-amber-400/90 font-medium">
            {s.category === 'tent' ? '⚡ 15/10s heal' : s.category === 'castle' ? '⭐ Max Points' : '🎯 Map Control'}
          </span>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  function setupElixirFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.elixir-filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.elixir-card');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => {
          b.classList.remove('active', 'border-amber-500/50', 'bg-amber-500/20', 'text-amber-300');
          b.classList.add('border-stone-700', 'bg-stone-800/60', 'text-stone-300');
        });
        btn.classList.add('active', 'border-amber-500/50', 'bg-amber-500/20', 'text-amber-300');
        btn.classList.remove('border-stone-700', 'bg-stone-800/60', 'text-stone-300');

        const filter = btn.dataset.filter;
        cards.forEach((card) => {
          if (filter === 'all' || card.dataset.category === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupElixirFilters);
  } else {
    setupElixirFilters();
  }
</script>
