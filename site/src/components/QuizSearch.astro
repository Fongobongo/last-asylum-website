<section class="not-prose my-10 rounded-3xl border border-toxic-500/30 bg-stone-950/80 p-6 sm:p-8 backdrop-blur-xl shadow-[0_0_50px_rgba(0,0,0,0.6)]" id="quiz-lookup-app">
  <div class="mb-6 flex flex-col gap-2">
    <div class="flex items-center gap-3">
      <span class="rounded-xl border border-toxic-500/40 bg-toxic-950/60 px-3 py-1 text-xs font-bold text-toxic-400">
        {totalCount} OFFICIAL QUESTIONS
      </span>
      <span class="text-xs text-stone-500 font-mono">SMART CONTEST SOLVER</span>
    </div>
    <h2 class="text-2xl font-bold tracking-tight text-toxic-400 sm:text-3xl">{t.title}</h2>
    <p class="text-sm text-stone-400 max-w-3xl">{t.subtitle}</p>
  </div>

  <!-- Timer Advice Banner -->
  <div class="mb-6 rounded-2xl border border-stone-800 bg-stone-900/60 p-4">
    <p class="text-xs text-stone-300 leading-relaxed font-medium">{t.timeTip}</p>
  </div>

  <!-- Search and filter controls -->
  <div class="space-y-4">
    <div class="relative flex items-center">
      <input
        type="text"
        id="quiz-search-input"
        class="w-full rounded-2xl border border-stone-800 bg-stone-900/90 px-4 py-3.5 pl-11 text-base text-stone-100 placeholder-stone-500 transition-all focus:border-toxic-500 focus:bg-black focus:outline-none focus:ring-2 focus:ring-toxic-500/30"
        placeholder={t.placeholder}
        autocomplete="off"
      />
      <span class="absolute left-4 text-stone-400">🔍</span>
      <button
        id="quiz-clear-btn"
        class="absolute right-3 hidden rounded-lg bg-stone-800 px-2.5 py-1 text-xs text-stone-400 hover:bg-stone-700 hover:text-white transition"
      >
        {t.clear}
      </button>
    </div>

    <!-- Category Tabs -->
    <div class="flex flex-wrap gap-2 pt-1" id="quiz-categories">
      {categories.map((c) => (
        <button
          type="button"
          data-cat={c.id}
          class={`quiz-cat-btn rounded-xl px-3.5 py-1.5 text-xs font-semibold transition-all ${
            c.id === 'all'
              ? 'bg-toxic-500 text-stone-950 shadow-[0_0_15px_rgba(180,255,57,0.3)]'
              : 'border border-stone-800 bg-stone-900/60 text-stone-400 hover:border-toxic-500/40 hover:text-stone-200'
          }`}
        >
          {c.label}
        </button>
      ))}
    </div>

    <!-- Counter -->
    <div class="flex items-center justify-between text-xs text-stone-400 px-1">
      <div>
        {t.found} <span id="quiz-count" class="font-bold text-toxic-400">{formattedQuiz.length}</span>
      </div>
    </div>
  </div>

  <!-- Questions Grid -->
  <div class="mt-6 grid gap-4 sm:grid-cols-2" id="quiz-cards-container">
    {formattedQuiz.map((q) => (
      <div
        class="quiz-card flex flex-col justify-between rounded-2xl border border-stone-800/80 bg-stone-900/40 p-4 transition-all hover:border-toxic-500/50 hover:bg-stone-900/80 hover:shadow-lg"
        data-category={q.category}
        data-search={q.searchIndex}
      >
        <div>
          <div class="mb-2 flex items-center justify-between">
            <span class="rounded-md border border-stone-800 bg-stone-950 px-2 py-0.5 text-[10px] font-mono text-stone-400">
              #{q.id}
            </span>
            <span class="rounded-md border border-stone-800 bg-stone-950 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wider text-stone-400">
              {q.category}
            </span>
          </div>

          <h3 class="text-sm font-bold text-stone-100 leading-snug">
            {q.title}
          </h3>

          <!-- All Options List -->
          <div class="mt-3 space-y-1.5">
            {q.options.map((opt: any) => (
              <div
                class={`flex items-center justify-between rounded-xl px-3 py-1.5 text-xs transition ${
                  opt.isCorrect
                    ? 'border border-toxic-500/40 bg-toxic-950/50 text-toxic-200 font-bold'
                    : 'border border-stone-800/60 bg-stone-950/40 text-stone-400'
                }`}
              >
                <span>
                  {opt.isCorrect ? '✅ ' : '• '}
                  {opt.text}
                </span>
                {opt.isCorrect && (
                  <span class="text-[10px] text-toxic-400 uppercase tracking-wide">
                    {lang === 'ru' ? 'ВЕРНО' : 'CORRECT'}
                  </span>
                )}
              </div>
            ))}
          </div>
        </div>

        <!-- Copy Answer Bar -->
        <div class="mt-4 pt-3 border-t border-stone-800/60 flex items-center justify-between text-xs">
          <div class="truncate max-w-[200px] text-stone-400">
            <span class="text-stone-500">{t.correctAnswer}</span> <strong class="text-toxic-300">{q.correctText}</strong>
          </div>
          <button
            type="button"
            class="quiz-copy-btn rounded-lg border border-stone-700 bg-stone-800/80 px-2.5 py-1 text-[11px] font-semibold text-stone-300 hover:bg-toxic-500 hover:text-stone-950 hover:border-toxic-500 transition"
            data-copy={q.correctText}
          >
            📋 {t.copyBtn}
          </button>
        </div>
      </div>
    ))}
  </div>

  <!-- No Results Box -->
  <div id="quiz-no-results" class="hidden mt-8 rounded-2xl border border-dashed border-stone-800 p-8 text-center text-sm text-stone-400">
    <p class="text-3xl mb-2">🔍</p>
    <p>{t.noResults}</p>
  </div>
</section>

<script>
  function initQuizSearch() {
    const input = document.getElementById('quiz-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('quiz-clear-btn');
    const cards = document.querySelectorAll<HTMLElement>('.quiz-card');
    const catBtns = document.querySelectorAll<HTMLButtonElement>('.quiz-cat-btn');
    const countSpan = document.getElementById('quiz-count');
    const noResults = document.getElementById('quiz-no-results');
    const copyBtns = document.querySelectorAll<HTMLButtonElement>('.quiz-copy-btn');

    if (!cards.length) return;

    let activeCategory = 'all';

    function filter() {
      const query = (input?.value || '').trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const cat = card.dataset.category || '';
        const searchTarget = card.dataset.search || '';

        const matchesCat = activeCategory === 'all' || cat === activeCategory;
        const matchesQuery = !query || searchTarget.includes(query);

        if (matchesCat && matchesQuery) {
          card.style.display = 'flex';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });

      if (countSpan) countSpan.textContent = visible.toString();
      if (noResults) {
        noResults.style.display = visible === 0 ? 'block' : 'none';
      }
      if (clearBtn) {
        clearBtn.style.display = query.length > 0 ? 'block' : 'none';
      }
    }

    if (input) input.addEventListener('input', filter);

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (input) {
          input.value = '';
          input.focus();
          filter();
        }
      });
    }

    catBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.cat || 'all';
        activeCategory = cat;

        catBtns.forEach((b) => {
          if (b === btn) {
            b.classList.remove('border', 'border-stone-800', 'bg-stone-900/60', 'text-stone-400');
            b.classList.add('bg-toxic-500', 'text-stone-950', 'shadow-[0_0_15px_rgba(180,255,57,0.3)]');
          } else {
            b.classList.remove('bg-toxic-500', 'text-stone-950', 'shadow-[0_0_15px_rgba(180,255,57,0.3)]');
            b.classList.add('border', 'border-stone-800', 'bg-stone-900/60', 'text-stone-400');
          }
        });

        filter();
      });
    });

    // Copy Answer handling
    copyBtns.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.dataset.copy || '';
        if (text && navigator.clipboard) {
          await navigator.clipboard.writeText(text);
          const orig = btn.innerHTML;
          btn.innerHTML = '✅ OK';
          btn.classList.add('bg-toxic-500', 'text-stone-950');
          setTimeout(() => {
            btn.innerHTML = orig;
            btn.classList.remove('bg-toxic-500', 'text-stone-950');
          }, 1500);
        }
      });
    });
  }

  initQuizSearch();
  document.addEventListener('astro:page-load', initQuizSearch);
</script>
