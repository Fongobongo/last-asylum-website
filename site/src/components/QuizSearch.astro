const t = i18n[lang as keyof typeof i18n] || i18n.en;

const categories = [
  { id: 'all', label: t.all },
  { id: 'events', label: t.events },
  { id: 'heroes', label: t.heroes },
  { id: 'buildings', label: t.buildings },
  { id: 'mechanics', label: t.mechanics },
  { id: 'lore', label: t.lore },
];

const formattedQuiz = (quizData as any[]).map((q) => {
  const title = q.title?.[lang] || q.title?.ru || q.title?.en || `Question #${q.id}`;
  const options = q.options.map((opt: any, idx: number) => {
    const text = opt?.[lang] || opt?.ru || opt?.en || `Option ${idx + 1}`;
    return {
      index: idx + 1,
      text,
      isCorrect: q.correctAnswer === idx + 1,
    };
  });
  const correctOption = options.find((o: any) => o.isCorrect) || options[0];

  const searchIndex = `${title} ${options.map((o: any) => o.text).join(' ')} ${q.title?.ru || ''} ${q.title?.en || ''}`.toLowerCase();

  return {
    id: q.id,
    category: q.category,
    title,
    options,
    correctText: correctOption.text,
    searchIndex,
  };
});
