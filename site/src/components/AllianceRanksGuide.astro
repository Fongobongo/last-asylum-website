---
import ranksData from '../data/officialAllianceRanks.json';
import type { Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = 'ru' } = Astro.props;

const i18n = {
  ru: {
    title: '🛡️ Иерархия Альянса: Ранги и Офицерские Должности',
    subtitle: 'Официальные роли альянса из клиента игры. Разделение обязанностей между R1–R5 и 4 специализированные должности офицеров.',
    r1to5Title: 'Основные ранги (R1 – R5)',
    officersTitle: 'Специальные офицерские должности (R4)',
  },
  en: {
    title: '🛡️ Alliance Hierarchy: Ranks & Officer Roles',
    subtitle: 'Official alliance roles from game files. Responsibility split between R1–R5 and 4 specialized officer titles.',
    r1to5Title: 'Core Ranks (R1 – R5)',
    officersTitle: 'Specialized Officer Positions (R4)',
  },
  de: {
    title: '🛡️ Allianzhierarchie: Ränge & Offiziersrollen',
    subtitle: 'Offizielle Allianzrollen und 4 spezialisierte R4-Posten.',
    r1to5Title: 'Hauptränge (R1 – R5)',
    officersTitle: 'Offiziersposten (R4)',
  },
  es: {
    title: '🛡️ Jerarquía de Alianza: Rangos y Oficiales',
    subtitle: 'Roles oficiales de alianza y 4 cargos especializados de R4.',
    r1to5Title: 'Rangos Principales (R1 – R5)',
    officersTitle: 'Cargos de Oficial (R4)',
  },
  fr: {
    title: '🛡️ Hiérarchie d\'Alliance : Rangs & Rôles',
    subtitle: 'Rôles officiels d\'alliance et 4 postes d\'officiers spécialisés.',
    r1to5Title: 'Rangs Principaux (R1 – R5)',
    officersTitle: 'Postes d\'Officiers (R4)',
  },
  id: {
    title: '🛡️ Hierarki Guild: Pangkat & Peran Perwira',
    subtitle: 'Peran resmi guild dan 4 jabatan khusus perwira R4.',
    r1to5Title: 'Pangkat Utama (R1 – R5)',
    officersTitle: 'Jabatan Khusus Perwira (R4)',
  },
  ja: {
    title: '🛡️ 同盟の階級制度と役職（R1〜R5および専任役職）',
    subtitle: '公式クライアントデータに基づく階級と4つのR4専門役職一覧。',
    r1to5Title: '基本階級（R1〜R5）',
    officersTitle: '専門役職（R4幹部）',
  },
  ko: {
    title: '🛡️ 연맹 계급 체계 및 간부 직책 안내',
    subtitle: '게임 내 공식 연맹 계급 R1~R5 및 4대 전문 장교 직책 상세 설명.',
    r1to5Title: '기본 계급 (R1 ~ R5)',
    officersTitle: '4대 전문 장교 직책 (R4)',
  },
  pt: {
    title: '🛡️ Hierarquia da Aliança: Cargos & Oficiais',
    subtitle: 'Funções oficiais da aliança e 4 cargos de oficiais R4.',
    r1to5Title: 'Cargos Principais (R1 – R5)',
    officersTitle: 'Cargos de Oficial (R4)',
  },
};

const t = i18n[lang as keyof typeof i18n] || i18n.en;

const coreRanks = (ranksData as any[]).filter((r) => r.id <= 105).map((r) => ({
  id: r.id,
  name: r.name?.[lang] || r.name?.ru || r.name?.en || `R${r.id - 100}`,
  desc: r.desc?.[lang] || r.desc?.ru || r.desc?.en || '',
}));

const officerRanks = (ranksData as any[]).filter((r) => r.id >= 201).map((r) => {
  let icon = '⚔️';
  if (r.id === 201) icon = '⚔️'; // Воевода
  else if (r.id === 202) icon = '📢'; // Вербовщик
  else if (r.id === 203) icon = '👑'; // Богиня
  else if (r.id === 204) icon = '📜'; // Дипломат

  return {
    id: r.id,
    name: r.name?.[lang] || r.name?.ru || r.name?.en || `Officer #${r.id}`,
    desc: r.desc?.[lang] || r.desc?.ru || r.desc?.en || '',
    icon,
  };
});
---

<section class="not-prose my-10 rounded-3xl border border-toxic-500/30 bg-stone-950/80 p-6 sm:p-8 backdrop-blur-xl shadow-[0_0_50px_rgba(0,0,0,0.6)]" id="alliance-ranks-guide">
  <div class="mb-6 flex flex-col gap-2">
    <div class="flex items-center gap-3">
      <span class="rounded-xl border border-toxic-500/40 bg-toxic-950/60 px-3 py-1 text-xs font-bold text-toxic-400">
        ALLIANCE STRUCTURE
      </span>
      <span class="text-xs text-stone-500 font-mono">UNION RANKS</span>
    </div>
    <h2 class="text-2xl font-bold tracking-tight text-toxic-400 sm:text-3xl">{t.title}</h2>
    <p class="text-sm text-stone-400 max-w-3xl">{t.subtitle}</p>
  </div>

  <!-- Specialized R4 Officers -->
  <div class="mb-8">
    <h3 class="text-base font-bold text-stone-200 mb-4 flex items-center gap-2">
      <span>⭐</span> {t.officersTitle}
    </h3>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {officerRanks.map((o) => (
        <div class="rounded-2xl border border-toxic-500/30 bg-stone-900/50 p-4 transition hover:border-toxic-500 hover:bg-stone-900/80">
          <div class="flex items-center justify-between mb-2">
            <span class="text-2xl">{o.icon}</span>
            <span class="rounded-md border border-toxic-500/40 bg-toxic-950 px-2 py-0.5 text-[10px] font-bold text-toxic-400">
              R4 TITLE
            </span>
          </div>
          <h4 class="text-sm font-bold text-stone-100">{o.name}</h4>
          <p class="mt-1.5 text-xs text-stone-400 leading-relaxed">{o.desc}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Core R1-R5 Levels -->
  <div>
    <h3 class="text-base font-bold text-stone-200 mb-4 flex items-center gap-2">
      <span>📊</span> {t.r1to5Title}
    </h3>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
      {coreRanks.map((r) => (
        <div class="rounded-2xl border border-stone-800 bg-stone-900/40 p-4 transition hover:border-stone-700">
          <div class="flex items-center justify-between mb-2">
            <span class="rounded-md border border-stone-700 bg-stone-950 px-2 py-0.5 text-xs font-bold text-stone-300">
              {r.name}
            </span>
          </div>
          <p class="text-xs text-stone-400 leading-relaxed">{r.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
