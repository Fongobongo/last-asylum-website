---
import { getCollection } from 'astro:content';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const prefix = lang === 'en' ? '' : `/${lang}`;

const all = await getCollection('guides');
const guides = all
  .filter((e) => e.id.split('/')[0] === lang && !e.id.endsWith('/guides'))
  .map((e) => {
    const parts = e.id.split('/');
    const slug = parts.slice(1).join('/').replace(/\.md$/, '');
    const url = lang === 'en' ? `/${slug}/` : `/${lang}/${slug}/`;
    return {
      slug,
      url,
      title: (e.data as any).title as string,
      description: (e.data as any).description as string | undefined,
      updated: (e.data as any).updated as string | undefined,
      section: slug.includes('/') ? slug.split('/')[0] : 'guides',
    };
  })
  .sort((a, b) => a.slug.localeCompare(b.slug));

const SECTION_ORDER = [
  'guides', 'beginners', 'buildings', 'heroes', 'economy', 'alliance',
  'events', 'era', 'gear', 'might', 'raven', 'tips', 'calendar',
];
const sectionLabel: Record<string, Record<string, string>> = {
  guides: { en: 'All guides', ru: 'Все гайды', ar: 'جميع الأدلة', it: 'Tutte le guide', ms: 'Semua panduan', nl: 'Alle gidsen', th: 'คู่มือทั้งหมด', tr: 'Tüm rehberler', vi: 'Tất cả hướng dẫn', zh: '所有攻略' },
  beginners: { en: 'Beginners', ru: 'Новичкам', ar: 'للمبتدئين', it: 'Principianti', ms: 'Pemula', nl: 'Beginners', th: 'ผู้เริ่มต้น', tr: 'Yeni Başlayanlar', vi: 'Người mới bắt đầu', zh: '新手指南' },
  buildings: { en: 'Buildings', ru: 'Здания', ar: 'المباني', it: 'Edifici', ms: 'Bangunan', nl: 'Gebouwen', th: 'สิ่งก่อสร้าง', tr: 'Binalar', vi: 'Công trình', zh: '建筑' },
  heroes: { en: 'Heroes', ru: 'Герои', ar: 'الأبطال', it: 'Eroi', ms: 'Wira', nl: 'Helden', th: 'ฮีโร่', tr: 'Kahramanlar', vi: 'Anh hùng', zh: '英雄' },
  economy: { en: 'Economy', ru: 'Экономика', ar: 'الاقتصاد', it: 'Economia', ms: 'Ekonomi', nl: 'Economie', th: 'เศรษฐกิจ', tr: 'Ekonomi', vi: 'Kinh tế', zh: '经济' },
  alliance: { en: 'Alliance', ru: 'Альянс', ar: 'التحالف', it: 'Alleanza', ms: 'Pakatan', nl: 'Alliantie', th: 'พันธมิตร', tr: 'İttifak', vi: 'Liên minh', zh: '联盟' },
  events: { en: 'Events', ru: 'События', ar: 'الفعاليات', it: 'Eventi', ms: 'Acara', nl: 'Evenementen', th: 'กิจกรรม', tr: 'Etkinlikler', vi: 'Sự kiện', zh: '活动' },
  era: { en: 'Era of Rebirth', ru: 'Эра Возрождения', ar: 'Era of Rebirth', it: 'Era of Rebirth', ms: 'Era of Rebirth', nl: 'Era of Rebirth', th: 'Era of Rebirth', tr: 'Era of Rebirth', vi: 'Era of Rebirth', zh: '重生纪元' },
  gear: { en: 'Gear', ru: 'Снаряжение', ar: 'العتاد', it: 'Equipaggiamento', ms: 'Peralatan', nl: 'Uitrusting', th: 'อุปกรณ์', tr: 'Ekipman', vi: 'Trang bị', zh: '装备' },
  might: { en: 'Might', ru: 'Мощь', ar: 'القوة', it: 'Potenza', ms: 'Kekuatan', nl: 'Kracht', th: 'พลัง', tr: 'Güç', vi: 'Sức mạnh', zh: '战力' },
  raven: { en: 'Raven', ru: 'Ворон', ar: 'Raven', it: 'Raven', ms: 'Raven', nl: 'Raven', th: 'Raven', tr: 'Raven', vi: 'Raven', zh: '乌鸦' },
  tips: { en: 'Tips', ru: 'Советы', ar: 'نصائح', it: 'Suggerimenti', ms: 'Petua', nl: 'Tips', th: 'เคล็ดลับ', tr: 'İpuçları', vi: 'Mẹo', zh: '小贴士' },
  calendar: { en: 'Calendar', ru: 'Календарь', ar: 'التقويم', it: 'Calendario', ms: 'Kalendar', nl: 'Kalender', th: 'ปฏิทิน', tr: 'Takvim', vi: 'Lịch', zh: '日历' },
};
const labelFor = (s: string) => sectionLabel[s]?.[lang] ?? sectionLabel[s]?.['en'] ?? s;

const groups = new Map<string, typeof guides>();
for (const g of guides) {
  const key = SECTION_ORDER.includes(g.section) ? g.section : 'guides';
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(g);
}
const orderedSections = [...groups.keys()].sort(
  (a, b) => SECTION_ORDER.indexOf(a) - SECTION_ORDER.indexOf(b)
);

const heading = lang === 'ru' ? 'Все гайды' : 'All guides';
const sub = lang === 'ru'
  ? `Все ${guides.length} публикаций в одном месте — хабы, события и справочники.`
  : `All ${guides.length} publications in one place — hubs, events and references.`;
---

<div class="not-prose my-8">
  <p class="text-sm text-stone-400">{sub}</p>
  {orderedSections.map((section) => (
    <section class="mt-8">
      <h2 class="text-lg font-bold text-white flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-toxic-400"></span>
        {labelFor(section)}
        <span class="rounded-full bg-stone-800 px-2 py-0.5 text-xs text-stone-400 border border-stone-700">
          {groups.get(section)!.length}
        </span>
      </h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {groups.get(section)!.map((g) => (
          <a
            href={g.url}
            class="group rounded-2xl border border-white/[0.08] bg-stone-900/60 p-4 hover:border-toxic-500/50 hover:bg-stone-900/90 transition"
          >
            <div class="text-sm font-bold text-white group-hover:text-toxic-300 transition line-clamp-1">
              {g.title}
            </div>
            {g.description && (
              <div class="mt-1 text-xs text-stone-400 line-clamp-2 leading-relaxed">{g.description}</div>
            )}
            <div class="mt-2 flex items-center justify-between text-[11px] text-stone-500 font-mono">
              <span class="truncate">{g.slug}/</span>
              {g.updated && <span>🗓 {g.updated}</span>}
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}
</div>
