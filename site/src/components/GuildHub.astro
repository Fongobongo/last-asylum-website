    s76: 'Enter Admin Panel →',
    s77: 'Invalid admin password.',
    s78: '🔑 1. Member Access Password',
    s79: 'Current password:',
    s80: 'New alliance password...',
    s81: 'Save New Password',
    s82: '🔗 Auto-login link for clan members',
    s83: 'Copy link with password',
    s84: '🛡️ 2. Change Admin Master Password',
    s85: 'New admin password...',
    s86: 'Update Admin Password',
    s87: '📢 3. Tactical Alliance Directive',
    s88: 'This directive is immediately displayed to all members in Battle Protocols tab.',
    s89: 'Attention alliance! Saturday 19:00 rally for fort...',
    s90: 'Publish Directive',
    s91: '💬 4. Discord Webhook Integration',
    s92: 'Enter your Discord channel Webhook URL to instantly broadcast directives and rallies without server backend.',
    s93: 'Save Webhook',
    s94: '🔔 Test Ping',
    s95: '📢 Publish & Send to Discord',
    s96: '✕ Close',
    s97: 'Logout Admin',
    s98: 'Guest',
    s99: 'Set Nick',
    s100: 'War RSVP',
    s101: 'Battle Protocols',
  },
};
const TR = (k: string): string => {
  const table: Record<string, string> | undefined = (STR as any)[lang] ?? STR.en;
  return table?.[k] ?? (STR.en as any)[k] ?? k;
};

const T = {
  restrictedBadge: TR('s0'),
  hubTitle: TR('s1'),
  hubSubtitle: TR('s2'),
  enterNickTitle: TR('s3'),
  enterNickDesc: TR('s4'),
  passLabel: TR('s5'),
  passPlaceholder: TR('s6'),
  nickPlaceholder: TR('s7'),
  nickLabel: TR('s8'),
  enterBtn: TR('s9'),
  showPassBtn: TR('s10'),
  hidePassBtn: TR('s11'),
  wrongPassMember: TR('s12'),
  nickCookieNote: TR('s13'),
  memberBadge: TR('s14'),
  onlineStatus: TR('s15'),
  changeNickBtn: TR('s16'),
  logoutBtn: TR('s17'),
  adminBtn: TR('s18'),
  tabPolls: TR('s19'),
  tabIntel: TR('s20'),
  pollsTitle: TR('s21'),
  pollsSubtitle: TR('s22'),
  newPollBtn: TR('s23'),
  manageDataBtn: TR('s24'),
  createPollTitle: TR('s25'),
  questionLabel: TR('s26'),
  questionPlaceholder: TR('s27'),
  descLabel: TR('s28'),
  descPlaceholder: TR('s29'),
  optionsLabel: TR('s30'),
  optionPlaceholder: TR('s31'),
  addOptionBtn: TR('s32'),
  pollTypeLabel: TR('s33'),
  typeSingle: TR('s34'),
  typeMultiple: TR('s35'),
  showVotersLabel: TR('s36'),
  publishBtn: TR('s37'),
  cancelBtn: TR('s38'),
  voteBtn: TR('s39'),
  changeVoteBtn: TR('s40'),
  yourVoteBadge: TR('s41'),
  totalVotes: TR('s42'),
  votersLabel: TR('s43'),
  shareBtn: TR('s44'),
  shareCopied: TR('s45'),
  closePollBtn: TR('s46'),
  reopenPollBtn: TR('s47'),
  deletePollBtn: TR('s48'),
  pollClosedBadge: TR('s49'),
  pollActiveBadge: TR('s50'),
  noPolls: TR('s51'),
  resetDataBtn: TR('s52'),
  exportBtn: TR('s53'),
  importBtn: TR('s54'),
  intelTitle: TR('s55'),
  intelSubtitle: TR('s56'),
  decryptTitle: TR('s57'),
  decryptDesc: TR('s58'),
  passphrasePlaceholder: TR('s59'),
  unlockBtn: TR('s60'),
  wrongPassErr: TR('s61'),
  defaultIntelTitle: TR('s62'),
  rallyOrderTitle: TR('s63'),
  rally1: TR('s64'),
  rally2: TR('s65'),
  rally3: TR('s66'),
  rotationTitle: TR('s67'),
  dayCol: TR('s68'),
  squadCol: TR('s69'),
  missionCol: TR('s70'),
  // Admin Panel strings
  adminModalTitle: TR('s71'),
  adminLoginPrompt: TR('s72'),
  adminLoginDesc: TR('s73'),
  adminMasterPassLabel: TR('s74'),
  adminMasterPassPlaceholder: TR('s75'),
  adminLoginBtn: TR('s76'),
  adminWrongPass: TR('s77'),
  adminSecPassTitle: TR('s78'),
  adminCurrentPassLabel: TR('s79'),
  adminNewPassPlaceholder: TR('s80'),
  adminSavePassBtn: TR('s81'),
  adminShareInviteTitle: TR('s82'),
  adminCopyInviteBtn: TR('s83'),
  adminSecMasterTitle: TR('s84'),
  adminNewMasterPlaceholder: TR('s85'),
  adminSaveMasterBtn: TR('s86'),
  adminSecDirectiveTitle: TR('s87'),
  adminDirectiveDesc: TR('s88'),
  adminDirectivePlaceholder: TR('s89'),
  adminSaveDirectiveBtn: TR('s90'),
  adminSecWebhookTitle: TR('s91'),
  adminWebhookDesc: TR('s92'),
  adminWebhookPlaceholder: 'https://discord.com/api/webhooks/...',
  adminSaveWebhookBtn: TR('s93'),
  adminTestWebhookBtn: TR('s94'),
  adminSendDiscordBtn: TR('s95'),
