<script>
  // ==========================================
  // GUILD HUB CLIENT LOGIC
  // - Password-protected access (member password)
  // - Admin control panel (master admin password)
  // - Cookie-based Nickname authorization
  // - Reactive Polls with voting & creation
  // - Real-time progress bars & voter breakdown
  // - URL sharing via base64 encoded poll
  // - WebCrypto AES-GCM decryption for DND
  // ==========================================

  interface PollOption {
    id: string;
    text: string;
    voters: string[];
  }

  interface GuildPoll {
    id: string;
    question: string;
    description?: string;
    author: string;
    createdAt: string;
    type: 'single' | 'multiple';
    showVoters: boolean;
    status: 'active' | 'closed';
    options: PollOption[];
  }

  const COOKIE_NICK = 'la_player_nick';
  const COOKIE_AUTH = 'la_dnd_auth';
  const STORAGE_POLLS = 'la_guild_polls_v2';
  const STORAGE_NICK = 'la_player_nick';
  const STORAGE_MEMBER_AUTH = 'la_dnd_member_authed';
  const STORAGE_ALLIANCE_PWD = 'la_dnd_alliance_pwd';
  const DEFAULT_ALLIANCE_PWD = 'dnd2026';
  const STORAGE_ADMIN_PWD = 'la_dnd_admin_pwd';
  const DEFAULT_ADMIN_PWD = 'admin2026';
  const STORAGE_DIRECTIVE = 'la_dnd_directive';
  const STORAGE_DIRECTIVE_TIME = 'la_dnd_directive_time';

  // --- Cookie Helpers ---
  function getCookie(name: string): string | null {
    const value = `; ${document.cookie}`;
    const parts = value.split(`; ${name}=`);
    if (parts.length === 2) {
      const val = parts.pop()?.split(';').shift();
      return val ? decodeURIComponent(val) : null;
    }
    return null;
  }

  function setCookie(name: string, val: string, days = 365) {
    const date = new Date();
    date.setTime(date.getTime() + days * 24 * 60 * 60 * 1000);
    document.cookie = `${name}=${encodeURIComponent(val)}; expires=${date.toUTCString()}; path=/; SameSite=Lax`;
  }

  function deleteCookie(name: string) {
    document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; SameSite=Lax`;
  }

  // --- Password & Auth Helpers ---
  function getAlliancePassword(): string {
    return localStorage.getItem(STORAGE_ALLIANCE_PWD) || DEFAULT_ALLIANCE_PWD;
  }

  function setAlliancePassword(newPass: string) {
    localStorage.setItem(STORAGE_ALLIANCE_PWD, newPass.trim());
  }

  function getAdminPassword(): string {
    return localStorage.getItem(STORAGE_ADMIN_PWD) || DEFAULT_ADMIN_PWD;
  }

  function setAdminPassword(newPass: string) {
    localStorage.setItem(STORAGE_ADMIN_PWD, newPass.trim());
  }

  function isMemberAuthed(): boolean {
    return localStorage.getItem(STORAGE_MEMBER_AUTH) === '1' || getCookie(COOKIE_AUTH) === '1';
  }

  function setMemberAuthed(val: boolean) {
    if (val) {
      localStorage.setItem(STORAGE_MEMBER_AUTH, '1');
      setCookie(COOKIE_AUTH, '1', 30);
    } else {
      localStorage.removeItem(STORAGE_MEMBER_AUTH);
      deleteCookie(COOKIE_AUTH);
    }
  }

  let isAdminAuthed = false;

  // --- Default Guild Polls ---
  const DEFAULT_POLLS: GuildPoll[] = [
    {
      id: 'poll_kvk_target',
      question: 'Целевой форт на первую фазу KvK: куда направляем удар?',
      description: 'Координация первого дня противостояния. Важно выбрать единую точку сбора всего альянса.',
      author: 'Commander_Daskal',
      createdAt: '2026-09-03',
      type: 'single',
      showVoters: true,
      status: 'active',
      options: [
        { id: 'opt_1', text: 'Центральный Бастион Чумы (высокая награда, сильное сопротивление)', voters: ['Arthur_King', 'Valkyrie', 'BlackLotus', 'Viper'] },
        { id: 'opt_2', text: 'Северное Святилище ветров (контроль фланга, умеренный риск)', voters: ['GhostRider', 'Raven', 'Shadow'] },
        { id: 'opt_3', text: 'Южный склад снабжения (быстрый фарм очков альянса)', voters: ['Harper_Main'] },
      ],
    },
    {
      id: 'poll_boss_time',
      question: 'Удобное время для вечернего сбора на Элитного Босса (МСК)',
      description: 'Выберите один или несколько временных слотов, в которые вы гарантированно онлайн.',
      author: 'Valkyrie',
      createdAt: '2026-09-02',
      type: 'multiple',
      showVoters: true,
      status: 'active',
      options: [
        { id: 'opt_b1', text: '19:00 - 20:00 МСК', voters: ['Arthur_King', 'NightWolf'] },
        { id: 'opt_b2', text: '20:00 - 21:00 МСК', voters: ['Valkyrie', 'Shadow', 'Harper_Main', 'Raven', 'Viper'] },
        { id: 'opt_b3', text: '21:00 - 22:00 МСК', voters: ['GhostRider', 'BlackLotus', 'Daskal'] },
        { id: 'opt_b4', text: '22:00+ МСК (Ночной рейд)', voters: ['Nocturne'] },
      ],
    },
    {
      id: 'poll_tech_focus',
      question: 'Приоритет исследований в Технологическом центре альянса на неделю',
      description: 'Куда инвестируем 100% очков взносов гильдии.',
      author: 'Arthur_King',
      createdAt: '2026-09-01',
      type: 'single',
      showVoters: true,
      status: 'active',
      options: [
        { id: 'opt_t1', text: 'Атака штурмовиков (+15% урон отрядов)', voters: ['Arthur_King', 'Viper', 'GhostRider', 'Nocturne'] },
        { id: 'opt_t2', text: 'Госпиталь альянса (+25% вместимость коек)', voters: ['Valkyrie', 'Harper_Main'] },
        { id: 'opt_t3', text: 'Логистика территории (+30% скорость сбора)', voters: ['FarmMaster'] },
      ],
    },
  ];

  // --- State Management ---
  function getPlayerNick(): string | null {
    const cookieNick = getCookie(COOKIE_NICK);
    if (cookieNick) return cookieNick;
    const localNick = localStorage.getItem(STORAGE_NICK);
    if (localNick) {
      setCookie(COOKIE_NICK, localNick);
      return localNick;
    }
    return null;
  }

  function setPlayerNick(nick: string) {
    const clean = nick.trim();
    if (!clean) return;
    setCookie(COOKIE_NICK, clean);
    localStorage.setItem(STORAGE_NICK, clean);
  }

  function clearPlayerNick() {
    deleteCookie(COOKIE_NICK);
    localStorage.removeItem(STORAGE_NICK);
  }

  function loadPolls(): GuildPoll[] {
    try {
      const raw = localStorage.getItem(STORAGE_POLLS);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed) && parsed.length > 0) return parsed;
      }
    } catch (e) {
      console.error('Error loading polls:', e);
    }
    savePolls(DEFAULT_POLLS);
    return DEFAULT_POLLS;
  }

  function savePolls(polls: GuildPoll[]) {
    try {
      localStorage.setItem(STORAGE_POLLS, JSON.stringify(polls));
    } catch (e) {
      console.error('Error saving polls:', e);
    }
  }

  // Check URL query for shared poll (?poll_share=...)
  function checkSharedPollUrl(currentPolls: GuildPoll[]): GuildPoll[] {
    try {
      const url = new URL(window.location.href);
      const shared = url.searchParams.get('poll_share');
      if (shared) {
        const json = decodeURIComponent(atob(shared));
        const importedPoll = JSON.parse(json) as GuildPoll;
        if (importedPoll && importedPoll.id && importedPoll.question) {
          const exists = currentPolls.some((p) => p.id === importedPoll.id);
          if (!exists) {
            currentPolls.unshift(importedPoll);
            savePolls(currentPolls);
          }
          url.searchParams.delete('poll_share');
          window.history.replaceState({}, '', url.toString());
        }
      }
    } catch (e) {
      console.warn('Could not parse shared poll from URL:', e);
    }
    return currentPolls;
  }

  // --- UI Update Functions ---
  function updateUI() {
    const isAuthed = isMemberAuthed();
    const nick = getPlayerNick();

    const loginScreen = document.getElementById('gh-login-screen');
    const mainContent = document.getElementById('gh-main-content');
    const memberBar = document.getElementById('gh-member-bar');
    const currentNickEl = document.getElementById('gh-current-nick');
    const passGroup = document.getElementById('gh-group-pass');
    const passInput = document.getElementById('gh-input-pass') as HTMLInputElement | null;

    if (!isAuthed || !nick) {
      loginScreen?.classList.remove('hidden');
      mainContent?.classList.add('hidden');
      memberBar?.classList.add('hidden');

      if (isAuthed) {
        // Already verified password earlier, only nick is needed
        if (passGroup) passGroup.classList.add('hidden');
        if (passInput) passInput.required = false;
      } else {
        if (passGroup) passGroup.classList.remove('hidden');
        if (passInput) passInput.required = true;
      }
    } else {
      loginScreen?.classList.add('hidden');
      mainContent?.classList.remove('hidden');
      memberBar?.classList.remove('hidden');
      if (currentNickEl) currentNickEl.textContent = nick;

      renderPollsList();
      renderDirective();
    }
  }

  function renderDirective() {
    const card = document.getElementById('gh-directive-card');
    const textEl = document.getElementById('gh-directive-text');
    const timeEl = document.getElementById('gh-directive-time');
    const saved = localStorage.getItem(STORAGE_DIRECTIVE);
    const savedTime = localStorage.getItem(STORAGE_DIRECTIVE_TIME);

    if (saved && saved.trim()) {
      if (card) card.classList.remove('hidden');
      if (textEl) textEl.textContent = saved;
      if (timeEl && savedTime) timeEl.textContent = `Обновлено: ${savedTime}`;
    } else {
      if (card) card.classList.add('hidden');
    }
  }

  function renderPollsList() {
    const pollsContainer = document.getElementById('gh-polls-list');
    const badge = document.getElementById('gh-polls-badge');
    if (!pollsContainer) return;

    let polls = loadPolls();
    polls = checkSharedPollUrl(polls);

    if (badge) badge.textContent = polls.length.toString();

    if (polls.length === 0) {
      pollsContainer.innerHTML = `
        <div class="rounded-2xl border border-stone-800 bg-stone-900/30 p-12 text-center text-stone-500">
          <p class="text-base">Пока нет голосований. Нажмите "+ Новое голосование", чтобы создать первое!</p>
        </div>
      `;
      return;
    }

    const currentNick = getPlayerNick() || '';

    pollsContainer.innerHTML = polls
      .map((poll) => {
        const totalVotes = poll.options.reduce((sum, opt) => sum + opt.voters.length, 0);
        const hasVoted = poll.options.some((opt) => opt.voters.includes(currentNick));
        const isClosed = poll.status === 'closed';

        return `
          <div class="poll-card rounded-2xl border ${hasVoted ? 'border-toxic-500/30 bg-stone-900/80' : 'border-stone-800 bg-stone-900/60'} p-5 sm:p-6 backdrop-blur-xl shadow-xl transition-all" data-poll-id="${poll.id}">
            <!-- Header -->
            <div class="flex flex-wrap items-start justify-between gap-3 border-b border-stone-800/80 pb-4">
              <div class="space-y-1">
                <div class="flex flex-wrap items-center gap-2 text-xs">
                  <span class="rounded-md px-2 py-0.5 font-mono font-semibold ${isClosed ? 'bg-stone-800 text-stone-400' : 'bg-toxic-500/20 text-toxic-300 border border-toxic-400/30'}">
                    ${isClosed ? '● Завершено' : '● Активно'}
                  </span>
                  <span class="rounded-md bg-stone-800/80 px-2 py-0.5 text-stone-400">
                    ${poll.type === 'multiple' ? 'Несколько вариантов' : 'Один ответ'}
                  </span>
                  <span class="text-stone-500">Автор: <strong class="text-stone-300">${escapeHtml(poll.author)}</strong></span>
                  <span class="text-stone-600">• ${escapeHtml(poll.createdAt)}</span>
                </div>
                <h3 class="text-base sm:text-lg font-bold text-white tracking-tight pt-1">${escapeHtml(poll.question)}</h3>
                ${poll.description ? `<p class="text-xs sm:text-sm text-stone-400 leading-relaxed pt-0.5">${escapeHtml(poll.description)}</p>` : ''}
              </div>

              <!-- Top right actions -->
              <div class="flex items-center gap-1.5">
                <button type="button" class="btn-share-poll rounded-lg border border-stone-700 bg-stone-800/80 px-2.5 py-1 text-xs font-medium text-stone-300 hover:text-white transition cursor-pointer" data-poll-id="${poll.id}" title="Скопировать ссылку на опрос">
                  🔗 Поделиться
                </button>
                <button type="button" class="btn-toggle-poll rounded-lg border border-stone-800 bg-stone-900 px-2.5 py-1 text-xs text-stone-400 hover:text-stone-200 transition cursor-pointer" data-poll-id="${poll.id}">
                  ${isClosed ? 'Возобновить' : 'Завершить'}
                </button>
                <button type="button" class="btn-delete-poll rounded-lg border border-stone-800 bg-stone-900 px-2 py-1 text-xs text-stone-500 hover:text-red-400 transition cursor-pointer" data-poll-id="${poll.id}" title="Удалить опрос">
                  ✕
                </button>
              </div>
            </div>

            <!-- Options & Voting Body -->
            <div class="my-5 space-y-3">
              ${poll.options
                .map((opt) => {
                  const optVotes = opt.voters.length;
                  const pct = totalVotes > 0 ? Math.round((optVotes / totalVotes) * 100) : 0;
                  const userVotedThis = opt.voters.includes(currentNick);

                  if (hasVoted || isClosed) {
                    // Results Mode with Progress Bar
                    return `
                      <div class="relative overflow-hidden rounded-xl border ${userVotedThis ? 'border-toxic-500/50 bg-stone-950/80 shadow-[0_0_15px_rgba(180,255,57,0.08)]' : 'border-stone-800 bg-stone-950/50'} p-3.5 transition-all">
                        <div class="absolute inset-y-0 left-0 bg-gradient-to-r ${userVotedThis ? 'from-toxic-500/20 to-plague-500/20' : 'from-stone-800/60 to-stone-800/30'} pointer-events-none transition-all duration-500" style="width: ${pct}%"></div>

                        <div class="relative flex items-center justify-between gap-3 text-sm">
                          <div class="flex items-center gap-2">
                            <span class="font-medium ${userVotedThis ? 'text-white' : 'text-stone-300'}">${escapeHtml(opt.text)}</span>
                            ${userVotedThis ? `<span class="rounded bg-toxic-400/20 px-1.5 py-0.5 text-[10px] font-bold text-toxic-300 border border-toxic-400/40">✓ Ваш выбор</span>` : ''}
                          </div>
                          <div class="flex items-center gap-2 font-mono text-xs shrink-0">
                            <span class="font-bold ${userVotedThis ? 'text-toxic-300' : 'text-stone-300'}">${pct}%</span>
                            <span class="text-stone-500">(${optVotes})</span>
                          </div>
                        </div>

                        ${
                          poll.showVoters && opt.voters.length > 0
                            ? `
                          <div class="relative mt-2 flex flex-wrap items-center gap-1.5 text-[11px] text-stone-400 border-t border-stone-800/60 pt-2">
                            <span class="text-stone-500">👥 Бойцы:</span>
                            ${opt.voters.map((v) => `<span class="rounded bg-stone-900 border border-stone-800 px-1.5 py-0.2 ${v === currentNick ? 'text-toxic-300 font-semibold' : 'text-stone-300'}">${escapeHtml(v)}</span>`).join('')}
                          </div>
                        `
                            : ''
                        }
                      </div>
                    `;
                  } else {
                    // Voting Mode (Selectable choices)
                    const inputType = poll.type === 'multiple' ? 'checkbox' : 'radio';
                    return `
                      <label class="flex items-center justify-between gap-3 rounded-xl border border-stone-800 bg-stone-950/60 p-3.5 cursor-pointer hover:border-stone-700 hover:bg-stone-950 transition">
                        <div class="flex items-center gap-3">
                          <input type="${inputType}" name="vote_${poll.id}" value="${opt.id}" class="accent-toxic-400 h-4 w-4 rounded" />
                          <span class="text-sm font-medium text-stone-200">${escapeHtml(opt.text)}</span>
                        </div>
                        <span class="text-xs font-mono text-stone-500">${optVotes} ${optVotes === 1 ? 'голос' : 'голосов'}</span>
                      </label>
                    `;
                  }
                })
                .join('')}
            </div>

            <!-- Footer / Action Row -->
            <div class="flex flex-wrap items-center justify-between gap-3 border-t border-stone-800/80 pt-4 text-xs text-stone-400">
              <div class="flex items-center gap-2">
                <span>Всего проголосовало: <strong class="text-stone-200">${totalVotes}</strong></span>
              </div>

              <div>
                ${
                  !hasVoted && !isClosed
                    ? `
                  <button type="button" class="btn-submit-vote rounded-xl bg-toxic-400 px-4 py-2 font-bold text-black shadow-[0_0_15px_rgba(180,255,57,0.25)] hover:bg-toxic-300 transition cursor-pointer" data-poll-id="${poll.id}">
                    Отдать голос
                  </button>
                `
                    : hasVoted && !isClosed
                      ? `
                  <button type="button" class="btn-change-vote rounded-lg border border-stone-700 bg-stone-800/60 px-3 py-1.5 text-stone-300 hover:text-white hover:border-stone-600 transition cursor-pointer" data-poll-id="${poll.id}">
                    Изменить голос
                  </button>
                `
                      : ''
                }
              </div>
            </div>
          </div>
        `;
      })
      .join('');

    attachPollEvents();
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // --- Attach Event Listeners to Poll Elements ---
  function attachPollEvents() {
    // 1. Submit Vote
    document.querySelectorAll('.btn-submit-vote').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const pollId = (e.currentTarget as HTMLElement).dataset.pollId;
        if (!pollId) return;

        const currentNick = getPlayerNick();
        if (!currentNick) {
          updateUI();
          return;
        }

        const selectedInputs = Array.from(
          document.querySelectorAll(`input[name="vote_${pollId}"]:checked`)
        ) as HTMLInputElement[];

        if (selectedInputs.length === 0) {
          alert('Пожалуйста, выберите хотя бы один вариант ответа!');
          return;
        }

        const selectedOptionIds = selectedInputs.map((i) => i.value);
        const polls = loadPolls();
        const poll = polls.find((p) => p.id === pollId);
        if (!poll) return;

        poll.options.forEach((opt) => {
          opt.voters = opt.voters.filter((v) => v !== currentNick);
        });

        poll.options.forEach((opt) => {
          if (selectedOptionIds.includes(opt.id)) {
            if (!opt.voters.includes(currentNick)) {
              opt.voters.push(currentNick);
            }
          }
        });

        savePolls(polls);
        renderPollsList();
      });
    });

    // 2. Change Vote (Revote)
    document.querySelectorAll('.btn-change-vote').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const pollId = (e.currentTarget as HTMLElement).dataset.pollId;
        if (!pollId) return;
        const currentNick = getPlayerNick();
        if (!currentNick) return;

        const polls = loadPolls();
        const poll = polls.find((p) => p.id === pollId);
        if (!poll) return;

        poll.options.forEach((opt) => {
          opt.voters = opt.voters.filter((v) => v !== currentNick);
        });

        savePolls(polls);
        renderPollsList();
      });
    });

    // 3. Toggle Open/Close Poll
    document.querySelectorAll('.btn-toggle-poll').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const pollId = (e.currentTarget as HTMLElement).dataset.pollId;
        if (!pollId) return;
        const polls = loadPolls();
        const poll = polls.find((p) => p.id === pollId);
        if (!poll) return;

        poll.status = poll.status === 'closed' ? 'active' : 'closed';
        savePolls(polls);
        renderPollsList();
      });
    });

    // 4. Delete Poll
    document.querySelectorAll('.btn-delete-poll').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const pollId = (e.currentTarget as HTMLElement).dataset.pollId;
        if (!pollId) return;
        if (!confirm('Вы уверены, что хотите удалить это голосование?')) return;

        let polls = loadPolls();
        polls = polls.filter((p) => p.id !== pollId);
        savePolls(polls);
        renderPollsList();
      });
    });

    // 5. Share Poll link
    document.querySelectorAll('.btn-share-poll').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const targetBtn = e.currentTarget as HTMLButtonElement;
        const pollId = targetBtn.dataset.pollId;
        if (!pollId) return;

        const polls = loadPolls();
        const poll = polls.find((p) => p.id === pollId);
        if (!poll) return;

        try {
          const pollJson = JSON.stringify(poll);
          const b64 = btoa(encodeURIComponent(pollJson));
          const url = new URL(window.location.href);
          url.searchParams.set('poll_share', b64);

          await navigator.clipboard.writeText(url.toString());
          const originalText = targetBtn.innerHTML;
          targetBtn.innerHTML = '✓ Скопировано!';
          targetBtn.classList.add('text-toxic-300', 'border-toxic-500/50');
          setTimeout(() => {
            targetBtn.innerHTML = originalText;
            targetBtn.classList.remove('text-toxic-300', 'border-toxic-500/50');
          }, 2000);
        } catch (err) {
          prompt('Скопируйте ссылку на голосование:', window.location.href);
        }
      });
    });
  }

  // --- Dynamic Option Inputs for Poll Creation ---
  let optionCount = 3;

  function renderCreateOptions() {
    const container = document.getElementById('gh-options-container');
    if (!container) return;

    let html = '';
    for (let i = 1; i <= optionCount; i++) {
      html += `
        <div class="flex items-center gap-2">
          <span class="text-xs font-mono text-stone-500 w-5 text-right">${i}.</span>
          <input
            type="text"
            required
            name="option_${i}"
            placeholder="Вариант ответа ${i}"
            class="flex-1 rounded-xl border border-stone-700 bg-stone-900 px-3.5 py-2 text-sm text-stone-100 placeholder-stone-600 outline-none focus:border-toxic-400"
          />
          ${
            optionCount > 2
              ? `<button type="button" class="btn-remove-option text-stone-500 hover:text-red-400 text-sm px-2 py-1" data-index="${i}">✕</button>`
              : ''
          }
        </div>
      `;
    }
    container.innerHTML = html;

    container.querySelectorAll('.btn-remove-option').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (optionCount > 2) {
          optionCount--;
          renderCreateOptions();
        }
      });
    });
  }

  // --- DOM Initialization ---
  document.addEventListener('DOMContentLoaded', () => {
    // 0. Auto-auth check from URL query (?pass=... or ?key=...)
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const urlPass = urlParams.get('pass') || urlParams.get('key');
      if (urlPass && urlPass.trim() === getAlliancePassword()) {
        setMemberAuthed(true);
      }
      if (urlParams.get('admin') === '1') {
        openAdminModal();
      }
    } catch (e) {
      console.warn('URL params parse error:', e);
    }

    updateUI();

    // 1. Password Toggle Visibility
    const passInput = document.getElementById('gh-input-pass') as HTMLInputElement | null;
    const togglePassBtn = document.getElementById('gh-toggle-pwd-btn');
    togglePassBtn?.addEventListener('click', () => {
      if (!passInput) return;
      if (passInput.type === 'password') {
        passInput.type = 'text';
        togglePassBtn.textContent = '🙈 Скрыть';
      } else {
        passInput.type = 'password';
        togglePassBtn.textContent = '👁️ Показать';
      }
    });

    // 2. Login Form Submit
    const loginForm = document.getElementById('gh-login-form');
    const loginError = document.getElementById('gh-login-error');

    loginForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      loginError?.classList.add('hidden');

      const passVal = passInput ? passInput.value.trim() : '';
      const nickInput = document.getElementById('gh-input-nick') as HTMLInputElement | null;
      const nickVal = nickInput ? nickInput.value.trim() : '';

      // Check Password if member is not yet authed
      if (!isMemberAuthed()) {
        const requiredPass = getAlliancePassword();
        if (passVal !== requiredPass) {
          if (loginError) {
            loginError.textContent = '⚠️ Неверный пароль альянса. Обратитесь к офицерам за актуальным паролем.';
            loginError.classList.remove('hidden');
          }
          return;
        }
        setMemberAuthed(true);
      }

      if (!nickVal) {
        if (loginError) {
          loginError.textContent = '⚠️ Укажите игровой никнейм.';
          loginError.classList.remove('hidden');
        }
        return;
      }

      setPlayerNick(nickVal);
      updateUI();
    });

    // 3. Member Logout & Change Nick
    document.getElementById('gh-btn-logout')?.addEventListener('click', () => {
      if (confirm('Выйти из закрытого сектора штаба?')) {
        setMemberAuthed(false);
        clearPlayerNick();
        updateUI();
      }
    });

    document.getElementById('gh-btn-change-nick')?.addEventListener('click', () => {
      const current = getPlayerNick() || '';
      const next = prompt('Введите новый игровой никнейм:', current);
      if (next && next.trim() && next.trim() !== current) {
        setPlayerNick(next.trim());
        updateUI();
      }
    });

    // 4. Admin Modal Controls
    function openAdminModal() {
      const modal = document.getElementById('gh-admin-modal');
      const loginView = document.getElementById('gh-admin-login-view');
      const dashView = document.getElementById('gh-admin-dashboard');

      modal?.classList.remove('hidden');

      if (isAdminAuthed) {
        loginView?.classList.add('hidden');
        dashView?.classList.remove('hidden');
        populateAdminDashboard();
      } else {
        loginView?.classList.remove('hidden');
        dashView?.classList.add('hidden');
      }
    }

    function closeAdminModal() {
      document.getElementById('gh-admin-modal')?.classList.add('hidden');
    }

    function populateAdminDashboard() {
      const curPassEl = document.getElementById('gh-admin-cur-pass-display');
      if (curPassEl) curPassEl.textContent = getAlliancePassword();

      const directiveInput = document.getElementById('gh-admin-directive-input') as HTMLTextAreaElement | null;
      if (directiveInput) {
        directiveInput.value = localStorage.getItem(STORAGE_DIRECTIVE) || '';
      }
    }

    document.getElementById('gh-btn-open-admin-from-bar')?.addEventListener('click', openAdminModal);
    document.getElementById('gh-btn-open-admin-from-login')?.addEventListener('click', openAdminModal);
    document.getElementById('gh-btn-close-admin-modal')?.addEventListener('click', closeAdminModal);
    document.getElementById('gh-admin-btn-close-dash')?.addEventListener('click', closeAdminModal);

    // Admin Login Form
    document.getElementById('gh-admin-login-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const input = document.getElementById('gh-admin-master-input') as HTMLInputElement | null;
      const err = document.getElementById('gh-admin-login-error');
      err?.classList.add('hidden');

      const passVal = input ? input.value.trim() : '';
      if (passVal === getAdminPassword()) {
        isAdminAuthed = true;
        if (input) input.value = '';
        document.getElementById('gh-admin-login-view')?.classList.add('hidden');
        document.getElementById('gh-admin-dashboard')?.classList.remove('hidden');
        populateAdminDashboard();
      } else {
        if (err) {
          err.textContent = '⚠️ Неверный мастер-пароль администратора.';
          err.classList.remove('hidden');
        }
      }
    });

    // Admin Save New Member Password
    document.getElementById('gh-admin-btn-save-member-pass')?.addEventListener('click', () => {
      const input = document.getElementById('gh-admin-new-member-pass') as HTMLInputElement | null;
      const val = input ? input.value.trim() : '';
      if (!val) {
        alert('Введите новый пароль!');
        return;
      }
      setAlliancePassword(val);
      populateAdminDashboard();
      if (input) input.value = '';
      alert('✓ Новый пароль альянса сохранен!');
    });

    // Admin Copy Share Link
    document.getElementById('gh-admin-btn-copy-invite')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const currentPass = getAlliancePassword();
      const url = new URL(window.location.href);
      url.searchParams.set('pass', currentPass);
      url.searchParams.delete('admin');

      try {
        await navigator.clipboard.writeText(url.toString());
        const orig = btn.innerHTML;
        btn.innerHTML = '✓ Ссылка скопирована!';
        btn.classList.add('text-toxic-300', 'border-toxic-400');
        setTimeout(() => {
          btn.innerHTML = orig;
          btn.classList.remove('text-toxic-300', 'border-toxic-400');
        }, 2500);
      } catch {
        prompt('Скопируйте ссылку с паролем для соклановцев:', url.toString());
      }
    });

    // Admin Save New Master Password
    document.getElementById('gh-admin-btn-save-master-pass')?.addEventListener('click', () => {
      const input = document.getElementById('gh-admin-new-master-pass') as HTMLInputElement | null;
      const val = input ? input.value.trim() : '';
      if (!val || val.length < 4) {
        alert('Мастер-пароль должен быть не менее 4 символов!');
        return;
      }
      setAdminPassword(val);
      if (input) input.value = '';
      alert('✓ Мастер-пароль администратора обновлен!');
    });

    // Admin Save Directive
    document.getElementById('gh-admin-btn-save-directive')?.addEventListener('click', () => {
      const input = document.getElementById('gh-admin-directive-input') as HTMLTextAreaElement | null;
      const val = input ? input.value.trim() : '';
      const now = new Date().toLocaleString();
      localStorage.setItem(STORAGE_DIRECTIVE, val);
      localStorage.setItem(STORAGE_DIRECTIVE_TIME, now);
      renderDirective();
      alert('✓ Директива опубликована для всех участников!');
    });

    document.getElementById('gh-admin-btn-clear-directive')?.addEventListener('click', () => {
      if (confirm('Очистить оперативную директиву?')) {
        localStorage.removeItem(STORAGE_DIRECTIVE);
        localStorage.removeItem(STORAGE_DIRECTIVE_TIME);
        const input = document.getElementById('gh-admin-directive-input') as HTMLTextAreaElement | null;
        if (input) input.value = '';
        renderDirective();
      }
    });

    // Admin Logout
    document.getElementById('gh-admin-btn-logout')?.addEventListener('click', () => {
      isAdminAuthed = false;
      document.getElementById('gh-admin-dashboard')?.classList.add('hidden');
      document.getElementById('gh-admin-login-view')?.classList.remove('hidden');
    });

    // 5. Tabs switching
    const tabBtnPolls = document.getElementById('gh-tab-btn-polls');
    const tabBtnIntel = document.getElementById('gh-tab-btn-intel');
    const tabViewPolls = document.getElementById('gh-tab-view-polls');
    const tabViewIntel = document.getElementById('gh-tab-view-intel');

    tabBtnPolls?.addEventListener('click', () => {
      tabBtnPolls.classList.add('border-toxic-400', 'text-white', 'font-bold');
      tabBtnPolls.classList.remove('border-transparent', 'text-stone-400');
      tabBtnIntel?.classList.remove('border-toxic-400', 'text-white', 'font-bold');
      tabBtnIntel?.classList.add('border-transparent', 'text-stone-400');

      tabViewPolls?.classList.remove('hidden');
      tabViewIntel?.classList.add('hidden');
    });

    tabBtnIntel?.addEventListener('click', () => {
      tabBtnIntel.classList.add('border-toxic-400', 'text-white', 'font-bold');
      tabBtnIntel.classList.remove('border-transparent', 'text-stone-400');
      tabBtnPolls?.classList.remove('border-toxic-400', 'text-white', 'font-bold');
      tabBtnPolls?.classList.add('border-transparent', 'text-stone-400');

      tabViewIntel?.classList.remove('hidden');
      tabViewPolls?.classList.add('hidden');
      renderDirective();
    });

    // 6. Create Poll Modal
    const createModal = document.getElementById('gh-create-poll-modal');
    const openCreateBtn = document.getElementById('gh-btn-open-create');
    const closeCreateBtn = document.getElementById('gh-btn-close-create');
    const cancelCreateBtn = document.getElementById('gh-btn-cancel-create');
    const addOptionBtn = document.getElementById('gh-btn-add-option');

    openCreateBtn?.addEventListener('click', () => {
      renderCreateOptions();
      createModal?.classList.remove('hidden');
      createModal?.scrollIntoView({ behavior: 'smooth' });
    });

    closeCreateBtn?.addEventListener('click', () => createModal?.classList.add('hidden'));
    cancelCreateBtn?.addEventListener('click', () => createModal?.classList.add('hidden'));

    addOptionBtn?.addEventListener('click', () => {
      if (optionCount < 10) {
        optionCount++;
        renderCreateOptions();
      } else {
        alert('Максимум 10 вариантов ответа!');
      }
    });

    const createForm = document.getElementById('gh-create-poll-form') as HTMLFormElement | null;
    createForm?.addEventListener('submit', (e) => {
      e.preventDefault();

      const questionEl = document.getElementById('gh-poll-question') as HTMLInputElement | null;
      const descEl = document.getElementById('gh-poll-desc') as HTMLTextAreaElement | null;
      const showVotersEl = document.getElementById('gh-poll-show-voters') as HTMLInputElement | null;
      const pollTypeEl = document.querySelector('input[name="pollType"]:checked') as HTMLInputElement | null;

      const question = questionEl ? questionEl.value.trim() : '';
      const description = descEl ? descEl.value.trim() : '';
      const showVoters = showVotersEl ? showVotersEl.checked : true;
      const type = (pollTypeEl ? pollTypeEl.value : 'single') as 'single' | 'multiple';

      if (!question) {
        alert('Укажите вопрос голосования!');
        return;
      }

      const options: PollOption[] = [];
      const optionInputs = document.querySelectorAll('#gh-options-container input[type="text"]') as NodeListOf<HTMLInputElement>;
      optionInputs.forEach((inp, idx) => {
        const text = inp.value.trim();
        if (text) {
          options.push({
            id: `opt_${Date.now()}_${idx}`,
            text,
            voters: [],
          });
        }
      });

      if (options.length < 2) {
        alert('Нужно указать как минимум 2 варианта ответа!');
        return;
      }

      const currentNick = getPlayerNick() || 'Anonymous';

      const newPoll: GuildPoll = {
        id: `poll_${Date.now()}`,
        question,
        description,
        author: currentNick,
        createdAt: new Date().toISOString().split('T')[0],
        type,
        showVoters,
        status: 'active',
        options,
      };

      const polls = loadPolls();
      polls.unshift(newPoll);
      savePolls(polls);

      questionEl.value = '';
      descEl.value = '';
      optionCount = 3;
      renderCreateOptions();
      createModal?.classList.add('hidden');

      renderPollsList();
    });

    // 7. Manage Data Drawer & Actions
    const manageDrawer = document.getElementById('gh-manage-drawer');
    document.getElementById('gh-btn-manage-toggle')?.addEventListener('click', () => {
      manageDrawer?.classList.toggle('hidden');
    });

    document.getElementById('gh-btn-reset-polls')?.addEventListener('click', () => {
      if (confirm('Сбросить все опросы к исходным для гильдии?')) {
        savePolls(DEFAULT_POLLS);
        renderPollsList();
      }
    });

    document.getElementById('gh-btn-export')?.addEventListener('click', () => {
      const polls = loadPolls();
      const blob = new Blob([JSON.stringify(polls, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `la_guild_polls_${Date.now()}.json`;
      a.click();
      URL.revokeObjectURL(url);
    });

    document.getElementById('gh-btn-import')?.addEventListener('click', () => {
      const input = document.createElement('input');
      input.type = 'file';
      input.accept = '.json';
      input.onchange = async () => {
        const file = input.files?.[0];
        if (!file) return;
        try {
          const text = await file.text();
          const parsed = JSON.parse(text);
          if (Array.isArray(parsed)) {
            savePolls(parsed);
            renderPollsList();
            alert('Голосования успешно импортированы!');
          }
        } catch (e) {
          alert('Ошибка чтения JSON файла.');
        }
      };
      input.click();
    });

    // 8. AES-GCM Intel Decryption (WebCrypto)
    async function deriveKey(pass: string, salt: Uint8Array): Promise<CryptoKey> {
      const enc = new TextEncoder();
      const base = await crypto.subtle.importKey('raw', enc.encode(pass), 'PBKDF2', false, ['deriveKey']);
      return crypto.subtle.deriveKey(
        { name: 'PBKDF2', salt: salt as any, iterations: 150000, hash: 'SHA-256' },
        base,
        { name: 'AES-GCM', length: 256 },
        false,
        ['decrypt']
      );
    }

    async function decrypt(payloadB64: string, pass: string): Promise<string> {
      const raw = Uint8Array.from(atob(payloadB64), (c) => c.charCodeAt(0));
      const salt = raw.slice(0, 16);
      const iv = raw.slice(16, 28);
      const data = raw.slice(28);
      const key = await deriveKey(pass, salt);
      const plain = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: iv as any }, key, data as any);
      return new TextDecoder().decode(plain);
    }

    document.getElementById('dnd-unlock')?.addEventListener('click', async () => {
      const pass = (document.getElementById('dnd-key') as HTMLInputElement)?.value;
      const err = document.getElementById('dnd-error');
      err?.classList.add('hidden');
      try {
        const res = await fetch('/dnd/payload.enc');
        if (!res.ok) throw new Error('no payload');
        const payload = (await res.text()).trim();
        const md = await decrypt(payload, pass);

        const html = md
          .split(/\n{2,}/)
          .map((block) => {
            if (block.startsWith('### ')) return `<h3>${block.slice(4)}</h3>`;
            if (block.startsWith('## ')) return `<h2>${block.slice(3)}</h2>`;
            if (block.startsWith('# ')) return `<h2>${block.slice(2)}</h2>`;
            if (block.startsWith('- ') || block.startsWith('* ')) {
              const items = block.split('\n').map((l) => `<li>${l.replace(/^[-*] /, '')}</li>`).join('');
              return `<ul>${items}</ul>`;
            }
            if (/^\|/.test(block)) {
              const rows = block.split('\n').filter((r) => !/^\|[\s-|]+\|$/.test(r));
              const cells = rows.map((r) => {
                const tds = r.split('|').slice(1, -1).map((c) => c.trim());
                return `<tr>${tds.map((c) => `<td>${c}</td>`).join('')}</tr>`;
              });
              return `<table>${cells.join('')}</table>`;
            }
            const p = block
              .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
              .replace(/\*(.+?)\*/g, '<em>$1</em>')
              .replace(/`(.+?)`/g, '<code>$1</code>');
            return `<p>${p}</p>`;
          })
          .join('\n');

        const content = document.getElementById('dnd-content');
        if (content) {
          content.innerHTML = html;
          content.classList.remove('hidden');
        }
      } catch {
        err?.classList.remove('hidden');
      }
    });

    // 9. Sync between tabs with storage event
    window.addEventListener('storage', (e) => {
      if (e.key === STORAGE_POLLS) {
        renderPollsList();
      }
      if (e.key === STORAGE_NICK || e.key === STORAGE_MEMBER_AUTH) {
        updateUI();
      }
      if (e.key === STORAGE_DIRECTIVE) {
        renderDirective();
      }
    });
  });
</script>
