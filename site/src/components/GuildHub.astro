  adminLogoutBtn: TR('s97'),
};
---

<div class="guild-hub not-prose mx-auto max-w-5xl" data-lang={lang}>
  <!-- Top Beacon Banner -->
  <div class="mb-8 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-toxic-500/20 bg-stone-900/60 p-4 backdrop-blur-xl shadow-[0_0_30px_rgba(180,255,57,0.04)]">
    <div class="flex items-center gap-3">
      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-toxic-500/20 to-plague-500/20 border border-toxic-400/30 text-xl shadow-[0_0_15px_rgba(180,255,57,0.2)]">
        🛡️
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-mono font-bold tracking-widest text-toxic-400 uppercase">{T.restrictedBadge}</span>
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-toxic-400 animate-pulse"></span>
        </div>
        <h1 class="text-xl font-bold tracking-tight text-white">{T.hubTitle}</h1>
      </div>
    </div>

    <!-- Member Quick Bar (Always shown) -->
    <div id="gh-member-bar" class="flex flex-wrap items-center gap-3">
      <div class="flex items-center gap-2 rounded-xl border border-stone-800 bg-stone-950/80 px-3.5 py-1.5 text-sm">
        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-toxic-500/20 text-xs font-bold text-toxic-300">
          ⚔️
        </span>
        <div>
          <span class="text-stone-400 text-xs">{T.memberBadge}:</span>
          <strong id="gh-current-nick" class="ml-1 text-white font-semibold">{TR('s98')}</strong>
        </div>
        <span class="ml-1 rounded-full bg-toxic-500/20 px-1.5 py-0.5 text-[10px] font-mono text-toxic-300">
          ● {T.onlineStatus}
        </span>
      </div>

      <button
        id="gh-btn-set-nick"
        type="button"
        class="rounded-lg border border-toxic-500/40 bg-stone-900 px-3 py-1.5 text-xs font-bold text-toxic-300 hover:bg-toxic-500/20 hover:border-toxic-400 transition-colors cursor-pointer"
      >
        {TR('s99')}
      </button>

      <button
        id="gh-btn-change-nick"
        type="button"
        class="hidden rounded-lg border border-stone-700 bg-stone-800/80 px-3 py-1.5 text-xs font-medium text-stone-300 hover:border-stone-600 hover:text-white transition-colors cursor-pointer"
      >
        {T.changeNickBtn}
      </button>

      <button
        id="gh-btn-open-admin-from-bar"
        type="button"
        class="rounded-lg border border-stone-800 bg-stone-900 px-3 py-1.5 text-xs font-medium text-stone-400 hover:text-toxic-300 hover:border-toxic-500/40 transition-colors cursor-pointer"
      >
        {T.adminBtn}
      </button>
    </div>
  </div>

  <div id="gh-login-screen" class="hidden"></div>

  <!-- STATE 2: MAIN HUB CONTENT (Tabs: Polls & Battle Protocols) -->
  <div id="gh-main-content" class="space-y-6">
    <!-- Navigation Tabs -->
    <div class="flex border-b border-stone-800">
      <button
        id="gh-tab-btn-polls"
        type="button"
        class="relative flex items-center gap-2 border-b-2 border-toxic-400 px-5 py-3 text-sm font-bold text-white transition-colors cursor-pointer"
      >
        <span>🗳️ {T.tabPolls}</span>
        <span id="gh-polls-badge" class="rounded-full bg-toxic-500/20 px-2 py-0.5 text-xs font-mono text-toxic-300">3</span>
      </button>
      <button
        id="gh-tab-btn-intel"
        type="button"
        class="flex items-center gap-2 border-b-2 border-transparent px-5 py-3 text-sm font-medium text-stone-400 hover:text-stone-200 transition-colors cursor-pointer"
      >
        <span>📜 {T.tabIntel}</span>
      </button>
      <button
        id="gh-tab-btn-rsvp"
        type="button"
        class="flex items-center gap-2 border-b-2 border-transparent px-5 py-3 text-sm font-medium text-stone-400 hover:text-stone-200 transition-colors cursor-pointer"
      >
        <span>⚔️ {TR('s100')}</span>
        <span id="gh-rsvp-badge" class="rounded-full bg-toxic-500/20 px-2 py-0.5 text-xs font-mono text-toxic-300">0</span>
      </button>
    </div>

    <!-- TAB 1: POLLS VIEW -->
    <div id="gh-tab-view-polls" class="space-y-6">
      <!-- Actions Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-2xl border border-stone-800/80 bg-stone-900/40 p-5 backdrop-blur-md">
        <div>
          <h2 class="text-lg font-bold text-white tracking-tight">{T.pollsTitle}</h2>
          <p class="mt-1 text-xs sm:text-sm text-stone-400 leading-relaxed max-w-xl">{T.pollsSubtitle}</p>
        </div>
        <div class="flex items-center gap-2.5">
          <button
            id="gh-btn-open-create"
            type="button"
            class="flex items-center gap-1.5 rounded-xl bg-gradient-to-r from-toxic-400 to-plague-400 px-4 py-2.5 text-xs sm:text-sm font-bold text-black shadow-[0_0_20px_rgba(180,255,57,0.25)] hover:brightness-110 transition active:scale-95 cursor-pointer"
          >
            {T.newPollBtn}
          </button>
          <button
            id="gh-btn-manage-toggle"
            type="button"
            class="rounded-xl border border-stone-700 bg-stone-800/70 px-3 py-2.5 text-xs sm:text-sm font-medium text-stone-300 hover:text-white hover:border-stone-600 transition cursor-pointer"
          >
            {T.manageDataBtn}
          </button>
        </div>
      </div>

      <!-- Manage Drawer (hidden by default) -->
      <div id="gh-manage-drawer" class="hidden rounded-2xl border border-stone-800 bg-stone-950 p-4 space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-stone-800/80 pb-3 text-xs text-stone-400">
          <span>Хранилище данных опросов (LocalStorage + Cookies)</span>
          <span class="text-stone-500">Синхронизируется автоматически</span>
        </div>
        <div class="flex flex-wrap gap-2">
          <button
            id="gh-btn-export"
            type="button"
            class="rounded-lg border border-stone-700 bg-stone-900 px-3 py-1.5 text-xs font-medium text-stone-300 hover:text-white hover:bg-stone-800 cursor-pointer"
          >
            💾 {T.exportBtn}
          </button>
          <button
            id="gh-btn-import"
            type="button"
            class="rounded-lg border border-stone-700 bg-stone-900 px-3 py-1.5 text-xs font-medium text-stone-300 hover:text-white hover:bg-stone-800 cursor-pointer"
          >
            📂 {T.importBtn}
          </button>
          <button
            id="gh-btn-reset-polls"
            type="button"
            class="rounded-lg border border-red-900/60 bg-red-950/30 px-3 py-1.5 text-xs font-medium text-red-300 hover:bg-red-900/50 cursor-pointer"
          >
            🔄 {T.resetDataBtn}
          </button>
        </div>
      </div>

      <!-- CREATE POLL FORM MODAL / CARD -->
      <div id="gh-create-poll-modal" class="hidden rounded-2xl border border-toxic-500/30 bg-stone-950 p-6 shadow-2xl backdrop-blur-xl">
        <div class="mb-5 flex items-center justify-between border-b border-stone-800 pb-3">
          <h3 class="text-base font-bold text-white flex items-center gap-2">
            <span>✨ {T.createPollTitle}</span>
          </h3>
          <button id="gh-btn-close-create" type="button" class="text-stone-400 hover:text-white text-lg p-1 cursor-pointer">✕</button>
        </div>

        <form id="gh-create-poll-form" class="space-y-4">
          <div>
            <label class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-stone-300">
              {T.questionLabel} <span class="text-toxic-400">*</span>
            </label>
            <input
              id="gh-poll-question"
              type="text"
              required
              placeholder={T.questionPlaceholder}
              class="w-full rounded-xl border border-stone-700 bg-stone-900 px-4 py-2.5 text-sm text-stone-100 placeholder-stone-600 outline-none focus:border-toxic-400"
            />
          </div>

          <div>
            <label class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-stone-300">
              {T.descLabel}
            </label>
            <textarea
              id="gh-poll-desc"
              rows="2"
              placeholder={T.descPlaceholder}
              class="w-full rounded-xl border border-stone-700 bg-stone-900 px-4 py-2.5 text-sm text-stone-100 placeholder-stone-600 outline-none focus:border-toxic-400 resize-none"
            ></textarea>
          </div>

          <div>
            <div class="mb-1.5 flex items-center justify-between">
              <label class="text-xs font-semibold uppercase tracking-wider text-stone-300">
                {T.optionsLabel} <span class="text-toxic-400">*</span>
              </label>
              <span class="text-xs text-stone-500">Минимум 2 варианта</span>
            </div>
            <div id="gh-options-container" class="space-y-2">
              <!-- Options dynamically rendered by script -->
            </div>
            <button
              id="gh-btn-add-option"
              type="button"
              class="mt-2 inline-flex items-center gap-1.5 rounded-lg border border-stone-700/80 bg-stone-900/60 px-3 py-1.5 text-xs font-semibold text-toxic-300 hover:border-toxic-500/50 hover:bg-stone-800 transition cursor-pointer"
            >
              {T.addOptionBtn}
            </button>
          </div>

          <!-- Poll Settings -->
          <div class="rounded-xl border border-stone-800 bg-stone-900/40 p-3.5 space-y-3">
            <span class="block text-xs font-semibold uppercase tracking-wider text-stone-400">{T.pollTypeLabel}</span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <label class="flex items-center gap-2.5 rounded-lg border border-stone-800 bg-stone-950 p-2.5 cursor-pointer hover:border-stone-700">
                <input type="radio" name="pollType" value="single" checked class="accent-toxic-400" />
                <span class="text-xs font-medium text-stone-200">{T.typeSingle}</span>
              </label>
              <label class="flex items-center gap-2.5 rounded-lg border border-stone-800 bg-stone-950 p-2.5 cursor-pointer hover:border-stone-700">
                <input type="radio" name="pollType" value="multiple" class="accent-toxic-400" />
                <span class="text-xs font-medium text-stone-200">{T.typeMultiple}</span>
              </label>
            </div>

            <label class="flex items-center gap-2.5 cursor-pointer pt-1">
              <input id="gh-poll-show-voters" type="checkbox" checked class="rounded accent-toxic-400" />
              <span class="text-xs text-stone-300">{T.showVotersLabel}</span>
            </label>
          </div>

          <div class="flex items-center justify-end gap-3 pt-2">
            <button
              id="gh-btn-cancel-create"
              type="button"
              class="rounded-xl border border-stone-700 bg-stone-900 px-4 py-2.5 text-xs sm:text-sm font-semibold text-stone-300 hover:text-white transition cursor-pointer"
            >
              {T.cancelBtn}
            </button>
            <button
              type="submit"
              class="rounded-xl bg-toxic-400 px-5 py-2.5 text-xs sm:text-sm font-bold text-black shadow-[0_0_20px_rgba(180,255,57,0.3)] hover:bg-toxic-300 transition cursor-pointer"
            >
              {T.publishBtn}
            </button>
          </div>
        </form>
      </div>

      <!-- Polls List Container -->
      <div id="gh-polls-list" class="space-y-5">
        <!-- Rendered by JS -->
      </div>
    </div>

    <!-- TAB 2: BATTLE PROTOCOLS & DIRECTIVES -->
    <div id="gh-tab-view-intel" class="space-y-6">
      <div class="rounded-2xl border border-stone-800 bg-stone-900/60 p-6 backdrop-blur-md">
        <div class="mb-6">
          <div class="inline-flex items-center gap-1.5 rounded-md bg-toxic-950/80 border border-toxic-500/30 px-2.5 py-1 text-xs font-mono font-bold text-toxic-300 uppercase">
            ⚔️ {TR('s101')}
          </div>
          <h2 class="mt-2 text-xl font-bold text-white">{T.intelTitle}</h2>
          <p class="mt-1 text-sm text-stone-400">{T.intelSubtitle}</p>
        </div>

        <!-- Custom Command Directive Banner (Set by Admin) -->
        <div id="gh-directive-card" class="hidden mb-8 rounded-2xl border border-toxic-500/40 bg-gradient-to-r from-toxic-500/10 via-stone-950 to-stone-950 p-5 shadow-[0_0_25px_rgba(180,255,57,0.1)]">
          <div class="flex items-center justify-between gap-3 mb-2.5 pb-2 border-b border-toxic-500/20">
            <div class="flex items-center gap-2">
              <span class="text-base">📢</span>
              <h3 class="text-sm font-bold text-toxic-300 uppercase tracking-wider">Оперативная директива командования</h3>
            </div>
            <span id="gh-directive-time" class="text-[11px] font-mono text-stone-400">Активно</span>
          </div>
          <div id="gh-directive-text" class="text-sm text-stone-200 leading-relaxed whitespace-pre-wrap"></div>
        </div>

        <!-- Defense & Battle Protocols -->
        <div id="alliance-default-protocol" class="space-y-6 mb-8">
          <div>
            <h3 class="text-base font-bold text-toxic-300 flex items-center gap-2">
              <span>📋</span> {T.defaultIntelTitle}
            </h3>
            <p class="mt-1 text-xs text-stone-400">Общие директивы координации боевых действий альянса.</p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-xl border border-stone-800 bg-stone-950/60 p-4">
              <h4 class="text-sm font-bold text-stone-200 mb-2">{T.rallyOrderTitle}</h4>
              <ul class="space-y-2 text-xs text-stone-400 leading-relaxed">
                <li class="flex items-start gap-2">
                  <span class="text-toxic-400 font-bold">1.</span>
                  <span>{T.rally1}</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-toxic-400 font-bold">2.</span>
                  <span>{T.rally2}</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-toxic-400 font-bold">3.</span>
                  <span>{T.rally3}</span>
                </li>
              </ul>
            </div>

            <div class="rounded-xl border border-stone-800 bg-stone-950/60 p-4">
              <h4 class="text-sm font-bold text-stone-200 mb-2">{T.rotationTitle}</h4>
              <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                  <thead>
                    <tr class="border-b border-stone-800 text-stone-500 font-mono">
                      <th class="py-1.5 pr-2">{T.dayCol}</th>
                      <th class="py-1.5 px-2">{T.squadCol}</th>
                      <th class="py-1.5 pl-2">{T.missionCol}</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-stone-800/50 text-stone-300">
                    <tr>
                      <td class="py-2 pr-2 font-mono text-toxic-400">Сб 19:00</td>
                      <td class="py-2 px-2 font-semibold">Alpha Squad</td>
                      <td class="py-2 pl-2">Штурм Бастиона KvK</td>
                    </tr>
                    <tr>
                      <td class="py-2 pr-2 font-mono text-toxic-400">Вс 20:00</td>
                      <td class="py-2 px-2 font-semibold">Bravo Squad</td>
                      <td class="py-2 pl-2">Зачистка Реликвии</td>
                    </tr>
                    <tr>
                      <td class="py-2 pr-2 font-mono text-stone-500">Пн-Пт</td>
                      <td class="py-2 px-2 font-semibold text-stone-400">All Squads</td>
                      <td class="py-2 pl-2 text-stone-400">Подготовка и фарм</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ADMIN PANEL MODAL -->
  <div id="gh-admin-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-black/80 backdrop-blur-md">
    <div class="w-full max-w-xl max-h-[90vh] overflow-y-auto rounded-3xl border border-toxic-500/40 bg-stone-950 p-6 sm:p-8 shadow-2xl">
      <!-- Modal Header -->
      <div class="mb-6 flex items-center justify-between border-b border-stone-800 pb-4">
        <div class="flex items-center gap-2.5">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-toxic-500/20 text-lg border border-toxic-400/40">⚙️</span>
          <div>
            <h3 class="text-lg font-bold text-white tracking-tight">{T.adminModalTitle}</h3>
            <span class="text-xs font-mono text-toxic-400">Superuser / Officer Mode</span>
          </div>
        </div>
        <button id="gh-btn-close-admin-modal" type="button" class="text-stone-400 hover:text-white text-xl p-1 cursor-pointer">✕</button>
      </div>

      <!-- ADMIN LOGIN VIEW (if not authed as admin) -->
      <div id="gh-admin-login-view" class="space-y-4">
        <div class="rounded-xl border border-stone-800 bg-stone-900/60 p-4">
          <h4 class="text-sm font-bold text-white mb-1">{T.adminLoginPrompt}</h4>
          <p class="text-xs text-stone-400 leading-relaxed">{T.adminLoginDesc}</p>
        </div>
        <form id="gh-admin-login-form" class="space-y-4">
          <div>
            <label for="gh-admin-master-input" class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-stone-300">
              {T.adminMasterPassLabel}
            </label>
            <input
              id="gh-admin-master-input"
              type="password"
              required
              placeholder={T.adminMasterPassPlaceholder}
              class="w-full rounded-xl border border-stone-700 bg-stone-900 px-4 py-3 text-stone-100 placeholder-stone-600 outline-none focus:border-toxic-400 font-medium"
            />
            <p id="gh-admin-login-error" class="mt-2 hidden text-xs font-medium text-red-400"></p>
          </div>
          <button
            type="submit"
            class="w-full rounded-xl bg-toxic-400 py-3 text-sm font-bold text-black shadow-[0_0_20px_rgba(180,255,57,0.25)] hover:bg-toxic-300 transition cursor-pointer"
          >
            {T.adminLoginBtn}
          </button>
        </form>
      </div>

      <!-- ADMIN DASHBOARD (after admin login) -->
      <div id="gh-admin-dashboard" class="hidden space-y-6">
        <!-- 1. Member Password Config -->
        <div class="rounded-2xl border border-stone-800 bg-stone-900/50 p-5 space-y-3">
