---
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const isRu = lang === 'ru';

const T = {
  restrictedBadge: isRu ? 'ЗАКРЫТЫЙ СЕКТОР АЛЬЯНСА' : 'RESTRICTED ALLIANCE SECTOR',
  hubTitle: isRu ? 'Штаб гильдии DND' : 'DND Guild Headquarters',
  hubSubtitle: isRu
    ? 'Координация альянса, тактические голосования и секретные военные директивы.'
    : 'Alliance coordination, tactical polls, and classified battle directives.',
  enterNickTitle: isRu ? 'Доступ в штаб DND' : 'DND Headquarters Access',
  enterNickDesc: isRu
    ? 'Для входа в закрытый сектор введите пароль альянса и ваш игровой никнейм.'
    : 'Enter alliance access password and your in-game nickname to enter restricted sector.',
  passLabel: isRu ? 'Пароль доступа альянса' : 'Alliance Access Password',
  passPlaceholder: isRu ? 'Введите пароль альянса...' : 'Enter alliance password...',
  nickPlaceholder: isRu ? 'Ваш игровой ник (например: Viper_99)' : 'Your in-game nickname (e.g. Viper_99)',
  nickLabel: isRu ? 'Игровой никнейм' : 'In-game nickname',
  enterBtn: isRu ? 'Войти в штаб →' : 'Enter Headquarters →',
  showPassBtn: isRu ? 'Показать' : 'Show',
  hidePassBtn: isRu ? 'Скрыть' : 'Hide',
  wrongPassMember: isRu
    ? 'Неверный пароль альянса. Обратитесь к офицерам или лидеру.'
    : 'Invalid alliance password. Contact your officers or leader.',
  nickCookieNote: isRu
    ? 'Авторизация и никнейм сохраняются в браузере для подтверждения ваших голосов.'
    : 'Authorization and nickname are saved in browser cookies to verify your votes.',
  memberBadge: isRu ? 'Боец альянса' : 'Alliance Member',
  onlineStatus: isRu ? 'В сети' : 'Online',
  changeNickBtn: isRu ? 'Сменить ник' : 'Change Nick',
  logoutBtn: isRu ? 'Выйти' : 'Log out',
  adminBtn: isRu ? '⚙️ Админка' : '⚙️ Admin',
  tabPolls: isRu ? 'Голосования' : 'Polls & Votes',
  tabIntel: isRu ? 'Военные протоколы (DND)' : 'Classified Intel (DND)',
  pollsTitle: isRu ? 'Тактические голосования' : 'Tactical Polls',
  pollsSubtitle: isRu
    ? 'Принимайте решения вместе с альянсом. Голосуйте за цели KvK, расписание сборов и приоритеты.'
    : 'Make decisions together with the alliance. Vote on KvK objectives, rally schedules, and priorities.',
  newPollBtn: isRu ? '+ Новое голосование' : '+ Create Poll',
  manageDataBtn: isRu ? 'Управление' : 'Data',
  createPollTitle: isRu ? 'Создание голосования' : 'Create New Poll',
  questionLabel: isRu ? 'Тема или вопрос голосования' : 'Poll topic or question',
  questionPlaceholder: isRu ? 'Например: Какой форт штурмуем в первую волну KvK?' : 'E.g.: Which fort should we attack in wave 1 of KvK?',
  descLabel: isRu ? 'Пояснение / контекст (необязательно)' : 'Description / context (optional)',
  descPlaceholder: isRu ? 'Укажите важные детали или тайминги для соклановцев...' : 'Add details or timing notes for clan members...',
  optionsLabel: isRu ? 'Варианты ответов' : 'Answer Options',
  optionPlaceholder: isRu ? 'Вариант ответа' : 'Option text',
  addOptionBtn: isRu ? '+ Добавить вариант' : '+ Add Option',
  pollTypeLabel: isRu ? 'Тип голосования' : 'Vote Type',
  typeSingle: isRu ? 'Один вариант (Single choice)' : 'Single choice',
  typeMultiple: isRu ? 'Несколько вариантов (Multiple choice)' : 'Multiple choice',
  showVotersLabel: isRu ? 'Показывать никнеймы проголосовавших' : 'Show voter nicknames',
  publishBtn: isRu ? 'Опубликовать голосование' : 'Publish Poll',
  cancelBtn: isRu ? 'Отмена' : 'Cancel',
  voteBtn: isRu ? 'Проголосовать' : 'Submit Vote',
  changeVoteBtn: isRu ? 'Изменить голос' : 'Change Vote',
  yourVoteBadge: isRu ? '✓ Ваш выбор' : '✓ Your vote',
  totalVotes: isRu ? 'Всего голосов' : 'Total votes',
  votersLabel: isRu ? 'Проголосовали' : 'Voters',
  shareBtn: isRu ? 'Поделиться' : 'Share',
  shareCopied: isRu ? '✓ Ссылка скопирована!' : '✓ Link copied!',
  closePollBtn: isRu ? 'Завершить' : 'Close',
  reopenPollBtn: isRu ? 'Возобновить' : 'Reopen',
  deletePollBtn: isRu ? 'Удалить' : 'Delete',
  pollClosedBadge: isRu ? 'Завершено' : 'Closed',
  pollActiveBadge: isRu ? 'Активно' : 'Active',
  noPolls: isRu ? 'Пока нет голосований. Создайте первое!' : 'No polls yet. Create the first one!',
  resetDataBtn: isRu ? 'Сбросить к исходным' : 'Reset to defaults',
  exportBtn: isRu ? 'Экспорт JSON' : 'Export JSON',
  importBtn: isRu ? 'Импорт JSON' : 'Import JSON',
  intelTitle: isRu ? 'Секретный архив альянса' : 'Alliance Classified Intel',
  intelSubtitle: isRu
    ? 'Шифрованные военные протоколы, распределение ролей и инструкции лидеров.'
    : 'Encrypted battle protocols, role assignments, and leadership directives.',
  decryptTitle: isRu ? 'Дешифрование архива' : 'Decrypt Archive',
  decryptDesc: isRu
    ? 'Архив зашифрован AES-256-GCM. Введите секретную кодовую фразу альянса для расшифровки.'
    : 'Archive is encrypted with AES-256-GCM. Enter the alliance secret passphrase to decrypt.',
  passphrasePlaceholder: isRu ? 'Кодовая фраза альянса' : 'Alliance passphrase',
  unlockBtn: isRu ? 'Расшифровать' : 'Decrypt',
  wrongPassErr: isRu ? 'Неверная кодовая фраза или файл архива отсутствует.' : 'Wrong passphrase or archive payload is missing.',
  defaultIntelTitle: isRu ? 'Базовый протокол обороны альянса' : 'Standard Alliance Defense Protocol',
  rallyOrderTitle: isRu ? 'Порядок сбора (Rally order)' : 'Rally Order',
  rally1: isRu ? '1. Разведчики отмечают цель и докладывают состав гарнизона' : '1. Scouts identify target and report garrison composition',
  rally2: isRu ? '2. Первыми слот заполняют танки и защитные герои (Arthur, Daskal)' : '2. Tanks and defensive heroes fill first (Arthur, Daskal)',
  rally3: isRu ? '3. Основной урон и поддержка закрывают строй (Marlena, Claire, Harper)' : '3. High DPS and support close the ranks (Marlena, Claire, Harper)',
  rotationTitle: isRu ? 'График дежурств на KvK' : 'KvK Shift Schedule',
  dayCol: isRu ? 'День / Время' : 'Day / Time',
  squadCol: isRu ? 'Отряд' : 'Squad',
  missionCol: isRu ? 'Задача' : 'Objective',
  // Admin Panel strings
  adminModalTitle: isRu ? 'Панель управления альянса DND' : 'DND Alliance Admin Panel',
  adminLoginPrompt: isRu ? 'Вход для администратора' : 'Admin Login',
  adminLoginDesc: isRu ? 'Введите мастер-пароль администратора для управления доступом и опросами.' : 'Enter admin master password to manage access and polls.',
  adminMasterPassLabel: isRu ? 'Мастер-пароль администратора' : 'Admin Master Password',
  adminMasterPassPlaceholder: isRu ? 'Пароль администратора...' : 'Admin password...',
  adminLoginBtn: isRu ? 'Войти в панель →' : 'Enter Admin Panel →',
  adminWrongPass: isRu ? 'Неверный пароль администратора.' : 'Invalid admin password.',
  adminSecPassTitle: isRu ? '🔑 1. Пароль доступа для участников (/dnd)' : '🔑 1. Member Access Password (/dnd)',
  adminCurrentPassLabel: isRu ? 'Текущий пароль:' : 'Current password:',
  adminNewPassPlaceholder: isRu ? 'Новый пароль альянса...' : 'New alliance password...',
  adminSavePassBtn: isRu ? 'Сохранить новый пароль' : 'Save New Password',
  adminShareInviteTitle: isRu ? '🔗 Ссылка с авто-входом для соклановцев' : '🔗 Auto-login link for clan members',
  adminCopyInviteBtn: isRu ? 'Копировать ссылку с паролем' : 'Copy link with password',
  adminSecMasterTitle: isRu ? '🛡️ 2. Смена мастер-пароля администратора' : '🛡️ 2. Change Admin Master Password',
  adminNewMasterPlaceholder: isRu ? 'Новый пароль админа...' : 'New admin password...',
  adminSaveMasterBtn: isRu ? 'Обновить пароль админа' : 'Update Admin Password',
  adminSecDirectiveTitle: isRu ? '📢 3. Оперативная директива альянса' : '📢 3. Tactical Alliance Directive',
  adminDirectiveDesc: isRu ? 'Этот приказ сразу отображается всем бойцам во вкладке «Военные протоколы».' : 'This directive is immediately displayed to all members in Classified Intel tab.',
  adminDirectivePlaceholder: isRu ? 'Внимание альянсу! В субботу в 19:00 сбор на форт...' : 'Attention alliance! Saturday 19:00 rally for fort...',
  adminSaveDirectiveBtn: isRu ? 'Опубликовать директиву' : 'Publish Directive',
  adminCloseModalBtn: isRu ? '✕ Закрыть' : '✕ Close',
  adminLogoutBtn: isRu ? 'Выйти из админки' : 'Logout Admin',
};
---

<div class="guild-hub not-prose mx-auto max-w-5xl" data-lang={lang}>
  <!-- Top Beacon Banner -->
  <div class="mb-8 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-toxic-500/20 bg-stone-900/60 p-4 backdrop-blur-xl shadow-[0_0_30px_rgba(180,255,57,0.04)]">
    <div class="flex items-center gap-3">
      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-toxic-500/20 to-plague-500/20 border border-toxic-400/30 text-xl shadow-[0_0_15px_rgba(180,255,57,0.2)]">
        🛡️
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-mono font-bold tracking-widest text-toxic-400 uppercase">{T.restrictedBadge}</span>
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-toxic-400 animate-pulse"></span>
        </div>
        <h1 class="text-xl font-bold tracking-tight text-white">{T.hubTitle}</h1>
      </div>
    </div>

    <!-- Authorized Member Quick Bar (Shown when logged in) -->
    <div id="gh-member-bar" class="hidden flex flex-wrap items-center gap-3">
      <div class="flex items-center gap-2 rounded-xl border border-stone-800 bg-stone-950/80 px-3.5 py-1.5 text-sm">
        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-toxic-500/20 text-xs font-bold text-toxic-300">
          ⚔️
        </span>
        <div>
          <span class="text-stone-400 text-xs">{T.memberBadge}:</span>
          <strong id="gh-current-nick" class="ml-1 text-white font-semibold">...</strong>
        </div>
        <span class="ml-1 rounded-full bg-toxic-500/20 px-1.5 py-0.5 text-[10px] font-mono text-toxic-300">
          ● {T.onlineStatus}
        </span>
      </div>

      <button
        id="gh-btn-open-admin-from-bar"
        type="button"
        class="rounded-lg border border-toxic-500/40 bg-stone-900 px-3 py-1.5 text-xs font-bold text-toxic-300 hover:bg-toxic-500/20 hover:border-toxic-400 transition-colors cursor-pointer"
      >
        {T.adminBtn}
      </button>

      <button
        id="gh-btn-change-nick"
        type="button"
        class="rounded-lg border border-stone-700 bg-stone-800/80 px-3 py-1.5 text-xs font-medium text-stone-300 hover:border-stone-600 hover:text-white transition-colors cursor-pointer"
      >
        {T.changeNickBtn}
      </button>

      <button
        id="gh-btn-logout"
        type="button"
        class="rounded-lg border border-stone-800 bg-stone-900/60 px-3 py-1.5 text-xs font-medium text-stone-400 hover:border-red-800/50 hover:text-red-400 transition-colors cursor-pointer"
      >
        {T.logoutBtn}
      </button>
    </div>
  </div>

  <!-- STATE 1: LOGIN / ENTER PASSWORD & NICKNAME (When not authorized) -->
  <div id="gh-login-screen" class="hidden">
    <div class="mx-auto max-w-lg rounded-3xl border border-stone-800 bg-gradient-to-b from-stone-900/95 to-stone-950 p-8 shadow-2xl backdrop-blur-xl">
      <div class="mb-6 text-center">
        <div class="mx-auto mb-3 flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-toxic-500/20 to-plague-600/20 border border-toxic-400/40 text-3xl shadow-[0_0_25px_rgba(180,255,57,0.2)]">
          🛡️
        </div>
        <div class="inline-block rounded-full bg-toxic-500/10 border border-toxic-500/30 px-3 py-0.5 text-[11px] font-mono text-toxic-300 uppercase tracking-widest mb-2">
          {T.restrictedBadge}
        </div>
        <h2 class="text-2xl font-bold tracking-tight text-white">{T.enterNickTitle}</h2>
        <p class="mt-2 text-sm leading-relaxed text-stone-400">{T.enterNickDesc}</p>
      </div>

      <form id="gh-login-form" class="space-y-4">
        <!-- Alliance Access Password Field -->
        <div id="gh-group-pass">
          <label for="gh-input-pass" class="mb-1.5 flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-stone-300">
            <span>{T.passLabel} <span class="text-toxic-400">*</span></span>
            <button type="button" id="gh-toggle-pwd-btn" class="text-[11px] text-stone-400 hover:text-toxic-300 transition cursor-pointer">
              👁️ {T.showPassBtn}
            </button>
          </label>
          <input
            id="gh-input-pass"
            type="password"
            required
            autocomplete="current-password"
            placeholder={T.passPlaceholder}
            class="w-full rounded-xl border border-stone-700 bg-stone-950 px-4 py-3 text-stone-100 placeholder-stone-600 outline-none transition focus:border-toxic-400 focus:ring-1 focus:ring-toxic-400 font-medium"
          />
        </div>

        <!-- Nickname Field -->
        <div id="gh-group-nick">
          <label for="gh-input-nick" class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-stone-300">
            {T.nickLabel} <span class="text-toxic-400">*</span>
          </label>
          <input
            id="gh-input-nick"
            type="text"
            required
            minlength="2"
            maxlength="32"
            autocomplete="nickname"
            placeholder={T.nickPlaceholder}
            class="w-full rounded-xl border border-stone-700 bg-stone-950 px-4 py-3 text-stone-100 placeholder-stone-600 outline-none transition focus:border-toxic-400 focus:ring-1 focus:ring-toxic-400 font-medium"
          />
        </div>

        <p id="gh-login-error" class="hidden rounded-lg bg-red-950/60 border border-red-800/60 p-2.5 text-center text-xs font-medium text-red-300"></p>

        <button
          type="submit"
          class="w-full rounded-xl bg-gradient-to-r from-plague-600 to-toxic-500 py-3.5 text-sm font-bold text-black shadow-[0_0_25px_rgba(180,255,57,0.3)] transition hover:brightness-110 active:scale-[0.99] cursor-pointer"
        >
          {T.enterBtn}
        </button>

        <div class="pt-3 border-t border-stone-800/80 flex flex-col items-center gap-2 text-center text-xs text-stone-500">
          <p>🔒 {T.nickCookieNote}</p>
          <button
            type="button"
            id="gh-btn-open-admin-from-login"
            class="mt-1 inline-flex items-center gap-1.5 rounded-lg border border-stone-800 bg-stone-900/60 px-3 py-1.5 text-xs text-stone-400 hover:text-toxic-300 hover:border-toxic-500/40 transition cursor-pointer"
          >
            {T.adminBtn}
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- STATE 2: MAIN HUB CONTENT (Tabs: Polls & Classified Intel) -->
  <div id="gh-main-content" class="hidden space-y-6">
    <!-- Navigation Tabs -->
    <div class="flex border-b border-stone-800">
      <button
        id="gh-tab-btn-polls"
        type="button"
        class="relative flex items-center gap-2 border-b-2 border-toxic-400 px-5 py-3 text-sm font-bold text-white transition-colors cursor-pointer"
      >
        <span>🗳️ {T.tabPolls}</span>
        <span id="gh-polls-badge" class="rounded-full bg-toxic-500/20 px-2 py-0.5 text-xs font-mono text-toxic-300">3</span>
      </button>
      <button
        id="gh-tab-btn-intel"
        type="button"
        class="flex items-center gap-2 border-b-2 border-transparent px-5 py-3 text-sm font-medium text-stone-400 hover:text-stone-200 transition-colors cursor-pointer"
      >
        <span>📜 {T.tabIntel}</span>
      </button>
    </div>

    <!-- TAB 1: POLLS VIEW -->
    <div id="gh-tab-view-polls" class="space-y-6">
      <!-- Actions Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-2xl border border-stone-800/80 bg-stone-900/40 p-5 backdrop-blur-md">
        <div>
          <h2 class="text-lg font-bold text-white tracking-tight">{T.pollsTitle}</h2>
          <p class="mt-1 text-xs sm:text-sm text-stone-400 leading-relaxed max-w-xl">{T.pollsSubtitle}</p>
        </div>
        <div class="flex items-center gap-2.5">
          <button
            id="gh-btn-open-create"
            type="button"
            class="flex items-center gap-1.5 rounded-xl bg-gradient-to-r from-toxic-400 to-plague-400 px-4 py-2.5 text-xs sm:text-sm font-bold text-black shadow-[0_0_20px_rgba(180,255,57,0.25)] hover:brightness-110 transition active:scale-95 cursor-pointer"
          >
            {T.newPollBtn}
          </button>
          <button
            id="gh-btn-manage-toggle"
            type="button"
            class="rounded-xl border border-stone-700 bg-stone-800/70 px-3 py-2.5 text-xs sm:text-sm font-medium text-stone-300 hover:text-white hover:border-stone-600 transition cursor-pointer"
          >
            {T.manageDataBtn}
          </button>
        </div>
      </div>

      <!-- Manage Drawer (hidden by default) -->
      <div id="gh-manage-drawer" class="hidden rounded-2xl border border-stone-800 bg-stone-950 p-4 space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-stone-800/80 pb-3 text-xs text-stone-400">
          <span>Хранилище данных опросов (LocalStorage + Cookies)</span>
          <span class="text-stone-500">Синхронизируется автоматически</span>
        </div>
        <div class="flex flex-wrap gap-2">
          <button
            id="gh-btn-export"
            type="button"
            class="rounded-lg border border-stone-700 bg-stone-900 px-3 py-1.5 text-xs font-medium text-stone-300 hover:text-white hover:bg-stone-800 cursor-pointer"
          >
            💾 {T.exportBtn}
          </button>
          <button
            id="gh-btn-import"
            type="button"
            class="rounded-lg border border-stone-700 bg-stone-900 px-3 py-1.5 text-xs font-medium text-stone-300 hover:text-white hover:bg-stone-800 cursor-pointer"
          >
            📂 {T.importBtn}
          </button>
          <button
            id="gh-btn-reset-polls"
            type="button"
            class="rounded-lg border border-red-900/60 bg-red-950/30 px-3 py-1.5 text-xs font-medium text-red-300 hover:bg-red-900/50 cursor-pointer"
          >
            🔄 {T.resetDataBtn}
          </button>
        </div>
      </div>

      <!-- CREATE POLL FORM MODAL / CARD -->
      <div id="gh-create-poll-modal" class="hidden rounded-2xl border border-toxic-500/30 bg-stone-950 p-6 shadow-2xl backdrop-blur-xl">
        <div class="mb-5 flex items-center justify-between border-b border-stone-800 pb-3">
          <h3 class="text-base font-bold text-white flex items-center gap-2">
            <span>✨ {T.createPollTitle}</span>
          </h3>
          <button id="gh-btn-close-create" type="button" class="text-stone-400 hover:text-white text-lg p-1 cursor-pointer">✕</button>
        </div>

        <form id="gh-create-poll-form" class="space-y-4">
          <div>
            <label class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-stone-300">
              {T.questionLabel} <span class="text-toxic-400">*</span>
            </label>
            <input
              id="gh-poll-question"
              type="text"
              required
              placeholder={T.questionPlaceholder}
              class="w-full rounded-xl border border-stone-700 bg-stone-900 px-4 py-2.5 text-sm text-stone-100 placeholder-stone-600 outline-none focus:border-toxic-400"
            />
          </div>

          <div>
            <label class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-stone-300">
              {T.descLabel}
            </label>
            <textarea
              id="gh-poll-desc"
              rows="2"
              placeholder={T.descPlaceholder}
              class="w-full rounded-xl border border-stone-700 bg-stone-900 px-4 py-2.5 text-sm text-stone-100 placeholder-stone-600 outline-none focus:border-toxic-400 resize-none"
            ></textarea>
          </div>

          <div>
            <div class="mb-1.5 flex items-center justify-between">
              <label class="text-xs font-semibold uppercase tracking-wider text-stone-300">
                {T.optionsLabel} <span class="text-toxic-400">*</span>
              </label>
              <span class="text-xs text-stone-500">Минимум 2 варианта</span>
            </div>
            <div id="gh-options-container" class="space-y-2">
              <!-- Options dynamically rendered by script -->
            </div>
            <button
              id="gh-btn-add-option"
              type="button"
              class="mt-2 inline-flex items-center gap-1.5 rounded-lg border border-stone-700/80 bg-stone-900/60 px-3 py-1.5 text-xs font-semibold text-toxic-300 hover:border-toxic-500/50 hover:bg-stone-800 transition cursor-pointer"
            >
              {T.addOptionBtn}
            </button>
          </div>

          <!-- Poll Settings -->
          <div class="rounded-xl border border-stone-800 bg-stone-900/40 p-3.5 space-y-3">
            <span class="block text-xs font-semibold uppercase tracking-wider text-stone-400">{T.pollTypeLabel}</span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <label class="flex items-center gap-2.5 rounded-lg border border-stone-800 bg-stone-950 p-2.5 cursor-pointer hover:border-stone-700">
                <input type="radio" name="pollType" value="single" checked class="accent-toxic-400" />
                <span class="text-xs font-medium text-stone-200">{T.typeSingle}</span>
              </label>
              <label class="flex items-center gap-2.5 rounded-lg border border-stone-800 bg-stone-950 p-2.5 cursor-pointer hover:border-stone-700">
                <input type="radio" name="pollType" value="multiple" class="accent-toxic-400" />
                <span class="text-xs font-medium text-stone-200">{T.typeMultiple}</span>
              </label>
            </div>

            <label class="flex items-center gap-2.5 cursor-pointer pt-1">
              <input id="gh-poll-show-voters" type="checkbox" checked class="rounded accent-toxic-400" />
