    general_btn: '割引ショッピング ↗',
  },
};
const Lpick = (k: string, ru: string, en: string): string =>
  lang === 'ru' ? ru : ((STR as any)[lang]?.[k] ?? en);

const variants = {
  marlena: {
    icon: '⚡',
    title: Lpick('marlena_title', 'Стартовый набор Марлены ($1) со скидкой', 'Marlena $1 Starter Pack Discount'),
    desc: Lpick('marlena_desc', 'Лучший старт в игре: мгновенное получение UR-героя Марлены, алмазы и ускорения через партнёра LDShop по игровому UID без пароля.', 'The undisputed best value in Last Asylum: get UR hero Marlena, bonus diamonds, and speedups via partner LDShop using your UID.'),
    btn: Lpick('marlena_btn', 'Забрать набор на LDShop ↗', 'Claim Pack on LDShop ↗'),
  },
  speedup: {
    icon: '🏗️',
    title: Lpick('speedup_title', 'Ускорения строительства и алмазы со скидкой до 20%', 'Construction Speedups & Diamonds up to 20% Off'),
    desc: Lpick('speedup_desc', 'Не хватает ресурсов или времени до закрытия этапа Святилища? Забирайте алмазы с бонусом x2 на первый платёж на LDShop.', 'Pushing Sanctuary to level 25–30? Top-up diamonds and construction packs with instant delivery by UID on LDShop.'),
    btn: Lpick('speedup_btn', 'Открыть магазин со скидкой ↗', 'Open Store with Discount ↗'),
  },
  gear: {
    icon: '⚔️',
    title: Lpick('gear_title', 'Материалы снаряжения и призывы', 'Gear Materials & Recruit Tickets'),
    desc: Lpick('gear_desc', 'Камни снаряжения, чертежи UR и билеты призыва по выгодным ценам с моментальной доставкой на ваш игровой аккаунт.', 'Gearstones, UR blueprints, and recruitment tickets at competitive rates with instant UID delivery.'),
    btn: Lpick('gear_btn', 'Перейти к покупкам ↗', 'Browse Materials ↗'),
  },
  general: {
    icon: '💎',
    title: Lpick('general_title', 'Магазин валюты со скидкой — LDShop', 'Discounted Currency Store — LDShop'),
    desc: Lpick('general_desc', 'Алмазы, боевые пропуска и наборы с моментальной доставкой по UID и скидками до 20%. Поддержите проект без дополнительных затрат!', 'Diamonds, battle passes, and starter packs delivered instantly via UID with discounts up to 20%. Support the fan hub at zero extra cost!'),
    btn: Lpick('general_btn', 'Магазин со скидкой ↗', 'Shop with Discount ↗'),
  },
};

const v = variants[variant] || variants.general;
---

<div class="not-prose my-8 overflow-hidden rounded-2xl border border-toxic-500/30 bg-gradient-to-r from-toxic-950/30 via-stone-900/90 to-stone-950 p-5 shadow-lg backdrop-blur-xl">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div class="flex items-start gap-3.5">
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-toxic-500/15 border border-toxic-400/30 text-2xl shadow-[0_0_15px_rgba(180,255,57,0.15)]">
        {v.icon}
      </span>
      <div>
        <div class="flex items-center gap-2">
          <span class="rounded bg-toxic-500/20 px-2 py-0.5 font-mono text-[10px] font-bold text-toxic-300">
            LDSHOP PARTNER
          </span>
          <span class="text-[10px] text-stone-500 font-mono">UID ONLY</span>
        </div>
        <h4 class="mt-1 text-sm sm:text-base font-bold text-white tracking-tight">
          {v.title}
        </h4>
        <p class="mt-1 text-xs text-stone-400 leading-relaxed max-w-xl">
          {v.desc}
        </p>
      </div>
    </div>

    <a
      href={AFF_LINK}
      target="_blank"
      rel="noopener noreferrer"
      class="shrink-0 w-full sm:w-auto inline-flex items-center justify-center gap-1.5 rounded-xl bg-toxic-400 px-5 py-2.5 text-xs sm:text-sm font-bold text-black hover:bg-toxic-300 hover:shadow-[0_0_20px_rgba(180,255,57,0.3)] transition cursor-pointer"
    >
      <span>{v.btn}</span>
    </a>
  </div>
</div>
