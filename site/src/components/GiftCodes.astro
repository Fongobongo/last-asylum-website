const labels = dict[lang] ?? dict.en;
const activeCodes = giftCodes.filter((c) => c.active);
const allActiveCodesText = activeCodes.map((c) => c.code).join("\n");
---

<div class="not-prose my-6 space-y-6">
  <!-- Status and Quick Actions Bar -->
  <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-stone-800 bg-stone-900/70 p-3.5 backdrop-blur">
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-toxic-400/10 px-2.5 py-1 text-xs font-semibold text-toxic-400 border border-toxic-400/30">
        <span class="h-1.5 w-1.5 rounded-full bg-toxic-400 animate-pulse"></span>
        {labels.verifiedToday}
      </span>
      <span class="text-xs text-stone-400">
        <strong class="text-white font-mono">{activeCodes.length}</strong> {labels.activeCount}
      </span>
    </div>

    <button
      id="js-copy-all"
      type="button"
      data-all={allActiveCodesText}
      data-copied={labels.allCopied}
      data-default={labels.copyAll}
      class="inline-flex items-center justify-center rounded-lg border border-toxic-500/40 bg-stone-900 px-3.5 py-1.5 text-xs font-semibold text-toxic-300 hover:bg-toxic-500/20 hover:border-toxic-400 transition cursor-pointer shadow-[0_0_12px_rgba(180,255,57,0.1)]"
    >
      {labels.copyAll}
    </button>
  </div>

  <!-- Active Codes Grid -->
  <div class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3" id="codes-active">
    {activeCodes.map((c) => (
      <div data-code-card={c.code} data-home="active" class="group relative flex items-center justify-between gap-3 rounded-xl border border-toxic-500/30 bg-gradient-to-br from-toxic-500/10 to-transparent p-4 shadow-[0_4px_20px_rgba(0,0,0,0.3)] transition-all hover:border-toxic-400/60 hover:shadow-[0_0_24px_rgba(180,255,57,0.15)]">
        <div>
          <div class="flex items-center gap-2">
            <code class="font-mono text-lg font-bold tracking-wider text-toxic-400">{c.code}</code>
            <span class="inline-flex items-center rounded-full bg-toxic-400/20 px-2 py-0.5 text-[10px] font-semibold text-toxic-300">ACTIVE</span>
          </div>
          {c.note && <p class="mt-1 text-xs text-stone-300">{c.note}</p>}
          <p class="mt-0.5 text-[11px] font-mono text-stone-500">{c.date}</p>
          <div class="mt-2 flex items-center gap-1.5" data-code-votes={c.code}>
            <button
              type="button"
              class="js-code-vote inline-flex items-center gap-1 rounded-lg border border-white/10 bg-white/5 px-2 py-1 text-[11px] font-semibold text-stone-300 transition hover:border-toxic-400/60 hover:text-toxic-300 cursor-pointer"
              data-vote="yes"
              title={labels.worked}
            >
              👍 <span class="js-cv-yes-count font-mono">0</span>
            </button>
            <button
              type="button"
              class="js-code-vote inline-flex items-center gap-1 rounded-lg border border-white/10 bg-white/5 px-2 py-1 text-[11px] font-semibold text-stone-300 transition hover:border-red-400/60 hover:text-red-300 cursor-pointer"
              data-vote="no"
              title={labels.failed}
            >
              👎 <span class="js-cv-no-count font-mono">0</span>
            </button>
          </div>
        </div>
        <button
          class="js-copy inline-flex shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-stone-200 transition hover:bg-toxic-400 hover:text-black hover:border-toxic-400 cursor-pointer"
          data-code={c.code}
          data-label-copy={labels.copy}
          data-label-copied={labels.copied}
        >
          {labels.copy}
        </button>
      </div>
    ))}
  </div>

  <!-- Suggest a code -->
  <div
    id="codes-suggest"
    class="rounded-xl border border-white/10 bg-stone-900/60 p-4"
    data-msg-ok={labels.suggestOk}
    data-msg-dup={labels.suggestDup}
    data-msg-err={labels.suggestErr}
    data-need-more={labels.needMore}
    data-pending-badge={labels.pendingBadge}
    data-label-copy={labels.copy}
    data-label-copied={labels.copied}
  >
    <h3 class="text-sm font-bold text-white">➕ {labels.suggestTitle}</h3>
    <form id="js-suggest-form" class="mt-3 flex flex-col gap-2 sm:flex-row">
      <input
        id="js-suggest-code"
        type="text"
        maxlength="24"
        autocomplete="off"
        spellcheck="false"
        placeholder={labels.suggestCodePh}
        class="w-full sm:w-48 rounded-lg border border-white/10 bg-black/40 px-3 py-2 font-mono text-sm uppercase tracking-wider text-white placeholder:normal-case placeholder:font-sans placeholder:text-stone-500 focus:border-toxic-400/60 focus:outline-none"
      />
      <input
        id="js-suggest-note"
        type="text"
        maxlength="140"
        placeholder={labels.suggestNotePh}
        class="w-full flex-1 rounded-lg border border-white/10 bg-black/40 px-3 py-2 text-sm text-white placeholder:text-stone-500 focus:border-toxic-400/60 focus:outline-none"
      />
      <button
        type="submit"
        class="shrink-0 rounded-lg border border-toxic-500/40 bg-toxic-500/15 px-4 py-2 text-xs font-semibold text-toxic-300 hover:bg-toxic-500/25 transition cursor-pointer"
      >
        {labels.suggestBtn}
      </button>
    </form>
    <p id="js-suggest-msg" class="mt-2 hidden text-xs text-stone-400"></p>
  </div>

  <!-- New from players -->
  <section id="codes-new-wrap" class="hidden">
    <h3 class="text-sm font-bold text-white">🆕 {labels.sectionNew}</h3>
    <p class="mt-1 text-xs text-stone-400">{labels.sectionNewDesc}</p>
    <div class="mt-3 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3" id="codes-new"></div>
  </section>

  <!-- Probably expired -->
  <section id="codes-expired-wrap" class="hidden">
    <h3 class="text-sm font-bold text-white">⚠️ {labels.sectionExpired}</h3>
    <p class="mt-1 text-xs text-stone-400">{labels.sectionExpiredDesc}</p>
    <div class="mt-3 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3 opacity-80" id="codes-expired"></div>
  </section>

</div>

<script is:inline>
  (function() {
    async function copyToClipboard(text) {
      if (!text) return false;
      // Modern Clipboard API
      if (navigator.clipboard && window.isSecureContext) {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch (err) {
          console.warn("navigator.clipboard failed, attempting fallback", err);
        }
      }

      // Hidden textarea fallback
      try {
        const textarea = document.createElement("textarea");
        textarea.value = text;
        textarea.setAttribute("readonly", "");
        textarea.style.position = "fixed";
        textarea.style.left = "-9999px";
        textarea.style.top = "0";
        textarea.style.opacity = "0";
        document.body.appendChild(textarea);
        textarea.focus();
        textarea.select();
        textarea.setSelectionRange(0, textarea.value.length);
        const success = document.execCommand("copy");
        document.body.removeChild(textarea);
        return success;
      } catch (err) {
        console.error("execCommand fallback failed", err);
        return false;
      }
    }

    function initGiftCodes() {
      // Per-code votes: 👍 = code worked, 👎 = didn't (localStorage, per browser)
      var V = window.LAVotes;
      if (V) {
        document.querySelectorAll('[data-code-votes]').forEach(function (row) {
          if (row.dataset.votesBound === 'true') return;
          row.dataset.votesBound = 'true';
          var key = 'code:' + (row.dataset.codeVotes || '');
          var yesBtn = row.querySelector('[data-vote="yes"]');
          var noBtn = row.querySelector('[data-vote="no"]');
          var yesCount = row.querySelector('.js-cv-yes-count');
          var noCount = row.querySelector('.js-cv-no-count');
          var render = function (st) {
            if (yesCount) yesCount.textContent = String(st.likes);
            if (noCount) noCount.textContent = String(st.dislikes);
            if (yesBtn) yesBtn.classList.toggle('border-toxic-400', st.mine === 'yes');
            if (noBtn) noBtn.classList.toggle('border-red-400', st.mine === 'no');
          };
          render(V.read(key));
          V.subscribe(key, render);
          V.refresh(key);
          row.querySelectorAll('.js-code-vote').forEach(function (btn) {
            btn.addEventListener('click', function () {
              render(V.vote(key, btn.dataset.vote));
            });
          });
        });
      }

      // Individual Code Copy
      document.querySelectorAll(".js-copy").forEach(function(btn) {
        if (btn.dataset.bound === "true") return;
        btn.dataset.bound = "true";

        btn.addEventListener("click", async function() {
          const code = btn.dataset.code || "";
          const copiedLabel = btn.dataset.labelCopied || "✓ Copied";
          const copyLabel = btn.dataset.labelCopy || "Copy";

          const ok = await copyToClipboard(code);
          if (ok) {
            btn.textContent = copiedLabel;
            btn.classList.add("border-toxic-400", "text-toxic-300", "bg-toxic-500/10");
            setTimeout(function() {
              btn.textContent = copyLabel;
              btn.classList.remove("border-toxic-400", "text-toxic-300", "bg-toxic-500/10");
            }, 1500);
          } else {
            window.prompt("Код для копирования (Ctrl+C / Cmd+C):", code);
          }
        });
      });

      // Copy All Codes
      const copyAllBtn = document.getElementById("js-copy-all");
      if (copyAllBtn && copyAllBtn.dataset.bound !== "true") {
        copyAllBtn.dataset.bound = "true";
        copyAllBtn.addEventListener("click", async function() {
          const allText = copyAllBtn.dataset.all || "";
          const defaultLabel = copyAllBtn.dataset.default || "Copy All";
          const copiedLabel = copyAllBtn.dataset.copied || "✓ Copied!";

          const ok = await copyToClipboard(allText);
          if (ok) {
            copyAllBtn.textContent = copiedLabel;
            copyAllBtn.classList.add("bg-toxic-400", "text-black", "border-toxic-400");
            setTimeout(function() {
              copyAllBtn.textContent = defaultLabel;
              copyAllBtn.classList.remove("bg-toxic-400", "text-black", "border-toxic-400");
            }, 2000);
          } else {
            window.prompt("Коды для копирования (Ctrl+C / Cmd+C):", allText);
          }
        });
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initGiftCodes);
    } else {
      initGiftCodes();
    }
    document.addEventListener("astro:page-load", initGiftCodes);
  })();
</script>

<script is:inline>
  // Community codes: player suggestions + derived sections.
  // Active = builtin actives + approved suggestions, minus demoted.
  // Demoted (probably expired): likes >= 10 AND dislikes >= 2 * likes.
  (function () {
    var DEMOTE_LIKES = 10;
    var PROMOTE_LIKES = 5;

    function cfg() {
      return document.getElementById('codes-suggest');
    }
    function labels() {
      var el = cfg();
      return {
        needMore: (el && el.dataset.needMore) || '{n} more 👍 to keep',
        pendingBadge: (el && el.dataset.pendingBadge) || 'Unverified',
        copy: (el && el.dataset.labelCopy) || 'Copy',
        copied: (el && el.dataset.labelCopied) || '✓ Copied',
        msgOk: (el && el.dataset.msgOk) || 'Thanks!',
        msgDup: (el && el.dataset.msgDup) || 'Already listed.',
        msgErr: (el && el.dataset.msgErr) || 'Failed, try again.',
      };
    }

    function countsOf(code) {
      var V = window.LAVotes;
      if (!V) return { likes: 0, dislikes: 0, mine: null };
      return V.read('code:' + code);
    }

    function isDemoted(code) {
      var st = countsOf(code);
      return st.likes >= DEMOTE_LIKES && st.dislikes >= st.likes * 2;
    }

    function updateNeedMore(card, code) {
      var el = card.querySelector('.js-need-more');
      if (!el) return;
      var st = countsOf(code);
      var left = Math.max(0, PROMOTE_LIKES - st.likes);
      el.textContent = left > 0 ? labels().needMore.replace('{n}', String(left)) : '';
    }

    function layoutCodes() {
      var active = document.getElementById('codes-active');
      var fresh = document.getElementById('codes-new');
      var exp = document.getElementById('codes-expired');
      if (!active || !fresh || !exp) return;
      document.querySelectorAll('[data-code-card]').forEach(function (card) {
        var code = card.getAttribute('data-code-card') || '';
        var home = card.getAttribute('data-home') || 'active';
        updateNeedMore(card, code);
        var target = isDemoted(code) ? exp : home === 'new' ? fresh : active;
        if (card.parentNode !== target) target.appendChild(card);
      });
      var nw = document.getElementById('codes-new-wrap');
      var ex = document.getElementById('codes-expired-wrap');
      if (nw) nw.classList.toggle('hidden', fresh.children.length === 0);
      if (ex) ex.classList.toggle('hidden', exp.children.length === 0);
    }

    function esc(s) {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function cardHtml(s) {
      var pending = s.status === 'pending';
      return (
        '<div>' +
          '<div class="flex items-center gap-2">' +
            '<code class="font-mono text-lg font-bold tracking-wider text-toxic-400">' + esc(s.code) + '</code>' +
            (pending
              ? '<span class="inline-flex items-center rounded-full bg-amber-400/20 px-2 py-0.5 text-[10px] font-semibold text-amber-300">' + esc(labels().pendingBadge) + '</span>'
              : '<span class="inline-flex items-center rounded-full bg-toxic-400/20 px-2 py-0.5 text-[10px] font-semibold text-toxic-300">ACTIVE</span>') +
          '</div>' +
          (s.note ? '<p class="mt-1 text-xs text-stone-300">' + esc(s.note) + '</p>' : '') +
          '<p class="js-need-more mt-0.5 text-[11px] font-mono text-amber-300/80"></p>' +
          '<div class="mt-2 flex items-center gap-1.5" data-code-votes="' + esc(s.code) + '">' +
            '<button type="button" class="js-code-vote inline-flex items-center gap-1 rounded-lg border border-white/10 bg-white/5 px-2 py-1 text-[11px] font-semibold text-stone-300 transition hover:border-toxic-400/60 hover:text-toxic-300 cursor-pointer" data-vote="yes" title="👍">👍 <span class="js-cv-yes-count font-mono">' + s.likes + '</span></button>' +
            '<button type="button" class="js-code-vote inline-flex items-center gap-1 rounded-lg border border-white/10 bg-white/5 px-2 py-1 text-[11px] font-semibold text-stone-300 transition hover:border-red-400/60 hover:text-red-300 cursor-pointer" data-vote="no" title="👎">👎 <span class="js-cv-no-count font-mono">' + s.dislikes + '</span></button>' +
          '</div>' +
        '</div>' +
        '<button type="button" class="js-copy inline-flex shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-stone-200 transition hover:bg-toxic-400 hover:text-black hover:border-toxic-400 cursor-pointer" data-code="' + esc(s.code) + '" data-label-copy="' + esc(labels().copy) + '" data-label-copied="' + esc(labels().copied) + '">' + esc(labels().copy) + '</button>'
      );
    }

    function upsertCard(s) {
      var card = document.querySelector('[data-code-card="' + s.code + '"]');
      var home = s.status === 'pending' ? 'new' : 'active';
      if (!card) {
        card = document.createElement('div');
        card.setAttribute('data-code-card', s.code);
        card.setAttribute('data-origin', 'suggested');
        card.className = 'group relative flex items-center justify-between gap-3 rounded-xl border border-amber-400/30 bg-gradient-to-br from-amber-400/10 to-transparent p-4 shadow-[0_4px_20px_rgba(0,0,0,0.3)] transition-all hover:border-amber-300/60';
        card.innerHTML = cardHtml(s);
        bindCard(card);
      } else if (card.getAttribute('data-origin') !== 'suggested') {
        return card; // builtin card: never re-home from a suggestion row
      }
      card.setAttribute('data-home', home);
      return card;
    }

    function bindCard(card) {
      var V = window.LAVotes;
      var row = card.querySelector('[data-code-votes]');
      if (V && row && row.dataset.votesBound !== 'true') {
        row.dataset.votesBound = 'true';
        var key = 'code:' + (row.getAttribute('data-code-votes') || '');
        var yesBtn = row.querySelector('[data-vote="yes"]');
        var noBtn = row.querySelector('[data-vote="no"]');
        var yesCount = row.querySelector('.js-cv-yes-count');
        var noCount = row.querySelector('.js-cv-no-count');
        var render = function (st) {
          if (yesCount) yesCount.textContent = String(st.likes);
          if (noCount) noCount.textContent = String(st.dislikes);
          if (yesBtn) yesBtn.classList.toggle('border-toxic-400', st.mine === 'yes');
          if (noBtn) noBtn.classList.toggle('border-red-400', st.mine === 'no');
          layoutCodes();
        };
        render(V.read(key));
        V.subscribe(key, render);
        V.refresh(key);
        row.querySelectorAll('.js-code-vote').forEach(function (btn) {
          btn.addEventListener('click', function () {
            render(V.vote(key, btn.getAttribute('data-vote')));
            setTimeout(syncSuggestions, 800);
          });
        });
      }
      var copyBtn = card.querySelector('.js-copy');
      if (copyBtn && copyBtn.dataset.bound !== 'true') {
        copyBtn.dataset.bound = 'true';
        copyBtn.addEventListener('click', function () {
          var code = copyBtn.getAttribute('data-code') || '';
          var done = copyBtn.getAttribute('data-label-copied') || '✓ Copied';
          var idle = copyBtn.getAttribute('data-label-copy') || 'Copy';
          var t = document.createElement('textarea');
          t.value = code;
          t.style.position = 'fixed';
          t.style.left = '-9999px';
          document.body.appendChild(t);
          t.select();
          try { document.execCommand('copy'); } catch (e) {}
          document.body.removeChild(t);
          copyBtn.textContent = done;
          setTimeout(function () { copyBtn.textContent = idle; }, 1500);
        });
      }
    }

    function syncSuggestions() {
      fetch('/api/codes', { cache: 'no-store' })
        .then(function (r) {
          if (!r.ok) throw new Error('bad status');
          return r.json();
        })
        .then(function (data) {
          var list = (data && data.suggestions) || [];
          list.forEach(upsertCard);
          // A vote may have promoted a pending card — reconcile homes.
          // Builtin cards are never re-homed by suggestion rows.
          document.querySelectorAll('[data-code-card][data-origin="suggested"]').forEach(function (card) {
            var code = card.getAttribute('data-code-card');
            var found = list.find(function (s) { return s.code === code; });
            if (found) card.setAttribute('data-home', found.status === 'pending' ? 'new' : 'active');
          });
          layoutCodes();
        })
        .catch(function () {});
    }

    function knownCodes() {
      var set = {};
      document.querySelectorAll('[data-code-card]').forEach(function (card) {
        var c = (card.getAttribute('data-code-card') || '').toUpperCase();
        if (c) set[c] = true;
      });
      return set;
    }

    function initCommunity() {
      // Re-layout static cards once server counts arrive.
      var V = window.LAVotes;
      if (V) {
        document.querySelectorAll('[data-code-card]').forEach(function (card) {
          var code = card.getAttribute('data-code-card') || '';
          V.subscribe('code:' + code, layoutCodes);
        });
      }
      layoutCodes();
      syncSuggestions();

      var form = document.getElementById('js-suggest-form');
      if (form && !form.dataset.bound) {
        form.dataset.bound = 'true';
        form.addEventListener('submit', function (ev) {
          ev.preventDefault();
          var codeEl = document.getElementById('js-suggest-code');
          var noteEl = document.getElementById('js-suggest-note');
          var msg = document.getElementById('js-suggest-msg');
          var code = ((codeEl && codeEl.value) || '').trim().toUpperCase();
          var note = ((noteEl && noteEl.value) || '').trim().slice(0, 140);
          var show = function (text, ok) {
            if (!msg) return;
            msg.textContent = text;
            msg.classList.remove('hidden');
            msg.classList.toggle('text-toxic-300', !!ok);
            msg.classList.toggle('text-stone-400', !ok);
          };
          if (!/^[A-Z0-9]{3,24}$/.test(code)) {
            show(labels().msgErr, false);
            return;
          }
          if (knownCodes()[code]) {
            show(labels().msgDup, false);
            return;
          }
          var fp = '';
          try {
            var m = document.cookie.match(/lav_fp=([a-f0-9]{8})/);
            if (m) fp = m[1];
          } catch (e) {}
          fetch('/api/suggest', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ code: code, note: note, fp: fp }),
          })
            .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
            .then(function (res) {
              if (!res.ok && !res.d.duplicate) {
                show(res.d.error === 'too many suggestions, try tomorrow' ? res.d.error : labels().msgErr, false);
                return;
              }
              if (res.d.duplicate) {
                show(labels().msgDup, false);
                syncSuggestions();
                return;
              }
              show(labels().msgOk, true);
              if (codeEl) codeEl.value = '';
              if (noteEl) noteEl.value = '';
              syncSuggestions();
            })
            .catch(function () { show(labels().msgErr, false); });
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCommunity);
    } else {
      initCommunity();
    }
    document.addEventListener('astro:page-load', initCommunity);
  })();
</script>

