const labels = dict[lang] ?? dict.en;
const activeCodes = giftCodes.filter((c) => c.active);
const expiredCodes = giftCodes.filter((c) => !c.active);
const allActiveCodesText = activeCodes.map((c) => c.code).join("\n");
---

<div class="not-prose my-6 space-y-6">
  <!-- Status and Quick Actions Bar -->
  <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-stone-800 bg-stone-900/70 p-3.5 backdrop-blur">
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-toxic-400/10 px-2.5 py-1 text-xs font-semibold text-toxic-400 border border-toxic-400/30">
        <span class="h-1.5 w-1.5 rounded-full bg-toxic-400 animate-pulse"></span>
        {labels.verifiedToday}
      </span>
      <span class="text-xs text-stone-400">
        <strong class="text-white font-mono">{activeCodes.length}</strong> {labels.activeCount}
      </span>
    </div>

    <button
      id="js-copy-all"
      type="button"
      data-all={allActiveCodesText}
      data-copied={labels.allCopied}
      data-default={labels.copyAll}
      class="inline-flex items-center justify-center rounded-lg border border-toxic-500/40 bg-stone-900 px-3.5 py-1.5 text-xs font-semibold text-toxic-300 hover:bg-toxic-500/20 hover:border-toxic-400 transition cursor-pointer shadow-[0_0_12px_rgba(180,255,57,0.1)]"
    >
      {labels.copyAll}
    </button>
  </div>

  <!-- Active Codes Grid -->
  <div class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3" id="codes-active">
    {activeCodes.map((c) => (
      <div class="group relative flex items-center justify-between gap-3 rounded-xl border border-toxic-500/30 bg-gradient-to-br from-toxic-500/10 to-transparent p-4 shadow-[0_4px_20px_rgba(0,0,0,0.3)] transition-all hover:border-toxic-400/60 hover:shadow-[0_0_24px_rgba(180,255,57,0.15)]">
        <div>
          <div class="flex items-center gap-2">
            <code class="font-mono text-lg font-bold tracking-wider text-toxic-400">{c.code}</code>
            <span class="inline-flex items-center rounded-full bg-toxic-400/20 px-2 py-0.5 text-[10px] font-semibold text-toxic-300">ACTIVE</span>
          </div>
          {c.note && <p class="mt-1 text-xs text-stone-300">{c.note}</p>}
          <p class="mt-0.5 text-[11px] font-mono text-stone-500">{c.date}</p>
        </div>
        <button
          class="js-copy inline-flex shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-stone-200 transition hover:bg-toxic-400 hover:text-black hover:border-toxic-400 cursor-pointer"
          data-code={c.code}
          data-label-copy={labels.copy}
          data-label-copied={labels.copied}
        >
          {labels.copy}
        </button>
      </div>
    ))}
  </div>

  <!-- Expired Codes Accordion Toggle -->
  {expiredCodes.length > 0 && (
    <div class="rounded-xl border border-stone-800 bg-stone-950/40 p-3">
      <button
        id="js-toggle-expired"
        type="button"
        class="flex w-full items-center justify-between text-left text-xs font-semibold text-stone-400 hover:text-stone-200 transition cursor-pointer"
        data-show={labels.showExpired + ` (${expiredCodes.length})`}
        data-hide={labels.hideExpired}
      >
        <span class="flex items-center gap-2">
          <span>⏳</span>
          <span id="js-toggle-expired-label">{labels.showExpired} ({expiredCodes.length})</span>
        </span>
        <span id="js-toggle-expired-icon" class="text-stone-500 text-sm transition-transform duration-200">▼</span>
      </button>

      <div id="js-expired-container" class="hidden mt-3 pt-3 border-t border-stone-800/60 space-y-2">
        <p class="text-[11px] text-stone-500 leading-relaxed">{labels.expiredNote}</p>
        <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3 pt-1">
          {expiredCodes.map((c) => (
            <div class="flex items-center justify-between gap-2 rounded-lg border border-stone-800/80 bg-stone-900/30 p-2.5 opacity-60">
              <div class="min-w-0">
                <code class="font-mono text-xs line-through text-stone-400">{c.code}</code>
                <p class="text-[10px] text-stone-500">{c.date}</p>
              </div>
              <span class="rounded bg-stone-800 px-1.5 py-0.5 text-[9px] font-semibold text-stone-400">EXPIRED</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  )}

  <!-- Official Web Redemption Box -->
  <div class="rounded-xl border border-plague-700/50 bg-gradient-to-r from-plague-950/60 via-stone-900 to-stone-950 p-4">
    <p class="text-sm text-stone-300 flex flex-wrap items-center gap-2">
      <span class="text-lg">🌐</span>
      <strong class="text-plague-200">{labels.webTitle}</strong>
      <a href={REDEEM_URL} target="_blank" rel="noopener noreferrer" class="text-toxic-400 hover:text-toxic-300 underline font-mono text-xs break-all transition">
        {REDEEM_URL} ↗
      </a>
    </p>
    <p class="mt-2 text-xs leading-relaxed text-stone-400 border-t border-stone-800/80 pt-2">
      📱 {labels.iosTip}
    </p>
  </div>
</div>

<script>
  // Individual Code Copy
  document.querySelectorAll(".js-copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const code = (btn as HTMLElement).dataset.code ?? "";
      const copiedLabel = (btn as HTMLElement).dataset.labelCopied ?? "✓ Copied";
      const copyLabel = (btn as HTMLElement).dataset.labelCopy ?? "Copy";
      try {
        await navigator.clipboard.writeText(code);
        (btn as HTMLElement).textContent = copiedLabel;
        btn.classList.add("border-toxic-400", "text-toxic-300", "bg-toxic-500/10");
        setTimeout(() => {
          (btn as HTMLElement).textContent = copyLabel;
          btn.classList.remove("border-toxic-400", "text-toxic-300", "bg-toxic-500/10");
        }, 1500);
      } catch {
        (btn as HTMLElement).textContent = code;
      }
    });
  });

  // Copy All Codes
  const copyAllBtn = document.getElementById("js-copy-all");
  if (copyAllBtn) {
    copyAllBtn.addEventListener("click", async () => {
      const allText = copyAllBtn.dataset.all ?? "";
      const defaultLabel = copyAllBtn.dataset.default ?? "Copy All";
      const copiedLabel = copyAllBtn.dataset.copied ?? "✓ Copied!";
      try {
        await navigator.clipboard.writeText(allText);
        copyAllBtn.textContent = copiedLabel;
        copyAllBtn.classList.add("bg-toxic-400", "text-black", "border-toxic-400");
        setTimeout(() => {
          copyAllBtn.textContent = defaultLabel;
          copyAllBtn.classList.remove("bg-toxic-400", "text-black", "border-toxic-400");
        }, 2000);
      } catch {
        alert("Clipboard access denied.");
      }
    });
  }

  // Toggle Expired Codes Accordion
  const toggleBtn = document.getElementById("js-toggle-expired");
  const expiredContainer = document.getElementById("js-expired-container");
  const toggleLabel = document.getElementById("js-toggle-expired-label");
  const toggleIcon = document.getElementById("js-toggle-expired-icon");

  if (toggleBtn && expiredContainer && toggleLabel && toggleIcon) {
    let isOpen = false;
    toggleBtn.addEventListener("click", () => {
      isOpen = !isOpen;
      if (isOpen) {
        expiredContainer.classList.remove("hidden");
        toggleLabel.textContent = toggleBtn.dataset.hide ?? "Hide Expired Codes";
        toggleIcon.style.transform = "rotate(180deg)";
      } else {
        expiredContainer.classList.add("hidden");
        toggleLabel.textContent = toggleBtn.dataset.show ?? "Show Expired Codes";
        toggleIcon.style.transform = "rotate(0deg)";
      }
    });
  }
</script>
