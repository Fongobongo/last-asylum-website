---
import { giftCodes, REDEEM_URL } from '../data/giftcodes';
---

<div class="not-prose my-6">
  <div class="mb-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" id="codes-active">
    {giftCodes.filter((c) => c.active).map((c) => (
      <div class="flex items-center justify-between gap-3 rounded-lg border border-toxic-500/40 bg-toxic-500/10 px-4 py-3">
        <div>
          <code class="text-lg font-bold tracking-wider text-toxic-400">{c.code}</code>
          {c.note && <p class="mt-0.5 text-xs text-stone-400">{c.note}</p>}
          <p class="text-xs text-stone-500">{c.date}</p>
        </div>
        <button class="js-copy rounded-md border border-stone-600 px-3 py-1.5 text-xs font-semibold text-stone-200 hover:bg-stone-800" data-code={c.code}>
          Copy
        </button>
      </div>
    ))}
  </div>

  <details class="rounded-lg border border-stone-800 bg-stone-900 p-4">
    <summary class="cursor-pointer font-semibold text-stone-300">Older codes (probably expired)</summary>
    <div class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      {giftCodes.filter((c) => !c.active).map((c) => (
        <div class="flex items-center justify-between gap-3 rounded-lg border border-stone-800 bg-stone-950 px-4 py-2.5 opacity-70">
          <div>
            <code class="font-mono font-bold tracking-wider text-stone-400">{c.code}</code>
            {c.note && <span class="ml-2 text-xs text-stone-500">{c.note}</span>}
            <p class="text-xs text-stone-600">{c.date}</p>
          </div>
          <button class="js-copy rounded-md border border-stone-700 px-2.5 py-1 text-xs text-stone-400 hover:bg-stone-800" data-code={c.code}>
            Copy
          </button>
        </div>
      ))}
    </div>
  </details>

  <div class="mt-6 rounded-lg border border-plague-700 bg-plague-950/50 p-4">
    <p class="text-sm text-stone-300">
      рџЊђ <strong class="text-plague-200">Web redemption (iOS & Android):</strong>
      <a href={REDEEM_URL} target="_blank" rel="noopener noreferrer" class="ml-1 text-toxic-400 underline">{REDEEM_URL}</a>
    </p>
  </div>
</div>

<script>
  document.querySelectorAll('.js-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = (btn as HTMLElement).dataset.code ?? '';
      try {
        await navigator.clipboard.writeText(code);
        (btn as HTMLElement).textContent = 'вњ“ Copied';
        setTimeout(() => ((btn as HTMLElement).textContent = 'Copy'), 1500);
      } catch {
        (btn as HTMLElement).textContent = code;
      }
    });
  });
</script>