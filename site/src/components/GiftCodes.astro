---
import { giftCodes, REDEEM_URL } from '../data/giftcodes';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;

const dict: Record<string, { copy: string; copied: string; webTitle: string; iosTip: string }> = {
  ru: {
    copy: 'Копировать',
    copied: '✓ Скопировано',
    webTitle: 'Активация через сайт (для iPhone / iOS и Android):',
    iosTip: 'Инструкция для iPhone (iOS): в самом приложении на iOS нет кнопки ввода кода из-за правил Apple. Откройте официальную веб-страницу активации по ссылке выше, войдите в привязанный аккаунт, выберите свой сервер и персонажа, введите код — награды сразу поступят на игровую почту.',
  },
  de: {
    copy: 'Kopieren',
    copied: '✓ Kopiert',
    webTitle: 'Einlösung per Website (für iPhone / iOS & Android):',
    iosTip: 'iPhone / iOS Anleitung: In der iOS-App gibt es aufgrund von Apple-Richtlinien keine Schaltfläche für Geschenkcodes. Öffne die offizielle Einlösungsseite oben, melde dich mit deinem verknüpften Konto an, wähle Server und Charakter, gib den Code ein und hole die Belohnung im Spiel-Postfach ab.',
  },
  es: {
    copy: 'Copiar',
    copied: '✓ Copiado',
    webTitle: 'Canje vía web (para iPhone / iOS y Android):',
    iosTip: 'Guía para iPhone (iOS): En iOS no hay botón dentro de la aplicación debido a políticas de Apple. Abre la página oficial de canje arriba, inicia sesión con tu cuenta vinculada, elige servidor y personaje, canjea el código y recoge las recompensas en tu buzón del juego.',
  },
  fr: {
    copy: 'Copier',
    copied: '✓ Copié',
    webTitle: 'Échange via le web (pour iPhone / iOS et Android) :',
    iosTip: "Guide iPhone (iOS) : L'application iOS ne comporte pas de bouton d'échange en raison des règles d'Apple. Ouvrez la page web officielle ci-dessus, connectez-vous avec votre compte lié, choisissez serveur et personnage, saisissez le code et recevez les récompenses par courrier en jeu.",
  },
  id: {
    copy: 'Salin',
    copied: '✓ Tersalin',
    webTitle: 'Penukaran via web (untuk iPhone / iOS & Android):',
    iosTip: 'Panduan iPhone / iOS: Tidak ada tombol kode hadiah di dalam aplikasi iOS karena kebijakan Apple. Buka halaman penukaran resmi di atas, masuk dengan akun tertaut Anda, pilih server dan karakter, masukkan kode, lalu ambil hadiah di kotak masuk dalam game.',
  },
  ja: {
    copy: 'コピー',
    copied: '✓ コピー完了',
    webTitle: 'ウェブ交換ページ（iPhone / iOS & Android対応）：',
    iosTip: 'iPhone / iOS向け手順：Appleの規約により、iOSアプリ内にはコード入力欄がありません。上記の公式ウェブ交換ページを開き、連携済みアカウントでログイン後、サーバーとキャラクターを選択してコードを入力してください。報酬はゲーム内メールに届きます。',
  },
  ko: {
    copy: '복사',
    copied: '✓ 복사됨',
    webTitle: '웹사이트 교환 (iPhone / iOS 및 Android 공용):',
    iosTip: 'iPhone (iOS) 가이드: Apple 정책으로 인해 iOS 앱 내에는 선물 코드 입력 버튼이 없습니다. 위 공식 웹 교환 페이지를 열고 연동 계정으로 로그인한 뒤, 서버와 캐릭터를 선택하고 코드를 입력하면 게임 내 우편으로 보상이 지급됩니다.',
  },
  pt: {
    copy: 'Copiar',
    copied: '✓ Copiado',
    webTitle: 'Resgate via web (para iPhone / iOS e Android):',
    iosTip: 'Guia para iPhone / iOS: Não há botão de código dentro do aplicativo iOS devido às regras da Apple. Abra a página oficial de resgate acima, faça login com sua conta vinculada, selecione servidor e personagem, insira o código e colete as recompensas no correio do jogo.',
  },
  en: {
    copy: 'Copy',
    copied: '✓ Copied',
    webTitle: 'Web redemption (for iPhone / iOS & Android):',
    iosTip: 'iPhone / iOS guide: There is no in-app promo code button on iOS devices due to Apple policy. Open the official web redemption page above, sign in with your linked account, select your server and character, submit the code, and claim rewards via your in-game mailbox.',
  },
};

const labels = dict[lang] ?? dict.en;
---

<div class="not-prose my-6">
  <div class="mb-6 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3" id="codes-active">
    {giftCodes.filter((c) => c.active).map((c) => (
      <div class="group relative flex items-center justify-between gap-3 rounded-xl border border-toxic-500/30 bg-gradient-to-br from-toxic-500/10 to-transparent p-4 shadow-[0_4px_20px_rgba(0,0,0,0.3)] transition-all hover:border-toxic-400/60 hover:shadow-[0_0_24px_rgba(180,255,57,0.15)]">
        <div>
          <div class="flex items-center gap-2">
            <code class="font-mono text-lg font-bold tracking-wider text-toxic-400">{c.code}</code>
            <span class="inline-flex items-center rounded-full bg-toxic-400/20 px-2 py-0.5 text-[10px] font-semibold text-toxic-300">ACTIVE</span>
          </div>
          {c.note && <p class="mt-1 text-xs text-stone-300">{c.note}</p>}
          <p class="mt-0.5 text-[11px] font-mono text-stone-500">{c.date}</p>
        </div>
        <button
          class="js-copy inline-flex shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-stone-200 transition hover:bg-toxic-400 hover:text-black hover:border-toxic-400"
          data-code={c.code}
          data-label-copy={labels.copy}
          data-label-copied={labels.copied}
        >
          {labels.copy}
        </button>
      </div>
    ))}
  </div>

  <div class="mt-6 rounded-xl border border-plague-700/50 bg-gradient-to-r from-plague-950/60 via-stone-900 to-stone-950 p-4">
    <p class="text-sm text-stone-300 flex flex-wrap items-center gap-2">
      <span class="text-lg">🌐</span>
      <strong class="text-plague-200">{labels.webTitle}</strong>
      <a href={REDEEM_URL} target="_blank" rel="noopener noreferrer" class="text-toxic-400 hover:text-toxic-300 underline font-mono text-xs break-all transition">
        {REDEEM_URL} ↗
      </a>
    </p>
    <p class="mt-2 text-xs leading-relaxed text-stone-400 border-t border-stone-800/80 pt-2">
      📱 {labels.iosTip}
    </p>
  </div>
</div>

<script>
  document.querySelectorAll('.js-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = (btn as HTMLElement).dataset.code ?? '';
      const copiedLabel = (btn as HTMLElement).dataset.labelCopied ?? '✓ Copied';
      const copyLabel = (btn as HTMLElement).dataset.labelCopy ?? 'Copy';
      try {
        await navigator.clipboard.writeText(code);
        (btn as HTMLElement).textContent = copiedLabel;
        btn.classList.add('border-toxic-400', 'text-toxic-300', 'bg-toxic-500/10');
        setTimeout(() => {
          (btn as HTMLElement).textContent = copyLabel;
          btn.classList.remove('border-toxic-400', 'text-toxic-300', 'bg-toxic-500/10');
        }, 1500);
      } catch {
        (btn as HTMLElement).textContent = code;
      }
    });
  });
</script>