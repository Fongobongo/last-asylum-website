  copy: string;
  copied: string;
  copyAll: string;
  allCopied: string;
  verifiedToday: string;
  activeCount: string;
  showExpired: string;
  hideExpired: string;
  expiredTitle: string;
  expiredNote: string;
  webTitle: string;
  iosTip: string;
}

