---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  src: string;       // e.g. '/infographics/f2p-guide.png'
  alt: string;
  caption?: string;
  credit?: string;   // author name
}
const { src, alt, caption, credit } = Astro.props;

// Determine if a -mobile version exists in public directory
const ext = path.extname(src);
const mobileCandidate = src.replace(new RegExp(`\\${ext}$`), `-mobile.webp`);
let hasMobile = false;
try {
  const fileUrl = new URL(`../../public${mobileCandidate.startsWith('/') ? mobileCandidate : '/' + mobileCandidate}`, import.meta.url);
  hasMobile = fs.existsSync(fileUrl);
} catch (e) {
  hasMobile = false;
}
const mobileSrc = hasMobile ? mobileCandidate : null;
---
<figure class="not-prose my-8">
  <a href={src} target="_blank" rel="noopener noreferrer" class="block overflow-hidden rounded-lg border border-stone-800 bg-stone-900 hover:border-stone-700 transition cursor-zoom-in" title="Открыть в полном разрешении">
    <picture>
      {mobileSrc && <source media="(max-width: 768px)" srcset={mobileSrc} type="image/webp" />}
      <img src={src} alt={alt} loading="lazy" class="w-full h-auto" />
    </picture>
  </a>
  {(caption || credit) && (
    <figcaption class="mt-2 text-center text-xs text-stone-500">
      {caption}{credit && <span class="ml-1">— © {credit}</span>}
    </figcaption>
  )}
</figure>

