        </div>
        <div class="rounded-lg border border-stone-700 bg-stone-950 p-4">
          <p class="text-xs uppercase tracking-wide text-stone-400">{L.shards}</p>
          <p class="js-cynthia-shards mt-1 font-mono text-xl font-bold text-stone-200">~50</p>
        </div>
      </div>
      <p class="mt-3 text-xs text-stone-500">💡 {L.note}</p>
    </div>
  )}
</section>

<script>
  function initCalcs() {
    // AD Phase 4
    const adTotal = document.querySelector('.js-ad-total');
    if (adTotal) {
      const inputs = document.querySelectorAll('.js-ad-input');
      const recalcAd = () => {
        let sum = 0;
        inputs.forEach((i) => {
          sum += (parseFloat((i as HTMLInputElement).value) || 0) * parseFloat((i as HTMLInputElement).dataset.mult || '0');
        });
        adTotal.textContent = sum.toLocaleString('ru-RU').replace(/,/g, ' ');
      };
      inputs.forEach((i) => i.addEventListener('input', recalcAd));
      recalcAd();
    }

    // Claire shards
    const h60 = document.querySelector('.js-claire-h60') as HTMLInputElement | null;
    if (h60) {
      const b1 = document.querySelector('.js-claire-b1');
      const b2 = document.querySelector('.js-claire-b2');
      const b3 = document.querySelector('.js-claire-b3');
      const recalcClaire = () => {
        const v = parseInt(h60!.value, 10) || 0;
        const capped = Math.min(Math.max(v, 0), 1600);
        if (b1) b1.textContent = String(Math.min(capped, 600));
        if (b2) b2.textContent = String(Math.min(capped, 1000));
        if (b3) b3.textContent = String(capped);
      };
      h60!.addEventListener('input', recalcClaire);
      recalcClaire();
    }

    // Cynthia wheel
    const spins = document.querySelector('.js-cynthia-spins') as HTMLInputElement | null;
    if (spins) {
      const n = document.querySelector('.js-cynthia-n');
      const cost = document.querySelector('.js-cynthia-cost');
      const shards = document.querySelector('.js-cynthia-shards');
      const recalcCy = () => {
        const k = parseInt(spins!.value, 10) || 1;
        if (n) n.textContent = String(k);
        if (cost) cost.textContent = (4500 * k).toLocaleString('ru-RU').replace(/,/g, ' ');
        if (shards) shards.textContent = `~${50 * k}`;
      };
      spins!.addEventListener('input', recalcCy);
      recalcCy();
    }
  }
  initCalcs();
</script>