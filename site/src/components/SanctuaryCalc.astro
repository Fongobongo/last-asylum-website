---

<div class="not-prose my-8 rounded-xl border border-stone-800 bg-stone-900/95 p-5 shadow-xl" id="sanctuary-calc-container">
  <div class="border-b border-stone-800 pb-4">
    <h3 class="text-xl font-bold text-plague-200 flex items-center gap-2">
      <span>🏰</span>
      <span>{texts.title}</span>
    </h3>
    <p class="text-xs text-stone-400 mt-0.5">{texts.subtitle}</p>
  </div>

  <!-- Interactive Controls Grid -->
  <div class="mt-5 grid gap-4 sm:grid-cols-3">
    <div>
      <label for="sc-current" class="block text-xs font-semibold text-stone-300 mb-1">
        {texts.currentLevel}
      </label>
      <select
        id="sc-current"
        class="w-full rounded-lg border border-stone-700 bg-stone-800 px-3 py-2 text-sm text-stone-200 focus:border-plague-500 focus:outline-none"
      >
        {Array.from({ length: 20 }, (_, i) => i + 10).map((lvl) => (
          <option value={lvl} selected={lvl === 15}>Уровень {lvl}</option>
        ))}
      </select>
    </div>

    <div>
      <label for="sc-target" class="block text-xs font-semibold text-stone-300 mb-1">
        {texts.targetLevel}
      </label>
      <select
        id="sc-target"
        class="w-full rounded-lg border border-stone-700 bg-stone-800 px-3 py-2 text-sm text-stone-200 focus:border-plague-500 focus:outline-none"
      >
        {Array.from({ length: 20 }, (_, i) => i + 11).map((lvl) => (
          <option value={lvl} selected={lvl === 20}>Уровень {lvl}</option>
        ))}
      </select>
    </div>

    <div>
      <div class="flex justify-between items-center mb-1">
        <label for="sc-buff" class="text-xs font-semibold text-stone-300">
          {texts.speedBuff}
        </label>
        <span id="sc-buff-val" class="font-mono text-xs font-bold text-toxic-400">+50%</span>
      </div>
      <input
        type="range"
        id="sc-buff"
        min="0"
        max="300"
        step="5"
        value="50"
        class="w-full h-2 bg-stone-800 rounded-lg appearance-none cursor-pointer accent-toxic-400"
      />
    </div>
  </div>

  <!-- Results Summary Cards -->
  <div class="mt-5 grid gap-3 sm:grid-cols-3">
    <div class="rounded-lg border border-stone-800 bg-stone-950/60 p-3.5">
      <p class="text-xs text-stone-400">{texts.food}</p>
      <p id="sc-res-food" class="text-lg font-bold font-mono text-amber-300 mt-0.5">0</p>
    </div>
    <div class="rounded-lg border border-stone-800 bg-stone-950/60 p-3.5">
      <p class="text-xs text-stone-400">{texts.timber}</p>
      <p id="sc-res-timber" class="text-lg font-bold font-mono text-emerald-300 mt-0.5">0</p>
    </div>
    <div class="rounded-lg border border-stone-800 bg-stone-950/60 p-3.5">
      <p class="text-xs text-stone-400">{texts.herbs}</p>
      <p id="sc-res-herbs" class="text-lg font-bold font-mono text-purple-300 mt-0.5">0</p>
    </div>
  </div>

  <!-- Time Comparison Cards -->
  <div class="mt-3 grid gap-3 sm:grid-cols-3">
    <div class="rounded-lg border border-stone-800 bg-stone-950/40 p-3">
      <p class="text-[11px] text-stone-400">{texts.baseTime}</p>
      <p id="sc-time-base" class="text-sm font-semibold font-mono text-stone-300 mt-0.5">0</p>
    </div>
    <div class="rounded-lg border border-toxic-500/30 bg-toxic-950/20 p-3">
      <p class="text-[11px] text-toxic-300 font-semibold">{texts.actualTime}</p>
      <p id="sc-time-actual" class="text-base font-bold font-mono text-toxic-400 mt-0.5">0</p>
    </div>
    <div class="rounded-lg border border-stone-800 bg-stone-950/40 p-3">
      <p class="text-[11px] text-stone-400">{texts.daysSaved}</p>
      <p id="sc-time-saved" class="text-sm font-semibold font-mono text-stone-400 mt-0.5">0</p>
    </div>
  </div>

  <!-- Prerequisite Chain -->
  <div class="mt-4 rounded-lg border border-stone-800 bg-stone-950/40 p-4">
    <h4 class="text-xs font-bold uppercase tracking-wider text-plague-300 mb-2">
      {texts.prereqs}
    </h4>
    <ul id="sc-prereqs-list" class="space-y-1.5 text-xs text-stone-300 font-mono">
    </ul>
  </div>

  <!-- Hammer Pro-Tip -->
  <div class="mt-4 rounded-lg border border-amber-500/30 bg-amber-950/20 p-3.5 text-xs text-amber-200">
    <p class="font-bold text-amber-300">{texts.hammerTipTitle}</p>
    <p class="mt-1 text-amber-100/90 leading-relaxed">{texts.hammerTipText}</p>
  </div>
</div>

<script define:vars={{ levelsData: sanctuaryLevels, unitDays: texts.days, unitHours: texts.hours, unitM: texts.millions, unitB: texts.billions }}>
  (function () {
    const currentSelect = document.getElementById('sc-current');
    const targetSelect = document.getElementById('sc-target');
    const buffSlider = document.getElementById('sc-buff');
    const buffVal = document.getElementById('sc-buff-val');

    const resFood = document.getElementById('sc-res-food');
    const resTimber = document.getElementById('sc-res-timber');
    const resHerbs = document.getElementById('sc-res-herbs');

    const timeBase = document.getElementById('sc-time-base');
    const timeActual = document.getElementById('sc-time-actual');
    const timeSaved = document.getElementById('sc-time-saved');
    const prereqsList = document.getElementById('sc-prereqs-list');

    function formatNumber(num) {
      if (num >= 1000000000) {
        return (num / 1000000000).toFixed(2) + ' ' + unitB;
      }
      if (num >= 1000000) {
        return (num / 1000000).toFixed(1) + ' ' + unitM;
      }
      return num.toLocaleString();
    }

    function formatHours(h) {
      const days = Math.floor(h / 24);
      const remHours = Math.round(h % 24);
      if (days === 0) return `${remHours}${unitHours}`;
      return `${days}${unitDays} ${remHours}${unitHours}`;
    }

    function calculate() {
      const cur = parseInt(currentSelect.value, 10);
      let target = parseInt(targetSelect.value, 10);
      const buff = parseInt(buffSlider.value, 10);

      buffVal.textContent = `+${buff}%`;

      // Keep target > current
      if (target <= cur) {
        target = cur + 1;
        targetSelect.value = target;
      }

      let totalFood = 0;
      let totalTimber = 0;
      let totalHerbs = 0;
      let totalHours = 0;
      const prereqs = [];

      for (const item of levelsData) {
        if (item.level > cur && item.level <= target) {
          totalFood += item.food;
          totalTimber += item.timber;
          totalHerbs += item.herbs;
          totalHours += item.hours;
          prereqs.push(`→ Ур. ${item.level}: ${item.prereq}`);
        }
      }

      const actualHours = totalHours / (1 + buff / 100);
      const savedHours = Math.max(0, totalHours - actualHours);

      if (resFood) resFood.textContent = formatNumber(totalFood);
      if (resTimber) resTimber.textContent = formatNumber(totalTimber);
      if (resHerbs) resHerbs.textContent = formatNumber(totalHerbs);

      if (timeBase) timeBase.textContent = formatHours(totalHours);
      if (timeActual) timeActual.textContent = formatHours(actualHours);
      if (timeSaved) timeSaved.textContent = `-${formatHours(savedHours)}`;

      if (prereqsList) {
        prereqsList.innerHTML = '';
        if (prereqs.length === 0) {
          prereqsList.innerHTML = '<li class="text-stone-500">Уже на этом уровне</li>';
        } else {
          prereqs.forEach((p) => {
            const li = document.createElement('li');
            li.textContent = p;
            prereqsList.appendChild(li);
          });
        }
      }
    }

    currentSelect.addEventListener('change', calculate);
    targetSelect.addEventListener('change', calculate);
    buffSlider.addEventListener('input', calculate);

    calculate();
  })();
</script>
