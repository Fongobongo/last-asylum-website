---

<section class="not-prose my-10 rounded-3xl border border-toxic-500/30 bg-stone-950/80 p-6 sm:p-8 backdrop-blur-xl shadow-[0_0_50px_rgba(0,0,0,0.6)]" id="hero-gear-guide">
  <div class="mb-6 flex flex-col gap-2">
    <div class="flex items-center gap-3">
      <span class="rounded-xl border border-toxic-500/40 bg-toxic-950/60 px-3 py-1 text-xs font-bold text-toxic-400">
        GEAR & MR SYSTEM
      </span>
      <span class="text-xs text-stone-500 font-mono">WORKSHOP ID 1008</span>
    </div>
    <h2 class="text-2xl font-bold tracking-tight text-toxic-400 sm:text-3xl">{t.title}</h2>
    <p class="text-sm text-stone-400 max-w-3xl">{t.subtitle}</p>
  </div>

  <!-- 4 Slots Grid -->
  <div class="mb-8">
    <h3 class="text-base font-bold text-stone-200 mb-4 flex items-center gap-2">
      <span>⚙️</span> {t.slotsTitle}
    </h3>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {slots.map((s) => (
        <div class="rounded-2xl border border-stone-800 bg-stone-900/50 p-4 transition hover:border-toxic-500/40 hover:bg-stone-900/80">
          <div class="flex items-center justify-between mb-2">
            <span class="text-2xl">{s.icon}</span>
            <span class="rounded-md border border-stone-700 bg-stone-950 px-2 py-0.5 text-[10px] font-bold text-stone-300">
              {s.role}
            </span>
          </div>
          <h4 class="text-sm font-bold text-stone-100">{s.name}</h4>
          <p class="mt-1 text-xs text-toxic-300 font-medium">{s.primary}</p>
          <p class="mt-2 text-xs text-stone-400 leading-snug">{s.priority}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Rarity Tiers and MR Promotion Box -->
  <div class="grid gap-6 lg:grid-cols-2">
    <!-- Tiers progression -->
    <div class="rounded-2xl border border-stone-800 bg-stone-900/60 p-5">
      <h3 class="text-sm font-bold text-stone-200 mb-3 flex items-center gap-2">
        <span>🏆</span> {t.tiersTitle}
      </h3>
      <div class="space-y-2.5">
        <div class="flex items-center justify-between rounded-xl border border-stone-800/80 bg-stone-950/60 px-3 py-2 text-xs">
          <span class="font-semibold text-emerald-400">🟢 R (Rare)</span>
          <span class="text-stone-400">Max Lv. 10</span>
        </div>
        <div class="flex items-center justify-between rounded-xl border border-stone-800/80 bg-stone-950/60 px-3 py-2 text-xs">
          <span class="font-semibold text-sky-400">🔵 SR (Super Rare)</span>
          <span class="text-stone-400">Max Lv. 20</span>
        </div>
        <div class="flex items-center justify-between rounded-xl border border-stone-800/80 bg-stone-950/60 px-3 py-2 text-xs">
          <span class="font-semibold text-purple-400">🟣 SSR (Special Super Rare)</span>
          <span class="text-stone-400">Max Lv. 30</span>
        </div>
        <div class="flex items-center justify-between rounded-xl border border-stone-800/80 bg-stone-950/60 px-3 py-2 text-xs">
          <span class="font-semibold text-amber-400">🟡 UR (Ultra Rare)</span>
          <span class="text-stone-400">Max Lv. 40</span>
        </div>
        <div class="flex items-center justify-between rounded-xl border border-rose-500/40 bg-rose-950/30 px-3 py-2 text-xs">
          <span class="font-bold text-rose-400">🔴 MR (Mythic Red / Promoted)</span>
          <span class="text-rose-300 font-semibold">Lv. 40+ Reforged</span>
        </div>
      </div>
    </div>

    <!-- MR Promotion Callout -->
    <div class="rounded-2xl border border-rose-500/30 bg-rose-950/20 p-5 flex flex-col justify-between">
      <div>
        <h3 class="text-sm font-bold text-rose-300 mb-2">{t.promotionTitle}</h3>
        <p class="text-xs text-stone-300 leading-relaxed mb-4">{t.promotionDesc}</p>
        
        <div class="rounded-xl border border-stone-800 bg-stone-950/60 p-3 space-y-1.5 text-xs">
          <div class="text-stone-300">
            <span class="text-rose-400 font-bold">1.</span> {t.ruleTank} {t.ruleTankDesc}
          </div>
          <div class="text-stone-300">
            <span class="text-rose-400 font-bold">2.</span> {t.ruleDps} {t.ruleDpsDesc}
          </div>
        </div>
      </div>

      <div class="mt-4 pt-3 border-t border-stone-800/80 text-[11px] text-stone-400 italic">
        ℹ️ {t.workshopNote}
      </div>
    </div>
  </div>
</section>
