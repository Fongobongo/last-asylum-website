          <th class="p-2.5 border-b border-stone-800 print:border-black/20 w-2/5">{texts.actionCol}</th>
          <th class="p-2.5 border-b border-stone-800 print:border-black/20 w-1/3">{texts.saveCol}</th>
          <th class="p-2.5 border-b border-stone-800 print:border-black/20">{texts.pointsCol}</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-800 print:divide-black/20 text-stone-200 print:text-black">
        <tr class="hover:bg-stone-800/40">
          <td class="p-2.5 font-bold text-plague-200 print:text-black whitespace-nowrap">{texts.mon}</td>
          <td class="p-2.5 leading-relaxed">{texts.monAction}</td>
          <td class="p-2.5 text-amber-300 print:text-stone-800 leading-relaxed">{texts.monSave}</td>
          <td class="p-2.5 text-stone-400 print:text-stone-600 font-mono text-[11px]">{texts.monPoints}</td>
        </tr>
        <tr class="hover:bg-stone-800/40">
          <td class="p-2.5 font-bold text-plague-200 print:text-black whitespace-nowrap">{texts.tue}</td>
          <td class="p-2.5 leading-relaxed">{texts.tueAction}</td>
          <td class="p-2.5 text-amber-300 print:text-stone-800 leading-relaxed">{texts.tueSave}</td>
          <td class="p-2.5 text-stone-400 print:text-stone-600 font-mono text-[11px]">{texts.tuePoints}</td>
        </tr>
        <tr class="hover:bg-stone-800/40">
          <td class="p-2.5 font-bold text-plague-200 print:text-black whitespace-nowrap">{texts.wed}</td>
          <td class="p-2.5 leading-relaxed">{texts.wedAction}</td>
          <td class="p-2.5 text-amber-300 print:text-stone-800 leading-relaxed">{texts.wedSave}</td>
          <td class="p-2.5 text-stone-400 print:text-stone-600 font-mono text-[11px]">{texts.wedPoints}</td>
        </tr>
        <tr class="hover:bg-stone-800/40 bg-toxic-950/20 print:bg-emerald-50">
          <td class="p-2.5 font-bold text-toxic-300 print:text-emerald-900 whitespace-nowrap">{texts.thu}</td>
          <td class="p-2.5 leading-relaxed font-medium text-toxic-200 print:text-black">{texts.thuAction}</td>
          <td class="p-2.5 text-amber-300 print:text-stone-800 leading-relaxed">{texts.thuSave}</td>
          <td class="p-2.5 text-stone-400 print:text-stone-600 font-mono text-[11px]">{texts.thuPoints}</td>
        </tr>
        <tr class="hover:bg-stone-800/40">
          <td class="p-2.5 font-bold text-plague-200 print:text-black whitespace-nowrap">{texts.fri}</td>
          <td class="p-2.5 leading-relaxed">{texts.friAction}</td>
          <td class="p-2.5 text-amber-300 print:text-stone-800 leading-relaxed">{texts.friSave}</td>
          <td class="p-2.5 text-stone-400 print:text-stone-600 font-mono text-[11px]">{texts.friPoints}</td>
        </tr>
        <tr class="hover:bg-stone-800/40 bg-blood-950/20 print:bg-red-50">
          <td class="p-2.5 font-bold text-blood-300 print:text-red-900 whitespace-nowrap">{texts.sat}</td>
          <td class="p-2.5 leading-relaxed">{texts.satAction}</td>
          <td class="p-2.5 text-amber-300 print:text-stone-800 leading-relaxed">{texts.satSave}</td>
          <td class="p-2.5 text-stone-400 print:text-stone-600 font-mono text-[11px]">{texts.satPoints}</td>
        </tr>
        <tr class="hover:bg-stone-800/40">
          <td class="p-2.5 font-bold text-plague-200 print:text-black whitespace-nowrap">{texts.sun}</td>
          <td class="p-2.5 leading-relaxed">{texts.sunAction}</td>
          <td class="p-2.5 text-amber-300 print:text-stone-800 leading-relaxed">{texts.sunSave}</td>
          <td class="p-2.5 text-stone-400 print:text-stone-600 font-mono text-[11px]">{texts.sunPoints}</td>
        </tr>
      </tbody>
    </table>
  </div>

  <p class="mt-3 text-xs text-stone-400 print:text-stone-600 text-center font-mono">
    {texts.footerReset}
  </p>
</div>

<script>
  document.getElementById('btn-print-cheatsheet')?.addEventListener('click', () => {
    window.print();
  });
</script>
