<div class="not-prose my-8 rounded-xl border border-stone-800 bg-stone-900/95 p-5 shadow-xl print:m-0 print:p-2 print:border-none print:bg-white print:text-black">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-stone-800 pb-4 print:border-black/20">
    <div>
      <h3 class="text-xl font-bold text-plague-200 print:text-black flex items-center gap-2">
        <span>📄</span>
        <span>{texts.title}</span>
      </h3>
      <p class="text-xs text-stone-400 print:text-stone-600 mt-0.5">{texts.subtitle}</p>
    </div>
    <button
      id="btn-print-cheatsheet"
      type="button"
      class="inline-flex items-center gap-1.5 rounded-lg border border-stone-700 bg-stone-800 px-3 py-1.5 text-xs font-semibold text-stone-200 hover:bg-stone-700 transition cursor-pointer print:hidden"
    >
      {texts.printBtn}
    </button>
  </div>

  <!-- Responsive & Printable Table -->
  <div class="mt-4 overflow-x-auto rounded-lg border border-stone-800 print:border-black/30">
    <table class="w-full text-left text-xs">
      <thead class="bg-stone-950 text-plague-300 print:bg-stone-100 print:text-black font-bold uppercase tracking-wider">
