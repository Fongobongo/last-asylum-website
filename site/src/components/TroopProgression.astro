const t = ui[lang] || ui.en;
---

<section class="not-prose my-10 rounded-2xl border border-stone-800 bg-stone-950/80 p-5 shadow-2xl backdrop-blur-sm sm:p-8">
  <div class="border-b border-stone-800/80 pb-6">
    <span class="inline-flex items-center gap-1.5 rounded-full border border-red-500/30 bg-red-950/60 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-red-400">
      ⚔️ Official Troop System
    </span>
    <h2 class="mt-2 text-2xl font-black tracking-tight text-stone-100 sm:text-3xl">
      {t.title}
    </h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-stone-400">
      {t.subtitle}
    </p>

    <!-- Clarification between Training Grounds (Полигон) and Barracks (Казарма) -->
    <div class="mt-6 rounded-xl border border-stone-800 bg-stone-900/70 p-4 sm:p-5">
      <h3 class="text-xs font-bold uppercase tracking-wider text-plague-300">
        {t.buildingClarificationTitle}
      </h3>
      <div class="mt-3 grid gap-3 text-xs text-stone-300 sm:grid-cols-2">
        <div class="rounded-lg border border-red-900/40 bg-red-950/20 p-3">
          <p class="font-bold text-red-200">🎯 {t.trainingGroundRole.split(':')[0]}:</p>
          <p class="mt-1 leading-relaxed text-stone-300">{t.trainingGroundRole.split(':')[1]}</p>
        </div>
        <div class="rounded-lg border border-stone-800 bg-stone-900/50 p-3">
          <p class="font-bold text-stone-200">⛺ {t.barracksRole.split(':')[0]}:</p>
          <p class="mt-1 leading-relaxed text-stone-300">{t.barracksRole.split(':')[1]}</p>
        </div>
      </div>
    </div>

    <!-- Combat Triangle Box -->
    <div class="mt-6 rounded-xl border border-red-900/40 bg-red-950/20 p-4 sm:p-5">
      <h3 class="text-xs font-bold uppercase tracking-wider text-red-300">
        {t.triangleTitle}
      </h3>
      <div class="mt-3 grid gap-2.5 text-xs text-stone-300 sm:grid-cols-3">
        <div class="rounded-lg border border-stone-800/80 bg-stone-900/60 p-3 text-center">
          <span class="text-xl">🛡️ ➔ 🏹</span>
          <p class="mt-1 font-bold text-stone-200">{t.warriorBeat}</p>
        </div>
        <div class="rounded-lg border border-stone-800/80 bg-stone-900/60 p-3 text-center">
          <span class="text-xl">🏹 ➔ 🔮</span>
          <p class="mt-1 font-bold text-stone-200">{t.rangerBeat}</p>
        </div>
        <div class="rounded-lg border border-stone-800/80 bg-stone-900/60 p-3 text-center">
          <span class="text-xl">🔮 ➔ 🛡️</span>
          <p class="mt-1 font-bold text-stone-200">{t.warlockBeat}</p>
        </div>
      </div>
      <p class="mt-3 text-xs italic text-stone-400 text-center sm:text-left">
        💡 {t.bonusNote}
      </p>
    </div>
  </div>

  <!-- Troops Table -->
  <div class="mt-6 overflow-x-auto">
    <table class="w-full text-left text-xs sm:text-sm">
      <thead>
        <tr class="border-b border-stone-800 text-stone-400 uppercase text-[11px] font-bold">
          <th class="py-3 px-3">{t.tierCol}</th>
          <th class="py-3 px-3">{t.barracksCol}</th>
          <th class="py-3 px-3">{t.mightCol}</th>
          <th class="py-3 px-3">{t.loadCol}</th>
          <th class="py-3 px-3">{t.speedCol}</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-800/60 text-stone-300">
        {barracksProgression.map((b: any) => {
          const isHigh = parseInt(b.tier.replace('T', ''), 10) >= 8;
          return (
            <tr class={`transition-colors hover:bg-stone-900/60 ${isHigh ? 'bg-red-950/15 font-semibold' : ''}`}>
              <td class="py-3 px-3 font-black text-stone-100">
                <span class={`inline-block rounded px-2 py-0.5 text-xs ${isHigh ? 'bg-red-900 text-red-200' : 'bg-stone-800 text-stone-300'}`}>
                  {b.tier}
                </span>
              </td>
              <td class="py-3 px-3 text-plague-300 font-bold">
                {t.polygonLevelPrefix} {b.level}
              </td>
              <td class="py-3 px-3 text-amber-300 font-mono">
                +{b.mightPerTroop}
              </td>
              <td class="py-3 px-3 font-mono text-stone-300">
                {b.load}
              </td>
              <td class="py-3 px-3 font-mono text-stone-400">
                {b.speed}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</section>
