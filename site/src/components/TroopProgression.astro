    triangleTitle: '🔄 战斗克制关系 (+20% 伤害)：',
    warriorBeat: '战士克制游侠',
    rangerBeat: '游侠克制术士',
    warlockBeat: '术士克制战士',
    bonusNote: '拥有兵种克制优势的部队将造成 +20% 伤害，并减免受到的反击伤害。',
    tableTitle: '训练场里程碑与兵种阶级',
    tierCol: '阶级',
    barracksCol: '所需训练场等级',
    mightCol: '单兵战力',
    loadCol: '资源负重',
    speedCol: '基础速度',
    polygonLevelPrefix: '',
  },
  'zh-tw': {
    title: '⚔️ T1–T10 兵種進階與陣營剋制關係',
    subtitle: '基於遊戲引擎數據提取的訓練場升級里程碑、戰力加成及陣營剋制機制。',
    buildingClarificationTitle: '🏰 訓練場與兵營的作用區別：',
    trainingGroundRole: '訓練場 (Training Grounds)：用於訓練士兵，並隨着建築等級提升解鎖更高兵階 (T1–T10)。',
    barracksRole: '兵營 (Barracks)：作爲集結中轉點，用於提升部隊總容量上限。',
    triangleTitle: '🔄 戰鬥剋制關係 (+20% 傷害)：',
    warriorBeat: '戰士剋制遊俠',
    rangerBeat: '遊俠剋制術士',
    warlockBeat: '術士剋制戰士',
    bonusNote: '擁有兵種剋制優勢的部隊將造成 +20% 傷害，並減免受到的反擊傷害。',
    tableTitle: '訓練場里程碑與兵種階級',
    tierCol: '階級',
    barracksCol: '所需訓練場等級',
    mightCol: '單兵戰力',
    loadCol: '資源負重',
    speedCol: '基礎速度',
    polygonLevelPrefix: '',
  },
  pl: {
    title: '⚔️ Progresja jednostek T1–T10 i trójkąt kontr frakcji',
    subtitle: 'Kamienie milowe ulepszeń poligonu dla każdego poziomu jednostek, skalowanie potęgi (Might) oraz mechanika starć frakcji wyodrębniona z tabel silnika gry.',
    buildingClarificationTitle: '🏰 Role: Poligon (Training Grounds) vs. Koszary (Barracks):',
    trainingGroundRole: 'Poligon (Training Grounds): szkoli żołnierzy i odblokowuje wyższe poziomy (T1–T10) wraz z ulepszaniem budynku.',
    barracksRole: 'Koszary (Barracks): służą jako punkt zbiórki wojsk i zwiększają całkowity limit pojemności armii.',
    triangleTitle: '🔄 Przewaga trójkąta walki (+20% obrażeń):',
    warriorBeat: 'Wojownicy kontrują Łuczników',
    rangerBeat: 'Łucznicy kontrują Czarnoksiężników',
