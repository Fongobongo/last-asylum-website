const t = ui[lang] || ui.en;
---

<GuidePage
  title={heroDisplayName}
  description={hero.role}
  lang={lang}
  breadcrumbs={breadcrumbs}
>
  <!-- Hero Portrait -->
  <img
    src={`/game/heroes/${hero.slug}.png`}
    alt={heroDisplayName}
    width="128"
    height="128"
    class="not-prose mb-4 h-28 w-28 rounded-2xl border border-white/10 object-cover shadow-lg"
    onerror="this.remove()"
  />
  <!-- Hero Badges Header -->
  <div class="not-prose mb-6 flex flex-wrap items-center gap-2">
    <span class={`rounded-lg px-2.5 py-1 text-xs font-bold ${hero.tier === 'S' ? 'bg-red-950/80 border border-red-500/40 text-red-300 shadow-[0_0_12px_rgba(239,68,68,0.2)]' : hero.tier === 'A' ? 'bg-amber-950/80 border border-amber-500/40 text-amber-300' : 'bg-sky-950/80 border border-sky-500/40 text-sky-300'}`}>
      {hero.tier} {t.tierBadge}
    </span>
    <span class="rounded-lg bg-stone-900 border border-stone-800 px-2.5 py-1 text-xs font-semibold text-plague-300">
      {hero.rarity}
    </span>
    <span class="rounded-lg bg-stone-900 border border-stone-800 px-2.5 py-1 text-xs text-stone-300">
      {hero.faction}
    </span>
    <span class="rounded-lg bg-stone-900 border border-stone-800 px-2.5 py-1 text-xs text-stone-400">
      {hero.className}
    </span>

    {weaponName && (
      <span class="inline-flex items-center gap-1.5 rounded-lg border border-amber-500/30 bg-amber-950/50 px-2.5 py-1 text-xs font-semibold text-amber-300">
        <span>⚔️</span>
        <span>{t.weaponLabel}: <strong>{weaponName}</strong></span>
      </span>
    )}

    {traitName && (
      <span class="inline-flex items-center gap-1.5 rounded-lg border border-stone-700 bg-stone-900 px-2.5 py-1 text-xs text-stone-300">
        <span>✨</span>
        <span>{t.traitLabel}: {traitName}</span>
      </span>
    )}
  </div>

  {awakeningBanner && (
    <a href={awakeningHref} class="not-prose mb-5 flex items-center gap-2.5 rounded-xl border border-plague-600/40 bg-plague-950/40 px-4 py-3 text-sm font-medium text-plague-200 hover:border-plague-500 hover:text-plague-100">
      {awakeningBanner}
    </a>
  )}

  <!-- Recruitment Quote -->
  {previewQuote && (
    <div class="not-prose my-5 rounded-xl border border-stone-800/80 bg-stone-900/50 p-4 italic text-stone-300 shadow-inner">
      <p class="flex items-start gap-2.5 text-sm sm:text-base">
        <span class="text-xl text-plague-400">💬</span>
        <span>«{previewQuote}»</span>
      </p>
    </div>
  )}

  <!-- Official Lore / Dossier -->
  {heroStory && heroStory.length > 10 && (
    <div class="not-prose my-6 rounded-xl border border-stone-800/90 bg-stone-950/60 p-4 sm:p-5">
      <h3 class="flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-stone-400">
        {t.dossierTitle}
      </h3>
      <p class="mt-2 text-xs leading-relaxed text-stone-300 sm:text-sm">
        {heroStory}
      </p>
    </div>
  )}

  <!-- Official Skills Breakdown (5 Slots) -->
  {officialSkills && officialSkills.length > 0 ? (
    <div class="not-prose my-8 space-y-4">
      <div class="border-b border-stone-800 pb-3">
        <h2 class="text-xl font-black text-stone-100 sm:text-2xl">
          {t.officialSkillsTitle}
        </h2>
        <p class="mt-1 text-xs text-stone-400 sm:text-sm">
          {t.officialSkillsSubtitle}
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-1">
        {officialSkills.map((s: any) => {
          const slotTitle = (t.slotNames as any)[s.slot] || `Slot ${s.slot}`;
          const skillTitle = s.name?.[lang] || s.name?.en || 'Skill';
          const typeDesc = s.type?.[lang] || s.type?.en;
          const dmgType = s.dmgType?.[lang] || s.dmgType?.en;
          const descText = s.desc?.[lang] || s.desc?.en;

          return (
            <div class="rounded-xl border border-stone-800 bg-stone-900/70 p-4 transition-colors hover:border-stone-700 sm:p-5">
              <div class="flex flex-wrap items-center justify-between gap-2 border-b border-stone-800/80 pb-3">
                <div>
                  <span class="text-xs font-semibold uppercase tracking-wider text-plague-400">
                    {slotTitle}
                  </span>
                  <h3 class="mt-0.5 text-base font-bold text-stone-100 sm:text-lg">
                    {skillTitle}
                  </h3>
                </div>

                <div class="flex flex-wrap items-center gap-1.5">
                  {typeDesc && (
                    <span class="rounded bg-stone-800 px-2 py-0.5 text-xs font-medium text-stone-300">
                      {typeDesc}
                    </span>
                  )}
                  {dmgType && (
                    <span class="rounded bg-stone-800 border border-stone-700 px-2 py-0.5 text-xs font-medium text-plague-300">
                      {dmgType}
                    </span>
                  )}
                </div>
              </div>

              <p class="mt-3 text-xs leading-relaxed text-stone-300 sm:text-sm">
                {descText}
              </p>

              <!-- Level upgrades list -->
              {s.upgrades && s.upgrades.length > 0 && (
                <div class="mt-3.5 rounded-lg border border-stone-800/90 bg-stone-950/60 p-3">
                  <span class="text-[11px] font-bold uppercase tracking-wider text-amber-400/90">
                    {t.levelScaling}
                  </span>
                  <ul class="mt-2 space-y-1.5">
                    {s.upgrades.map((u: any) => {
                      const eff = u.effect?.[lang] || u.effect?.en;
                      return (
                        <li class="flex items-start gap-2 text-xs text-stone-300">
                          <span class="font-bold text-amber-300/90">Lv.{u.level}:</span>
                          <span>{eff}</span>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  ) : (
    <!-- Fallback community skills if official 5-slot not present -->
    <div class="not-prose my-6">
      <h2 class="mb-3 text-lg font-bold text-plague-200">{t.build}</h2>
      <div class="space-y-3">
        {hero.skills.map((s) => (
          <div class="rounded-xl border border-stone-800/90 bg-stone-900/60 p-4">
            <p class="font-bold text-plague-200">{s.name}</p>
            <p class="mt-1 text-sm text-stone-400 leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Tactical Community Guide -->
  <div class="border-t border-stone-800/80 pt-6">
    <h2 class="text-xl font-black text-stone-100 sm:text-2xl">
      {t.tacticalGuideTitle}
    </h2>

    <h3 id="how-to-get" class="mt-6 text-base font-bold text-plague-300 sm:text-lg">
      {t.howToGet}
    </h3>
    <p class="mt-2 text-sm leading-relaxed text-stone-300">
      {hero.howToGet}
    </p>

    <h3 id="build" class="mt-6 text-base font-bold text-plague-300 sm:text-lg">
      {t.build}
    </h3>
    <ul class="mt-2 space-y-2 text-sm text-stone-300">
      {hero.buildTips.map((tip) => (
        <li class="flex items-start gap-2">
          <span class="mt-1.5 block h-1.5 w-1.5 shrink-0 rounded-full bg-plague-400" />
          <span>{tip}</span>
        </li>
      ))}
    </ul>

    <h3 id="teams" class="mt-6 text-base font-bold text-plague-300 sm:text-lg">
      {t.teams}
    </h3>
    <p class="mt-2 text-sm leading-relaxed text-stone-300">
      {hero.teamNotes}
    </p>

    {(hero.video || hero.deepdiveVideo) && (
      <div class="not-prose my-8">
        <h3 class="mb-4 text-lg font-bold text-plague-200 flex items-center gap-2">
          <span>🎥</span>
          <span>{t.video}</span>
        </h3>
        <div class="grid gap-4 sm:grid-cols-2">
          {hero.deepdiveVideo && (
            <div class="overflow-hidden rounded-xl border border-stone-800 bg-stone-900/80 p-3.5 shadow-lg flex flex-col justify-between">
              <div>
                <div class="mb-2 flex items-center justify-between">
                  <span class="inline-flex items-center gap-1.5 text-xs font-bold text-toxic-300">
                    <span>⚡</span> {t.videoDeepdive ?? '20-Second Deepdive'}
                  </span>
                  <span class="rounded bg-black/60 px-2 py-0.5 text-[10px] font-mono text-stone-400 border border-stone-800">20s</span>
                </div>
                <div
                  class="js-video-facade group relative aspect-video cursor-pointer overflow-hidden rounded-lg border border-stone-800 hover:border-toxic-400 transition"
                  data-video-id={hero.deepdiveVideo}
                  role="button"
                  tabindex="0"
                  aria-label="Play 20s deepdive"
                >
                  <span class="block aspect-video overflow-hidden bg-stone-900">
                    <img
                      src={`https://i.ytimg.com/vi/${hero.deepdiveVideo}/hqdefault.jpg`}
                      alt={`${heroDisplayName} 20s deepdive`}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                  </span>
                  <span class="pointer-events-none absolute inset-0 flex items-center justify-center bg-black/40 transition-opacity group-hover:bg-black/25">
                    <span class="flex h-11 w-11 items-center justify-center rounded-full bg-toxic-400 text-black text-sm pl-0.5 shadow-[0_0_15px_rgba(180,255,57,0.4)] group-hover:scale-110 transition-transform font-bold">
                      ▶
                    </span>
                  </span>
                </div>
              </div>
              <p class="mt-2 text-xs text-stone-400">Korpez Gaming • Quick build & skill overview</p>
            </div>
          )}

          {hero.video && (
            <div class="overflow-hidden rounded-xl border border-stone-800 bg-stone-900/80 p-3.5 shadow-lg flex flex-col justify-between">
              <div>
                <div class="mb-2 flex items-center justify-between">
                  <span class="inline-flex items-center gap-1.5 text-xs font-bold text-plague-300">
                    <span>🎯</span> {t.videoFull ?? 'Full Tactical Breakdown'}
                  </span>
                  <span class="rounded bg-black/60 px-2 py-0.5 text-[10px] font-mono text-stone-400 border border-stone-800">In-Depth</span>
                </div>
                <div
                  class="js-video-facade group relative aspect-video cursor-pointer overflow-hidden rounded-lg border border-stone-800 hover:border-plague-500 transition"
                  data-video-id={hero.video}
                  role="button"
                  tabindex="0"
                  aria-label="Play full video guide"
                >
                  <span class="block aspect-video overflow-hidden bg-stone-900">
                    <img
                      src={`https://i.ytimg.com/vi/${hero.video}/hqdefault.jpg`}
                      alt={`${heroDisplayName} video guide`}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                  </span>
                  <span class="pointer-events-none absolute inset-0 flex items-center justify-center bg-black/40 transition-opacity group-hover:bg-black/25">
                    <span class="flex h-11 w-11 items-center justify-center rounded-full bg-blood-600/90 text-white text-base pl-0.5 shadow-[0_0_20px_rgba(225,29,72,0.6)] group-hover:scale-110 transition-transform">
                      ▶
                    </span>
                  </span>
                </div>
              </div>
              <p class="mt-2 text-xs text-stone-400">Korpez Gaming • Comprehensive tactical breakdown</p>
            </div>
          )}
        </div>
      </div>
    )}

    <p class="mt-8">
      <a
        href={lang === 'en' ? '/codex/' : `/${lang}/codex/`}
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-plague-400 hover:text-plague-300 hover:underline"
      >
        {t.allHeroes}
      </a>
    </p>

    <DiscordBanner lang={lang} />
  </div>
</GuidePage>

<script>
  document.querySelectorAll('.js-video-facade').forEach((el) => {
    el.addEventListener('click', () => {
      const id = (el as HTMLElement).dataset.videoId;
      if (!id) return;
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
      frame.title = 'Video guide';
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      frame.allowFullscreen = true;
      frame.className = 'aspect-video w-full max-w-lg rounded-lg';
      el.replaceWith(frame);
    });
  });
</script>
