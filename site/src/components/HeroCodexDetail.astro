---
import type { HeroCodex } from '../data/heroCodex';
import type { Lang } from '../i18n/utils';
import DiscordBanner from './DiscordBanner.astro';
import GuidePage from './GuidePage.astro';
import officialHeroesData from '../data/officialHeroes.json';

interface Props {
  hero: HeroCodex;
  lang: Lang;
  breadcrumbs: { label: string; href?: string }[];
}

const { hero, lang, breadcrumbs } = Astro.props;

// Heroes with known awakening trees get an interlink banner to the awakening deep-dive.
const AWAKENED_SLUGS = new Set(['marlena', 'cynthia', 'annie']);
const awakeningBanner = AWAKENED_SLUGS.has(hero.slug)
  ? (lang === 'ru'
      ? '🌟 У этого героя есть разблокированное Пробуждение — механика, осколки и что качать: раздел «Awakening» в гайде по героям →'
      : '🌟 This hero has an Awakening tree unlocked — mechanics, shards and what to buy: the Awakening section of the Heroes guide →')
  : null;
const awakeningHref = lang === 'ru' ? '/ru/heroes/#awakening-walkthrough' : '/heroes/#awakening-walkthrough';

const officialData = hero.officialId ? (officialHeroesData as any)[hero.officialId.toString()] : null;

// Localized hero name & details
const heroDisplayName = officialData?.names?.[lang] || hero.names?.[lang] || hero.name;
const weaponName = officialData?.weapons?.[lang] || hero.exclusiveWeapon?.[lang];
const traitName = officialData?.trait?.[lang];
const previewQuote = officialData?.previewQuote?.[lang];
const heroStory = officialData?.story?.[lang];
const officialSkills = officialData?.officialSkills || [];

const ui = {
