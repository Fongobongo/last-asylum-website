---
import type { Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const isRu = lang === 'ru';

// UI strings localized for all 19 langs (fallback to EN). Gallery items keep
// RU titles for ru and EN titles otherwise — image files themselves are
// mostly RU-sourced, so each card shows an explicit image-language badge
// instead of rendering silently "empty" for untranslated locales.
const ui = {
  all: { en: 'All Posters', ru: 'Все схемы', de: 'Alle Poster', es: 'Todos', fr: 'Tous', id: 'Semua', ja: 'すべて', ko: '전체', pt: 'Todos', ar: 'كل الملصقات', it: 'Tutti i poster', ms: 'Semua Poster', nl: 'Alle posters', th: 'โปสเตอร์ทั้งหมด', tr: 'Tüm Posterler', vi: 'Tất cả Áp phích', zh: '全部海报', pl: 'Wszystkie plakaty', 'zh-tw': '全部海報' },
  gear: { en: 'Gear & Relics', ru: 'Снаряжение и реликвии', de: 'Ausrüstung', es: 'Equipo', fr: 'Équipement', id: 'Gear', ja: '装備', ko: '장비', pt: 'Equipamento', ar: 'العتاد والآثار', it: 'Equipaggiamento e reliquie', ms: 'Gear & Relik', nl: 'Uitrusting & Relikwieën', th: 'อุปกรณ์ & วัตถุโบราณ', tr: 'Ekipman & Kalıntılar', vi: 'Trang bị & Di vật', zh: '装备与遗物', pl: 'Ekwipunek i relikwie', 'zh-tw': '裝備與遺物' },
  events: { en: 'Events & Duels', ru: 'События и Дуэль', de: 'Events & Duelle', es: 'Eventos', fr: 'Événements', id: 'Event', ja: 'イベント', ko: '이벤트', pt: 'Eventos', ar: 'الفعاليات والمبارزات', it: 'Eventi e duelli', ms: 'Acara & Duel', nl: 'Evenementen & Duels', th: 'กิจกรรม & ดวล', tr: 'Etkinlikler & Düellolar', vi: 'Sự kiện & Đấu tay đôi', zh: '活动与对决', pl: 'Wydarzenia i pojedynki', 'zh-tw': '活動與對決' },
  era: { en: 'Era of Rebirth', ru: 'Эра Возрождения', de: 'Ära der Wiedergeburt', es: 'Era del Renacer', fr: 'Ère du Renouveau', id: 'Era Kelahiran', ja: '再生の時代', ko: '부활의 시대', pt: 'Era do Renascimento', ar: 'عصر النهضة', it: 'Era della Rinascita', ms: 'Era Kelahiran Semula', nl: 'Tijdperk van Heropleving', th: 'ยุคแห่งการฟื้นคืน', tr: 'Diriliş Dönemi', vi: 'Kỷ nguyên Hồi sinh', zh: '复苏纪元', pl: 'Era Odrodzenia', 'zh-tw': '復甦紀元' },
  base: { en: 'Base & Tech', ru: 'База и наука', de: 'Basis & Tech', es: 'Base', fr: 'Base', id: 'Markas', ja: '基地', ko: '기지', pt: 'Base', ar: 'القاعدة والتكنولوجيا', it: 'Base e tecnologia', ms: 'Pangkalan & Teknologi', nl: 'Basis & Tech', th: 'ฐาน & เทคโนโลยี', tr: 'Üs & Teknoloji', vi: 'Căn cứ & Công nghệ', zh: '基地与科技', pl: 'Baza i technologia', 'zh-tw': '基地與科技' },
  economy: { en: 'Economy & Shop', ru: 'Экономика и магазин', de: 'Wirtschaft', es: 'Economía', fr: 'Économie', id: 'Ekonomi', ja: '経済', ko: '경제', pt: 'Economia', ar: 'الاقتصاد والمتجر', it: 'Economia e negozio', ms: 'Ekonomi & Kedai', nl: 'Economie & Winkel', th: 'เศรษฐกิจ & ร้านค้า', tr: 'Ekonomi & Mağaza', vi: 'Kinh tế & Cửa hàng', zh: '经济与商店', pl: 'Ekonomia i sklep', 'zh-tw': '經濟與商店' },
  heroes: { en: 'Heroes & Squads', ru: 'Герои и отряды', de: 'Helden', es: 'Héroes', fr: 'Héros', id: 'Hero', ja: '英雄', ko: '영웅', pt: 'Heróis', ar: 'الأبطال والتشكيلات', it: 'Eroi e squadre', ms: 'Hero & Skuad', nl: 'Helden & Squads', th: 'ฮีโร่ & ทีม', tr: 'Kahramanlar & Birlikler', vi: 'Anh hùng & Đội hình', zh: '英雄与阵容', pl: 'Bohaterowie i oddziały', 'zh-tw': '英雄與陣容' },
  enlarge: { en: 'Enlarge', ru: 'Увеличить', de: 'Vergrößern', es: 'Ampliar', fr: 'Agrandir', id: 'Perbesar', ja: '拡大', ko: '확대', pt: 'Ampliar', ar: 'تكبير', it: 'Ingrandisci', ms: 'Besarkan', nl: 'Vergroten', th: 'ขยาย', tr: 'Büyüt', vi: 'Phóng to', zh: '放大', pl: 'Powiększ', 'zh-tw': '放大' },
  download: { en: 'Download ↗', ru: 'Скачать ↗', de: 'Download ↗', es: 'Descargar ↗', fr: 'Télécharger ↗', id: 'Unduh ↗', ja: 'ダウンロード ↗', ko: '다운로드 ↗', pt: 'Baixar ↗', ar: 'تحميل ↗', it: 'Scarica ↗', ms: 'Muat Turun ↗', nl: 'Downloaden ↗', th: 'ดาวน์โหลด ↗', tr: 'İndir ↗', vi: 'Tải xuống ↗', zh: '下载 ↗', pl: 'Pobierz ↗', 'zh-tw': '下載 ↗' },
} as const;
type UiKey = keyof typeof ui;
const t = (k: UiKey) => (ui[k] as Record<string, string>)[lang] ?? ui[k].en;
const imgLang = (src: string) => {
  if (src.includes('cheese-trap')) return 'RU';
  const m = src.match(/-([a-z]{2}(?:-[a-z]{2})?)\.(?:webp|png|jpg)$/i);
  if (m) return m[1].toUpperCase();
  if (src.includes('-ru.')) return 'RU';
  if (src.includes('-en.')) return 'EN';
  return 'EN';
};

import translations from '../data/infographicsTranslations.json';

const rawGallery = [
  // Gear & Relics
  { id: 'gear-craft', category: 'gear', src: '/infographics/gear-craft-priority-ru.webp', author: 'promethev (RU)' },
  { id: 'relics-1', category: 'gear', src: '/infographics/relics-guide-part1-ru.webp', author: 'promethev (RU)' },
  { id: 'relics-2', category: 'gear', src: '/infographics/relics-guide-part2-ru.webp', author: 'promethev (RU)' },
  { id: 'skill-scaling', category: 'gear', src: '/infographics/skill-scaling.webp', author: 'HottChoklit' },

  // Events & Duels
  { id: 'falcon-tower-storage', category: 'events', src: '/infographics/falcon-tower-storage.webp', author: '#252 Dalkongss' },
  { id: 'troops-training', category: 'events', src: '/infographics/troops-training-strategy-ru.webp', author: 'promethev (RU)' },
  { id: 'duel-day-guide', category: 'events', src: '/infographics/duel-day-guide.webp', author: 'community' },
  { id: 'undead-siege', category: 'events', src: '/infographics/undead-siege-guide.webp', author: 'community' },
  { id: 'undead-siege-2', category: 'events', src: '/infographics/undead-siege-guide-2.webp', author: 'community' },
  { id: 'canyon-rats', category: 'events', src: '/infographics/canyon-crystal-rats-ru.webp', author: 'promethev (RU)' },
  { id: 'crystal-mine', category: 'events', src: '/infographics/crystal-mine-strategy-ru.webp', author: 'promethev (RU)' },
  { id: 'royal-city', category: 'events', src: '/infographics/royal-city-tactics-ru.webp', author: 'promethev (RU)' },
  { id: 'royal-scramble', category: 'events', src: '/infographics/royal-scramble.webp', author: 'cinorafist' },
  { id: 'elixir-guide', category: 'events', src: '/infographics/elixir-guide.webp', author: 'community' },
  { id: 'cheese-trap', category: 'events', src: '/infographics/cheese-trap.webp', author: 'community' },

  // Era of Rebirth
  { id: 'hero-awakening', category: 'era', src: '/infographics/hero-awakening-ru.jpg', author: 'promethev (RU)' },
  { id: 'era-monsters', category: 'era', src: '/infographics/era-monsters-infection-ru.jpg', author: 'promethev (RU)' },
  { id: 'era-royal', category: 'era', src: '/infographics/era-royal-city-ru.webp', author: 'promethev (RU)' },

  // Base & Economy
  { id: 'sanctuary-guide', category: 'base', src: '/infographics/sanctuary-guide.webp', author: 'Last Asylum Community' },
  { id: 'building-speed', category: 'base', src: '/infographics/building-speed-formula-ru.webp', author: 'promethev (RU)' },
  { id: 'tech-order', category: 'base', src: '/infographics/tech-research-order-ru.webp', author: 'promethev (RU)' },
  { id: 'diamond-shop', category: 'economy', src: '/infographics/diamond-shop-guide-ru.jpg', author: 'promethev (RU)' },
  { id: 'raven-epigraph', category: 'heroes', src: '/infographics/raven-epigraph-priority-ru.webp', author: 'promethev (RU)' },
  { id: 'squad-damage', category: 'heroes', src: '/infographics/squad-damage-guide-ru.webp', author: 'promethev (RU)' },
] as const;

export interface InfographicItem {
  id: string;
  title: string;
  category: 'gear' | 'events' | 'era' | 'economy' | 'base' | 'heroes';
  src: string;
  author: string;
  desc: string;
}

const getInfographicSrc = (id: string, defaultSrc: string, currentLang: Lang): string => {
  if (id === 'sanctuary-guide') {
    return `/infographics/sanctuary-guide-${currentLang}.webp`;
  }
  if (id === 'falcon-tower-storage') {
    return currentLang === 'ru' ? '/infographics/falcon-tower-storage-ru.webp' : '/infographics/falcon-tower-storage.webp';
  }
  if (id === 'royal-scramble') {
    return currentLang === 'ru' ? '/infographics/royal-scramble-ru.webp' : '/infographics/royal-scramble.webp';
  }
  return defaultSrc;
};

const gallery: InfographicItem[] = rawGallery.map((item) => {
  const itemTrans = (translations as Record<string, { title: Record<string, string>; desc: Record<string, string> }>)[item.id];
  const title = itemTrans?.title?.[lang] ?? itemTrans?.title?.en ?? itemTrans?.title?.ru ?? item.id;
  const desc = itemTrans?.desc?.[lang] ?? itemTrans?.desc?.en ?? itemTrans?.desc?.ru ?? '';
  const src = getInfographicSrc(item.id, item.src, lang);

  return {
    id: item.id,
    title,
    category: item.category,
    src,
    author: item.author,
    desc,
  };
});

const categories = [
  { id: 'all', label: t('all') },
  { id: 'gear', label: t('gear') },
  { id: 'events', label: t('events') },
  { id: 'era', label: t('era') },
  { id: 'base', label: t('base') },
  { id: 'economy', label: t('economy') },
  { id: 'heroes', label: t('heroes') },
];
---

<div class="infographics-hub not-prose my-8" id="infographics-gallery">
  <!-- Filter Chips -->
  <div class="flex flex-wrap gap-2 mb-8">
    {categories.map((c, idx) => (
      <button
        type="button"
        data-cat={c.id}
        class={`ig-filter-btn rounded-xl border px-3.5 py-2 text-xs font-semibold transition ${idx === 0 ? 'active border-toxic-400 bg-toxic-500/20 text-toxic-300 shadow-[0_0_12px_rgba(180,255,57,0.2)]' : 'border-white/10 bg-black/40 text-stone-400 hover:text-white hover:bg-white/10'}`}
      >
        {c.label}
      </button>
    ))}
  </div>

  <!-- Cards Grid -->
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="ig-grid">
    {gallery.map((item) => (
      <div id={item.id} class="ig-card group overflow-hidden rounded-2xl border border-white/[0.08] bg-stone-900/60 p-4 transition-all hover:border-toxic-500/50 hover:bg-stone-900/90 shadow-lg flex flex-col justify-between scroll-mt-24" data-category={item.category}>
        <div>
          <!-- Thumbnail with Zoom Trigger -->
          <div
            role="button"
            tabindex="0"
            aria-label={`${t('enlarge')}: ${item.title}`}
            class="relative overflow-hidden rounded-xl bg-black/60 aspect-[4/3] cursor-zoom-in group-hover:shadow-2xl transition focus-visible:outline-2 focus-visible:outline-toxic-400"
            data-src={item.src}
            data-title={item.title}
            data-author={item.author}
          >
            <img src={item.src} alt={item.title} loading="lazy" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
            <span class="absolute left-2 top-2 rounded-md bg-black/75 px-1.5 py-0.5 text-[10px] font-bold text-stone-300 border border-white/15 backdrop-blur-sm">
              {imgLang(item.src)}
            </span>
            <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
              <span class="rounded-full bg-black/80 px-3 py-1 text-xs font-semibold text-white border border-white/20 backdrop-blur-sm shadow-xl">
                🔍 {t('enlarge')}
              </span>
            </div>
          </div>

          <div class="mt-3.5">
            <h4 class="text-sm font-bold text-white group-hover:text-toxic-300 transition line-clamp-1">{item.title}</h4>
            <p class="mt-1 text-xs text-stone-400 line-clamp-2 leading-relaxed">{item.desc}</p>
          </div>
        </div>

        <div class="mt-4 flex items-center justify-between border-t border-white/5 pt-3 text-[11px] text-stone-500 font-mono">
          <span>© {item.author}</span>
          <a href={item.src} target="_blank" rel="noopener noreferrer" class="hover:text-toxic-300 transition" download>
            {t('download')}
          </a>
        </div>
      </div>
    ))}
  </div>

  <!-- Fullscreen Modal Lightbox -->
  <div id="ig-lightbox" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/90 backdrop-blur-md p-4 sm:p-6 transition-opacity select-none">
    <div class="relative max-h-full max-w-5xl w-full flex flex-col items-center">
      <!-- Top Bar -->
      <div class="w-full flex items-center justify-between pb-3 text-white">
        <div class="flex items-center gap-2">
          <span class="text-sm font-bold text-toxic-300 font-sans" id="ig-lb-title"></span>
          <span class="text-xs text-stone-500 font-mono" id="ig-lb-author"></span>
        </div>
        <div class="flex items-center gap-2">
          <a id="ig-lb-download" href="#" target="_blank" rel="noopener noreferrer" class="rounded-lg border border-white/10 bg-white/5 px-2.5 py-1 text-xs text-stone-300 hover:text-white hover:bg-white/10 transition">
            {isRu ? 'Оригинал ↗' : 'Original ↗'}
          </a>
          <button type="button" id="ig-lb-close" class="h-8 w-8 rounded-lg border border-white/10 bg-white/10 flex items-center justify-center text-sm text-stone-300 hover:text-white hover:bg-white/20 transition cursor-pointer">
            ✕
          </button>
        </div>
      </div>

      <!-- Image Display -->
      <div class="relative overflow-auto max-h-[82vh] w-full flex justify-center rounded-xl border border-white/10 bg-black/60 p-1 shadow-2xl">
        <img id="ig-lb-img" src="" alt="Infographic" class="max-h-[80vh] w-auto object-contain rounded-lg transition-transform" />
      </div>
    </div>
  </div>
</div>

<script>
  function initGallery() {
    const root = document.getElementById('infographics-gallery');
    if (!root) return;

    const filterBtns = root.querySelectorAll('.ig-filter-btn');
    const cards = root.querySelectorAll('.ig-card');

    const lightbox = document.getElementById('ig-lightbox');
    const lbImg = document.getElementById('ig-lb-img') as HTMLImageElement;
    const lbTitle = document.getElementById('ig-lb-title');
    const lbAuthor = document.getElementById('ig-lb-author');
    const lbDownload = document.getElementById('ig-lb-download') as HTMLAnchorElement;
    const lbClose = document.getElementById('ig-lb-close');

    // Filtering
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove('active', 'border-toxic-400', 'bg-toxic-500/20', 'text-toxic-300', 'shadow-[0_0_12px_rgba(180,255,57,0.2)]');
          b.classList.add('border-white/10', 'bg-black/40', 'text-stone-400');
        });
        btn.classList.add('active', 'border-toxic-400', 'bg-toxic-500/20', 'text-toxic-300', 'shadow-[0_0_12px_rgba(180,255,57,0.2)]');
        btn.classList.remove('border-white/10', 'bg-black/40', 'text-stone-400');

        const cat = btn.getAttribute('data-cat') || 'all';
        cards.forEach((c) => {
          const itemCat = c.getAttribute('data-category');
          if (cat === 'all' || itemCat === cat) {
            (c as HTMLElement).style.display = 'flex';
          } else {
            (c as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    // Lightbox open
    const openLightbox = (trigger: Element) => {
      const src = trigger.getAttribute('data-src') || '';
      const title = trigger.getAttribute('data-title') || '';
      const author = trigger.getAttribute('data-author') || '';

      if (lbImg) lbImg.src = src;
      if (lbTitle) lbTitle.textContent = title;
      if (lbAuthor) lbAuthor.textContent = `© ${author}`;
      if (lbDownload) lbDownload.href = src;

      lightbox?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    };
    cards.forEach((card) => {
      const trigger = card.querySelector('[data-src]');
      trigger?.addEventListener('click', () => {
        if (trigger) openLightbox(trigger);
      });
      trigger?.addEventListener('keydown', (e) => {
        if ((e.key === 'Enter' || e.key === ' ') && trigger) {
          e.preventDefault();
          openLightbox(trigger);
        }
      });
    });

    function closeLightbox() {
      lightbox?.classList.add('hidden');
      document.body.style.overflow = '';
      if (lbImg) lbImg.src = '';
    }

    lbClose?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lightbox?.classList.contains('hidden')) {
        closeLightbox();
      }
    });
  }

  document.addEventListener('astro:page-load', initGallery);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGallery);
  } else {
    initGallery();
  }
</script>
