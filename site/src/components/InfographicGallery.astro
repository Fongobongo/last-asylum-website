---
import type { Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const isRu = lang === 'ru';

export interface InfographicItem {
  id: string;
  title: string;
  category: 'gear' | 'events' | 'era' | 'economy' | 'base' | 'heroes';
  src: string;
  author: string;
  desc: string;
}

const gallery: InfographicItem[] = [
  // Gear & Relics
  {
    id: 'gear-craft',
    title: isRu ? 'Приоритет крафта снаряжения' : 'Gear Crafting Priority',
    category: 'gear',
    src: '/infographics/gear-craft-priority-ru.webp',
    author: 'promethev (RU)',
    desc: isRu ? 'Порядок создания и прокачки слотов снаряжения: Сапоги/Оружие → Броня → Шлем.' : 'Order of crafting gear slots: Boots/Weapon first, then Armor and Helmet.',
  },
  {
    id: 'relics-1',
    title: isRu ? 'Сундуки реликвий (Часть 1)' : 'Relics Guide (Part 1)',
    category: 'gear',
    src: '/infographics/relics-guide-part1-ru.webp',
    author: 'promethev (RU)',
    desc: isRu ? 'Дропрейты, гарантированные осколки и распределение реликвий по классам.' : 'Drop rates, guaranteed shards, and relic distribution by class.',
  },
  {
    id: 'relics-2',
    title: isRu ? 'Сундуки реликвий (Часть 2)' : 'Relics Guide (Part 2)',
    category: 'gear',
    src: '/infographics/relics-guide-part2-ru.webp',
    author: 'promethev (RU)',
    desc: isRu ? 'Оптимизация сбора золотых реликвий и синергия параметров отряда.' : 'Gold relic farming optimization and squad stat synergies.',
  },
  {
    id: 'skill-scaling',
    title: isRu ? 'Масштабирование навыков и снаряжения' : 'Skill & Gear Scaling',
    category: 'gear',
    src: '/infographics/skill-scaling.webp',
    author: 'HottChoklit',
    desc: isRu ? 'Почему герои без правильного снаряжения наносят мало урона: формулы скейлинга.' : 'Why heroes feel weak without correct gear stats: scaling math explained.',
  },

  // Events & Duels
  {
    id: 'troops-training',
    title: isRu ? '3-фазная тренировка войск под Дуэль' : '3-Phase Troop Training Strategy',
    category: 'events',
    src: '/infographics/troops-training-strategy-ru.webp',
    author: 'promethev (RU)',
    desc: isRu ? 'Как максимизировать очки в День 5 Дуэли через апгрейд T1 в T8/T9.' : 'Maximize Day 5 Duel points via T1 to T8/T9 promotion loops.',
  },
  {
    id: 'duel-day-guide',
    title: isRu ? 'Дуэль Альянсов: Расписание фаз' : 'Alliance Duel Day-by-Day',
    category: 'events',
    src: '/infographics/duel-day-guide.webp',
    author: 'community',
    desc: isRu ? 'План на каждый день недели для взятия 9-го сундука (7.2M очков).' : 'Weekly routine to claim Chest 9 (7.2M points) every day.',
  },
  {
    id: 'undead-siege',
    title: isRu ? 'Осада зомби: Тактика обороны' : 'Undead Siege Defense Tactics',
    category: 'events',
    src: '/infographics/undead-siege-guide.webp',
    author: 'community',
    desc: isRu ? 'Скрытые механики 2 отрядов на волну и расстановка подкреплений.' : 'Hidden 2-squad per wave rules and reinforcement positioning.',
  },
  {
    id: 'undead-siege-2',
    title: isRu ? 'Осада зомби: Карта волн' : 'Undead Siege Wave Map',
    category: 'events',
    src: '/infographics/undead-siege-guide-2.webp',
    author: 'community',
    desc: isRu ? 'Полный список волн 1–20, состав боссов и тайминги захода.' : 'Waves 1–20 breakdown, boss mechanics, and timing triggers.',
  },
  {
    id: 'canyon-rats',
    title: isRu ? 'Каньон: Кристальные крысы' : 'Canyon Crystal Rats Strategy',
    category: 'events',
    src: '/infographics/canyon-crystal-rats-ru.webp',
    author: 'promethev (RU)',
    desc: isRu ? 'Тактика сбора очков на крысах без потери основных отрядов.' : 'Crystal rat point-farming strategy without frontline attrition.',
  },
  {
    id: 'crystal-mine',
    title: isRu ? 'Каньон: Кристальная шахта' : 'Canyon Crystal Mine Strategy',
    category: 'events',
    src: '/infographics/crystal-mine-strategy-ru.webp',
    author: 'promethev (RU)',
    desc: isRu ? 'Захват центров, ротация баффов и удержание контрольных точек.' : 'Core mine capture, buff rotations, and zone control.',
  },
  {
    id: 'royal-city',
    title: isRu ? 'Королевский город: Тактика боя' : 'Royal City Battle Tactics',
    category: 'events',
    src: '/infographics/royal-city-tactics-ru.webp',
    author: 'promethev (RU)',
    desc: isRu ? 'Позиционирование альянса, тайминги пушей и перехват пушек.' : 'Alliance positioning, assault timing, and cannon interception.',
  },
  {
    id: 'royal-scramble',
    title: isRu ? 'Схватка за Королевский город' : 'Royal Scramble Infographic',
    category: 'events',
    src: '/infographics/royal-scramble-ru.webp',
    author: 'cinorafist',
    desc: isRu ? 'Официальные правила, роли командиров и распределение наград.' : 'Official rules, commander roles, and reward milestones.',
  },
  {
    id: 'elixir-guide',
    title: isRu ? 'Эликсир: Стратегия битвы' : 'Elixir Scramble Strategy',
    category: 'events',
    src: '/infographics/elixir-guide.webp',
    author: 'community',
    desc: isRu ? 'Маршруты сбора бочек, точки засад и распределение ролей.' : 'Barrel routes, ambush zones, and team roles.',
  },
  {
    id: 'cheese-trap',
    title: isRu ? 'Сырная ловушка (Cheese Trap)' : 'Cheese Trap Mechanics',
    category: 'events',
    src: '/infographics/cheese-trap.webp',
    author: 'community',
    desc: isRu ? 'Безопасный фарм наград мышиного короля без риска слива войск.' : 'Safe mouse king farming loops without troop wipeout risks.',
  },

  // Era of Rebirth
  {
    id: 'hero-awakening',
    title: isRu ? 'Пробуждение героев' : 'Hero Awakening System',
    category: 'era',
    src: '/infographics/hero-awakening-ru.jpg',
    author: 'promethev (RU)',
    desc: isRu ? 'Материалы пробуждения, разблокировка 4-го слота и порядок Синтия/Анни/Марлена.' : 'Awakening materials, 4th skill slot unlocks, and priority order.',
  },
  {
    id: 'era-monsters',
    title: isRu ? 'Монстры Эры и заражение' : 'Era Seasonal Monsters & Infection',
    category: 'era',
    src: '/infographics/era-monsters-infection-ru.jpg',
    author: 'promethev (RU)',
    desc: isRu ? 'Уровни заражения, иммунитет отряда и расчет необходимого антидота.' : 'Infection tiers, squad immunity scaling, and antidote requirements.',
  },
  {
    id: 'era-royal',
    title: isRu ? 'Королевский город в Эре Возрождения' : 'Era Royal City Changes',
    category: 'era',
    src: '/infographics/era-royal-city-ru.webp',
    author: 'promethev (RU)',
    desc: isRu ? 'Новые механики защиты столицы с учетом сезонных навыков Эры.' : 'Capital defense changes accounting for seasonal Era mechanics.',
  },

  // Base & Economy
  {
    id: 'building-speed',
    title: isRu ? 'Формула скорости строительства' : 'Building Speed Formula',
    category: 'base',
    src: '/infographics/building-speed-formula-ru.webp',
    author: 'promethev (RU)',
    desc: isRu ? 'Хижина строителя, формула снижения таймеров и бесплатное завершение.' : 'Builder’s Hut speed divisor math and free-completion thresholds.',
  },
  {
    id: 'tech-order',
    title: isRu ? 'Оптимальный порядок технологий' : 'Optimal Research Tech Order',
    category: 'base',
    src: '/infographics/tech-research-order-ru.webp',
    author: 'promethev (RU)',
    desc: isRu ? 'Приоритеты лаборатории: экономика vs военные ветки до T8/T9.' : 'Research lab priorities: economy vs military tree rush to T8/T9.',
  },
  {
    id: 'diamond-shop',
    title: isRu ? 'Магазин алмазов: Что покупать' : 'Diamond Shop Buying Guide',
    category: 'economy',
    src: '/infographics/diamond-shop-guide-ru.jpg',
    author: 'promethev (RU)',
    desc: isRu ? 'Топ покупок за алмазы: VIP 30 дней, ускорения со скидкой 70%, пропуск мусора.' : 'Best diamond investments: 30-day VIP, 70% speedups, and trap offers to skip.',
  },
  {
    id: 'raven-epigraph',
    title: isRu ? 'Приоритет эпиграфов Ворона' : 'Raven Epigraph Priorities',
    category: 'heroes',
    src: '/infographics/raven-epigraph-priority-ru.webp',
    author: 'promethev (RU)',
    desc: isRu ? 'Какую ветку эпиграфов качать первой и какие фракционные статы максить.' : 'Which epigraph branch to max first and optimal faction stat spreads.',
  },
  {
    id: 'squad-damage',
    title: isRu ? 'Формулы и разгон урона отряда' : 'Squad Damage Multipliers',
    category: 'heroes',
    src: '/infographics/squad-damage-guide-ru.webp',
    author: 'promethev (RU)',
    desc: isRu ? 'Влияние фракционных бонусов 3+2 и 5 моно-фракции на чистый DPS.' : 'Impact of 3+2 and 5-mono faction synergy bonuses on effective DPS.',
  },
];

const categories = [
  { id: 'all', label: isRu ? 'Все схемы' : 'All Posters' },
  { id: 'gear', label: isRu ? 'Снаряжение и реликвии' : 'Gear & Relics' },
  { id: 'events', label: isRu ? 'События и Дуэль' : 'Events & Duels' },
  { id: 'era', label: isRu ? 'Эра Возрождения' : 'Era of Rebirth' },
  { id: 'base', label: isRu ? 'База и наука' : 'Base & Tech' },
  { id: 'economy', label: isRu ? 'Экономика и магазин' : 'Economy & Shop' },
  { id: 'heroes', label: isRu ? 'Герои и отряды' : 'Heroes & Squads' },
];
---

<div class="infographics-hub not-prose my-8" id="infographics-gallery">
  <!-- Filter Chips -->
  <div class="flex flex-wrap gap-2 mb-8">
    {categories.map((c, idx) => (
      <button
        type="button"
        data-cat={c.id}
        class={`ig-filter-btn rounded-xl border px-3.5 py-2 text-xs font-semibold transition ${idx === 0 ? 'active border-toxic-400 bg-toxic-500/20 text-toxic-300 shadow-[0_0_12px_rgba(180,255,57,0.2)]' : 'border-white/10 bg-black/40 text-stone-400 hover:text-white hover:bg-white/10'}`}
      >
        {c.label}
      </button>
    ))}
  </div>

  <!-- Cards Grid -->
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="ig-grid">
    {gallery.map((item) => (
      <div class="ig-card group overflow-hidden rounded-2xl border border-white/[0.08] bg-stone-900/60 p-4 transition-all hover:border-toxic-500/50 hover:bg-stone-900/90 shadow-lg flex flex-col justify-between" data-category={item.category}>
        <div>
          <!-- Thumbnail with Zoom Trigger -->
          <div class="relative overflow-hidden rounded-xl bg-black/60 aspect-[4/3] cursor-zoom-in group-hover:shadow-2xl transition" data-src={item.src} data-title={item.title} data-author={item.author}>
            <img src={item.src} alt={item.title} loading="lazy" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
            <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
              <span class="rounded-full bg-black/80 px-3 py-1 text-xs font-semibold text-white border border-white/20 backdrop-blur-sm shadow-xl">
                🔍 {isRu ? 'Увеличить' : 'Enlarge'}
              </span>
            </div>
          </div>

          <div class="mt-3.5">
            <h4 class="text-sm font-bold text-white group-hover:text-toxic-300 transition line-clamp-1">{item.title}</h4>
            <p class="mt-1 text-xs text-stone-400 line-clamp-2 leading-relaxed">{item.desc}</p>
          </div>
        </div>

        <div class="mt-4 flex items-center justify-between border-t border-white/5 pt-3 text-[11px] text-stone-500 font-mono">
          <span>© {item.author}</span>
          <a href={item.src} target="_blank" rel="noopener noreferrer" class="hover:text-toxic-300 transition" download>
            {isRu ? 'Скачать ↗' : 'Download ↗'}
          </a>
        </div>
      </div>
    ))}
  </div>

  <!-- Fullscreen Modal Lightbox -->
  <div id="ig-lightbox" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/90 backdrop-blur-md p-4 sm:p-6 transition-opacity select-none">
    <div class="relative max-h-full max-w-5xl w-full flex flex-col items-center">
      <!-- Top Bar -->
      <div class="w-full flex items-center justify-between pb-3 text-white">
        <div class="flex items-center gap-2">
          <span class="text-sm font-bold text-toxic-300 font-sans" id="ig-lb-title"></span>
          <span class="text-xs text-stone-500 font-mono" id="ig-lb-author"></span>
        </div>
        <div class="flex items-center gap-2">
          <a id="ig-lb-download" href="#" target="_blank" rel="noopener noreferrer" class="rounded-lg border border-white/10 bg-white/5 px-2.5 py-1 text-xs text-stone-300 hover:text-white hover:bg-white/10 transition">
            {isRu ? 'Оригинал ↗' : 'Original ↗'}
          </a>
          <button type="button" id="ig-lb-close" class="h-8 w-8 rounded-lg border border-white/10 bg-white/10 flex items-center justify-center text-sm text-stone-300 hover:text-white hover:bg-white/20 transition cursor-pointer">
            ✕
          </button>
        </div>
      </div>

      <!-- Image Display -->
      <div class="relative overflow-auto max-h-[82vh] w-full flex justify-center rounded-xl border border-white/10 bg-black/60 p-1 shadow-2xl">
        <img id="ig-lb-img" src="" alt="Infographic" class="max-h-[80vh] w-auto object-contain rounded-lg transition-transform" />
      </div>
    </div>
  </div>
</div>

<script>
  function initGallery() {
    const root = document.getElementById('infographics-gallery');
    if (!root) return;

    const filterBtns = root.querySelectorAll('.ig-filter-btn');
    const cards = root.querySelectorAll('.ig-card');

    const lightbox = document.getElementById('ig-lightbox');
    const lbImg = document.getElementById('ig-lb-img') as HTMLImageElement;
    const lbTitle = document.getElementById('ig-lb-title');
    const lbAuthor = document.getElementById('ig-lb-author');
    const lbDownload = document.getElementById('ig-lb-download') as HTMLAnchorElement;
    const lbClose = document.getElementById('ig-lb-close');

    // Filtering
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove('active', 'border-toxic-400', 'bg-toxic-500/20', 'text-toxic-300', 'shadow-[0_0_12px_rgba(180,255,57,0.2)]');
          b.classList.add('border-white/10', 'bg-black/40', 'text-stone-400');
        });
        btn.classList.add('active', 'border-toxic-400', 'bg-toxic-500/20', 'text-toxic-300', 'shadow-[0_0_12px_rgba(180,255,57,0.2)]');
        btn.classList.remove('border-white/10', 'bg-black/40', 'text-stone-400');

        const cat = btn.getAttribute('data-cat') || 'all';
        cards.forEach((c) => {
          const itemCat = c.getAttribute('data-category');
          if (cat === 'all' || itemCat === cat) {
            (c as HTMLElement).style.display = 'flex';
          } else {
            (c as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    // Lightbox open
    cards.forEach((card) => {
      const trigger = card.querySelector('[data-src]');
      trigger?.addEventListener('click', () => {
        const src = trigger.getAttribute('data-src') || '';
        const title = trigger.getAttribute('data-title') || '';
        const author = trigger.getAttribute('data-author') || '';

        if (lbImg) lbImg.src = src;
        if (lbTitle) lbTitle.textContent = title;
        if (lbAuthor) lbAuthor.textContent = `© ${author}`;
        if (lbDownload) lbDownload.href = src;

        lightbox?.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      });
    });

    function closeLightbox() {
      lightbox?.classList.add('hidden');
      document.body.style.overflow = '';
      if (lbImg) lbImg.src = '';
    }

    lbClose?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lightbox?.classList.contains('hidden')) {
        closeLightbox();
      }
    });
  }

  document.addEventListener('astro:page-load', initGallery);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGallery);
  } else {
    initGallery();
  }
</script>
