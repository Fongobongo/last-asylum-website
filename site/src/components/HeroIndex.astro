---
import { getCollection } from 'astro:content';
import type { Lang } from '../i18n/utils';

const { lang, showHub = true } = Astro.props as { lang: Lang; showHub?: boolean };

const SECTION_ORDER: { slug: string; icon: string }[] = [
  { slug: 'hero-basics', icon: '🧭' },
  { slug: 'hero-progression', icon: '📈' },
  { slug: 'hero-awakening-guide', icon: '🔥' },
  { slug: 'hero-squads-tierlist', icon: '✅' },
  { slug: 'hero-shards-guide', icon: '🧤' },
  { slug: 'hero-might-mechanics', icon: '⚙️' },
];

const all = await getCollection('guides');
const sectionSlugs = new Set(SECTION_ORDER.map((s) => s.slug));

const entries = all
  .filter((e) => e.data.lang === lang && e.id.startsWith(`${lang}/heroes/`) && !sectionSlugs.has(e.id.replace(/\.md$/, '').split('/').pop()!))
  .map((e) => ({
    slug: e.id.replace(`${lang}/heroes/`, '').replace(/\.md$/, ''),
    title: e.data.title.split(':')[0].split(',')[0].trim(),
    desc: (e.data.description || '').split('. ')[0] + '.',
  }))
  .sort((a, b) => a.title.localeCompare(b.title));

const base = lang === 'en' ? '' : `/${lang}`;
const H: Record<string, { h: string; d: string }> = {
  ru: { h: 'Гайды по героям', d: `${entries.length} героев: навыки, билды, прокачка, получение и осколки.` },
  en: { h: 'Hero Guides', d: `${entries.length} heroes: skills, builds, leveling, how to unlock, shard sources.` },
  de: { h: 'Helden-Guides', d: `${entries.length} Helden: Fähigkeiten, Builds, Levelaufstieg, Freischaltung, Splitterquellen.` },
  es: { h: 'Guías de Héroes', d: `${entries.length} héroes: habilidades, builds, subida de nivel, cómo desbloquear, fuentes de fragmentos.` },
  pt: { h: 'Guias de Heróis', d: `${entries.length} heróis: habilidades, builds, evolução, como desbloquear, fontes de fragmentos.` },
  fr: { h: 'Guides des héros', d: `${entries.length} héros : compétences, builds, amélioration, méthodes de déblocage, sources de fragments.` },
  id: { h: 'Panduan Pahlawan', d: `${entries.length} pahlawan: keterampilan, build, peningkatan level, cara membuka, sumber pecahan.` },
  ko: { h: '영웅 가이드', d: `${entries.length}명의 영웅: 스킬, 빌드, 육성, 해제 방법, 조각 수급처.` },
  ja: { h: 'ヒーローガイド', d: `${entries.length}人のヒーロー：スキル、ビルド、育成、解放方法、破片の入手先。` },
  ar: { h: 'أدلة الأبطال', d: `أبطال ${entries.length}: المهارات، التصميمات، الارتقاء بالمستوى، طريقة الفتح، مصادر الشظايا.` },
  it: { h: 'Guide degli Eroi', d: `${entries.length} eroi: abilità, build, crescita, come sbloccare, fonti di frammenti.` },
  ms: { h: 'Panduan Hero', d: `${entries.length} hero: kemahiran, binaan, penaiktarafan, cara buka kunci, sumber shard.` },
  nl: { h: 'Heldengidsen', d: `${entries.length} helden: vaardigheden, builds, level omhoog, ontgrendelen, scherfbronnen.` },
  th: { h: 'คู่มือฮีโร่', d: `ฮีโร่ ${entries.length} ตัว: ทักษะ, แนวทางการสร้าง, การอัปเลเวล, วิธีปลดล็อก, แหล่งที่มาของชิ้นส่วน` },
  tr: { h: 'Kahraman Rehberleri', d: `${entries.length} kahraman: beceriler, dizilimler, seviye atlatma, nasıl açılır, parça kaynakları.` },
  vi: { h: 'Hướng dẫn Tướng', d: `${entries.length} tướng: kỹ năng, xây dựng, tăng cấp, cách mở khóa, nguồn mảnh.` },
  zh: { h: '英雄攻略', d: `${entries.length} 名英雄：技能、加点、升级、解锁方式及碎片获取途径。` },
  pl: { h: 'Poradniki do bohaterów', d: `${entries.length} bohaterów: umiejętności, buildy, rozwój, jak odblokować, źródła odłamków.` },
  'zh-tw': { h: '英雄攻略', d: `${entries.length} 位英雄：技能、配點、升級、解鎖方式、碎片來源。` },
};
const tt = H[lang] || H.en;
const LBL: Record<string, string> = { ru: 'Общая информация', en: 'Topics', de: 'Themen', es: 'Temas', pt: 'Tópicos', fr: 'Sujets', id: 'Topik', ko: '주제', ja: 'トピック', ar: 'المواضيع', it: 'Argomenti', ms: 'Topik', nl: 'Onderwerpen', th: 'หัวข้อ', tr: 'Konular', vi: 'Chủ đề', zh: '主题', pl: 'Tematy', 'zh-tw': '主題' };

const sectionCards = showHub
  ? SECTION_ORDER
      .map(({ slug, icon }) => {
        const e = all.find((x) => x.data.lang === lang && x.id.replace(/\.md$/, '') === `${lang}/heroes/${slug}`);
        return e ? { href: `${base}/heroes/${slug}/`, icon, title: e.data.title, desc: e.data.description || '' } : null;
      })
      .filter(Boolean) as { href: string; icon: string; title: string; desc: string }[]
  : [];
---
<section class="py-12">
  {showHub && <h1 class="mb-3 text-4xl font-bold text-plague-100">{tt.h}</h1>}
  {showHub && <p class="mb-10 text-lg text-stone-400">{tt.d}</p>}
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {entries.map((e) => (
      <a href={`${base}/heroes/${e.slug}/`} class="group flex items-start gap-3 rounded-lg border border-stone-800 bg-stone-900 p-4 transition-colors hover:border-plague-600">
        <img src={`/hero-icons/${e.slug}.webp`} alt={e.title} loading="lazy" class="h-14 w-14 shrink-0 rounded-lg object-cover" onerror="this.remove()" />
        <div class="min-w-0">
          <h2 class="text-lg font-bold text-plague-200 group-hover:text-plague-100">{e.title}</h2>
          <p class="mt-1 text-sm text-stone-400">{e.desc}</p>
        </div>
      </a>
    ))}
  </div>

  {sectionCards.length > 0 && (
    <>
      <h2 class="mt-14 mb-6 text-3xl font-bold text-plague-100">{LBL[lang] || LBL.en}</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {sectionCards.map((c) => (
          <a href={c.href} class="group rounded-lg border border-stone-800 bg-stone-900 p-5 transition-colors hover:border-plague-600">
            <h3 class="text-lg font-bold text-plague-200 group-hover:text-plague-100">{c.icon} {c.title}</h3>
            <p class="mt-2 text-sm text-stone-400">{c.desc}</p>
          </a>
        ))}
      </div>
    </>
  )}
</section>
