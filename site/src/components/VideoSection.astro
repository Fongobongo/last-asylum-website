---
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/utils';
import { videosFor, getYouTubeSearchUrl, getTopicName, getSearchQuery } from '../data/videos';
import rawTranscripts from '../data/videoTranscripts.json';

interface TranscriptItem {
  id: string;
  title: string;
  duration: string;
  timestamps: { time: string; label: string }[];
  ru: { time: string; text: string }[];
  en: { time: string; text: string }[];
}

const transcripts = rawTranscripts as Record<string, TranscriptItem>;

interface Props {
  topic: string;
  lang: Lang;
}

const { topic, lang } = Astro.props;
const vids = videosFor(topic, lang);
const topicName = getTopicName(topic, lang);
const ytSearchUrl = getYouTubeSearchUrl(topic, lang);
const queryText = getSearchQuery(topic, lang);

function toSeconds(timeStr: string): number {
  const parts = timeStr.split(':').map(Number);
  if (parts.length === 2) return parts[0] * 60 + parts[1];
  if (parts.length === 3) return parts[0] * 3600 + parts[1] * 60 + parts[2];
  return 0;
}

const videoSchema = JSON.stringify(
  vids.map((v) => ({
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: v.title,
    description: transcripts[v.id]?.title || v.title,
    thumbnailUrl: [
      `https://i.ytimg.com/vi/${v.id}/maxresdefault.jpg`,
      `https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`,
    ],
    embedUrl: `https://www.youtube-nocookie.com/embed/${v.id}`,
    contentUrl: `https://www.youtube.com/watch?v=${v.id}`,
    uploadDate: '2026-01-01T00:00:00Z',
    author: {
      '@type': 'Person',
      name: 'Korpez Gaming',
    },
  }))
);

const langBadges: Record<string, string> = {
  ru: '🇷🇺 RU',
  en: '🇺🇸 EN',
  fr: '🇫🇷 FR',
  pt: '🇧🇷 PT',
  ko: '🇰🇷 KO',
  de: '🇩🇪 DE',
  es: '🇪🇸 ES',
  id: '🇮🇩 ID',
  ja: '🇯🇵 JA',
};
---

{
  vids.length > 0 && (
    <section class="not-prose my-10">
      <div class="mb-4 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
        <h2 class="text-2xl font-bold text-plague-200 flex items-center gap-2">
          <span>🎥</span>
          <span>{t(lang, 'video.section')}</span>
        </h2>
        <p class="text-xs text-stone-400">{t(lang, 'video.subtitle')}</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {vids.map((v) => {
          const tr = transcripts[v.id];
          const lines = tr ? (lang === 'ru' ? (tr.ru.length > 0 ? tr.ru : tr.en) : (tr.en.length > 0 ? tr.en : tr.ru)) : null;

          return (
            <div class="js-video-card group overflow-hidden rounded-xl border border-stone-800 bg-stone-900 transition-colors hover:border-plague-500 flex flex-col justify-between shadow-lg">
              <div>
                <button
                  class="js-video-facade relative block w-full text-left cursor-pointer"
                  data-video-id={v.id}
                  aria-label={v.title ?? 'Play video'}
                >
                  <span class="block aspect-video overflow-hidden bg-stone-800">
                    <img
                      src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`}
                      alt={v.title ?? 'Video guide'}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                  </span>
                  <span class="pointer-events-none absolute inset-0 flex items-center justify-center bg-black/30 opacity-80 transition-opacity group-hover:opacity-100">
                    <span class="flex h-12 w-12 items-center justify-center rounded-full bg-red-600/90 text-xl text-white shadow-lg transition-transform group-hover:scale-110">▶</span>
                  </span>
                  {v.lang && (
                    <span class="absolute right-2 top-2 rounded bg-black/80 px-2 py-0.5 text-xs font-bold text-stone-200 shadow border border-stone-700">
                      {langBadges[v.lang] ?? v.lang.toUpperCase()}
                    </span>
                  )}
                </button>
                <div class="p-3">
                  <p class="line-clamp-2 text-sm font-medium text-stone-200 group-hover:text-plague-200 transition-colors">{v.title}</p>
                </div>
              </div>

              {tr && (tr.timestamps.length > 0 || (lines && lines.length > 0)) && (
                <details class="group/tr border-t border-stone-800/80 bg-stone-950/40 text-xs">
                  <summary class="flex cursor-pointer select-none items-center justify-between px-3 py-2 text-toxic-400/90 hover:text-toxic-300 font-medium transition">
                    <span class="flex items-center gap-1.5">
                      <span>📝</span>
                      <span>{lang === 'ru' ? 'Текстовая расшифровка' : 'Text Transcript'}</span>
                      {tr.duration && <span class="rounded bg-stone-800 px-1.5 py-0.2 text-[10px] font-mono text-stone-400">{tr.duration}</span>}
                    </span>
                    <span class="text-stone-500 text-[10px] group-open/tr:rotate-180 transition-transform">▼</span>
                  </summary>

                  <div class="border-t border-stone-800/60 p-3 bg-black/40 space-y-3">
                    {tr.timestamps.length > 0 && (
                      <div>
                        <div class="text-[10px] font-mono uppercase tracking-wider text-stone-400 mb-1.5">
                          {lang === 'ru' ? 'Таймкоды:' : 'Timestamps:'}
                        </div>
                        <div class="flex flex-wrap gap-1">
                          {tr.timestamps.map((ts) => (
                            <button
                              type="button"
                              class="js-ts-btn inline-flex items-center gap-1 rounded bg-stone-800/90 hover:bg-toxic-400 hover:text-black px-1.5 py-0.5 text-[11px] font-mono text-stone-300 transition cursor-pointer"
                              data-video-id={v.id}
                              data-seconds={toSeconds(ts.time)}
                              title={ts.label}
                            >
                              <span class="font-bold text-toxic-400 hover:text-inherit">[{ts.time}]</span>
                              <span class="truncate max-w-[140px]">{ts.label}</span>
                            </button>
                          ))}
                        </div>
                      </div>
                    )}

                    {lines && lines.length > 0 && (
                      <div>
                        <div class="text-[10px] font-mono uppercase tracking-wider text-stone-400 mb-1.5">
                          {lang === 'ru' ? 'Расшифровка:' : 'Full Transcript:'}
                        </div>
                        <div class="max-h-52 overflow-y-auto space-y-1.5 pr-1 text-stone-300 text-[12px] leading-relaxed font-sans">
                          {lines.map((l) => (
                            <div class="flex items-baseline gap-1.5">
                              <button
                                type="button"
                                class="js-ts-btn shrink-0 font-mono text-[10px] text-toxic-400/80 hover:text-toxic-300 hover:underline cursor-pointer"
                                data-video-id={v.id}
                                data-seconds={toSeconds(l.time)}
                              >
                                [{l.time}]
                              </button>
                              <span>{l.text}</span>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>
                </details>
              )}

              <div class="px-3 pb-3 pt-2 flex items-center justify-between text-xs text-stone-500 border-t border-stone-800/60 mt-auto">
                <span class="inline-flex items-center gap-1">
                  <svg class="h-3.5 w-3.5 text-red-500 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                  <span>YouTube</span>
                </span>
                <a
                  href={`https://www.youtube.com/watch?v=${v.id}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-stone-400 hover:text-plague-300 transition-colors"
                  title="Open in YouTube"
                >
                  ↗
                </a>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Localized YouTube Search Banner -->
      <div class="mt-4 flex flex-col sm:flex-row items-center justify-between gap-3 rounded-lg border border-stone-800 bg-stone-900/90 p-3.5">
        <div class="flex items-center gap-3 min-w-0">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-red-600/20 text-red-500">
            <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </span>
          <div class="min-w-0">
            <p class="text-xs sm:text-sm font-semibold text-stone-200 truncate">
              {t(lang, 'video.search_topic')}: <span class="text-plague-300">«{topicName}»</span>
            </p>
            <p class="text-xs text-stone-400 truncate">
              <span class="text-stone-500">{t(lang, 'video.search_prefix')}</span> <span class="text-stone-300 font-mono">{queryText}</span>
            </p>
          </div>
        </div>
        <a
          href={ytSearchUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 shrink-0 rounded-md bg-red-600 hover:bg-red-500 px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider text-white shadow transition-all active:scale-95"
        >
          <span>{t(lang, 'video.watch_on_yt')}</span>
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
        </a>
      </div>

      <!-- VideoObject Schema.org microdata for search engines -->
      <script is:inline type="application/ld+json" set:html={videoSchema} />
    </section>
  )
}

<script>
  function initVideoCards() {
    document.querySelectorAll('.js-video-facade').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.videoId;
        if (!id) return;
        const frame = document.createElement('iframe');
        frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
        frame.title = 'Video guide';
        frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        frame.allowFullscreen = true;
        frame.className = 'aspect-video w-full';
        btn.replaceWith(frame);
        frame.focus();
      });
    });

    document.querySelectorAll('.js-ts-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const vidId = (btn as HTMLElement).dataset.videoId;
        const seconds = (btn as HTMLElement).dataset.seconds || '0';
        if (!vidId) return;

        const card = btn.closest('.js-video-card');
        if (!card) return;

        const facade = card.querySelector<HTMLElement>('.js-video-facade');
        const existingFrame = card.querySelector<HTMLIFrameElement>('iframe');
        const src = `https://www.youtube-nocookie.com/embed/${vidId}?autoplay=1&start=${seconds}`;

        if (existingFrame) {
          existingFrame.src = src;
        } else if (facade) {
          const frame = document.createElement('iframe');
          frame.src = src;
          frame.title = 'Video guide';
          frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
          frame.allowFullscreen = true;
          frame.className = 'aspect-video w-full';
          facade.replaceWith(frame);
        }
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });
  }
  initVideoCards();
</script>
