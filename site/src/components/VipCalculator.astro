      {t.title}
    </h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-stone-400">
      {t.subtitle}
    </p>

    <!-- Essential Automation Callouts -->
    <div class="mt-6 rounded-xl border border-amber-900/40 bg-amber-950/20 p-4 sm:p-5">
      <h3 class="text-xs font-bold uppercase tracking-wider text-amber-300">
        {t.automationTitle}
      </h3>
      <div class="mt-3 grid gap-2.5 text-xs text-stone-300 sm:grid-cols-2">
        <div class="flex items-start gap-2 rounded-lg border border-stone-800/80 bg-stone-900/60 p-2.5">
          <span class="text-base">🚀</span>
          <span><strong>VIP 6:</strong> {t.auto1}</span>
        </div>
        <div class="flex items-start gap-2 rounded-lg border border-amber-500/30 bg-amber-950/40 p-2.5 text-amber-200">
          <span class="text-base">🎯</span>
          <span><strong>VIP 8:</strong> {t.auto2}</span>
        </div>
        <div class="flex items-start gap-2 rounded-lg border border-stone-800/80 bg-stone-900/60 p-2.5">
          <span class="text-base">⚡</span>
          <span><strong>VIP 10:</strong> {t.auto3}</span>
        </div>
        <div class="flex items-start gap-2 rounded-lg border border-stone-800/80 bg-stone-900/60 p-2.5">
          <span class="text-base">🏰</span>
          <span><strong>HQ 20:</strong> {t.auto4}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Table of VIP Levels -->
  <div class="mt-6 overflow-x-auto">
    <table class="w-full text-left text-xs sm:text-sm">
      <thead>
        <tr class="border-b border-stone-800 text-stone-400 uppercase text-[11px] font-bold">
          <th class="py-3 px-3">{t.levelCol}</th>
          <th class="py-3 px-3">{t.giftCol}</th>
          <th class="py-3 px-3">{t.featureCol}</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-800/60 text-stone-300">
        {vipList.map((v: any) => {
          const giftName = v.dailyGift?.[lang] || v.dailyGift?.en;
          const isHighlight = !!v.highlight;

          return (
            <tr class={`transition-colors hover:bg-stone-900/60 ${isHighlight ? 'bg-amber-950/15' : ''}`}>
              <td class="py-3 px-3 font-bold text-stone-100 whitespace-nowrap">
                <span class="inline-flex items-center gap-1 rounded bg-stone-800 border border-stone-700 px-2 py-0.5 text-amber-400 text-xs">
                  👑 VIP {v.level}
                </span>
              </td>
              <td class="py-3 px-3 font-medium text-stone-200">
                {giftName}
              </td>
              <td class="py-3 px-3">
                {v.highlight ? (
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-500/40 bg-amber-950/60 px-2.5 py-0.5 text-xs font-bold text-amber-300">
                    <span>⚡</span>
                    <span>{v.highlight.badge}</span>
                  </span>
                ) : (
                  <span class="text-xs text-stone-500">—</span>
                )}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</section>
