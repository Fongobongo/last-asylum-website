---
import { t } from '../i18n/ui';
import { DISCORD_URL } from '../data/community';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const DISCORD_INVITE = DISCORD_URL;

const text =
  lang === 'ru'
    ? { title: 'Обсудить в сообществе', desc: 'Официальный Discord Last Asylum: Plague — гайды, помощь, коды первыми.' }
    : lang === 'es' ? { title: 'Únete a la comunidad', desc: 'Discord oficial de Last Asylum: Plague — guías, ayuda y códigos primero.' }
    : lang === 'pt' ? { title: 'Junte-se à comunidade', desc: 'Discord oficial — guias, ajuda e códigos em primeira mão.' }
    : lang === 'fr' ? { title: 'Rejoindre la communauté', desc: 'Discord officiel — guides, aide et codes en avant-première.' }
    : lang === 'de' ? { title: 'Community beitreten', desc: 'Offizieller Discord — Guides, Hilfe und Codes zuerst.' }
    : lang === 'id' ? { title: 'Gabung komunitas', desc: 'Discord resmi — panduan, bantuan, dan kode paling awal.' }
    : lang === 'ko' ? { title: '커뮤니티 참여', desc: '공식 디스코드 — 가이드, 도움, 코드를 가장 먼저.' }
    : lang === 'ja' ? { title: 'コミュニティに参加', desc: '公式Discord — ガイド、サポート、コードをいち早く。' }
    : lang === 'ar' ? { title: 'انضم إلى المجتمع', desc: 'خادم Discord الرسمي للعبة Last Asylum: Plague — احصل على الأدلة، المساعدة، والأكواد أولاً.' }
    : lang === 'it' ? { title: 'Unisciti alla community', desc: 'Discord ufficiale di Last Asylum: Plague — guide, aiuto e codici in anteprima.' }
    : lang === 'ms' ? { title: 'Sertai komuniti', desc: 'Discord rasmi Last Asylum: Plague — panduan, bantuan dan kod terkini.' }
    : lang === 'nl' ? { title: 'Word lid van de community', desc: 'Officiële Last Asylum: Plague Discord — gidsen, hulp en als eerste codes.' }
    : lang === 'tr' ? { title: 'Topluluğa katılın', desc: 'Resmi Last Asylum: Plague Discord sunucusu — rehberler, yardım ve kodlar ilk burada.' }
    : lang === 'vi' ? { title: 'Tham gia cộng đồng', desc: 'Discord chính thức của Last Asylum: Plague — nơi cập nhật hướng dẫn, trợ giúp và mã quà tặng sớm nhất.' }
    : lang === 'zh' ? { title: '加入社区', desc: 'Last Asylum: Plague 官方 Discord — 第一时间获取指南、帮助和兑换码。' }
    : lang === 'th' ? { title: 'เข้าร่วมชุมชนของเรา', desc: 'Discord อย่างเป็นทางการของ Last Asylum: Plague — รับคู่มือ, ความช่วยเหลือ และโค้ดก่อนใคร' }
    : { title: 'Join the community', desc: 'Official Last Asylum: Plague Discord — guides, help and codes first.' };
---

<a
  href={DISCORD_INVITE}
  target="_blank"
  rel="noopener noreferrer"
  class="not-prose my-8 flex items-center gap-4 rounded-xl border border-indigo-800/60 bg-indigo-950/40 p-5 transition-colors hover:border-indigo-600"
>
  <span class="text-3xl">💬</span>
  <span>
    <span class="block font-bold text-indigo-300">{text.title} ↗</span>
    <span class="mt-0.5 block text-sm text-stone-400">{text.desc}</span>
  </span>
</a>