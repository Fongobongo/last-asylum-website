---

<div class="not-prose my-8 rounded-xl border border-stone-800 bg-stone-900/95 p-5 shadow-xl" id="daily-checklist-container">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-stone-800 pb-4">
    <div>
      <h3 class="text-xl font-bold text-plague-200 flex items-center gap-2">
        <span>📋</span>
        <span>{texts.title}</span>
      </h3>
      <p class="text-xs text-stone-400 mt-0.5">{texts.subtitle}</p>
    </div>
    <div class="flex items-center gap-2">
      <span id="checklist-progress-text" class="text-xs font-mono font-bold text-toxic-400">0 / {texts.tasks.length}</span>
      <button
        id="checklist-reset-btn"
        class="text-[11px] text-stone-400 hover:text-stone-200 underline decoration-stone-600 transition"
      >
        {texts.resetBtn}
      </button>
    </div>
  </div>

  <!-- Progress Bar -->
  <div class="mt-4 h-2 w-full overflow-hidden rounded-full bg-stone-800">
    <div
      id="checklist-progress-bar"
      class="h-full bg-gradient-to-r from-plague-500 to-toxic-400 transition-all duration-300"
      style="width: 0%;"
    ></div>
  </div>

  <!-- Today's Event Focus Alert -->
  <div class="mt-4 rounded-lg border border-amber-500/30 bg-amber-950/20 p-3 text-xs text-amber-200">
    <p class="font-bold flex items-center gap-1.5 text-amber-300">
      <span>💡</span>
      <span>{texts.todayFocus}</span>
    </p>
    <p id="checklist-today-text" class="mt-1 text-amber-100/90 leading-relaxed"></p>
  </div>

  <!-- Task Items -->
  <div class="mt-4 space-y-2.5">
    {texts.tasks.map((task) => (
      <label class="group flex items-start gap-3 rounded-lg border border-stone-800/80 bg-stone-950/40 p-3 transition-colors hover:border-stone-700 cursor-pointer">
        <input
          type="checkbox"
          class="js-chk mt-0.5 h-4 w-4 rounded border-stone-700 bg-stone-800 text-plague-500 focus:ring-plague-500/40 cursor-pointer"
          data-task-id={task.id}
        />
        <div class="min-w-0 flex-1">
          <p class="text-sm font-semibold text-stone-200 group-hover:text-plague-200 transition-colors js-task-title">
            {task.label}
          </p>
          <p class="mt-0.5 text-xs text-stone-400 leading-relaxed">{task.tip}</p>
        </div>
      </label>
    ))}
  </div>

  <!-- Success Banner -->
  <div id="checklist-all-done" class="mt-4 hidden rounded-lg border border-toxic-500/40 bg-toxic-950/30 p-3 text-xs font-semibold text-toxic-300">
    {texts.allDone}
  </div>

  <p class="mt-3 text-[11px] text-stone-400 text-right">
    ℹ️ {texts.resetNotice}
  </p>
</div>

<script define:vars={{ daysList: texts.days, totalTasks: texts.tasks.length }}>
  (function () {
    const STORAGE_KEY = 'lap_daily_checklist_v1';
    const DATE_KEY = 'lap_checklist_last_date_v1';

    // Calculate current server date (UTC-2, YYYY-MM-DD); server midnight = 02:00 UTC
    const now = new Date();
    const serverNow = new Date(now.getTime() - 2 * 60 * 60 * 1000);
    const utcDayOfWeek = serverNow.getUTCDay(); // 0 = Sun, 1 = Mon, ...
    const utcDateStr = serverNow.toISOString().slice(0, 10);

    // Display today's event focus
    const todayEl = document.getElementById('checklist-today-text');
    if (todayEl && daysList[utcDayOfWeek]) {
      todayEl.textContent = daysList[utcDayOfWeek];
    }

    // Check if date changed since last store (auto-reset on new UTC day)
    const savedDate = localStorage.getItem(DATE_KEY);
    let state = {};
    if (savedDate !== utcDateStr) {
      localStorage.setItem(DATE_KEY, utcDateStr);
      localStorage.setItem(STORAGE_KEY, JSON.stringify({}));
      state = {};
    } else {
      try {
        state = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
      } catch (e) {
        state = {};
      }
    }

    const checkboxes = document.querySelectorAll('.js-chk');
    const progressBar = document.getElementById('checklist-progress-bar');
    const progressText = document.getElementById('checklist-progress-text');
    const allDoneBanner = document.getElementById('checklist-all-done');

    function updateUI() {
      let count = 0;
      checkboxes.forEach((cb) => {
        const id = cb.dataset.taskId;
        const isChecked = !!state[id];
        cb.checked = isChecked;
        const label = cb.closest('label')?.querySelector('.js-task-title');
        if (label) {
          if (isChecked) {
            label.classList.add('line-through', 'text-stone-500');
          } else {
            label.classList.remove('line-through', 'text-stone-500');
          }
        }
        if (isChecked) count++;
      });

      const pct = Math.round((count / totalTasks) * 100);
      if (progressBar) progressBar.style.width = pct + '%';
      if (progressText) progressText.textContent = `${count} / ${totalTasks}`;

      if (allDoneBanner) {
        if (count === totalTasks && totalTasks > 0) {
          allDoneBanner.classList.remove('hidden');
        } else {
          allDoneBanner.classList.add('hidden');
        }
      }
    }

    checkboxes.forEach((cb) => {
      cb.addEventListener('change', () => {
        const id = cb.dataset.taskId;
        state[id] = cb.checked;
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        updateUI();
      });
    });

    const resetBtn = document.getElementById('checklist-reset-btn');
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        state = {};
        localStorage.setItem(STORAGE_KEY, JSON.stringify({}));
        updateUI();
      });
    }

    updateUI();
  })();
</script>
