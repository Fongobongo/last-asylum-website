<script>
  function initSquadBuilder() {
    const root = document.getElementById('squad-builder');
    if (!root) return;

    let squad: (any | null)[] = [null, null, null, null, null];
    let currentSlotIdx = -1;

    const modal = document.getElementById('sb-modal');
    const modalClose = document.getElementById('sb-modal-close');
    const modalSlotLabel = document.getElementById('sb-modal-slot-label');

    const presets: Record<string, string[]> = {
      'f2p-warrior': ['arthur', 'daskal', 'marlena', 'claire', 'bell'],
      'ranger-burst': ['zoya', 'celia', 'cynthia', 'shadow', 'harper'],
      'sorcerer-cc': ['annie', 'joker', 'red-lady', 'lucius', 'kesso'],
    };

    const heroesData: Record<string, { name: string; rarity: string; tier: string; cls: string }> = {};
    root.querySelectorAll<HTMLButtonElement>('.sb-hero-pick-btn').forEach((b) => {
      const slug = b.dataset.slug || '';
      heroesData[slug] = {
        name: b.dataset.name || slug,
        rarity: b.dataset.rarity || 'SSR',
        tier: b.dataset.tier || 'A',
        cls: b.dataset.class || 'Warrior',
      };
    });

    const updateSlotsUI = () => {
      let warriors = 0;
      let rangers = 0;
      let sorcerers = 0;

      squad.forEach((slug, idx) => {
        const slotEl = root.querySelector(`.squad-slot[data-slot="${idx}"]`);
        if (!slotEl) return;
        const emptyEl = slotEl.querySelector('.slot-empty');
        const filledEl = slotEl.querySelector('.slot-filled');

        if (!slug || !heroesData[slug]) {
          emptyEl?.classList.remove('hidden');
          filledEl?.classList.add('hidden');
          slotEl.classList.remove('border-solid', 'border-toxic-400', 'bg-toxic-500/10');
          slotEl.classList.add('border-dashed', 'border-white/15', 'bg-black/40');
        } else {
          emptyEl?.classList.add('hidden');
          filledEl?.classList.remove('hidden');
          slotEl.classList.remove('border-dashed', 'border-white/15', 'bg-black/40');
          slotEl.classList.add('border-solid', 'border-toxic-500/40', 'bg-stone-950/80');

          const h = heroesData[slug];
          if (h.cls === 'Warrior') warriors++;
          else if (h.cls === 'Ranger') rangers++;
          else if (h.cls === 'Sorcerer') sorcerers++;

          if (filledEl) {
            filledEl.innerHTML = `
              <div class="flex items-center justify-between w-full mb-1">
                <span class="rounded bg-white/10 px-1.5 py-0.5 text-[9px] font-mono font-bold text-stone-300">${h.rarity}</span>
                <button type="button" class="sb-btn-remove text-stone-500 hover:text-red-400 text-xs font-bold" data-slot="${idx}">✕</button>
              </div>
              <div class="text-base font-bold text-white truncate">${h.name}</div>
              <div class="mt-1 flex items-center justify-center gap-1.5 text-xs text-stone-400">
                <span>${h.cls === 'Warrior' ? '🛡️' : h.cls === 'Ranger' ? '🏹' : '🔮'}</span>
                <span>${h.cls}</span>
                <span class="text-stone-600">•</span>
                <span class="font-mono text-toxic-300 font-bold">Tier ${h.tier}</span>
              </div>
            `;

            filledEl.querySelector('.sb-btn-remove')?.addEventListener('click', (e) => {
              e.stopPropagation();
              squad[idx] = null;
              updateSlotsUI();
            });
          }
        }
      });

      // Update counters
      const cntW = document.getElementById('sb-cnt-warrior');
      const cntR = document.getElementById('sb-cnt-ranger');
      const cntS = document.getElementById('sb-cnt-sorcerer');
      if (cntW) cntW.textContent = String(warriors);
      if (cntR) cntR.textContent = String(rangers);
      if (cntS) cntS.textContent = String(sorcerers);

      // Synergy calculation
      const maxCount = Math.max(warriors, rangers, sorcerers);
      const auraTitle = document.getElementById('sb-aura-title');
      const auraBonus = document.getElementById('sb-aura-bonus');

      const filledCount = squad.filter(Boolean).length;
      if (filledCount < 5) {
        if (auraTitle) auraTitle.innerHTML = `<span class="text-stone-500">⚪ Выбрано ${filledCount} из 5 героев</span>`;
        if (auraBonus) auraBonus.textContent = '+0% к параметрам (заполните все 5 слотов)';
      } else {
        if (maxCount === 5) {
          const clsName = warriors === 5 ? 'Воинов (Mono-Warrior)' : rangers === 5 ? 'Рейнджеров (Mono-Ranger)' : 'Колдунов (Mono-Sorcerer)';
          if (auraTitle) auraTitle.innerHTML = `<span class="text-toxic-300">⚡ Аура Моно-класса: 5 ${clsName}</span>`;
          if (auraBonus) auraBonus.innerHTML = '<strong class="text-toxic-300 font-bold">+20% АТАКИ / +20% ЗДОРОВЬЯ</strong> (Максимум)';
        } else if (maxCount === 4) {
          if (auraTitle) auraTitle.innerHTML = '<span class="text-amber-300">🔥 Синергия 4+1</span>';
          if (auraBonus) auraBonus.innerHTML = '<strong class="text-amber-300 font-bold">+15% АТАКИ / +15% ЗДОРОВЬЯ</strong>';
        } else if (maxCount === 3) {
          const counts = [warriors, rangers, sorcerers].sort((a, b) => b - a);
          if (counts[1] === 2) {
            if (auraTitle) auraTitle.innerHTML = '<span class="text-sky-300">✨ Гибридная синергия 3+2</span>';
            if (auraBonus) auraBonus.innerHTML = '<strong class="text-sky-300 font-bold">+10% АТАКИ / +10% ЗДОРОВЬЯ</strong>';
          } else {
            if (auraTitle) auraTitle.innerHTML = '<span class="text-stone-300">🔹 Базовая синергия 3+1+1</span>';
            if (auraBonus) auraBonus.innerHTML = '<strong class="text-stone-300 font-bold">+5% АТАКИ / +5% ЗДОРОВЬЯ</strong>';
          }
        } else {
          if (auraTitle) auraTitle.innerHTML = '<span class="text-stone-400">⚠️ Смешанный отряд (Без бонуса ауры)</span>';
          if (auraBonus) auraBonus.textContent = '+0% АТАКИ / +0% ЗДОРОВЬЯ (Рекомендуется собрать минимум 3 героя одного класса)';
        }
      }
    };

    // Slot click opens modal
    root.querySelectorAll('.squad-slot').forEach((slot) => {
      slot.addEventListener('click', () => {
        currentSlotIdx = parseInt((slot as HTMLElement).dataset.slot || '0', 10);
        if (modalSlotLabel) modalSlotLabel.textContent = `Слот ${currentSlotIdx + 1}`;
        modal?.classList.remove('hidden');
      });
    });

    modalClose?.addEventListener('click', () => modal?.classList.add('hidden'));
    modal?.addEventListener('click', (e) => { if (e.target === modal) modal.classList.add('hidden'); });

    // Hero selection
    root.querySelectorAll('.sb-hero-pick-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = (btn as HTMLElement).dataset.slug;
        if (slug && currentSlotIdx >= 0 && currentSlotIdx < 5) {
          squad[currentSlotIdx] = slug;
          modal?.classList.add('hidden');
          updateSlotsUI();
        }
      });
    });

    // Preset buttons
    root.querySelectorAll('.sb-preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const pKey = (btn as HTMLElement).dataset.preset || '';
        if (presets[pKey]) {
          squad = [...presets[pKey]];
          updateSlotsUI();
        }
      });
    });

    // Clear button
    document.getElementById('sb-btn-clear')?.addEventListener('click', () => {
      squad = [null, null, null, null, null];
      updateSlotsUI();
    });

    // Share link button
    document.getElementById('sb-btn-share')?.addEventListener('click', async () => {
      const slugs = squad.filter(Boolean).join(',');
      const url = new URL(window.location.href);
      url.searchParams.set('squad', slugs);
      window.history.replaceState({}, '', url.toString());

      const label = document.getElementById('sb-share-label');
      const isRu = (document.documentElement.lang || '').startsWith('ru');
      const origText = label?.textContent || (isRu ? 'Поделиться' : 'Share Squad');
      try {
        await navigator.clipboard.writeText(url.toString());
        if (label) label.textContent = isRu ? '✓ Скопировано!' : '✓ Copied!';
        setTimeout(() => { if (label) label.textContent = origText; }, 2000);
      } catch {
        if (label) label.textContent = url.toString();
      }
    });

    // Load from URL params if present
    const urlParams = new URLSearchParams(window.location.search);
    const sqParam = urlParams.get('squad');
    if (sqParam) {
      const list = sqParam.split(',').slice(0, 5);
      list.forEach((slug, i) => { squad[i] = slug; });
    }

    // External event loader (e.g. from Squad Quiz)
    window.addEventListener('lap-load-squad', ((e: CustomEvent) => {
      if (e.detail && e.detail.slugs) {
        squad = [null, null, null, null, null];
        const list = e.detail.slugs.split(',').slice(0, 5);
        list.forEach((slug: string, i: number) => { squad[i] = slug; });
        updateSlotsUI();
      }
    }) as EventListener);

    updateSlotsUI();
  }

  initSquadBuilder();
</script>
