---
import Feedback from './Feedback.astro';

interface Props {
  title: string;
  description?: string;
  lang: 'en' | 'ru' | 'es' | 'pt' | 'fr' | 'de' | 'id' | 'ko' | 'ja' | string;
  breadcrumbs?: { label: string; href?: string }[];
}

const { title, description, breadcrumbs = [] } = Astro.props;
const lang: string = (Astro.props as any).lang ?? 'en';
