const G = (k: string): string => {
  const table: Record<string, string> | undefined = (GPS as any)[lang] ?? GPS.en;
  return table?.[k] ?? (GPS.en as any)[k] ?? k;
};

const slots = await Astro.slots.render('default');
const re = /<(h[23])[^>]*id="([^"]+)"[^>]*>(.*?)<\/\1>/g;
let m;
const toc: { level: string; id: string; text: string }[] = [];
while ((m = re.exec(slots)) !== null) {
  toc.push({
    level: m[1],
    id: m[2],
    text: m[3].replace(/<[^>]+>/g, '').trim(),
  });
}

---

<div class:list={[toc.length > 2 && 'lg:grid lg:grid-cols-[1fr_280px] lg:gap-8 xl:gap-10']}>
  {
    breadcrumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-5 flex flex-wrap items-center gap-1.5 text-[13px] text-stone-500 lg:col-span-2">
        <a href="/" class="inline-flex items-center gap-1 hover:text-stone-300 transition">
          <span class="text-stone-600">⌂</span>
        </a>
        <span class="text-stone-700">›</span>
        {breadcrumbs.map((b, i) => (
          <span class="flex items-center gap-1.5">
            {b.href ? (
              <a href={b.href} class="rounded-full px-2 py-0.5 hover:bg-stone-800 hover:text-plague-200 transition">
                {b.label}
              </a>
            ) : (
              <span class="rounded-full bg-stone-800 px-2.5 py-0.5 text-stone-300 border border-stone-700/50">{b.label}</span>
            )}
            {i < breadcrumbs.length - 1 && <span class="text-stone-700">›</span>}
          </span>
        ))}
      </nav>
    )
  }

  <article class="prose-la max-w-none">
    <header class="mb-8 border-b border-stone-800/60 pb-6">
      <h1 class="mb-3 text-3xl font-bold tracking-[-0.02em] text-stone-100 sm:text-[32px] leading-tight" id="top">{title}</h1>
      {description && <p class="text-[15px] leading-6 text-stone-400 max-w-2xl">{description}</p>}
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-xs text-stone-500">
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-stone-800 bg-stone-900/50 px-2.5 py-1">
            <span class="h-1.5 w-1.5 rounded-full bg-toxic-400"></span>
            Guide
          </span>
          <span>Updated • Community verified</span>
        </div>

        <div class="flex items-center gap-2">
          <button
            id="btn-page-share"
            type="button"
            class="inline-flex items-center gap-1.5 rounded-xl border border-stone-800 bg-stone-900/80 px-3 py-1.5 text-xs font-semibold text-stone-300 hover:text-white hover:border-toxic-500/50 transition cursor-pointer"
            title={G('copylink')}
          >
            <span id="share-icon">🔗</span>
            <span id="share-label">{G('share')}</span>
          </button>

          <button
            id="btn-page-bookmark"
            type="button"
            class="inline-flex items-center gap-1.5 rounded-xl border border-stone-800 bg-stone-900/80 px-3 py-1.5 text-xs font-semibold text-stone-300 hover:text-white hover:border-toxic-500/50 transition cursor-pointer"
            data-title={title}
          >
            <span id="bm-icon">☆</span>
            <span id="bm-label">{G('bookmark')}</span>
          </button>
        </div>
      </div>
    </header>

    {
      toc.length > 2 && (
        <details class="mb-6 overflow-hidden rounded-2xl border border-stone-800 bg-stone-900/40 lg:hidden">
          <summary class="flex cursor-pointer select-none items-center justify-between px-4 py-3 text-sm font-medium text-stone-200">
            <span class="inline-flex items-center gap-2">☰ {G('toc')} <span class="rounded-full bg-stone-800 px-2 py-0.5 text-xs text-stone-400 border border-stone-700">{toc.length}</span></span>
            <span class="text-stone-500">▾</span>
          </summary>
          <nav class="border-t border-stone-800 px-2 py-2 text-sm">
            {toc.map((item) => (
              <a href={`#${item.id}`} class={`flex items-center gap-2 rounded-lg px-3 py-2 text-stone-400 hover:bg-stone-800 hover:text-stone-100 transition ${item.level === 'h3' ? 'ml-3 text-[13px] border-l border-stone-800 pl-3' : ''}`}>
                <span class="h-1 w-1 rounded-full bg-stone-600"></span>
                {item.text}
              </a>
            ))}
          </nav>
        </details>
      )
    }

    <div class="prose-la">
      <slot />
    </div>

    <div class="mt-10">
      <Feedback lang={Astro.props.lang} />
    </div>
  </article>

  {
    toc.length > 2 && (
      <aside class="sticky top-[84px] hidden self-start lg:block">
        <div class="rounded-2xl border border-stone-800/80 bg-stone-900/40 backdrop-blur-xl p-4 shadow-xl">
          <p class="mb-3 text-[11px] font-semibold uppercase tracking-widest text-stone-500 flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-toxic-400"></span>
            {G('toc')}
          </p>
          <nav class="space-y-1 text-[13.5px]">
            {toc.map((item) => (
              <a href={`#${item.id}`} class={`toc-link flex items-center gap-2.5 rounded-lg px-2.5 py-1.5 transition text-stone-400 hover:bg-stone-800/60 hover:text-stone-100 ${item.level === 'h3' ? 'ml-3 text-[13px] border-l border-stone-800/80 pl-2.5' : ''}`}>
                <span class={`toc-dot h-1.5 w-1.5 rounded-full shrink-0 transition-transform ${item.level === 'h2' ? 'bg-plague-400/80' : 'bg-stone-600'}`}></span>
                <span class="line-clamp-1">{item.text}</span>
              </a>
            ))}
          </nav>
        </div>
      </aside>
    )
  }
</div>

<script>
  function initTOC() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('aside nav a[href^="#"]'));
    if (!links.length) return;

    const headings = links
      .map((link) => {
        const id = link.getAttribute('href')?.slice(1);
        return id ? document.getElementById(id) : null;
      })
      .filter((h): h is HTMLElement => h !== null);

    if (!headings.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.find((e) => e.isIntersecting);
        if (visible) {
          const id = visible.target.id;
          links.forEach((l) => {
            const match = l.getAttribute('href') === `#${id}`;
            l.classList.toggle('active', match);
          });
        }
      },
      { rootMargin: '-90px 0px -70% 0px' }
    );

    headings.forEach((h) => observer.observe(h));
  }
  initTOC();

  function initPageBookmark() {
    const btn = document.getElementById('btn-page-bookmark');
    if (!btn) return;
    const STORAGE_KEY = 'lap_bookmarks';
    const pageUrl = window.location.pathname;
    const pageTitle = btn.dataset.title || document.title;

    const getList = () => {
      try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); }
      catch { return []; }
    };

    const isBookmarked = () => getList().some((b: any) => b.url === pageUrl);

    const updateState = () => {
      const active = isBookmarked();
      const icon = document.getElementById('bm-icon');
      const label = document.getElementById('bm-label');
      const isRu = (document.documentElement.lang || '').startsWith('ru');
      if (icon) icon.textContent = active ? '★' : '☆';
      if (label) label.textContent = active ? (isRu ? 'В закладках' : 'Bookmarked') : (isRu ? 'В закладки' : 'Bookmark');
      btn.classList.toggle('border-toxic-400', active);
      btn.classList.toggle('text-toxic-300', active);
      btn.classList.toggle('bg-toxic-500/10', active);
    };

    updateState();

    btn.addEventListener('click', () => {
      let list = getList();
      if (isBookmarked()) {
        list = list.filter((b: any) => b.url !== pageUrl);
      } else {
        list.push({ url: pageUrl, title: pageTitle });
      }
      localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
      updateState();
      window.dispatchEvent(new CustomEvent('lap-bookmarks-updated'));
    });
  }
  initPageBookmark();

  function initShareButton() {
    const btn = document.getElementById('btn-page-share');
    if (!btn) return;
    const label = document.getElementById('share-label');
    const isRu = (document.documentElement.lang || '').startsWith('ru');

    btn.addEventListener('click', async () => {
      try {
        if (navigator.share && /mobile|android|iphone|ipad/i.test(navigator.userAgent)) {
          await navigator.share({
            title: document.title,
            url: window.location.href,
          });
        } else {
          await navigator.clipboard.writeText(window.location.href);
          if (label) label.textContent = isRu ? '✓ Скопировано' : '✓ Copied';
          btn.classList.add('border-toxic-400', 'text-toxic-300', 'bg-toxic-500/10');
          setTimeout(() => {
            if (label) label.textContent = isRu ? 'Поделиться' : 'Share';
            btn.classList.remove('border-toxic-400', 'text-toxic-300', 'bg-toxic-500/10');
          }, 2000);
        }
      } catch (e) {
        // User cancelled or clipboard error
      }
    });
  }
  initShareButton();
</script>