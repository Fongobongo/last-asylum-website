<script define:vars={{ msgUnlocked: T('s25'), msgRemain: T('s26') }}>
  function initAdCalc() {
    const root = document.getElementById('ad-calculator');
    if (!root) return;

    let activeDay = '4';
    const totalEl = document.getElementById('ad-total-points');
    const barEl = document.getElementById('ad-progress-bar');
    const targetStatusEl = document.getElementById('ad-target-status');

    const updatePoints = () => {
      const activeForm = document.getElementById(`ad-form-${activeDay}`);
      if (!activeForm) return;

      let total = 0;
      activeForm.querySelectorAll<HTMLInputElement>('.ad-input').forEach((inp) => {
        const factor = parseInt(inp.dataset.factor || '0', 10);
        const val = parseInt(inp.value || '0', 10);
        if (!isNaN(val) && val > 0) {
          total += val * factor;
        }
      });

      if (totalEl) totalEl.textContent = total.toLocaleString();

      const maxGoal = 7200000;
      const pct = Math.min(100, Math.round((total / maxGoal) * 100));
      if (barEl) barEl.style.width = `${pct}%`;

      const m1 = document.getElementById('m-1');
      const m3 = document.getElementById('m-3');
      const m6 = document.getElementById('m-6');
      const m9 = document.getElementById('m-9');

      m1?.classList.toggle('border-toxic-400', total >= 100000);
      m1?.classList.toggle('text-toxic-300', total >= 100000);
      m3?.classList.toggle('border-toxic-400', total >= 500000);
      m3?.classList.toggle('text-toxic-300', total >= 500000);
      m6?.classList.toggle('border-toxic-400', total >= 2000000);
      m6?.classList.toggle('text-toxic-300', total >= 2000000);
      m9?.classList.toggle('border-toxic-400', total >= 7200000);
      m9?.classList.toggle('text-toxic-300', total >= 7200000);

      if (targetStatusEl) {
        if (total >= 7200000) {
          targetStatusEl.innerHTML = '<strong class="text-toxic-300">' + msgUnlocked + '</strong>';
        } else {
          const diff = (7200000 - total).toLocaleString();
          targetStatusEl.textContent = msgRemain.replace('{diff}', diff);
        }
      }
    };

    // Tab switching
    root.querySelectorAll<HTMLButtonElement>('.ad-tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        root.querySelectorAll('.ad-tab').forEach((t) => {
          t.classList.remove('active', 'border-toxic-400', 'bg-toxic-500/20', 'text-toxic-300');
          t.classList.add('border-white/10');
        });
        tab.classList.add('active', 'border-toxic-400', 'bg-toxic-500/20', 'text-toxic-300');
        tab.classList.remove('border-white/10');

        activeDay = tab.dataset.day || '4';

        root.querySelectorAll('.ad-day-form').forEach((f) => f.classList.add('hidden'));
        document.getElementById(`ad-form-${activeDay}`)?.classList.remove('hidden');

        updatePoints();
      });
    });

    // Inputs listener
    root.querySelectorAll<HTMLInputElement>('.ad-input').forEach((inp) => {
      inp.addEventListener('input', updatePoints);
    });

    updatePoints();
  }

  initAdCalc();
</script>
